#: plasmoid/contents/config/config.qml
msgid "General"
msgstr "일반"

#: plasmoid/contents/ui/FullRepresentation.qml plasmoid/contents/ui/logic.js
msgid "System updates install during the next restart. Apps update now."
msgstr "시스템 업데이트는 다음 재시작 시 설치됩니다. 앱은 지금 업데이트됩니다."

#: plasmoid/contents/ui/FullRepresentation.qml plasmoid/contents/ui/logic.js
msgid "System updates install during the next restart."
msgstr "시스템 업데이트는 다음 재시작 시 설치됩니다."

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Holding %1"
msgstr "%1 보류 중"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "No longer holding %1"
msgstr "%1을(를) 더 이상 보류하지 않음"

#: plasmoid/contents/ui/FullRepresentation.qml plasmoid/contents/ui/main.qml
msgid "Check for Updates"
msgstr "업데이트 확인"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Checks for updates now, instead of waiting for the timer."
msgstr "타이머를 기다리지 않고 지금 업데이트를 확인합니다."

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Configure Kempt…"
msgstr "Kempt 구성…"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Check interval, where updates run, and the packages you hold."
msgstr "확인 간격, 업데이트 실행 위치, 보류 중인 패키지."

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Check Installation"
msgstr "설치 확인"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Restart to finish updating."
msgstr "재시작하여 업데이트를 완료하세요."

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Restart…"
msgstr "재시작…"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Discard Updates"
msgstr "업데이트 폐기"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Removes the updates waiting for the next restart, so the restart installs nothing. May ask for your password. It deletes the packages it downloaded, so installing again downloads them again."
msgstr "다음 재시작을 기다리는 업데이트를 제거하여 재시작 시 아무것도 설치되지 않게 합니다. 비밀번호를 물어볼 수 있습니다. 다운로드한 패키지를 삭제하므로 다시 설치하면 다시 다운로드합니다."

#: plasmoid/contents/ui/FullRepresentation.qml
#: plasmoid/contents/ui/configGeneral.qml
msgid "Turn Off Discover's Update Checks"
msgstr "Discover의 업데이트 확인 끄기"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Turning off Discover's update checks should stop that."
msgstr "Discover의 업데이트 확인을 끄면 이 문제가 중단됩니다."

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Nothing is installed yet. %1"
msgstr "아직 아무것도 설치되지 않았습니다. %1"

#: plasmoid/contents/ui/FullRepresentation.qml plasmoid/contents/ui/logic.js
#: plasmoid/contents/ui/main.qml
msgid "Install on Next Restart"
msgstr "다음 재시작 시 설치"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Install Now"
msgstr "지금 설치"

#: plasmoid/contents/ui/FullRepresentation.qml plasmoid/contents/ui/logic.js
msgid "Update Now"
msgstr "지금 업데이트"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Installs the update now, while your desktop is running."
msgstr "데스크톱이 실행 중인 동안 지금 업데이트를 설치합니다."

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Show Log"
msgstr "로그 표시"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Check Anyway"
msgstr "그래도 확인"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Checks online now over this metered connection."
msgstr "이 종량제 연결을 통해 지금 온라인으로 확인합니다."

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Checks online now on battery power."
msgstr "배터리 전원으로 지금 온라인으로 확인합니다."

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Checking Kempt's installation…"
msgstr "Kempt 설치 확인 중…"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Show Full Report"
msgstr "전체 보고서 표시"

#: plasmoid/contents/ui/FullRepresentation.qml
#: plasmoid/contents/ui/StartupPage.qml plasmoid/contents/ui/logic.js
msgid "Copy Command"
msgstr "명령 복사"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Full report"
msgstr "전체 보고서"

#: plasmoid/contents/ui/FullRepresentation.qml
#: plasmoid/contents/ui/StartupPage.qml plasmoid/contents/ui/main.qml
msgid "Startup Report"
msgstr "시작 보고서"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Shows what failed, and the command to see why."
msgstr "실패한 항목과 원인을 확인하는 명령을 표시합니다."

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Freeing Up Space…"
msgstr "공간 확보 중…"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Free Up Space"
msgstr "공간 확보"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Removes the Flatpak runtimes listed under Show Runtimes."
msgstr "'런타임 표시' 아래에 나열된 Flatpak 런타임을 제거합니다."

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Show Runtimes"
msgstr "런타임 표시"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Kempt skips these. Other updaters still see them."
msgstr "Kempt는 이들을 건너뜁니다. 다른 업데이트 도구에서는 계속 보입니다."

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Hide details of the last update"
msgstr "마지막 업데이트 세부 정보 숨기기"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Show details of the last update"
msgstr "마지막 업데이트 세부 정보 표시"

#: plasmoid/contents/ui/FullRepresentation.qml plasmoid/contents/ui/logic.js
msgid "Preparing updates for the next restart…"
msgstr "다음 재시작을 위한 업데이트 준비 중…"

#: plasmoid/contents/ui/FullRepresentation.qml plasmoid/contents/ui/logic.js
msgid "Updating…"
msgstr "업데이트 중…"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Not Updating? Check Again"
msgstr "업데이트되지 않나요? 다시 확인"

#: plasmoid/contents/ui/StartupPage.qml
msgid "Back"
msgstr "뒤로"

#: plasmoid/contents/ui/StartupPage.qml
msgid "Returns to the list of updates."
msgstr "업데이트 목록으로 돌아갑니다."

#: plasmoid/contents/ui/StartupPage.qml
msgid "Refresh"
msgstr "새로 고침"

#: plasmoid/contents/ui/StartupPage.qml
msgid "Reads the startup list again."
msgstr "시작 목록을 다시 읽습니다."

#: plasmoid/contents/ui/StartupPage.qml
msgctxt "@action:button a service's name follows"
msgid "Copy Command: %1"
msgstr "명령 복사: %1"

#: plasmoid/contents/ui/StartupPage.qml
msgid "Mute Until It Starts"
msgstr "시작될 때까지 음소거"

#: plasmoid/contents/ui/StartupPage.qml
msgid "Muting…"
msgstr "음소거 중…"

#: plasmoid/contents/ui/StartupPage.qml
msgctxt "@action:button a service's name follows"
msgid "Muting…: %1"
msgstr "음소거 중…: %1"

#: plasmoid/contents/ui/StartupPage.qml
msgctxt "@action:button a service's name follows"
msgid "Mute Until It Starts: %1"
msgstr "시작될 때까지 음소거: %1"

#: plasmoid/contents/ui/StartupPage.qml
msgid "Kempt stops mentioning it until it starts cleanly again."
msgstr "정상적으로 다시 시작될 때까지 Kempt는 이를 언급하지 않습니다."

#: plasmoid/contents/ui/StartupPage.qml
msgid "Reading what starts with the computer…"
msgstr "컴퓨터와 함께 시작되는 항목을 읽는 중…"


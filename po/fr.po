msgstr "Mise en sourdine… : %1"

#: plasmoid/contents/ui/StartupPage.qml
msgctxt "@action:button a service's name follows"
msgid "Mute Until It Starts: %1"
msgstr "Mettre en sourdine jusqu'à son démarrage : %1"

#: plasmoid/contents/ui/StartupPage.qml
msgid "Kempt stops mentioning it until it starts cleanly again."
msgstr "Kempt cesse de le mentionner jusqu'à ce qu'il démarre à nouveau correctement."

#: plasmoid/contents/ui/StartupPage.qml
msgid "Reading what starts with the computer…"
msgstr "Lecture de ce qui démarre avec l'ordinateur…"


msgid "Removes the Flatpak runtimes listed under Show Runtimes."
msgstr "Supprime les environnements d'exécution Flatpak listés sous Afficher les environnements."

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Show Runtimes"
msgstr "Afficher les environnements"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Kempt skips these. Other updaters still see them."
msgstr "Kempt les ignore. Les autres programmes de mise à jour les voient toujours."

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Hide details of the last update"
msgstr "Masquer les détails de la dernière mise à jour"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Show details of the last update"
msgstr "Afficher les détails de la dernière mise à jour"

#: plasmoid/contents/ui/FullRepresentation.qml plasmoid/contents/ui/logic.js
msgid "Preparing updates for the next restart…"
msgstr "Préparation des mises à jour pour le prochain redémarrage…"

#: plasmoid/contents/ui/FullRepresentation.qml plasmoid/contents/ui/logic.js
msgid "Updating…"
msgstr "Mise à jour…"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Not Updating? Check Again"
msgstr "Pas de mise à jour ? Revérifier"

#: plasmoid/contents/ui/StartupPage.qml
msgid "Back"
msgstr "Retour"

#: plasmoid/contents/ui/StartupPage.qml
msgid "Returns to the list of updates."
msgstr "Retourne à la liste des mises à jour."


#: plasmoid/contents/config/config.qml
msgid "General"
msgstr "Général"

#: plasmoid/contents/ui/FullRepresentation.qml plasmoid/contents/ui/logic.js
msgid "System updates install during the next restart. Apps update now."
msgstr "Les mises à jour du système s'installent au prochain redémarrage. Les applications se mettent à jour maintenant."

#: plasmoid/contents/ui/FullRepresentation.qml plasmoid/contents/ui/logic.js
msgid "System updates install during the next restart."
msgstr "Les mises à jour du système s'installent au prochain redémarrage."

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Holding %1"
msgstr "%1 retenu"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "No longer holding %1"
msgstr "%1 n'est plus retenu"

#: plasmoid/contents/ui/FullRepresentation.qml plasmoid/contents/ui/main.qml
msgid "Check for Updates"
msgstr "Rechercher des mises à jour"

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Checks for updates now, instead of waiting for the timer."
msgstr "Recherche des mises à jour maintenant, au lieu d'attendre la minuterie."

#: plasmoid/contents/ui/FullRepresentation.qml
msgid "Configure Kempt…"
msgstr "Configurer Kempt…"


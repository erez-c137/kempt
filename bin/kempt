#!/usr/bin/env bash
# Kempt - one-click system updates. See docs/architecture.md
set -euo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(dirname "$(dirname "$SELF")")"
source "$ROOT/lib/common.sh"
source "$ROOT/backends/dnf.sh"
source "$ROOT/backends/flatpak.sh"

command -v jq >/dev/null || { echo "kempt: requires jq" >&2; exit 3; }

# Both spellings, because both get typed.
cmd_version() {
  [[ $# -eq 0 ]] || { echo "unknown option: $1" >&2; exit 2; }
  printf 'kempt %s\n' "$(kempt_version)"
}

cmd_check() {
  # NOTE: `if x="$(fn)"` disables errexit inside fn's whole body - backends must therefore
  # return status EXPLICITLY (they do) and never rely on set -e for error propagation.
  [[ $# -eq 0 ]] || { echo "unknown option: $1" >&2; exit 2; }
  kempt_init_dirs
  # serialize checks: without this the last FINISHER wins and a stale result overwrites a fresh one
  exec 9>"$KEMPT_STATE_DIR/check.lock"
  if ! flock -w "$KEMPT_CHECK_LOCK_WAIT" 9; then
    echo "warning: another check holds the lock; serving previous state" >&2
    # `[inputs][0]`, and NOT `jq -e .`: a multi-document state file is valid input to jq, so the
    # plain form prints BOTH documents under exit 0 and the widget's JSON.parse throws on the
    # second. House idiom - same guard on prev_ls below, in state_prev_items and `summary --json`.
    jq -e -n '[inputs][0] | select(type == "object")' "$STATE_FILE" 2>/dev/null || true
    return 0
  fi
  # inside the check lock, before anything reads the world: two overlapping checks must not turn
  # one staged transaction into two history entries
  harvest_offline
  maybe_refresh_metadata
  local status="ok" error="" dnf_items fp_items fp_enabled=true prev_ls serr errf
  # Download sizes, in files because attach_sizes joins against a TSV. Empty on any failure, and
  # nothing below may change `status`: the check must answer with or without a size.
  local dnf_sz fp_sz dnf_priced=false fp_priced=false
  dnf_sz="$(mktemp)"; fp_sz="$(mktemp)"
  # -n/[inputs][0]: the corrupt-tolerance idiom above (a multi-doc file joins one last_success per
  # document into one string).
  prev_ls="$(jq -r -n '[inputs][0].last_success? // empty' "$STATE_FILE" 2>/dev/null || true)"
  errf="$(mktemp)"
  if dnf_items="$(dnf_check 2>"$errf")"; then
    # Priced only when the check ANSWERED: a stale backend serves the previous state's items,
    # which carry their own sizes - re-pricing puts today's bytes on yesterday's list.
    dnf_priced=true
    dnf_sizes > "$dnf_sz" 2>/dev/null || : > "$dnf_sz"
  else
    # explain_helper_error rewrites the one case the raw text gets WRONG: a missing root helper,
    # which `timeout` reports as a failure to run a command and reads as a timeout. dnf only -
    # the one check path that goes through a root helper.
    serr="$(explain_helper_error "$(stderr_tail "$errf")")"
    status="stale"; error="dnf check failed${serr:+: $serr}"; dnf_items="$(state_prev_items dnf)"
  fi
  if is_true "$(config_get include_flatpak)"; then
    if fp_items="$(flatpak_check "$fp_sz" 2>"$errf")"; then fp_priced=true; else
      serr="$(stderr_tail "$errf")"
      status="stale"; error="${error:+$error; }flatpak check failed${serr:+: $serr}"; fp_items="$(state_prev_items flatpak)"
    fi
  else
    fp_enabled=false; fp_items='[]'
  fi
  rm -f "$errf"
  dnf_items="$(mark_held dnf <<<"$dnf_items")"
  fp_items="$(mark_held flatpak <<<"$fp_items")"
  # After mark_held, because the coverage rule below counts NON-HELD items only.
  [[ "$dnf_priced" == true ]] && dnf_items="$(attach_sizes "$dnf_sz" <<<"$dnf_items")"
  [[ "$fp_priced"  == true ]] && fp_items="$(attach_sizes "$fp_sz"  <<<"$fp_items")"
  rm -f "$dnf_sz" "$fp_sz"
  local dnf_bytes fp_bytes=""
  dnf_bytes="$(backend_download_bytes <<<"$dnf_items")"
  # A switched-off backend gets no figure rather than a zero: `download_bytes: 0` would claim
  # "nothing to download from it" where the truth is that nobody asked.
  [[ "$fp_enabled" == true ]] && fp_bytes="$(backend_download_bytes <<<"$fp_items")"
  # Published so the widget can offer "Install on Next Restart" without re-deriving the rule.
  # dnf only: a flatpak app cannot take the session down mid-transaction.
  local risky
  risky="$(risky_names <<<"$dnf_items" | jq -Rn '[inputs]')"
  # Whether a restart is owed RIGHT NOW - unlike a history entry's reboot_needed, which is about
  # the moment one run finished. Rewritten by every check, so it clears itself after a restart and
  # notices a `sudo dnf5 upgrade` typed in a terminal.
  # Safe here: dnf_reboot_needed is cache-only, repo-less and closes its own stdin, so it cannot
  # reach the network or prompt (do NOT add a second redirect - it fights the backend's own).
  # Unconditional because this CLI has no include_dnf key; THE RULE: if dnf gains one, this call
  # goes behind it, next to the flatpak gate above. Same in cmd_update.
  local reboot
  reboot="$(dnf_reboot_needed)"
  # Shape guard, twinned with cmd_update's: a surprise value reaching --argjson fails jq and loses
  # the whole check. Nothing reaches it today - it is a boundary on the backend contract.
  [[ "$reboot" == "true" || "$reboot" == "false" ]] || reboot=false
  # AFTER harvest_offline, where the marker's lifecycle is decided: a stage it just consumed or
  # cleared must not be published one line later as still pending.
  local staged_state
  staged_state="$(offline_staged_state)"
  local state
  state="$(assemble_state "$dnf_items" "$fp_items" "$status" "$error" "$fp_enabled" "$prev_ls" "$risky" "$reboot" "$dnf_bytes" "$fp_bytes" "$staged_state")"
  printf '%s\n' "$state"                 # answer first: a read-only state dir must not eat the result
  printf '%s\n' "$state" | write_state
  # One line per check, in the event log's fixed vocabulary. The lock-timeout return above records
  # nothing on purpose: it served a previous answer and looked at nothing.
  if [[ "$status" == "ok" ]]; then
    local counts
    counts="$(jq -r '"actionable=\(.actionable) held=\(.held_total)"' <<<"$state" 2>/dev/null)" \
      || counts="actionable=? held=?"
    log_event "check ok $counts"
  else
    log_event "check $status $error"
  fi
}

KEMPT_RETRY_DELAY="${KEMPT_RETRY_DELAY:-10}"

# Surfaces are a closed set. An unknown one (a config typo, an older widget's value) must not
# silently mean "detached": fall back to the surface that can show a human what happened.
resolve_surface() {  # surface → a known surface (single definition: cmd_update and cmd_run must never drift)
  case "$1" in
    terminal|popup|background|offline) printf '%s\n' "$1" ;;
    *) echo "warning: unknown surface '$1' - using terminal" >&2; printf 'terminal\n' ;;
  esac
}

# The runner is an argument because the two backends sit on OPPOSITE sides of the privilege
# boundary: dnf through the root helper (priv_apply), flatpak as the user (flatpak_apply). The run
# log, the live tee and the retry are the same for both.
# The predicate matches flatpak's lock wordings as well as dnf's. None of flatpak's say "rpm",
# "package", "transaction" or "held", and all three carry the path in the MIDDLE (`Unable to lock
# %s`, `Locking repo %s failed`, `Opening lock file %s/.lock failed`) - hence `.*`-joined patterns
# rather than literals. `\b` keeps `Unlocking repo failed`, a different error, out of the match.
apply_with_retry() {  # log_file runner args... ; retries on foreign package-lock errors
  local log="$1" runner="$2"; shift 2
  local attempt rc before_sz
  for attempt in 1 2 3; do
    rc=0
    # Only THIS attempt's output may decide whether to retry: a fixed `tail -n 20` re-reads the
    # previous attempt's lock error and retries a run that failed for another reason entirely.
    before_sz=0; [[ -f "$log" ]] && before_sz="$(stat -c %s "$log" 2>/dev/null || echo 0)"
    if [[ "${KEMPT_LIVE_OUTPUT:-}" == "1" ]]; then
      # terminal surface: the user must SEE live output, and any prompt when auto_accept=false.
      # `|| rc=` (not `; rc=`): keeps the pipeline errexit-exempt for a caller that invokes
      # apply_with_retry bare, where `; rc=` would abort the run instead of retrying.
      "$runner" "$@" 2>&1 | tee -a "$log" || rc=${PIPESTATUS[0]}
    else
      "$runner" "$@" >>"$log" 2>&1 || rc=$?
    fi
    [[ $rc -eq 0 ]] && return 0
    if tail -c +$(( before_sz + 1 )) "$log" \
       | grep -qiE '(rpm|package|transaction).*lock|lock.*held|another (process|application)|unable to lock|\blocking repo.*failed|opening lock file.*failed'; then
      # 3 attempts = 2 retries. The last failure must not promise a retry that never comes.
      if [[ $attempt -lt 3 ]]; then
        echo "Package system busy (PackageKit/Discover?) - retrying in ${KEMPT_RETRY_DELAY}s ($attempt/3)" | tee -a "$log" >&2
        sleep "$KEMPT_RETRY_DELAY"
      else
        echo "Package system still busy after $attempt attempts - giving up" | tee -a "$log" >&2
      fi
    else
      return "$rc"
    fi
  done
  return "$rc"
}

# Pre-flight failure: nothing has been changed and nothing will be. Loud on stderr, exit 5 (never
# a bare backend rc through errexit), and a notification where nobody reads stderr. Reads $surface.
preflight_abort() {  # message
  echo "$1" >&2
  [[ "$surface" != "terminal" ]] && notify "Kempt" "Update did not start: $1"
  exit 5
}

# --- the sections of cmd_update ------------------------------------------------------------------
# These four are SECTIONS, not helpers: each is called from exactly one place, in one order, and
# reads and writes the run's locals through bash's DYNAMIC scope rather than arguments. Each
# header says what it reads and what it changes - that is the contract; do not reuse them.

# The risky-transaction recommendation, run BEFORE the lock is taken so an abort leaves no lock
# residue and no history entry, having changed nothing at all.
# Reads: surface. Writes: surface - answering "s" at the prompt switches this run to offline.
recommend_offline_if_risky() {
  # spec §Run surfaces. Recommends, never blocks; an offline run IS the recommendation, so it is
  # never nagged.
  if [[ "$surface" != "offline" ]]; then
    local risky_list="" rerr rcount fams
    rerr="$(mktemp)"
    # A pre-check that cannot run is not "nothing risky": say so, then proceed - losing advice
    # must never stop the user updating.
    risky_list="$(dnf_check 2>"$rerr" | mark_held dnf | risky_names)" || {
      risky_list=""
      # same rewrite as cmd_check: a missing root helper must not be announced as a timeout here either
      echo "warning: could not check for session-critical updates: $(explain_helper_error "$(stderr_tail "$rerr")")" >&2
    }
    rm -f "$rerr"
    if [[ -n "$risky_list" ]]; then
      rcount="$(wc -l <<<"$risky_list")"
      if [[ "$surface" == "terminal" && ( -t 0 || -n "${KEMPT_ASSUME_TTY:-}" ) ]]; then
        echo "Recommendation: this update touches $rcount session-critical packages (a live upgrade can break the running desktop):"
        # ONE NAME PER FAMILY, same rule as the notification below, or a Qt bump's first eight
        # names alphabetically push a pending KERNEL out of sight. A family is the prefix up to
        # the first - or . (kernel-core and kernel-modules are one decision); the tail counts on.
        local reps shown nshown
        reps="$(awk '{ f = $0; sub(/[-.].*/, "", f); if (!(f in seen)) { seen[f] = 1; print } }' <<<"$risky_list")"
        shown="$(head -8 <<<"$reps")"        # still capped: a box can always surprise us with 30 families
        nshown="$(grep -c '' <<<"$shown")"
        # $shown is MULTI-LINE and every line needs the indent; in ${var//} the ^ is not a line
        # anchor, so only the first line would get one.
        # shellcheck disable=SC2001
        sed 's/^/  /' <<<"$shown"
        (( rcount > nshown )) && echo "  ... and $(( rcount - nshown )) more"
        local ans tries
        for tries in 1 2; do
          # `|| ans=""` keeps EOF (Ctrl-D) out of errexit. EOF and Enter both mean "I did not
          # answer", and the safe answer to a risk warning is to NOT proceed.
          read -rp "[u]pdate live / [s]tage offline / [a]bort (default: abort) " ans || ans=""
          case "${ans,,}" in
            ""|n|no|a|abort)  echo "aborted"; exit 0 ;;
            s|stage)          surface="offline"; break ;;
            u|update|y|yes)   break ;;
            *) if [[ $tries -eq 1 ]]; then echo "Please answer u, s or a."
               else echo "aborted"; exit 0; fi ;;
          esac
        done
      else
        # families, not names - same rule as the terminal listing above.
        # per-line strip on a MULTI-LINE list: ${risky_list//[-.]*/} is a glob, not a regex, and
        # its * crosses newlines - it would eat the whole list from the first - or . onwards.
        # shellcheck disable=SC2001
        fams="$(sed 's/[-.].*//' <<<"$risky_list" | sort -u)"
        local fam_n; fam_n="$(wc -l <<<"$fams")"
        notify "Kempt" "$rcount session-critical packages pending ($(head -4 <<<"$fams" | paste -sd, - | sed 's/,/, /g')$( (( fam_n > 4 )) && echo ', ...')) - consider the Offline surface"
      fi
    fi
  fi
}

# The flatpak half of a run. dnf has already run by now, so a flatpak failure is REPORTED and
# never fatal: crashing loses the history entry and notification for a system that already changed.
# Reads: include_fp, yflag, log. Writes: fp_status, and status (which only ever moves to "failed").
apply_flatpak_updates() {
  # NOT `local`: this is the caller's variable (see the header). A `local` would shadow it, leave
  # cmd_update's copy unset, and take the run down on the history entry under `set -u`.
  fp_status="skipped"
  if is_true "$include_fp"; then
    fp_status="ok"
    local held_fp ids=()
    held_fp="$(holds_for flatpak)"
    if [[ -n "$held_fp" ]]; then
      # holds exist → per-app updates of every pending, non-held, INSTALLED app. That pre-filter
      # is the ONLY installed check there is (flatpak errors out on an id it does not have), so an
      # empty installed set means no ids pass and the run reports flatpak failed.
      local installed_fp id
      installed_fp="$(flatpak_snapshot | cut -f1)" \
        || { installed_fp=""; fp_status="failed"; status="failed"; echo "warning: flatpak installed lookup failed - no flatpak apps updated" | tee -a "$log" >&2; }
      while IFS= read -r id; do
        [[ -n "$id" ]] || continue
        grep -qxF "$id" <<<"$held_fp" && continue
        grep -qxF "$id" <<<"$installed_fp" || continue
        ids+=("$id")
      done < <(flatpak_check 2>/dev/null | jq -r '.[].name')
      if [[ ${#ids[@]} -gt 0 ]]; then
        apply_with_retry "$log" flatpak_apply "${yflag[@]}" "${ids[@]}" || { fp_status="failed"; status="failed"; }
      fi
    else
      apply_with_retry "$log" flatpak_apply "${yflag[@]}" || { fp_status="failed"; status="failed"; }
    fi
  fi
}

# The offline marker: what Kempt records about a stage it has just made, and all any later reader
# has to go on.
# Reads: surface, dnf_status, staged_fresh, staged_check_names, staged_check_ok,
# staged_excluded_json, ts. Writes: staged, the count the run's own event line reports.
write_stage_marker() {
  # NOT `local`: the run's `offline staged N` event line reports it, so it is the caller's variable.
  staged=""
  if [[ "$surface" == "offline" && "$dnf_status" == "ok" && "$staged_nothing" != true ]]; then
    staged="$staged_fresh"
    [[ -n "$staged" ]] \
      || staged="$(jq -r -n '[inputs][0].backends.dnf.actionable? // empty' "$STATE_FILE" 2>/dev/null || true)"
    local staged_json="null"
    [[ "$staged" =~ ^[0-9]+$ ]] && staged_json="$staged"
    # marker owns its snapshot copy - a later update run overwrites dnf-before.tsv. Sweep first:
    # only the newest staging can be harvested, so older copies accumulate forever.
    rm -f "$SNAP_DIR"/offline-pre-*.tsv
    cp "$SNAP_DIR/dnf-before.tsv" "$SNAP_DIR/offline-pre-$ts.tsv"
    # WHICH packages, alongside how many: a hold added after this moment cannot change the stored
    # transaction, so all Kempt can do is name what is in it. Read from dnf5's own transaction -
    # the only source that sees packages the resolver added, or one someone else replaced. The
    # check is the fallback and LABELLED so: it may confirm a conflict and may never deny one.
    local staged_names="" staged_names_source=none
    if staged_names="$(offline_txjson_names)"; then
      staged_names_source=transaction
    elif [[ "$staged_check_ok" == true ]]; then
      staged_names="$staged_check_names"; staged_names_source=check
    fi
    # The one gate, at the one moment a name is written down, and all-or-nothing: a list with one
    # name filtered out could still be used to deny a conflict it never saw.
    # printf '%s', never <<<: a here-string on an empty list produces one empty line, which fails
    # the gate and would drop a legitimately empty list.
    if [[ "$staged_names_source" != none ]] && ! printf '%s' "$staged_names" | names_all_valid; then
      staged_names=""; staged_names_source=none
    fi
    # The excluded list comes from the holds file, which architecture.md promises is the user's to
    # edit by hand, so it gets the same gate rather than being trusted to hold_add's past checks.
    if ! jq -e 'type == "array" and all(.[]; type == "string")' <<<"$staged_excluded_json" >/dev/null 2>&1 \
       || ! jq -r '.[]' <<<"$staged_excluded_json" | names_all_valid; then
      staged_excluded_json='[]'
    fi
    local staged_names_json
    staged_names_json="$(printf '%s' "$staged_names" | jq -Rn '[inputs]')" || staged_names_json='[]'
    # boot_id: only a REBOOT applies a stage, so the harvest compares boot sessions rather than
    # guessing from the package set (see harvest_offline).
    # Fields are ADDITIVE and absent when unknown - `staged_names: []` would claim "the
    # transaction installs nothing" where the truth is that nobody could find out. Every reader
    # follows that rule, so a marker written before these fields existed still works.
    jq -n --arg ts "$(now_iso)" --arg snap "$SNAP_DIR/offline-pre-$ts.tsv" \
      --arg boot "$(current_boot_id)" --argjson staged "$staged_json" \
      --arg nsrc "$staged_names_source" --argjson names "$staged_names_json" \
      --argjson excl "$staged_excluded_json" \
      '{staged_at:$ts, pre_snapshot:$snap, boot_id:$boot, staged:$staged, armed:true,
        staged_names_source:$nsrc, staged_excluded:$excl}
       + (if $nsrc == "none" then {} else {staged_names:$names} end)' \
      | write_offline_marker
  fi
}

# What a LIVE run owes a staged transaction it found sitting there. Side effects only: it may
# discard the stage, rebase its baseline, or leave it alone, and it warns on the run's log.
# Reads: surface, snapshots_ok, dnf_status, log.
reconcile_stage_after_live_run() {
  # The lifecycle this sits inside: staging downloads AND arms, so any restart installs it, and
  # the check after that restart harvests it. A live run can arrive at any point in that, and the
  # three cases below are three situations, not variations on one rule. snapshots_ok (plus -s as
  # a floor): none may be decided on a truncated or empty snapshot.
  if [[ "$surface" != "offline" && -f "$OFFLINE_MARKER" && "$snapshots_ok" == true && -s "$SNAP_DIR/dnf-after.tsv" ]]; then
    local mpre
    mpre="$(jq -r '.pre_snapshot // empty' "$OFFLINE_MARKER" 2>/dev/null || true)"
    if [[ -z "$mpre" || ! -f "$mpre" ]]; then
      # Leave the marker alone: harvest_offline handles a dead pointer on its own (it clears the
      # marker), and guessing here could throw away a real staged transaction.
      echo "warning: unreadable offline marker - staged-update baseline not rebased" >&2
    elif same_content "$mpre" "$SNAP_DIR/dnf-before.tsv"; then
      # STILL PENDING: staging writes no rpm changes of its own, so a baseline that still matches
      # the world this run started from means no restart has applied it yet.
      # same_content answers THREE ways - equal, different, unreadable - and the branch below
      # DISCARDS a staged transaction, so only a positive "different" (rc 1) may reach it.
      # `! same_content` would collapse "unreadable" into "different".
      local moved=0
      same_content "$SNAP_DIR/dnf-before.tsv" "$SNAP_DIR/dnf-after.tsv" || moved=$?
      if [[ $moved -eq 2 ]]; then
        echo "warning: could not compare this run's package snapshots - the staged update was left as it was" | tee -a "$log" >&2
      fi
      if [[ "$dnf_status" == "ok" && $moved -eq 1 ]]; then
        # SUPERSEDED. The staged transaction carries the rpmdb cookie it was built against and
        # dnf5 refuses one whose cookie has moved, so after a live install the armed stage is a
        # failed offline boot waiting to happen.
        # ORDER: the marker goes with the stage, never before it - a marker without a stage
        # promises the popup and the doctor an install nothing can deliver.
        if apply_with_retry "$log" priv_apply dnf-offline-clean; then
          rm -f "$OFFLINE_MARKER" "$mpre"
          log_event "offline stage dropped (superseded by live update)"
        else
          # Keep the marker: the stage may still be there, and `kempt doctor` reads the two
          # together and says which of them is wrong.
          echo "warning: this update superseded the staged transaction, but it could not be discarded - run: sudo dnf5 offline clean" | tee -a "$log" >&2
        fi
      else
        # No rpm moved (a flatpak-only run), so the cookie still matches and the stage is good.
        # Rebasing the baseline onto the after-snapshot keeps the post-reboot harvest diffing the
        # staged transaction and nothing else. atomic_write, not cp: the widget's timer can read
        # this baseline at any moment, and a half-copied one would diff as a real transaction.
        atomic_write "$mpre" < "$SNAP_DIR/dnf-after.tsv" \
          || echo "warning: could not rebase the staged-update baseline - the next check may report this run as the staged one" >&2
      fi
    fi
    # ALREADY APPLIED (baselines differ): a restart ran the stage and no check has harvested it.
    # Nothing to supersede or rebase - either folds that delta into the baseline and the
    # transaction is never reported. The self-refresh below harvests it.
  fi
}

cmd_update() {
  local a h surface include_fp=""
  surface="$(config_get surface)"
  for a in "$@"; do case "$a" in
    --no-flatpak) include_fp=false ;;
    --surface=*) surface="${a#--surface=}" ;;
    *) echo "unknown option: $a" >&2; exit 2 ;;
  esac; done
  [[ -z "$include_fp" ]] && include_fp="$(config_get include_flatpak)"
  local auto; auto="$(config_get auto_accept)"
  # validate BEFORE the auto-accept guard so the two compose (unknown → terminal → still terminal)
  surface="$(resolve_surface "$surface")"
  # only a terminal can prompt - enforced HERE too (cmd_run also guards, but update can be invoked directly)
  is_true "$auto" || { surface="terminal"; KEMPT_LIVE_OUTPUT=1; }
  [[ "$surface" == "terminal" ]] && KEMPT_LIVE_OUTPUT=1
  export KEMPT_LIVE_OUTPUT

  recommend_offline_if_risky
  acquire_lock || { echo "another kempt update is running" >&2; exit 3; }
  trap release_lock EXIT

  kempt_init_dirs
  local ts start log status="ok" reboot=false
  ts="$(date +%Y%m%dT%H%M%S)"; start="$(date +%s)"
  log="$LOG_DIR/$ts.log"

  # snapshots (before). Without one we can never say what changed, so a failure stops the run
  # BEFORE anything is touched (see preflight_abort).
  dnf_snapshot > "$SNAP_DIR/dnf-before.tsv" \
    || preflight_abort "cannot read the installed package set - aborting before any change"
  if is_true "$include_fp"; then
    flatpak_snapshot > "$SNAP_DIR/fp-before.tsv" \
      || preflight_abort "cannot read the installed flatpak set - aborting before any change"
  fi

  # Recorded here and not a line earlier: everything above can still decline to run without
  # touching the system. Past this point the system changes.
  log_event "run start surface=$surface"

  # dnf
  local yflag=() excl=() dnf_status="ok"
  is_true "$auto" && yflag=(-y)
  local held_dnf; held_dnf="$(holds_for dnf)"
  while IFS= read -r h; do [[ -n "$h" ]] && excl+=("--exclude=$h"); done <<<"$held_dnf"
  # reason_override - a reason worked out here, because after a failed arm the log's first
  #   error-shaped line is about a symlink.
  # staged_check_names / staged_excluded_json - the pre-stage check's two lists, kept with the
  #   count because all three come out of ONE answer and describe one transaction.
  # staged_check_ok - "nothing is pending" as against "the check could not answer".
  # notify_tail - what the FAILED notification says BEYOND the reason, for a cleanup that also
  #   failed and left work only root can do.
  # staged_nothing: the stage ran, succeeded, and had nothing to build. Not a failure, and not a
  # stage either - no marker, no promise, no "installs on the next restart".
  local staged_nothing=false
  local reason_override="" notify_tail="" staged_fresh="" staged_check_names="" staged_check_ok=false
  local staged_excluded_json='[]'
  if [[ "$surface" == "offline" ]]; then
    # How many updates this stage carries, asked NOW rather than copied from the last check's
    # state.json: it is the only thing anyone is told about a transaction they cannot open. Held
    # packages drop out here exactly as they do from the transaction - the --exclude list above is
    # built from the same holds. A check that cannot answer must not stop the stage: the count
    # degrades to the stale one with a warning.
    # Captured ONCE into a file, not asked three times: the count, the held-and-pending set and
    # the pending names must describe one transaction, and three checks could disagree.
    local cerr cjson; cerr="$(mktemp)"; cjson="$(mktemp)"
    if dnf_check 2>"$cerr" | mark_held dnf > "$cjson"; then
      staged_check_ok=true
      # Each read guarded: inside an `if` body errexit is live again, and a jq that died would
      # take down a stage over a nicety.
      staged_fresh="$(jq '[.[] | select(.held | not)] | length' "$cjson")" || staged_fresh=""
      staged_check_names="$(jq -r '.[] | select(.held | not) | .name' "$cjson")" || staged_check_names=""
      staged_excluded_json="$(jq -c '[.[] | select(.held) | .name]' "$cjson")" || staged_excluded_json='[]'
    else
      staged_fresh=""
      # same rewrite as cmd_check: a missing root helper must not be announced as a timeout here either
      echo "warning: could not count the updates being staged: $(explain_helper_error "$(stderr_tail "$cerr")")" >&2
    fi
    rm -f "$cerr" "$cjson"
    # Whether a transaction existed BEFORE this attempt - the one fact every failure path below
    # needs and none can work out afterwards. Staging over an armed transaction is
    # cancel-then-stage: dnf5 destroys the old one as the new one begins, so a FAILED stage leaves
    # no transaction, a toml that is not `ready`, and the `/system-update` symlink still standing
    # over it - and the next restart detours into the offline updater, installing nothing.
    # Two sources, either enough alone: Kempt's marker and dnf5's status - the second covers a
    # transaction Kempt did not stage, which the re-stage destroys identically.
    local had_stage=false prev_marker prev_pre="" prev_conflict=""
    prev_marker="$(offline_marker_read)"
    [[ -n "$prev_marker" || "$(offline_system_status)" != absent ]] && had_stage=true
    if [[ -n "$prev_marker" ]]; then
      prev_pre="$(jq -r '.pre_snapshot // empty' <<<"$prev_marker" 2>/dev/null || true)"
      # The holds that conflict with the transaction about to be replaced, read NOW because after
      # the stage it is gone and the question cannot be asked. The only record of what a rebuild
      # was FOR.
      prev_conflict="$(offline_staged_state | jq -r '.holds_conflict[]?' 2>/dev/null || true)"
    fi
    # STAGE THEN ARM, and both or neither. `dnf5 upgrade --offline` only downloads - the
    # transaction sits at status="download-complete" and no boot applies it - while `dnf5 offline
    # reboot` (arming) flips it to "ready" and creates /system-update, the only thing systemd's
    # system-update-generator looks for. Arming HERE, not at the restart click, is what makes the
    # promise true: once staged, ANY restart installs. One pkexec flow covers both calls, since
    # auth_admin_keep still holds seconds later.
    if apply_with_retry "$log" priv_apply dnf-offline-stage "${yflag[@]}" "${excl[@]}"; then
      # `dnf5 upgrade --offline` exits 0 and stores NOTHING when the transaction would be empty:
      # every pending update held, or nothing pending at all. Arming then fails with "No offline
      # transaction is stored", and calling THAT "staged but could not arm" blames the arm for a
      # transaction that was never built - a run reported as failed, rc 1, over the user's own
      # holds doing exactly what they asked. Nothing was staged, nothing needed to be, and the run
      # succeeded.
      # Asked of dnf5 rather than inferred from the count this run measured: the count can be
      # stale by the time the stage runs, and dnf5's own answer cannot.
      if [[ "$(offline_system_status)" == absent ]]; then
        staged_nothing=true
        if [[ -n "$held_dnf" ]]; then
          log_event "offline stage found nothing to stage (every pending update is held)"
        else
          log_event "offline stage found nothing to stage"
        fi
      elif ! apply_with_retry "$log" priv_apply dnf-offline-arm; then
        dnf_status="failed"; status="failed"
        reason_override="staged but could not arm the restart install"
        # Unwind, or the box keeps a downloaded transaction nothing can apply while every later
        # check, doctor run and popup promises an install forever. Best-effort, and a cleanup
        # that also fails must not overwrite the reason with its own.
        apply_with_retry "$log" priv_apply dnf-offline-clean \
          || { echo "warning: could not discard the stage that failed to arm - run: sudo dnf5 offline clean" | tee -a "$log" >&2
               # Escalated past stderr because this is state (d): the toml and the boot symlink
               # now disagree and only root can settle it. The reason stays the ARM - the step
               # that failed - so the command travels on the notification instead.
               notify_tail=" - the staged update could not be removed; run: sudo dnf5 offline clean"; }
      elif [[ "$had_stage" == true ]]; then
        # A rebuild that worked. `offline staged N` below reports the new transaction; this line
        # reports that there was an old one, and what it was replaced for.
        log_event "offline restage${prev_conflict:+ (holds: $(printf '%s\n' "$prev_conflict" | names_phrase))}"
      fi
    else
      dnf_status="failed"; status="failed"
      # Unwind a failed STAGE too, not only a failed arm (invariant I3): consenting to a rebuild
      # forfeits the old transaction the instant the re-stage begins, so every failure path here
      # must land in "nothing staged, and the user told" - never "the old one is gone and nothing
      # says so". `dnf5 offline clean` is idempotent, so this is best-effort like the arm's.
      if [[ "$had_stage" == true ]]; then
        if [[ "$(offline_system_status)" == ready ]]; then
          # dnf5 failed BEFORE replacing the previous transaction: a download that cannot complete
          # leaves the armed one untouched, toml and symlink included. Nothing to unwind, and a
          # clean would throw away a stage the user still counts on. The marker stays.
          reason_override="could not rebuild the staged update - the previous one is unchanged and still installs on the next restart"
          log_event "offline restage failed (previous stage intact)"
        elif apply_with_retry "$log" priv_apply dnf-offline-clean; then
          reason_override="the previous staged update was discarded and could not be rebuilt"
          # The marker described a transaction that no longer exists: the re-stage destroyed it,
          # the clean took the remains. Left in place it promises an install nothing can deliver.
          if [[ -n "$prev_marker" ]]; then
            rm -f "$OFFLINE_MARKER" ${prev_pre:+"$prev_pre"}
            log_event "offline marker cleared (rebuild failed, stage discarded)"
          fi
        else
          reason_override="the previous staged update was discarded and could not be rebuilt, and could not be cleaned up - run: sudo dnf5 offline clean"
          # Marker KEPT here, deliberately - state (d) again. doctor reads it against the toml
          # and FAILs on that row, the boot-symlink row FAILs beside it, and both name the command
          # that fixes it. Clearing it downgrades the first to a benign "staged outside Kempt".
        fi
      fi
    fi
  else
    apply_with_retry "$log" priv_apply dnf-upgrade "${yflag[@]}" "${excl[@]}" || { dnf_status="failed"; status="failed"; }
  fi

  # flatpak (live even when dnf staged offline - flatpak has no offline mechanism)
  # Known v1 limitation: check/snapshot use --app, but `flatpak update` also updates RUNTIMES,
  # so the summary can under-report what the transaction actually changed. Documented, accepted.
  local fp_status=skipped   # apply_flatpak_updates writes this; see its header
  apply_flatpak_updates
  # snapshots (after) + reports
  # Reports must never crash cmd_update after the system already changed - degrade to empty +
  # warning, snapshot as well as diff: the run is over either way, and the history entry (with the
  # notification that carries it) must still be written.
  # `if fn; then` disables errexit inside fn, so both snapshot functions return status explicitly.
  # An empty after-snapshot is NOT usable as a diff input: it reports every package REMOVED.
  local empty_report='{"updated":[],"added":[],"removed":[]}'
  # snapshots_ok gates the offline-marker rebase below and NOTHING else. A snapshot that dies
  # mid-stream leaves a TRUNCATED but non-empty dnf-after.tsv (the redirection creates the file
  # before the command runs) - harmless as a report input, fatal as a harvest baseline, where
  # every package missing from the truncation comes back as newly installed.
  local dnf_report="$empty_report" fp_report="$empty_report" snapshots_ok=true
  if dnf_snapshot > "$SNAP_DIR/dnf-after.tsv"; then
    dnf_report="$(tsv_diff_updates "$SNAP_DIR/dnf-before.tsv" "$SNAP_DIR/dnf-after.tsv")" \
      || { dnf_report="$empty_report"; snapshots_ok=false; echo "warning: dnf report diff failed - summary incomplete, see snapshots in $SNAP_DIR" | tee -a "$log" >&2; }
  else
    snapshots_ok=false
    echo "warning: dnf snapshot after the run failed - summary incomplete, the update itself is unaffected" | tee -a "$log" >&2
  fi
  if is_true "$include_fp"; then
    if flatpak_snapshot > "$SNAP_DIR/fp-after.tsv"; then
      fp_report="$(tsv_diff_updates "$SNAP_DIR/fp-before.tsv" "$SNAP_DIR/fp-after.tsv")" \
        || { fp_report="$empty_report"; echo "warning: flatpak report diff failed - summary incomplete" | tee -a "$log" >&2; }
    else
      echo "warning: flatpak snapshot after the run failed - summary incomplete" | tee -a "$log" >&2
    fi
  fi
  # ONE reboot mechanism, owned by the backend: dnf_reboot_needed carries the verdict rule and the
  # -C / --disablerepo / </dev/null hardening (an uncached needs-restarting does network I/O and
  # can prompt on stdin, and this runs from detached surfaces where nobody can answer). Its seam
  # is KEMPT_DNF_CMD. Shape guard: see the twin in cmd_check.
  reboot="$(dnf_reboot_needed)"
  [[ "$reboot" == "true" || "$reboot" == "false" ]] || reboot=false

  # offline staging marker (harvested by cmd_check after reboot). Only ever written for a stage
  # that ARMED: an unarmed transaction installs on no restart, and a marker promises every later
  # reader - the harvest, the doctor, the popup - that one is coming.
  # Read into one variable here, not at the event line below, so the two cannot disagree.
  local staged=""   # write_stage_marker fills this in; the event line below reports it
  write_stage_marker
  # Why it failed, worked out ONCE and handed to everything that renders it: the history entry
  # (and through it the summary), the notification, and the event log. "See <log>" is no answer
  # when the log is four hundred lines of dnf progress.
  local reason=""
  [[ "$status" == "ok" ]] || reason="${reason_override:-$(run_failure_reason "$log")}"

  # history entry
  local held_dnf_json held_fp_json hist="$HIST_DIR/$ts.json"
  held_dnf_json="$(holds_for dnf | jq -Rn '[inputs]')"
  held_fp_json="$(holds_for flatpak | jq -Rn '[inputs]')"
  jq -n --arg ts "$(now_iso)" --arg surface "$surface" --arg status "$status" \
        --arg log "$log" --argjson dur "$(( $(date +%s) - start ))" \
        --argjson reboot "$reboot" --arg error "$reason" \
        --argjson dnf "$dnf_report" --arg dnf_status "$dnf_status" --argjson dnf_held "$held_dnf_json" \
        --argjson fp "$fp_report" --arg fp_status "$fp_status" --argjson fp_held "$held_fp_json" '
    {timestamp:$ts, surface:$surface, status:$status, duration_sec:$dur,
     reboot_needed:$reboot, log:$log, error:$error,
     backends: {
       dnf:     ($dnf | . + {status:$dnf_status, skipped_held:$dnf_held}),
       flatpak: ($fp  | . + {status:$fp_status,  skipped_held:$fp_held}) }}' > "$hist"

  # A successful OFFLINE run gets its own event line rather than "run done": nothing has been
  # applied yet, and the harvest after the restart is what reports it.
  if [[ "$status" == "ok" ]]; then
    if [[ "$surface" == "offline" ]]; then
      log_event "offline staged ${staged:-?}"
    else
      local upd
      upd="$(jq -r '[.backends[].updated | length] | add // 0' "$hist" 2>/dev/null)" || upd="?"
      log_event "run done rc=0 updated=$upd reboot=$([[ "$reboot" == true ]] && echo needed || echo no)"
    fi
  else
    # rc 1 is what this command exits with on a failed run (the return at the bottom).
    log_event "run failed rc=1: $reason"
  fi

  # tell the human
  render_summary "$hist"
  if [[ "$surface" != "terminal" ]]; then
    # Same truth as the summary: a run that installed and removed packages is never "0 updated".
    local phrase
    phrase="$(run_counts_phrase "$hist")"
    # ORDER: a failed offline run takes the failure branch, not the staged one. "Installs on the
    # next restart" is a claim about the future, and a stage that was discarded has none.
    if [[ "$surface" == "offline" && "$status" == "ok" && "$staged_nothing" == true ]]; then
      # Nothing was staged, so there is nothing to install on any restart. Saying which of the two
      # reasons it was is the difference between "Kempt did nothing" and "your holds did what you
      # asked": the first reads as a fault.
      if [[ -n "$held_dnf" ]]; then
        notify "Kempt" "Nothing to stage - every pending update is held"
      else
        notify "Kempt" "Nothing to stage - no updates are pending"
      fi
    elif [[ "$surface" == "offline" && "$status" == "ok" ]]; then
      notify "Kempt" "Updates staged - they install on the next restart"
    elif [[ "$status" == "ok" ]]; then
      notify "Kempt" "$phrase$([[ "$reboot" == "true" ]] && echo ', reboot needed')"
    else
      # The same reason the summary and the event line carry: "see the log" is not an answer.
      notify "Kempt" "Update FAILED${reason:+ ($reason)} - see $log$notify_tail"
    fi
  fi
  reconcile_stage_after_live_run
  # Best-effort self-refresh so a CLI-only user is not left staring at a pending list the run
  # already emptied. Never allowed to change the run's verdict.
  cmd_check >/dev/null 2>&1 || true
  [[ "$status" == "ok" ]]
}

# What the widget's "Update now" button calls: pick the surface, then get out of the way.
# cmd_update re-checks auto_accept itself; this guard is the LAUNCH decision, since a detached run
# can never answer a prompt.
cmd_run() {
  local dry="" surface auto
  # An unrecognised argument must never fall through to a real launch.
  case "${1:-}" in
    "") ;;
    --dry-run) dry=1 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  [[ $# -le 1 ]] || { echo "unknown option: $2" >&2; exit 2; }
  surface="$(config_get surface)"
  auto="$(config_get auto_accept)"
  surface="$(resolve_surface "$surface")"
  is_true "$auto" || surface="terminal"   # only a terminal can prompt

  if [[ "$surface" == "terminal" ]]; then
    # Checked before the dry run too: "what would happen" must include "nothing, you have no
    # terminal emulator".
    command -v "$KEMPT_TERMINAL" >/dev/null \
      || { echo "Kempt could not find $KEMPT_TERMINAL. Install it, or run updates another way: kempt config set surface background (Settings > Run updates in > In the background)" >&2; exit 4; }
    if [[ -n "$dry" ]]; then echo "terminal: $KEMPT_TERMINAL -e kempt update"; return 0; fi
    # INVARIANT: the widget leaves its updating state on ONE event - state.json changing under its
    # watcher (plasmoid/contents/ui/main.qml, pollWatch), or a three-hour guard. So EVERY exit
    # from this window must rewrite state.json, or the popup sits on an empty "Updating…" pane for
    # up to three hours. The two easy to miss: the risky prompt's abort (cmd_update exits 0 there,
    # BEFORE its own post-run check) and the user closing the window mid-run.
    # Hence two traps, NOT redundant: EXIT covers every ordinary exit whatever the status, and
    # HUP/INT/TERM exist because bash runs no EXIT trap when it dies of an untrapped fatal signal
    # and closing a terminal window SIGHUPs the foreground process group. They do nothing but
    # `exit`, which is what makes EXIT fire.
    # The check is quiet and its status discarded, so it cannot turn a good run into a failed one;
    # $ec, the UPDATE's status, is what leaves this shell on both paths. run_check is guarded so
    # the ordinary path checks once BEFORE the "press any key" prompt - the window must not be
    # closable until the state has been rewritten.
    # printf %q, not hand-written quotes: this builds a script for ANOTHER shell, and a checkout
    # path containing an apostrophe would close the quote early and yield a wrapper that fails
    # `bash -n`. Same in the detached branch below.
    local wrapper self_q
    printf -v self_q '%q' "$SELF"
    wrapper="checked=0; run_check() { [ \$checked = 1 ] && return 0; checked=1; $self_q check >/dev/null 2>&1 || true; }; "
    wrapper+="trap 'ec=\$?; run_check; exit \$ec' EXIT; trap 'exit' HUP INT TERM; "
    wrapper+="$self_q update; ec=\$?; run_check; echo; read -rn1 -s -p 'Press any key to close…'; exit \$ec"
    setsid "$KEMPT_TERMINAL" -e bash -c "$wrapper" >/dev/null 2>&1 &
  else
    if [[ -n "$dry" ]]; then echo "detached: kempt update (surface=$surface)"; return 0; fi
    local self_q surface_q
    printf -v self_q '%q' "$SELF"; printf -v surface_q '%q' "$surface"
    setsid bash -c "$self_q update --surface=$surface_q" >/dev/null 2>&1 &
  fi
}

cmd_summary() {  # [N] - 1 = latest (default) | --json - the newest run's entry, verbatim
  # --json exists for the popup, which needs what the last run DID as data. It hands over the
  # history entry and derives nothing: re-deriving would put a second, lossier copy of
  # render_summary's rules in the widget.
  local json=false
  if [[ "${1:-}" == "--json" ]]; then json=true; shift; fi
  # N means nothing to --json, which answers one question, about the last run - and ignoring the
  # stray argument would silently serve the WRONG run under exit 0.
  if [[ "$json" == true ]]; then
    [[ $# -eq 0 ]] || { echo "usage: kempt summary --json  (takes no N)" >&2; exit 2; }
  else
    [[ $# -le 1 ]] || { echo "usage: kempt summary [N] | kempt summary --json" >&2; exit 2; }
  fi
  local n="${1:-1}" f out i files=()
  [[ "$n" =~ ^[1-9][0-9]*$ ]] || { echo "usage: kempt summary [N]  (N >= 1, 1 = latest)" >&2; exit 2; }
  # newest first. `|| true`: an empty history dir makes ls exit 2, which pipefail would turn into
  # a dead command. No runs yet is NOT an error.
  # LC_ALL=C on the sort is NOT redundant with lib/common.sh's pin - do not delete it as such.
  # "Newest" is byte order, and the locales disagree: `20260827T120000-offline.json` (a harvest in
  # the same second as a run) sorts BELOW `20260827T120000.json` under C but ABOVE it under
  # en_US.UTF-8, which ignores punctuation at the first level.
  # `ls` is not parsing names: the SHELL expands the glob, ls is the existence filter, sort orders.
  # shellcheck disable=SC2012
  while IFS= read -r f; do [[ -n "$f" ]] && files+=("$f"); done \
    < <(ls -1 "$HIST_DIR"/*.json 2>/dev/null | LC_ALL=C sort -r || true)
  # Nothing recorded is not an error in either mode. --json says it with EMPTY stdout, this
  # project's "no data" convention - never a fabricated empty run a reader would count.
  if [[ ${#files[@]} -eq 0 ]]; then
    [[ "$json" == true ]] || echo "no update runs recorded yet"
    exit 0
  fi
  i=$(( n - 1 ))
  if (( i >= ${#files[@]} )); then   # N past the end → oldest, and SAY so
    i=$(( ${#files[@]} - 1 ))
    echo "note: only ${#files[@]} run(s) recorded - showing the oldest" >&2
  fi
  # --json answers about ONE run - the newest - and deliberately never walks back to the one
  # underneath, though the human branch below does: the widget asks what the run that just
  # finished DID, and an older entry would be announced as that run. A damaged newest entry is
  # therefore empty stdout under exit 0, the "no data" convention.
  # `cat`, not jq's rendering, so the caller gets exactly what the run recorded - fields this
  # build has never heard of included. Hence the strict guard, since whatever it waves through
  # reaches the widget's JSON.parse:
  #   [inputs] | length == 1   house idiom (see cmd_check) - a MULTI-DOCUMENT file is valid jq
  #     input, so `jq -e .` passes it and `cat` then emits two documents.
  #   .[0] | type == "object"  `jq -e` fails only on null and false, so `[]`, `42` and
  #     `"a string"` would pass here while render_summary below refuses them.
  if [[ "$json" == true ]]; then
    if jq -e -n '[inputs] | length == 1 and (.[0]|type == "object")' "${files[$i]}" >/dev/null 2>&1; then
      cat "${files[$i]}"; return 0
    fi
    echo "warning: corrupt history entry: ${files[$i]}" >&2
    return 0
  fi
  for (( ; i < ${#files[@]}; i++ )); do
    # One damaged entry must not be the last word the PERSON gets: warn, fall back to the next
    # newest. The -n test is load-bearing - render_summary exits 0 having printed NOTHING for a
    # zero-byte entry, and that must not pass for a successful render.
    if out="$(render_summary "${files[$i]}" 2>/dev/null)" && [[ -n "$out" ]]; then
      printf '%s\n' "$out"
      # Below the run, answering the other question: what is about to happen. Human mode only -
      # a staged transaction belongs to the box, not to the run --json hands over.
      staged_summary_line
      return 0
    fi
    echo "warning: corrupt history entry: ${files[$i]}" >&2
  done
  echo "no update runs recorded yet"
}

cmd_history() {
  local f row files=()
  # same while-read form as cmd_summary: an unquoted $(ls) splits on whitespace and globs
  # shellcheck disable=SC2012   # shell-expanded glob; ls is the existence filter, sort is the order
  while IFS= read -r f; do [[ -n "$f" ]] && files+=("$f"); done \
    < <(ls -1 "$HIST_DIR"/*.json 2>/dev/null | LC_ALL=C sort -r || true)
  local phrase err
  for f in "${files[@]}"; do
    # capture before printing: a damaged entry must not emit half a row, nor take the whole
    # listing down - every other run is still perfectly readable.
    # run_counts_phrase, not a local ".updated | length": counting upgrades alone prints
    # "0 updated" for a run whose own summary says "+2 installed, -1 removed".
    if row="$(jq -r '[.timestamp, .surface, .status] | join("  ")' "$f" 2>/dev/null)" \
       && [[ -n "$row" ]] \
       && phrase="$(run_counts_phrase "$f" 2>/dev/null)" && [[ -n "$phrase" ]]; then
      # The reason, on the rows that have one, or a failed row sends the reader to a log file
      # to learn the authentication dialog was closed. `// ""` keeps older entries rendering the
      # same.
      err="$(jq -r '.error // ""' "$f" 2>/dev/null || true)"
      printf '%s  %s%s\n' "$row" "$phrase" "${err:+  ($err)}"
    else
      echo "warning: corrupt history entry: $f" >&2
    fi
  done
}

# The staged-offline result is only visible AFTER the reboot that applied it, so the next check is
# what turns it into a normal history entry.
# GATED ON THE BOOT SESSION: "the installed set moved" is no evidence the stage applied - a live
# kempt run or a manual `dnf install cowsay` trips it too, and would label someone else's change
# "offline (applied on reboot)". Only a reboot can apply a stage, so same boot = still pending.
#
# clear_gone_stage: a stage that is no longer there is not pending, whatever the boot session or
# package set says, and nothing is reported but the event line. Its own function because
# harvest_offline reaches it from two directions and they must not drift about what "clearing"
# removes: the snapshot copy belongs to the marker, so it goes too or it is orphaned.
clear_gone_stage() {  # marker-owned pre-snapshot path (possibly empty), the marker it came from
  # Never delete a marker somebody else wrote while this ran: see offline_marker_still.
  if [[ -n "${2:-}" ]] && ! offline_marker_still "$2"; then
    rm -f ${1:+"$1"}
    log_event "offline marker kept (a new stage arrived while the check ran)"
    return 0
  fi
  rm -f "$OFFLINE_MARKER" ${1:+"$1"}
  log_event "offline marker cleared (stage gone)"
}

# The restart happened, the package set did not move, and the transaction is still there but is
# not `ready`: the boot symlink stood over a transaction nothing could apply, so the restart
# detoured into the offline updater, installed nothing and came back - and no later restart can
# install it either, because only `dnf5 offline reboot` arms one.
# The one branch that must NOT CLEAR: the marker is what lets `kempt doctor` say "staged update
# can never install"; without it that row degrades to "staged outside Kempt".
# The announce-once key is the marker itself - `armed: false` IS the record that this was said,
# and a box checking every ten minutes would otherwise repeat it 144 times a day.
reconcile_detour_stage() {  # marker-json toml-status
  # `.armed == false` and never `.armed // true`: jq's alternative operator treats FALSE as empty,
  # so `//` would read the demoted marker as armed and announce it again on every check. Absent
  # means announce - a marker written before this field existed describes a stage that was armed.
  if jq -e '.armed == false' <<<"$1" >/dev/null 2>&1; then return 0; fi
  # ...and never write the OLD marker back over a stage made while this check was running: the
  # write below is a read-modify-write of a file `kempt update` owns under a different lock.
  offline_marker_still "$1" || {
    log_event "offline marker kept (a new stage arrived while the check ran)"; return 0; }
  notify "Kempt" "Your staged update can no longer install on a restart. Re-stage it, or run sudo dnf5 offline clean."
  log_event "offline stage cannot install (status $2) - announced"
  # Additive, like every field of this file: everything already there is kept, so the pre-snapshot
  # pointer, the names and the boot id survive for the doctor rows that read them.
  jq -c '. + {armed: false}' <<<"$1" | write_offline_marker \
    || echo "warning: could not record that the staged update was announced - the next check may repeat it" >&2
}

harvest_offline() {
  local pre now_snap ts report hist boot toml_status marker
  # ONE defensive read, and nothing below runs without it. Every branch here either clears the
  # marker or turns it into a history entry, both far too destructive to do on a file we could not
  # parse (see offline_marker_read): falling through disowns an armed stage that will still
  # install, with every surface silent about it.
  marker="$(offline_marker_read)"
  [[ -n "$marker" ]] || return 0
  # Legacy markers (staged before this gate existed) and an unreadable boot_id fall back to the
  # snapshot comparison below - never to "never harvest".
  boot="$(jq -r '.boot_id // empty' <<<"$marker")"
  pre="$(jq -r '.pre_snapshot // empty' <<<"$marker")"
  # dnf5's own view, because the marker cannot tell "waiting for a restart" from "the transaction
  # is gone" - and a manual `dnf5 offline clean` would otherwise leave one every check waits on.
  toml_status="$(offline_system_status)"
  if [[ -n "$boot" && "$boot" != unknown && "$boot" == "$(current_boot_id)" ]]; then
    # Same boot: nothing can have APPLIED the stage, whatever the package set says - but it can
    # still have been thrown away, the one thing worth acting on here.
    [[ "$toml_status" == absent ]] && clear_gone_stage "$pre" "$marker"
    return 0
  fi
  # A marker whose snapshot is gone can never be harvested: clear it rather than re-read a dead
  # pointer on every check forever.
  [[ -n "$pre" && -f "$pre" ]] || {
    rm -f "$OFFLINE_MARKER"
    log_event "harvest cleared stale marker"
    return 0; }
  now_snap="$(mktemp)"
  # never take the check down with it - a failed harvest must still leave a working check
  dnf_snapshot > "$now_snap" \
    || { rm -f "$now_snap"; echo "warning: offline harvest skipped (snapshot failed)" >&2
         log_event "harvest skipped snapshot failed"; return 0; }
  # The package set did not move across a reboot. With the transaction still there that is the
  # honest "not applied yet" (the offline-update screen can be declined); with it GONE there is
  # nothing left to wait for.
  if same_content "$pre" "$now_snap"; then
    rm -f "$now_snap"
    if [[ "$toml_status" == absent ]]; then
      clear_gone_stage "$pre" "$marker"
    elif [[ "$toml_status" != ready ]]; then
      # Present but not armed, across a boot that changed: the detour above. Anything but `ready`
      # counts, including a status this build has never heard of - the only one a restart can
      # install is the one that made the symlink.
      reconcile_detour_stage "$marker" "$toml_status"
    elif [[ -n "$boot" && "$boot" != unknown && ! -L "$KEMPT_OFFLINE_LINK" ]]; then
      # `ready` and yet no /system-update: arming is TWO things, the status and the symlink, and
      # systemd removes the symlink once system-update.target is reached
      # (systemd.offline-updates(7)) - so a boot that came and went leaving `ready` did not run
      # the transaction, and no later one will either.
      reconcile_detour_stage "$marker" "ready, but the restart marker is gone"
    fi
    return 0
  fi

  # The package set MOVED across a reboot, which is evidence of an apply ONLY when dnf5's
  # transaction is gone with it: applying one removes all three of the toml, the /system-update
  # symlink and transaction.json. While any of that is still there, something ELSE moved the set,
  # and harvesting would name the other tool's packages and drop a still-armed marker.
  if [[ "$toml_status" != absent ]]; then
    rm -f "$now_snap"
    if [[ "$toml_status" != ready ]] \
       || [[ -n "$boot" && "$boot" != unknown && ! -L "$KEMPT_OFFLINE_LINK" ]]; then
      reconcile_detour_stage "$marker" "$toml_status"
    elif ! jq -e '.set_moved == true' <<<"$marker" >/dev/null 2>&1; then
      # Once, not once per check: this lasts until the restart that installs it. The baseline is
      # now stale - a later harvest diffs against a set the other tool already moved - and that
      # residual is what transaction identity (issue #9) closes properly.
      offline_marker_still "$marker" || return 0   # a newer stage owns the file now
      log_event "harvest deferred: packages moved outside Kempt while the stage is still armed"
      jq -c '. + {set_moved: true}' <<<"$marker" | write_offline_marker \
        || echo "warning: could not record that the package set moved under a staged update" >&2
    fi
    return 0
  fi
  ts="$(date +%Y%m%dT%H%M%S)"
  report="$(tsv_diff_updates "$pre" "$now_snap")" \
    || { report='{"updated":[],"added":[],"removed":[]}'; echo "warning: offline harvest diff failed - summary incomplete" >&2; }
  # History filenames are per-second and this harvest runs inside a check a live run may have
  # triggered in the same second. Never overwrite an existing entry - it destroys that run's own.
  hist="$HIST_DIR/$ts.json"
  [[ -e "$hist" ]] && hist="$HIST_DIR/$ts-offline.json"
  jq -n --arg ts "$(now_iso)" --argjson dnf "$report" '
    {timestamp:$ts, surface:"offline (applied on reboot)", status:"ok", duration_sec:0,
     reboot_needed:false, log:"",
     backends:{dnf:($dnf + {status:"ok", skipped_held:[]}),
               flatpak:{updated:[],added:[],removed:[],status:"skipped",skipped_held:[]}}}' > "$hist"
  rm -f "$now_snap"
  # The history entry above is honest whatever happened next, but the MARKER may no longer be the
  # one this harvest read: a stage made while the snapshot and diff ran owns the file now, and
  # deleting it makes the panel forget an armed transaction.
  if offline_marker_still "$marker"; then
    rm -f "$OFFLINE_MARKER"
  else
    log_event "offline marker kept (a new stage arrived while the check ran)"
  fi
  rm -f "$pre"   # $pre is this harvest's own marker-owned copy either way
  # Same counts phrase as a live run's notification: a transaction that only installed or removed
  # packages must not be announced as "0 packages".
  local harvested; harvested="$(run_counts_phrase "$hist")"
  # The only place the reboot's own result is recorded: the run that staged it ended a boot ago.
  log_event "harvest applied ($harvested)"
  notify "Kempt" "Staged updates were applied on reboot - $harvested"
}

cmd_config() {
  case "${1:-}" in
    get) [[ -n "${2:-}" && $# -le 3 ]] || { echo "usage: kempt config get <key> [default]" >&2; exit 2; }
         config_get "$2" "${3-}" ;;
    set) [[ -n "${2:-}" && -n "${3+x}" && $# -le 3 ]] || { echo "usage: kempt config set <key> <value>" >&2; exit 2; }
         config_set "$2" "$3" ;;
    *) echo "usage: kempt config get <key> [default] | set <key> <value>" >&2; exit 2 ;;
  esac
}

# a missing colon must not silently hold a package named after the backend ("kempt hold dnf")
cmd_hold() {
  [[ "${1:-}" == *:* ]] || { echo "use dnf:<pkg> or flatpak:<app.id>" >&2; exit 2; }
  local b="${1%%:*}" n="${1#*:}"
  [[ "$b" == dnf || "$b" == flatpak ]] || { echo "use dnf:<pkg> or flatpak:<app.id>" >&2; exit 2; }
  # Separate statements, not `hold_add ... && log_event ...`: an AND list swallows hold_add's exit
  # status and reports a rejected name as exit 1 instead of the 2 the contract promises. This way
  # errexit ends the command with the helper's own rc and no event is written.
  hold_add "$b" "$n"
  # AFTER the write, and it changes nothing about it. dnf5 cannot edit a transaction it has already
  # stored, so a hold added over an armed stage applies from the NEXT transaction Kempt builds -
  # correct, and invisible unless said: hold the kernel, restart, and the kernel installs. So this
  # warns on stderr and does nothing else: never prompts, never blocks, never changes the exit
  # status (a hold is bookkeeping, I1), and is identical interactive or not, because the case that
  # needs it most is a pin clicked in the panel. dnf only - the offline surface stages dnf alone,
  # so a flatpak hold can never conflict with an armed transaction.
  local note=""
  if [[ "$b" == dnf ]]; then
    # The SAME predicate state.json publishes for the widget, from the one reader that reconciles
    # the marker, dnf5's status and its stored transaction. AFTER hold_add on purpose: the
    # intersection is against the holds as they now stand.
    local staged; staged="$(offline_staged_state)"
    if [[ -n "$staged" ]]; then
      if jq -e --arg n "$n" '.holds_conflict | index($n)' <<<"$staged" >/dev/null 2>&1; then
        hold_staged_warning <<<"$n" >&2
        printf '%s\n' "$KEMPT_STAGED_RECIPE" >&2
        note=" (staged update still contains it)"
      elif [[ "$(jq -r '.names_source' <<<"$staged" 2>/dev/null || echo none)" == none ]]; then
        # No list may be trusted here (a legacy marker, or names that came from a check), so the
        # generic warning is what is left: wrong only by warning about a package that is not in
        # the transaction, never by staying quiet about one that is.
        hold_generic_warning "$n" >&2
        # The recipe follows the generic warning too - both remedies belong on every surface.
        printf '%s\n' "$KEMPT_STAGED_RECIPE" >&2
      fi
    fi
  fi
  # The suffix is only ever appended to a CONFIRMED conflict: the generic warning is a caveat, not
  # a finding, and the event log must not record it as one.
  log_event "hold $b:$n$note"
}
cmd_unhold() {
  [[ "${1:-}" == *:* ]] || { echo "use dnf:<pkg> or flatpak:<app.id>" >&2; exit 2; }
  local b="${1%%:*}" n="${1#*:}"
  [[ "$b" == dnf || "$b" == flatpak ]] || { echo "use dnf:<pkg> or flatpak:<app.id>" >&2; exit 2; }
  hold_remove "$b" "$n"
  # The mirror: releasing a hold does not put the package back into a transaction that was built
  # without it. Same rules as cmd_hold - after the write, stderr only, dnf only, status untouched.
  local note=""
  if [[ "$b" == dnf ]] && offline_stage_built_without "$n"; then
    unhold_staged_warning "$n" >&2
    note=" (staged update was built without it)"
  fi
  log_event "unhold $b:$n$note"
}
# Refuses a stray argument like every other command: `kempt holds --json` silently printing the
# plain list is how a script gets written against an option that does not exist.
cmd_holds()  { [[ $# -eq 0 ]] || { echo "unknown option: $1" >&2; exit 2; }; holds_all; }

# `kempt log` - the event log, newest last. Deliberately the plainest command here: the file is
# already one fact per line in a fixed vocabulary, meant to be read with grep.
cmd_log() {
  local n=30
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n) [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] \
            || { echo "usage: kempt log [-n N]  (N >= 1)" >&2; exit 2; }
          n="$2"; shift 2 ;;
      *)  echo "unknown option: $1" >&2; echo "usage: kempt log [-n N]" >&2; exit 2 ;;
    esac
  done
  # No file yet is the ordinary state of a fresh install, not an error - same answer shape as
  # `kempt summary` on a box with no runs: a sentence on STDOUT and exit 0.
  [[ -s "$EVENTS_FILE" ]] || { echo "No events recorded yet."; return 0; }
  tail -n "$n" "$EVENTS_FILE"
}

# --- kempt doctor ---
# The trap this closes: with the root helpers missing, `kempt check` exits 0 with status "stale"
# and 0 pending, which reads to a human and to a badge as "you are up to date". Every other command
# degrades instead of crashing, deliberately, so doctor is the one that says the install is broken.
# Every check runs and every problem is printed: stopping at the first sends the user round the
# loop once per problem.
DOCTOR_FAILS=0
doctor_ok()   { printf 'ok    %s\n' "$1"; }
doctor_info() { printf 'info  %s\n' "$1"; }
doctor_fail() { printf 'FAIL  %s\n' "$1"; DOCTOR_FAILS=$(( DOCTOR_FAILS + 1 )); }

# The hold that arrived after the stage. INFO and not FAIL: a package installing despite a hold is
# a legitimate state (see cmd_hold), and a FAIL for something legitimate teaches readers to skip
# FAILs - the bluntness lives in the sentence instead. It carries BOTH remedies through the one
# copy of them, KEMPT_STAGED_RECIPE, since someone who held a kernel may want the stage gone
# rather than rebuilt.
# Read from offline_staged_state, never the marker: that is the one function applying the
# suppression rule, and doctor must not grow a second opinion about which list may answer.
doctor_staged_conflict_row() {
  local staged names total phrase
  staged="$(offline_staged_state)" || return 0
  [[ -n "$staged" ]] || return 0
  names="$(jq -r '.holds_conflict[]?' <<<"$staged" 2>/dev/null || true)"
  if [[ -n "$names" ]]; then
    total="$(printf '%s' "$names" | grep -c '' || true)"
    phrase="$(printf '%s' "$names" | names_phrase)"
    # The verb moves with the noun, as in the staged count line and the hold warning.
    if [[ "$total" == 1 ]]; then
      doctor_info "staged update: it installs $phrase on the next restart despite the hold - the hold was recorded after the transaction was staged, and dnf5 offers no way to edit a stored one. $KEMPT_STAGED_RECIPE"
    else
      doctor_info "staged update: it installs $phrase on the next restart despite the holds - the holds were recorded after the transaction was staged, and dnf5 offers no way to edit a stored one. $KEMPT_STAGED_RECIPE"
    fi
    return 0
  fi
  # Nothing may be DENIED here: names_source `none` means the list came from a check (blind to
  # what the resolver added) or from nowhere, so the generic line is the honest one.
  [[ "$(jq -r '.names_source' <<<"$staged" 2>/dev/null || echo none)" == none ]] || return 0
  [[ -n "$(holds_for dnf)" ]] || return 0
  doctor_info "staged update: it may still install held packages on the next restart - Kempt cannot read what this transaction contains, and a hold recorded after it was staged cannot change it. $KEMPT_STAGED_RECIPE"
}

# What Kempt staged against what dnf5 has stored right now - the LIVE record, never anything
# remembered. FAIL, because unlike the row above this is nothing anyone chose: within the
# authentication keep window anything running as this user can replace an armed transaction, and
# every Kempt surface then describes a set that is not there.
# Only a transaction-derived marker list may be compared: a check-derived one disagrees with the
# stored transaction routinely and legitimately, so it would FAIL weekly on a healthy box.
doctor_staged_drift_row() {  # marker json
  local msrc live live_json rec_json plus minus
  msrc="$(jq -r '.staged_names_source // empty' <<<"$1" 2>/dev/null || true)"
  [[ "$msrc" == transaction ]] || return 0
  live="$(offline_txjson_names)" || return 0
  # jq for the set arithmetic, not sort/comm: `unique` orders by codepoint and `sort` by locale,
  # and two lists ordered by different rules compare as different.
  live_json="$(printf '%s' "$live" | jq -Rn '[inputs] | unique')" || return 0
  rec_json="$(jq -c '[.staged_names[]? | select(type == "string")] | unique' <<<"$1" 2>/dev/null)" || return 0
  [[ "$(jq -n --argjson a "$live_json" --argjson b "$rec_json" '$a == $b')" == true ]] && return 0
  # `. as $x` before index(): jq evaluates index()'s argument against index()'s OWN input, so the
  # inline form reads the wrong thing (the trap mark_held carries a note about).
  plus="$(jq -r --argjson b "$rec_json" '.[] | select(. as $x | $b | index($x) | not)' <<<"$live_json")"
  minus="$(jq -r --argjson a "$live_json" '.[] | select(. as $x | $a | index($x) | not)' <<<"$rec_json")"
  local -a clauses=()
  # Capped and counted by the shared renderer: a Qt bump puts dozens of names on each side.
  [[ -n "$plus" ]] && clauses+=("$(printf '%s\n' "$plus" | sed 's/^/+/' | names_phrase) in dnf5's record only")
  [[ -n "$minus" ]] && clauses+=("$(printf '%s\n' "$minus" | sed 's/^/-/' | names_phrase) in Kempt's only")
  local diff; diff="$(printf '%s, ' "${clauses[@]}")"
  doctor_fail "staged update is not the one Kempt built: dnf5's record differs from what Kempt staged (${diff%, }) - the transaction was replaced after Kempt staged it, so the next restart installs a set no Kempt surface describes. Rebuild it with: kempt update --surface=offline, or remove it with: sudo dnf5 offline clean"
}

# The `exec.path` annotation the installed policy pins for one action id - the only half of that
# file worth comparing, since pkexec matches an action by that path and by nothing else.
# awk rather than xmllint: a checkup must not need a dependency the rest of the tool does not have.
# It reads only the one-line form this project ships, `<annotate key="...">path</annotate>`; a
# policy with the value on its own line reads as "no annotation" and lands on the info branch.
policy_exec_path() {  # action_id file -> the annotated path, or "" if there is none
  awk -v want="$1" '
    /<action[ \t]+id="/ {
      id = ""
      if (match($0, /id="[^"]*"/)) id = substr($0, RSTART + 4, RLENGTH - 5)
    }
    id == want && /org\.freedesktop\.policykit\.exec\.path/ {
      if (match($0, />[^<]*</)) { print substr($0, RSTART + 1, RLENGTH - 2); exit }
    }
  ' "$2" 2>/dev/null || true
}

# The half of the polkit action a readable file can still get wrong. The RPM installs the helpers
# under /usr/libexec and rewrites the annotation to match (kempt.spec); install.sh uses
# /usr/local/libexec. A box carrying both hands pkexec a path no action names, so it falls back to
# an authentication dialog a background check cannot answer: priv_refresh times out after 120s and
# the check reports stale, forever.
# Compared only when the helper seam IS the annotated path (as doctor_helper does for ownership):
# with a stub in play, what this CLI runs is not what polkit was asked about.
doctor_exec_path() {  # label action_id helper_seam annotated_path
  local label="$1" action="$2" seam="$3" annotated="$4" pinned
  if [[ "$seam" != "$annotated" ]]; then
    doctor_info "polkit exec.path ($label): not compared - the helper seam points elsewhere ($seam)"
    return 0
  fi
  # Missing or unreadable is already a FAIL above; one problem must not be counted twice.
  if [[ ! -r "$KEMPT_POLICY_FILE" ]]; then
    doctor_info "polkit exec.path ($label): not compared - $KEMPT_POLICY_FILE is not readable"
    return 0
  fi
  pinned="$(policy_exec_path "$action" "$KEMPT_POLICY_FILE")"
  if [[ -z "$pinned" ]]; then
    doctor_info "polkit exec.path ($label): $KEMPT_POLICY_FILE pins no exec.path for $action"
  elif [[ "$pinned" == "$annotated" ]]; then
    doctor_ok "polkit exec.path ($label): $pinned"
  else
    # Both paths and both remedies: which one is wrong depends on the install the reader meant.
    doctor_fail "polkit exec.path ($label): the policy pins $pinned, this CLI runs $annotated - pkexec has no action for that path, so every privileged run falls back to an authentication dialog and background checks time out. Fix it with ./install.sh in a checkout, or: sudo dnf reinstall kempt for the package"
  fi
}

# ...and the other half of a split install, on the widget's side. The panel runs the CLI through
# its own PATH order (see KEMPT_WIDGET_PATH), so the kempt the widget uses and the kempt that
# printed this report can be two different files. Nothing here is executed.
doctor_widget_engine() {
  local w
  # A subshell, so the widget's PATH order decides this one lookup and nothing else in the run.
  # shellcheck disable=SC2123  # assigning PATH IS the check: it is the widget's own lookup order
  w="$(PATH="$KEMPT_WIDGET_PATH"; command -v kempt 2>/dev/null || true)"
  if [[ -z "$w" ]]; then
    # info, not FAIL: main.qml turns rc 127 into engineMissing, a message in the panel already.
    doctor_info "widget engine: no kempt on the widget's PATH ($KEMPT_WIDGET_PATH) - the panel reports the engine as missing"
    return 0
  fi
  # Resolved, because ~/.local/bin/kempt is a symlink on every checkout install: the question is
  # which FILE runs, not which name came first.
  w="$(readlink -f "$w" 2>/dev/null || printf '%s' "$w")"
  if [[ "$w" == "$SELF" ]]; then
    doctor_ok "widget engine: $w"
  else
    doctor_fail "widget engine: the widget would run $w; this report describes $SELF - remove the one you do not want, or point the ~/.local/bin/kempt symlink at the install you mean"
  fi
}

doctor_helper() {  # label seam_path annotated_path
  local label="$1" path="$2" annotated="$3" own
  if [[ ! -e "$path" ]]; then
    doctor_fail "root helper ($label) not installed: $path - run ./install.sh"
    return 0
  fi
  if [[ "$path" != "$annotated" ]]; then
    # Not the path polkit execs, so its ownership says nothing about what root would run.
    doctor_info "root helper ($label): $path (seam override, ownership not checked)"
    return 0
  fi
  # stat can fail on an unreachable path, and a helper we cannot INSPECT is not a broken one.
  own="$(stat -c '%U:%G %a' "$path" 2>/dev/null)" || {
    doctor_info "root helper ($label): $path (present, ownership not readable)"; return 0; }
  if [[ "$own" == "root:root 755" ]]; then
    doctor_ok "root helper ($label): $path (root:root 0755)"
  else
    doctor_fail "root helper ($label) is $own, expected root:root 755: $path - re-run ./install.sh"
  fi
}

# --- install skew -------------------------------------------------------------------------------
# A checkout install is a SYMLINK for the CLI and a COPY for everything that cannot be one: the two
# root helpers (root execs a file it owns, never a link into a user's tree), the polkit action, and
# the widget kpackagetool6 copies into the user's plasmoid directory. So `git pull` moves the CLI
# and silently leaves those three behind, root still running the last ./install.sh's code.
# Compared by CONTENT, never mtime: the installer rewrites files it did not change, and a fresh
# clone is younger than a correct install. No privilege needed - the copies are world-readable.
doctor_install_files() {  # label src dst [src dst ...]
  local label="$1"; shift
  local src dst missing=0 differ=0 nosrc=0
  while [[ $# -gt 1 ]]; do
    src="$1"; dst="$2"; shift 2
    if [[ ! -r "$src" ]]; then nosrc=1
    elif [[ ! -e "$dst" ]]; then missing=1
    elif ! same_content "$src" "$dst"; then differ=1; fi
  done
  # One label covers several files (the helpers are two) because the fix is one command.
  if [[ $nosrc -eq 1 ]]; then
    doctor_info "$label: not compared - the checkout has no copy to compare against"
  elif [[ $missing -eq 1 ]]; then
    # info, not FAIL: a missing installed copy is already a FAIL above, and one problem must not
    # be counted twice.
    doctor_info "$label: not installed - run ./install.sh"
  elif [[ $differ -eq 1 ]]; then
    doctor_fail "$label: DIFFER from checkout - run ./install.sh"
  else
    doctor_ok "$label: match checkout"
  fi
}

doctor_install_dir() {  # label src dst
  local label="$1" src="$2" dst="$3"
  if [[ ! -d "$src" ]]; then
    doctor_info "$label: not compared - the checkout has no copy to compare against"
  elif [[ ! -d "$dst" ]]; then
    # The widget is optional: a box with no kpackagetool6 gets a working CLI and no plasmoid.
    doctor_info "$label: not installed (the CLI works without it)"
  elif ! command -v diff >/dev/null; then
    doctor_info "$label: not compared - diff is not installed"
  elif diff -rq "$src" "$dst" >/dev/null 2>&1; then
    doctor_ok "$label: match checkout"
  else
    # `plasmashell --replace` as well as the installer: kpackagetool6 upgrades the package in
    # place and Plasma keeps the QML it already loaded, so a re-install alone changes nothing the
    # user can see.
    doctor_fail "$label: DIFFER from checkout - run ./install.sh, then plasmashell --replace"
  fi
}

# --- the rows of `kempt doctor`, one function per group ------------------------------------------
# cmd_doctor below is the ORDER of the report and nothing else. Each function here owns one group
# of rows, keeps its own locals, and communicates only through DOCTOR_FAILS - which doctor_fail
# increments and the summary reads. Keep it that way: the rows share no other state.

doctor_privileged_rows() {
  doctor_helper refresh "$KEMPT_REFRESH_HELPER" "$KEMPT_REFRESH_HELPER_PATH"
  doctor_helper apply   "$KEMPT_APPLY_HELPER"   "$KEMPT_APPLY_HELPER_PATH"

  # Without the action file pkexec has no policy for these helpers and falls back to an
  # authentication DIALOG - see doctor_exec_path.
  if [[ -r "$KEMPT_POLICY_FILE" ]]; then
    doctor_ok "polkit action: $KEMPT_POLICY_FILE"
  else
    doctor_fail "polkit action not installed: $KEMPT_POLICY_FILE - run ./install.sh"
  fi
  # ...and the half a readable file can still get wrong: which helper path it pins.
  doctor_exec_path refresh io.github.erez_c137.kempt.refresh \
    "$KEMPT_REFRESH_HELPER" "$KEMPT_REFRESH_HELPER_PATH"
  doctor_exec_path apply   io.github.erez_c137.kempt.apply \
    "$KEMPT_APPLY_HELPER"   "$KEMPT_APPLY_HELPER_PATH"
}

doctor_tool_rows() {
  # jq: a missing one exits 3 before this command runs, so this line only ever says ok - it names
  # WHICH jq answered rather than catching an absence.
  doctor_ok "jq: $(command -v jq) ($(jq --version 2>/dev/null || echo 'version unknown'))"

  # The terminal emulator matters only where it is launched: surface=terminal, plus any surface
  # when auto_accept=false (which forces terminal). A FAIL on a detached surface would be a
  # warning nobody can act on.
  local surface auto term_needed=false
  surface="$(config_get surface)"; auto="$(config_get auto_accept)"
  case "$surface" in popup|background|offline) ;; *) term_needed=true ;; esac   # unknown → terminal, same as resolve_surface
  is_true "$auto" || term_needed=true
  if command -v "$KEMPT_TERMINAL" >/dev/null; then
    doctor_ok "terminal emulator: $(command -v "$KEMPT_TERMINAL")"
  elif [[ "$term_needed" == true ]]; then
    doctor_fail "terminal emulator '$KEMPT_TERMINAL' not found - 'kempt run' exits 4 on this surface; install it, or run updates another way: kempt config set surface background (Settings > Run updates in > In the background)"
  else
    doctor_info "terminal emulator '$KEMPT_TERMINAL' not found - not needed for surface=$surface"
  fi

  # flatpak: ask about the command the BACKEND runs (first word of its seam), never a hardcoded
  # name a test or a power user may have redirected.
  local fp_cmd; fp_cmd="${KEMPT_FLATPAK_LIST_CMD%% *}"
  if command -v "$fp_cmd" >/dev/null; then
    doctor_ok "flatpak: $(command -v "$fp_cmd")"
  elif is_true "$(config_get include_flatpak)"; then
    doctor_fail "flatpak command '$fp_cmd' not found - include_flatpak=true, so every check reports the flatpak backend stale; install flatpak or run: kempt config set include_flatpak false"
  else
    doctor_info "flatpak command '$fp_cmd' not found - include_flatpak=false, so it is not needed"
  fi

  # The reboot verdict is the one thing Kempt asks a dnf command directly, on the hourly DETACHED
  # path where its "reboot check failed (rc=127)" reaches a stderr nobody reads and no event line -
  # so a permanently broken check looks exactly like a permanently answered one: reboot_needed
  # false, forever. This row is where it becomes visible. First word of the seam, like flatpak
  # above. info, not FAIL: updates are untouched and it degrades in the safe direction.
  local dnf_cmd; dnf_cmd="${KEMPT_DNF_CMD%% *}"
  if command -v "$dnf_cmd" >/dev/null; then
    doctor_ok "dnf: $(command -v "$dnf_cmd")"
  else
    doctor_info "dnf command '$dnf_cmd' not found - updates still work (they go through the root helper), but reboot_needed answers false on every check whether or not a restart is owed; install dnf5, or point KEMPT_DNF_CMD at the right command"
  fi
}

doctor_config_row() {
  # The config file is read with `grep "^key="`, so a line that is not key=value is ignored and the
  # setting the user believes they wrote never applies. Validated exactly as config_set validates.
  local line n=0 bad=0 keys=0 k
  if [[ ! -e "$CONFIG_FILE" ]]; then
    doctor_ok "config file: none yet, built-in defaults apply ($CONFIG_FILE)"
  elif [[ ! -r "$CONFIG_FILE" ]]; then
    doctor_fail "config file is not readable: $CONFIG_FILE - every command silently falls back to defaults"
  else
    # `|| [[ -n "$line" ]]`: a final line with no trailing newline is still a line.
    while IFS= read -r line || [[ -n "$line" ]]; do
      n=$(( n + 1 ))
      [[ -z "${line//[[:space:]]/}" ]] && continue
      k="${line%%=*}"
      if [[ "$line" != *=* || ! "$k" =~ ^[a-z][a-z0-9_]+$ ]]; then
        doctor_fail "config file line $n is not key=value: $line ($CONFIG_FILE)"
        bad=$(( bad + 1 ))
      else
        keys=$(( keys + 1 ))
      fi
    done < "$CONFIG_FILE"
    # The `if` form, not `[[ ... ]] && x=y`: a false test as a branch's last command returns 1 and
    # errexit would kill the checkup halfway through.
    if [[ $bad -eq 0 ]]; then
      local sword=settings
      if [[ $keys -eq 1 ]]; then sword=setting; fi
      doctor_ok "config file: $CONFIG_FILE ($keys $sword)"
    fi
  fi
}

doctor_state_dir_row() {
  # "Writable" means "can be written OR created": nothing has run yet on a fresh install, and a
  # checkup must not CREATE the directory it checks - so walk up to the nearest existing ancestor.
  local probe="$KEMPT_STATE_DIR"
  while [[ ! -e "$probe" ]]; do
    [[ "$probe" == */* && "$probe" != / ]] || break
    probe="${probe%/*}"; [[ -n "$probe" ]] || probe=/
  done
  if [[ -d "$probe" && -w "$probe" ]]; then
    if [[ "$probe" == "$KEMPT_STATE_DIR" ]]; then
      doctor_ok "state dir writable: $KEMPT_STATE_DIR"
    else
      doctor_ok "state dir writable: $KEMPT_STATE_DIR (created on first use)"
    fi
  else
    doctor_fail "state dir not writable: $KEMPT_STATE_DIR - no state, history or logs can be written"
  fi
}

# Which kind of install this is. install.sh is the file a checkout has and a package does not: it
# is what a fix message would tell you to run, and exactly what a packaged tree does not ship.
# One definition, because two rows ask the question and a report that called itself packaged on one
# line and a checkout on the next is worse than either answer alone.
install_is_packaged() { [[ ! -r "$ROOT/install.sh" ]]; }

doctor_files_row() {
  # Whatever tree the CLI resolved, whole. What is sourced fails at startup; what is not (the
  # passwordless rules template) fails only on the day somebody runs the command that needs it.
  local missing=() rel kind=checkout
  install_is_packaged && kind="program files"
  for rel in lib/common.sh backends/dnf.sh backends/flatpak.sh polkit/49-kempt.rules.in; do
    [[ -r "$ROOT/$rel" ]] || missing+=("$rel")
  done
  if [[ ${#missing[@]} -eq 0 ]]; then
    doctor_ok "$kind intact: $ROOT"
  else
    doctor_fail "$kind incomplete: missing ${missing[*]} (in $ROOT)"
  fi
}

doctor_offline_rows() {
  # The staged offline transaction, read as TWO facts side by side rather than reconciled - which
  # makes this doctor's line and nobody else's. Every other surface reads them together and
  # publishes one answer, so a marker over a transaction that can never install looks from outside
  # exactly like a pending update. Silent when there is neither, which is most boxes.
  local dr_toml dr_count dr_marker
  dr_toml="$(offline_system_status)"
  # Read the way every other reader reads it - never raw jq, which answers `empty` for a torn file
  # and would fall through to the armed row below. offline_marker_read refuses an empty,
  # unparsable or over-1 MB marker, and that means "skip", not "the stage is gone".
  dr_marker="$(offline_marker_read)"
  if [[ -n "$dr_marker" ]]; then
    dr_count="$(jq -r '.staged // empty' <<<"$dr_marker" 2>/dev/null || true)"
    case "$dr_toml" in
      ready)
        # One package is its own sentence, verb included; zero is plural.
        if [[ "$dr_count" == 1 ]]; then
          doctor_info "staged update: 1 package installs on the next restart"
        elif [[ "$dr_count" =~ ^[0-9]+$ ]]; then
          doctor_info "staged update: $dr_count packages install on the next restart"
        else
          doctor_info "staged update: it installs on the next restart"
        fi
        # Both only for `ready`: what an unarmed transaction holds, and whether Kempt built it,
        # are questions about a transaction that is not going to run.
        doctor_staged_conflict_row
        doctor_staged_drift_row "$dr_marker" ;;
      absent)
        # Nothing for anyone to do: harvest_offline clears a marker with no transaction under it.
        doctor_info "staged update: the transaction is gone, so the next check clears the marker ($OFFLINE_MARKER)" ;;
      *)
        # Not `ready` means not armed, and no restart applies it. FAIL rather than info: a real
        # defect with an exact remedy, spelled out because the remedy needs root.
        doctor_fail "staged update can never install: the transaction was downloaded but never armed (status \"$dr_toml\"), so no restart applies it - clear it with: sudo dnf5 offline clean" ;;
    esac
  elif [[ -f "$OFFLINE_MARKER" ]]; then
    # A marker is there and cannot be read. Reported as itself, not through the line below, which
    # would attribute Kempt's own stage to somebody else. info, not FAIL: a torn read is a moment
    # (update and check hold different locks, so a check can arrive mid-write).
    doctor_info "staged update: the marker cannot be read, so nothing here describes what Kempt staged: $OFFLINE_MARKER (dnf5 says \"$dr_toml\") - a marker that will not parse is skipped rather than cleared, so the next check leaves it where it is"
  elif [[ "$dr_toml" != absent ]]; then
    # Not Kempt's: it staged nothing and will harvest nothing. Still worth a line for somebody
    # reading this because a restart installed things they did not expect.
    doctor_info "an offline transaction is staged outside Kempt (status \"$dr_toml\") - see: dnf5 offline status"
  fi

  # The boot symlink, the half of arming that decides what the next restart does. A symlink over a
  # transaction that is not `ready` is a state the box reaches on its own: re-staging destroys the
  # old transaction before the new one exists, so a stage failing in between leaves exactly this,
  # and the boot detours into the offline updater and installs nothing. Checked marker or no
  # marker - the symlink is the boot's business, the marker is Kempt's.
  # -L is lstat: the symlink itself, never its target. system-update-generator does not resolve it
  # either, so a dangling one detours the boot exactly as a live one does.
  if [[ -L "$KEMPT_OFFLINE_LINK" && "$dr_toml" != ready ]]; then
    if [[ "$dr_toml" == absent ]]; then
      doctor_fail "boot symlink is live with nothing staged behind it: $KEMPT_OFFLINE_LINK - the next restart detours into the offline updater and installs nothing; remove it with: sudo dnf5 offline clean"
    else
      doctor_fail "boot symlink is live over a transaction that is not armed (status \"$dr_toml\"): $KEMPT_OFFLINE_LINK - the next restart detours into the offline updater and installs nothing; clear it with: sudo dnf5 offline clean"
    fi
  elif [[ "$dr_toml" == ready && ! -L "$KEMPT_OFFLINE_LINK" ]]; then
    # The INVERSE: `ready` with no symlink in front of it. A restart has already walked past this
    # transaction and no future one can install it either - see reconcile_detour_stage. Without
    # this row every surface calls it a pending install, forever.
    doctor_fail "staged update can never install: dnf5 says \"ready\" but $KEMPT_OFFLINE_LINK is gone, and only \`dnf5 offline reboot\` re-arms it - re-stage it with: kempt update --surface=offline, or clear it with: sudo dnf5 offline clean"
  fi
}

doctor_version_row() {
  # Which build this is. The opening line already names the release and the tree; this one names
  # the COMMIT, the difference between "0.1.0" and the twelve commits of 0.1.0 a reporter might be
  # running. `dirty` covers untracked files too - a new backend file changes behaviour as much as
  # an edited one. Every git call is tolerated failing: a tarball install has no .git, a packaged
  # one need not have git, and a version line must never be the thing that stops the checkup.
  local ver_line sha tree
  ver_line="version: kempt $(kempt_version)"
  sha=""
  # The `if` form, not `[[ ... ]] && x=y`: see doctor_config_row - errexit would kill the checkup.
  if [[ -e "$ROOT/.git" ]]; then
    sha="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || true)"
  fi
  if [[ -n "$sha" ]]; then
    tree=clean
    [[ -z "$(git -C "$ROOT" status --porcelain 2>/dev/null)" ]] || tree=dirty
    ver_line="$ver_line (checkout $sha $tree)"
  fi
  doctor_info "$ver_line"
}

doctor_install_rows() {
  # A packaged install has nothing to compare and nothing to drift: the RPM ships bin/, lib/ and
  # backends/ under /usr/share/kempt and none of libexec/, polkit/ or plasmoid/, because the
  # package manager owns those three and keeps them in step. install.sh's absence is what says
  # which kind of install this is - it is the file the fix message would name, and exactly what a
  # packaged tree does not ship.
  if install_is_packaged; then
    doctor_info "install: packaged - the package manager keeps these files in step"
    # ...and the one thing a packaged install can be silently wrong about. kpackagetool6 (the KDE
    # Store route) installs into the USER's plasmoid directory, the package into /usr/share, and
    # Plasma PREFERS the user one - so a store install predating the package stays the widget
    # Plasma loads, invisibly, and no other row would catch it.
    # Only in this branch: on a checkout that directory IS the install, and the message would tell
    # a developer to delete their own widget. The skew comparison below covers that case.
    if [[ -d "$KEMPT_PLASMOID_DIR" ]]; then
      doctor_fail "user widget copy shadows the package: $KEMPT_PLASMOID_DIR - Plasma loads this copy instead of the packaged widget, so package updates never reach your panel. Remove it with: kpackagetool6 -t Plasma/Applet -r io.github.erez_c137.kempt, then plasmashell --replace"
    elif [[ ! -d "$KEMPT_SYSTEM_PLASMOID_DIR" ]]; then
      # The panel half is its own package, so a working CLI can sit on a box with no widget and
      # nothing would say why. info, not FAIL: the CLI is the whole tool for anyone who wanted it.
      doctor_info "panel widget not installed - it is a separate package: sudo dnf install kempt-plasmoid"
    fi

    # The environment can point this process at a different update path than the rows above
    # describe, and on a PACKAGED install nothing else notices: a few lines in
    # ~/.config/environment.d make `kempt update` report "0 updated" while running nothing, under
    # a report that still says "all checks passed". Only the three seams that decide what RUNS -
    # the others change what is READ, and the rows above cover those.
    # Gated on a tree this user cannot WRITE, the one packaged-ness test an environment variable
    # cannot fake. Without that gate the suite's own sandbox, which sets all three seams by
    # design, trips the row on every run.
    local overridden=() seam
    for seam in KEMPT_PKEXEC KEMPT_APPLY_HELPER KEMPT_REFRESH_HELPER; do
      [[ " $KEMPT_ENV_OVERRIDES " == *" $seam "* ]] && overridden+=("$seam")
    done
    if [[ ${#overridden[@]} -gt 0 && ! -w "$ROOT" ]]; then
      doctor_fail "privileged path overridden in the environment: ${overridden[*]} - these are test seams, and while they are set this report describes a path that is not the one 'kempt update' takes. Unset them (look in ~/.config/environment.d and your shell profile) and run this again"
    fi
  else
    doctor_install_files helpers \
      "$ROOT/libexec/kempt-refresh" "$KEMPT_REFRESH_HELPER_PATH" \
      "$ROOT/libexec/kempt-apply"   "$KEMPT_APPLY_HELPER_PATH"
    doctor_install_files policy \
      "$ROOT/polkit/io.github.erez_c137.kempt.policy" "$KEMPT_POLICY_FILE"
    doctor_install_dir widget "$ROOT/plasmoid" "$KEMPT_PLASMOID_DIR"
  fi
}

doctor_recent_events() {
  # Not a check, and deliberately below every check that is: doctor answers "is this install
  # sound", and the next question is "then why did my change not take effect?". The last five
  # events answer that in place, without anyone needing to know `kempt log` exists. Indented, so
  # nothing here can be mistaken for a report line.
  echo
  echo "Recent events (kempt log):"
  if [[ -s "$EVENTS_FILE" ]]; then
    tail -n 5 "$EVENTS_FILE" | sed 's/^/  /'
  else
    echo "  none"
  fi
  echo
}

cmd_doctor() {
  DOCTOR_FAILS=0
  # First line, and info rather than ok: not a check that can pass or fail, but the fact every
  # other line has to be read against - a report pasted into a bug report without it describes an
  # unknown build.
  doctor_info "kempt $(kempt_version) ($KEMPT_ROOT)"
  doctor_privileged_rows

  doctor_tool_rows
  doctor_config_row
  doctor_state_dir_row
  doctor_files_row
  doctor_offline_rows
  doctor_version_row
  doctor_install_rows
  # Outside that branch on purpose: both kinds of install can be shadowed for the widget alone - a
  # leftover ~/.local/bin/kempt from a checkout wins over /usr/bin/kempt for the panel and for
  # nothing else.
  doctor_widget_engine

  doctor_recent_events

  if [[ $DOCTOR_FAILS -eq 0 ]]; then
    echo "kempt doctor: all checks passed"
    return 0
  fi
  local word=problems
  if [[ $DOCTOR_FAILS -eq 1 ]]; then word=problem; fi
  echo "kempt doctor: $DOCTOR_FAILS $word found"
  return 1
}

RULES_DST="${KEMPT_RULES_DST:-/etc/polkit-1/rules.d/49-kempt.rules}"

# The destination is a path this command hands to a ROOT install(1), so its shape is pinned, and
# neither "absolute and ending in .rules" nor an /etc-only fence is tight enough: either lets this
# plant a root-owned file in another tool's configuration directory (/etc/cron.d, /etc/sudoers.d,
# /usr/lib/udev/rules.d).
# polkit reads FOUR rules directories (polkit(8)); Kempt pins the ADMINISTRATOR's one,
# /etc/polkit-1/rules.d, because the other three belong to packages and to the runtime - and
# /usr/share/polkit-1/rules.d/50-default.rules is a file Fedora actually ships.
# So: that directory is accepted by name, every system prefix is refused outright, and what is
# left (a /tmp path, which the test seam uses) is accepted so the suite can exercise the
# production path without touching system policy. Compared on the realpath -m form, which resolves
# `..` without requiring the path to exist, so a destination cannot walk out of its directory.
check_rules_dst() {
  local p
  p="$(realpath -m -- "$RULES_DST" 2>/dev/null)" || p=""
  if [[ -z "$p" || "$RULES_DST" != /* || "$p" != *.rules ]]; then
    echo "invalid rules destination: $RULES_DST" >&2; exit 2
  fi
  if [[ "$p" =~ ^/etc/polkit-1/rules\.d/[^/]+\.rules$ ]]; then return 0; fi
  if [[ "$p" =~ ^(/etc|/run|/usr|/var|/boot|/opt)/ ]]; then
    echo "invalid rules destination: $RULES_DST - system directory; only /etc/polkit-1/rules.d/*.rules" >&2
    exit 2
  fi
  return 0
}

cmd_enable_passwordless() {
  local tmp
  check_rules_dst
  tmp="$(mktemp)"
  # render_passwordless_rule (lib/common.sh) renders from $(id -un) and self-checks the result; it
  # writes nothing on failure, so an unverified rule can never reach install(1).
  # One event per invocation carrying this command's exit status - a grant refused at the
  # authentication dialog is recorded as plainly as one that succeeded. Largest security
  # consequence Kempt can change.
  if ! render_passwordless_rule "$ROOT/polkit/49-kempt.rules.in" "$tmp"; then
    rm -f "$tmp"; log_event "passwordless enable rc=2"; exit 2
  fi
  # ${VAR:+$VAR} matches priv_refresh/priv_apply: empty KEMPT_PKEXEC means "no wrapper" (test
  # sandbox). lib/common.sh always sets the variable, so there is no fallback case to cover.
  if ! ${KEMPT_PKEXEC:+$KEMPT_PKEXEC} install -m 0644 -o root -g root "$tmp" "$RULES_DST"; then
    rm -f "$tmp"; log_event "passwordless enable rc=1"
    echo "could not install $RULES_DST - passwordless NOT enabled" >&2; exit 1
  fi
  rm -f "$tmp"
  log_event "passwordless enable rc=0"
  echo "Passwordless updates ENABLED for $(id -un) ($RULES_DST)"
}

cmd_disable_passwordless() {
  check_rules_dst
  # Nothing to remove is not a failure, and discovering that must not raise an auth prompt. The
  # negative test is trusted only where the directory is searchable: the real /etc/polkit-1/rules.d
  # is 0750 root:polkitd, so an unprivileged [[ -e ]] reports "absent" for a file that exists, and
  # "not enabled" would leave a live grant in place.
  if [[ -x "$(dirname "$RULES_DST")" && ! -e "$RULES_DST" ]]; then
    log_event "passwordless disable rc=0"
    echo "passwordless was not enabled"; return 0
  fi
  local rc=0
  ${KEMPT_PKEXEC:+$KEMPT_PKEXEC} rm -f "$RULES_DST" || rc=$?
  log_event "passwordless disable rc=$rc"
  # The rc is still the command's own: captured only so the event can name it, then handed back
  # unchanged - exactly what errexit would have done here.
  [[ $rc -eq 0 ]] || return $rc
  echo "Passwordless updates disabled"
}

# Exit codes (one contract, every command):
#   0 success - including a user who declines at the risky-transaction prompt
#   1 the run itself failed (a backend returned non-zero), `doctor` found a problem, or a writer
#     (config set / hold / unhold) could not take the writers' lock. docs/usage.md carries the
#     same table and calls that third case the one that surprises people - keep the two in step
#   2 usage error (unknown command, option or argument)
#   3 cannot start: jq missing, or another kempt update already holds the lock
#   4 launcher missing (no terminal emulator for the terminal surface)
#   5 aborted during pre-flight - nothing was changed
usage() {
  cat <<'EOF'
usage: kempt <command>
  check                 refresh pending-updates state (JSON to stdout)
  update                run the update now (options from config; --no-flatpak, --surface=X override)
  run [--dry-run]       launch update per configured surface (what the widget calls)
  summary [N]           human summary of the last (or Nth-last) run
  summary --json        the newest run's history entry, verbatim JSON (nothing if no runs yet,
                        or if the newest entry is damaged)
  history               list past runs
  log [-n N]            recent events: what Kempt did, when, and from where (default 30)
  doctor                check this install: helpers, polkit action, tools, config, state
  hold dnf:<pkg> | flatpak:<app.id>     skip in updates, still notify
  unhold <same>         remove a hold
  holds                 list holds
  config get|set        read/write settings
  enable-passwordless | disable-passwordless
  --version             print the version and exit
EOF
}

case "${1:-help}" in
  check)   shift; cmd_check "$@" ;;
  update)  shift; cmd_update "$@" ;;
  run)     shift; cmd_run "$@" ;;
  summary) shift; cmd_summary "$@" ;;
  history) shift; [[ $# -eq 0 ]] || { echo "unknown option: $1" >&2; exit 2; }; cmd_history ;;
  log)     shift; cmd_log "$@" ;;
  doctor)  shift; [[ $# -eq 0 ]] || { echo "unknown option: $1" >&2; exit 2; }; cmd_doctor ;;
  config)  shift; cmd_config "$@" ;;
  hold)    shift; cmd_hold "$@" ;;
  unhold)  shift; cmd_unhold "$@" ;;
  holds)   shift; cmd_holds "$@" ;;
  enable-passwordless)  [[ $# -eq 1 ]] || { echo "unknown option: $2" >&2; exit 2; }; cmd_enable_passwordless ;;
  disable-passwordless) [[ $# -eq 1 ]] || { echo "unknown option: $2" >&2; exit 2; }; cmd_disable_passwordless ;;
  version|--version|-V) shift; cmd_version "$@" ;;
  help|--help|-h) usage ;;
  *) echo "unknown command: $1" >&2; usage >&2; exit 2 ;;
esac

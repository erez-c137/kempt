#!/usr/bin/env bash
# Kempt - system updates for Fedora. See docs/architecture.md
set -euo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(dirname "$(dirname "$SELF")")"
source "$ROOT/lib/common.sh"
source "$ROOT/backends/dnf.sh"
source "$ROOT/backends/flatpak.sh"

command -v jq >/dev/null || { echo "kempt: requires jq" >&2; exit 3; }

# Both spellings, because both get typed.
cmd_version() {
  [[ $# -eq 0 ]] || { echo "unknown option: $1" >&2; exit 2; }
  printf 'kempt %s\n' "$(kempt_version)"
}

# --- reclaiming disk space ------------------------------------------------------------------------
# The unused refs for state.json, or nothing when the feature does not apply here or Flatpak does
# not answer. Called from cmd_check, which must never fail because of it. The widget offers them from
# 1 GB. A size that cannot be worked out is null, so there is no offer.
reclaim_check_block() {  # fp_enabled(true|false) → JSON object, or nothing
  [[ "$1" == true ]] && ! reclaim_as_root && flatpak_present || return 0
  local listing sizes bytes
  listing="$(flatpak_unused_list 2>/dev/null)" || return 0
  bytes=null
  if sizes="$(flatpak_unused_sizes "$listing" 2>/dev/null)"; then
    bytes="$(reclaim_bytes_of "$sizes" "$(reclaim_unused_refs "$listing")")"
  fi
  jq -c --argjson bytes "${bytes:-0}" '{refs: [.unused[] | {ref, eol}], bytes: $bytes}' <<<"$listing" 2>/dev/null || true
}

reclaim_unused_refs() { jq -r '.unused[].ref' <<<"$1" | LC_ALL=C sort; }  # listing → sorted refs
reclaim_all_refs() { jq -r '.unused[].ref, .used[].ref' <<<"$1" | LC_ALL=C sort; }  # listing → sorted refs

# What these refs take, from `flatpak_unused_sizes`: 0 when none of them is on it.
reclaim_bytes_of() {  # sizes TSV, refs one per line → bytes
  awk -F'\t' 'NR == FNR { s[$1] = $2; next } { t += s[$1] } END { printf "%.0f\n", t }' \
    <(printf '%s\n' "$1") <(printf '%s\n' "$2")
}

# The removal, under the update lock: the named refs, then the list read again, and the result said
# from that list alone. flatpak's exit status says nothing about what went: it can stop after some
# refs are gone. On failure the one line goes to stderr, where the widget reads it.
# 9>&- keeps check.lock's descriptor out of flatpak. The update lock (fd 8) is inherited on purpose:
# if kempt is killed, no update starts until flatpak exits.
reclaim_remove() {  # listing sizes refs(sorted, one per line) → 0, or 1 when anything is left to say
  local listing="$1" sizes="$2" out rc=0 after err gone left freed n said
  local -a refs; readarray -t refs <<<"$3"
  # shellcheck disable=SC2086  # the seam carries its own arguments
  out="$(timeout "$KEMPT_RECLAIM_UNINSTALL_TIMEOUT" $KEMPT_FLATPAK_UNINSTALL_CMD -- "${refs[@]}" </dev/null 2>&1 9>&-)" || rc=$?
  [[ -z "$out" ]] || printf '%s\n' "$out"
  err=""
  if [[ $rc -ne 0 ]]; then
    err="$(error_line_of <<<"$out")"
    err=" Flatpak stopped with exit code $rc${err:+: $err}"
  fi
  if ! after="$(flatpak_unused_list 2>/dev/null)"; then
    said="Kempt could not read the list afterwards, so it cannot say what was removed.$err"
    echo "$said" >&2; log_event "Unused runtimes: $said"
    return 1
  fi
  gone="$(comm -23 <(reclaim_all_refs "$listing") <(reclaim_all_refs "$after"))"
  left="$(comm -12 <(printf '%s\n' "$3") <(reclaim_all_refs "$after"))"
  n=0; [[ -z "$gone" ]] || n="$(wc -l <<<"$gone")"
  freed="$(reclaim_bytes_of "$sizes" "$gone")"
  if [[ $n -eq 0 ]]; then said="Nothing was removed."
  elif [[ "$freed" != 0 ]]; then said="Freed about $(human_bytes "$freed")."
  elif [[ $n -eq 1 ]]; then said="Removed 1 runtime."
  else said="Removed $n runtimes."
  fi
  [[ -z "$left" ]] || said+=" Still installed: $(tr '\n' ' ' <<<"$left" | sed 's/ $//')."
  said+="$err"
  log_event "Unused runtimes: $said"
  if [[ $rc -eq 0 && -z "$left" ]]; then echo "$said"; return 0; fi
  echo "$said" >&2
  return 1
}

# One optional block into the state cmd_check is assembling. A jq that fails leaves it as it was, so
# nothing merged here can fail the check.
state_merge() {  # jq args...
  local m
  m="$(jq "$@" <<<"$state" 2>/dev/null)" || return 0
  [[ -z "$m" ]] || state="$m"
}

cmd_check() {
  # NOTE: `if x="$(fn)"` disables errexit inside fn's whole body - backends must therefore
  # return status EXPLICITLY (they do) and never rely on set -e for error propagation.
  # --refresh overrules the three-hour interval only. --anyway implies it and also passes the
  # battery and metering rules, for this check alone. It stays a local, passed as an argument: the
  # internal `cmd_check` calls after holds and runs must never inherit it. maybe_refresh_metadata
  # carries both rules.
  # --coalesce is the widget's automatic checks (timer, watcher, popup open, startup, post-run
  # fallback): "any check that finishes after I asked answers me too". Two widget instances (one
  # per panel tray) otherwise turn every automatic trigger into two dnf queries back to back, the
  # second queued on the lock behind the first. Never with --refresh: that flag asks for a FETCH,
  # and a state someone else produced from the old metadata does not answer it.
  # --strict is for scripts: an answer that is not current (a backend failed, the per-user listing
  # failed, or the previous state was served) exits 1 instead of 0, after the state is printed.
  local force_refresh="" anyway="" coalesce="" strict=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --refresh) force_refresh=force; shift ;;
      --anyway) force_refresh=force; anyway=anyway; shift ;;
      --coalesce) coalesce=1; shift ;;
      --strict) strict=1; shift ;;
      *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
  done
  [[ -n "$force_refresh" ]] && coalesce=""
  # Taken BEFORE the lock wait: the question is whether a check finished after this one was asked
  # for, and the wait is exactly where that other check runs.
  local requested_at=""
  [[ -n "$coalesce" ]] && requested_at="$(date +%s)"
  kempt_init_dirs
  # serialize checks: without this the last FINISHER wins and a stale result overwrites a fresh one
  exec 9>"$KEMPT_STATE_DIR/check.lock"
  if ! flock -w "$KEMPT_CHECK_LOCK_WAIT" 9; then
    echo "warning: another check holds the lock; serving previous state" >&2
    [[ -z "$anyway" ]] \
      || echo "warning: nothing was downloaded; run kempt check --anyway again when the other check ends" >&2
    # `[inputs][0]`, and NOT `jq -e .`: a multi-document state file is valid input to jq, so the
    # plain form prints BOTH documents under exit 0 and the widget's JSON.parse throws on the
    # second. House idiom - same guard on prev_ls below, in state_prev_items and `summary --json`.
    jq -e -n '[inputs][0] | select(type == "object")' "$STATE_FILE" 2>/dev/null || true
    # --strict: an answer nobody checked just now is not a current one.
    [[ -z "$strict" ]] || return 1
    return 0
  fi
  local shared
  if [[ -n "$coalesce" ]] && shared="$(state_checked_since "$requested_at")"; then
    # The state that check wrote IS the answer. Nothing is written and nothing is reported (that
    # check did both), and the event line says so: this check asked no backend.
    printf '%s\n' "$shared"
    log_event "Check used the answer of the check at $(jq -r '.last_check' <<<"$shared" 2>/dev/null)"
    # state_checked_since adopts only an ok state today; --strict does not rely on that.
    # A failed per-user listing leaves status ok, so the scopes are asked as well.
    if [[ -n "$strict" ]] \
       && ! jq -e '.status == "ok" and ((.backends.flatpak.scopes // {}) | all(.[]; . != "failed"))' \
            <<<"$shared" >/dev/null 2>&1; then
      return 1
    fi
    return 0
  fi
  stage_report_restart
  # Right after that, so the first check of a new boot compares against the restart just reported.
  # Never fails the check.
  startup_observe || true
  maybe_refresh_metadata "$force_refresh" "$anyway"
  local status="ok" error="" dnf_items fp_items fp_enabled=true prev_ls serr errf
  # Download sizes, in files because attach_sizes joins against a TSV. Empty on any failure, and
  # nothing below may change `status`: the check must answer with or without a size.
  local dnf_sz fp_sz fp_scopes_f dnf_priced=false fp_priced=false
  local sec_raw="" sec_parsed="" sec_items_f
  dnf_sz="$(mktemp)"; fp_sz="$(mktemp)"; fp_scopes_f="$(mktemp)"
  # -n/[inputs][0]: the corrupt-tolerance idiom above (a multi-doc file joins one last_success per
  # document into one string).
  prev_ls="$(jq -r -n '[inputs][0].last_success? // empty' "$STATE_FILE" 2>/dev/null || true)"
  errf="$(mktemp)"
  if dnf_items="$(dnf_check 2>"$errf")"; then
    # Priced only when the check ANSWERED: a stale backend serves the previous state's items,
    # which carry their own sizes - re-pricing puts today's bytes on yesterday's list.
    dnf_priced=true
    dnf_sizes > "$dnf_sz" 2>/dev/null || : > "$dnf_sz"
  elif update_running_elsewhere; then
    # dnf5 waits for a running transaction, and this check's two minutes ran out behind it. That is
    # not a failed check, and the widget must not flash one: serve the previous state unchanged, as
    # when another check holds the lock above, and say why in one event line.
    rm -f "$errf" "$dnf_sz" "$fp_sz" "$fp_scopes_f"
    echo "warning: a Kempt update is running; serving previous state" >&2
    log_event "Not checked (a Kempt update is running)"
    jq -e -n '[inputs][0] | select(type == "object")' "$STATE_FILE" 2>/dev/null || true
    [[ -z "$strict" ]] || return 1
    return 0
  else
    # explain_helper_error rewrites the one case the raw text gets WRONG: a missing root helper,
    # which `timeout` reports as a failure to run a command and reads as a timeout. dnf only -
    # the one check path that goes through a root helper.
    serr="$(explain_helper_error "$(stderr_tail "$errf")")"
    status="stale"; error="dnf check failed${serr:+: $serr}"; dnf_items="$(state_prev_items dnf)"
  fi
  if flatpak_included; then
    if fp_items="$(flatpak_check "$fp_sz" "$fp_scopes_f" 2>"$errf")"; then fp_priced=true; else
      serr="$(stderr_tail "$errf")"
      status="stale"; error="${error:+$error; }flatpak check failed${serr:+: $serr}"; fp_items="$(state_prev_items flatpak)"
    fi
    # A per-user listing that failed keeps the previous check's per-user items, as a stale backend
    # keeps all of its own: pending updates must not vanish because a listing failed. They carry
    # their own sizes, and attach_sizes leaves an item it has no row for as it is. Through stdin,
    # never --argjson, for the argv cap assemble_state names.
    local fp_kept
    if grep -qx 'user failed' "$fp_scopes_f" 2>/dev/null \
       && fp_kept="$({ printf '%s\n' "$fp_items"; state_prev_items flatpak; } \
                     | jq -c -s '.[0] + [.[1][] | select(.scope == "user")]' 2>/dev/null)" \
       && [[ "$fp_kept" == \[* ]]; then
      fp_items="$fp_kept"
    fi
  else
    fp_enabled=false; fp_items='[]'
  fi
  rm -f "$errf"
  dnf_items="$(mark_held dnf <<<"$dnf_items")"
  # flatpak_runtimes_never_held is the second half of the refusal cmd_hold makes: a holds file can
  # already name a runtime (it was writable long before runtimes were counted), and mark_held keys
  # on the bare name, so without this a stale line would start holding a runtime today.
  fp_items="$(mark_held flatpak <<<"$fp_items" | flatpak_runtimes_never_held)"
  # Which pending packages fix a security advisory. Asked only when dnf answered and something not
  # held is pending, so an idle check costs nothing, and never on an image-based system, which dnf
  # does not update. A failure publishes nothing.
  if [[ "$dnf_priced" == true ]] && ! on_ostree \
     && jq -e 'any(.[]; .held != true)' <<<"$dnf_items" >/dev/null 2>&1; then
    sec_raw="$(dnf_security_query)" || sec_raw=""
  fi
  if [[ -n "$sec_raw" ]]; then
    sec_items_f="$(mktemp)"
    printf '%s\n' "$dnf_items" > "$sec_items_f"
    sec_parsed="$(dnf_security_parse "$sec_items_f" <<<"$sec_raw" 2>/dev/null)" || sec_parsed=""
    rm -f "$sec_items_f"
  fi
  # After mark_held, because the coverage rule below counts NON-HELD items only.
  [[ "$dnf_priced" == true ]] && dnf_items="$(attach_sizes "$dnf_sz" <<<"$dnf_items")"
  [[ "$fp_priced"  == true ]] && fp_items="$(attach_sizes "$fp_sz"  <<<"$fp_items")"
  # Each installation's outcome, written by flatpak_check only when there is a per-user one.
  local fp_scopes=""
  if [[ -s "$fp_scopes_f" ]]; then
    fp_scopes="$(jq -cSRn '[inputs | select(length > 0) | split(" ") | {(.[0]): .[1]}] | add' \
                 < "$fp_scopes_f" 2>/dev/null)" || fp_scopes=""
  fi
  rm -f "$dnf_sz" "$fp_sz" "$fp_scopes_f"
  local dnf_bytes fp_bytes=""
  dnf_bytes="$(backend_download_bytes <<<"$dnf_items")"
  # A switched-off backend gets no figure rather than a zero: `download_bytes: 0` would claim
  # "nothing to download from it" where the truth is that nobody asked.
  [[ "$fp_enabled" == true ]] && fp_bytes="$(backend_download_bytes <<<"$fp_items")"
  # Published so the widget can offer "Install on Next Restart" without re-deriving the rule.
  # dnf only: a flatpak app cannot take the session down mid-transaction.
  local risky
  risky="$(risky_names <<<"$dnf_items" | jq -Rn '[inputs]')"
  # Whether a restart is owed RIGHT NOW - unlike a history entry's reboot_needed, which is about
  # the moment one run finished. Rewritten by every check, so it clears itself after a restart and
  # notices a `sudo dnf5 upgrade` typed in a terminal.
  # Safe here: dnf_reboot_needed is cache-only, repo-less and closes its own stdin, so it cannot
  # reach the network or prompt (do NOT add a second redirect - it fights the backend's own).
  # Unconditional because this CLI has no include_dnf key; THE RULE: if dnf gains one, this call
  # goes behind it, next to the flatpak gate above. Same in cmd_update.
  local reboot
  reboot="$(dnf_reboot_needed)"
  # Shape guard, twinned with cmd_update's: a surprise value reaching --argjson fails jq and loses
  # the whole check. Nothing reaches it today - it is a boundary on the backend contract.
  [[ "$reboot" == "true" || "$reboot" == "false" ]] || reboot=false
  # The pending names go along only when dnf ANSWERED (dnf_priced): the previous state's items are
  # not news about what arrived after the stage. Held packages are left out, since the stage skips
  # them on purpose.
  # Read here and not at the start of the check: a stage may land during a slow fetch. Local, so
  # whatever runs after an internal check reads the machine again.
  local STAGE_WORD_NOW=""
  STAGE_WORD_NOW="$(stage_read)"
  local staged_state pend_f=""
  if [[ "$dnf_priced" == true ]] && pend_f="$(mktemp 2>/dev/null)"; then
    jq -r '.[] | select(.held != true) | .name' <<<"$dnf_items" > "$pend_f" 2>/dev/null \
      || { rm -f "$pend_f"; pend_f=""; }
  fi
  staged_state="$(offline_staged_state "$pend_f")"
  [[ -z "$pend_f" ]] || rm -f "$pend_f"
  # dnf5 keeps ONE stored transaction for ordinary offline updates and Fedora release upgrades
  # alike, so a staged release upgrade is a fact about what the offline surface can do right now:
  # staging over it cancels it, and Kempt refuses to. Published so the widget can say so and stop
  # offering the button, rather than the CLI explaining it after the press.
  # ...and the same for a machine dnf cannot update at all. Published rather than left to the
  # update to discover, so the widget can say what this box is and stop offering a button that
  # only ever ends in a refusal.
  local image_based=null
  on_ostree && image_based=true
  # Never both: a box that cannot be updated by dnf at all has nothing useful to say about what is
  # in dnf5's transaction slot, and the two messages contradict each other in a popup that shows
  # two at a time.
  local relup_json="" relup_pair
  if [[ "$image_based" == null ]] && relup_pair="$(offline_release_upgrade)"; then
    # `state` and not a boolean, and inside this object rather than beside it: three states, and a
    # reader holding two of the three would word its sentence wrongly for the one it cannot name.
    # Always present when the object is - it qualifies the fact rather than adding a new one.
    relup_json="$(jq -cn --arg from "${relup_pair%% *}" --arg to "${relup_pair##* }" \
                    --arg st "$(offline_release_upgrade_state)" \
                    '{from:$from, to:$to, state:$st}')" || relup_json=""
  fi
  local state
  # Read AFTER maybe_refresh_metadata, so a check that has just fetched publishes the fetch it
  # made rather than the one before it.
  state="$(assemble_state "$dnf_items" "$fp_items" "$status" "$error" "$fp_enabled" "$prev_ls" "$risky" "$reboot" "$dnf_bytes" "$fp_bytes" "$staged_state" "$relup_json" "$image_based" "$(metadata_refreshed_iso)")"
  # A per-user installation that failed leaves the system answer standing and says so here, as
  # the history's `scopes` does, rather than marking the whole backend stale.
  if [[ -n "$fp_scopes" ]]; then
    state_merge --argjson s "$fp_scopes" '.backends.flatpak.scopes = $s'
  fi
  # A stage another updater's symlink stands in front of. Merged in like the blocks below, and
  # guarded the same way: a failure leaves the state as assembled.
  local blocked_json
  blocked_json="$(offline_stage_blocked_state 2>/dev/null)" || blocked_json=""
  if [[ -n "$blocked_json" ]]; then
    state_merge --argjson b "$blocked_json" '. + {offline_stage_blocked: $b}'
  fi
  # A stage no restart will install, or one Kempt cannot read: said on every surface.
  local stage_problem
  stage_problem="$(offline_stage_problem_of "$(stage_read)")" || stage_problem=""
  if [[ -n "$stage_problem" ]]; then
    state_merge --arg p "$stage_problem" '. + {offline_stage_problem: $p}'
  fi
  # Who holds the next restart, and whether Discover is set to take it by itself.
  local unattended_now=false
  discover_unattended_active >/dev/null 2>&1 && unattended_now=true
  state_merge --arg h "$(restart_holder)" --argjson u "$unattended_now" \
                 '. + {restart_holder: $h, discover_unattended: $u}'
  # The unused Flatpak runtimes, merged in after assembly because the block is optional and has no
  # say in the check's status. Guarded at every step (set -e, and this runs inside the check lock):
  # a helper, du or jq that fails leaves the state exactly as assembled, never a failed check.
  local reclaim_json
  reclaim_json="$(reclaim_check_block "$fp_enabled" 2>/dev/null)" || reclaim_json=""
  if [[ -n "$reclaim_json" ]]; then
    state_merge --slurpfile r <(printf '%s\n' "$reclaim_json") '. + {reclaim: $r[0]}'
  fi
  # One line, or absent: the error of the latest dnf refresh, while it failed. A dnf check is
  # cache-only, so with no cache it says only "no cache", and this says why there is none.
  if [[ -f "$REFRESH_DNF_FAILED_FILE" ]]; then
    state_merge --rawfile e "$REFRESH_DNF_FAILED_FILE" \
                   '.backends.dnf.refresh_error = ($e | split("\n")[0])'
  fi
  # "battery", "metered" or absent: this check's metadata fetch was due and did not run.
  if [[ -n "${REFRESH_SKIPPED:-}" ]]; then
    state_merge --arg r "$REFRESH_SKIPPED" '. + {refresh_skipped: $r}'
  fi
  # The folder that has the root helper refusing updates, or absent: `kempt status` and the widget
  # say so now, instead of a list of updates that cannot install. The same find doctor and the helper use.
  local unsafe_folder
  if [[ "$image_based" == null ]] && unsafe_folder="$(apply_unsafe_dir 2>/dev/null)"; then
    state_merge --arg d "$unsafe_folder" '. + {unsafe_folder: $d}'
  fi
  # true or absent: the widget's one offer to turn off Discover's notifier, while it starts with
  # the session and nobody has answered.
  if discover_offer_pending; then
    state_merge '. + {discover_offer: true}'
  fi
  # true or absent: the warning about Discover's setting has not been drawn yet.
  if discover_unattended_warn_pending 2>/dev/null; then
    state_merge '. + {discover_unattended_warn: true}'
  fi
  # The writers' lock from here to the write, for a check with a startup block: `kempt startup ack`
  # and mute patch it there. A short wait, and not having it never fails the check.
  local wlocked=""
  if [[ -n "${STARTUP_SEEN:-}" ]]; then
    writer_lock "$WRITER_LOCK_WAIT" 2>/dev/null && wlocked=1
  fi
  local st_block
  if [[ -n "${STARTUP_SEEN:-}" ]] && st_block="$(startup_block)"; then
    state_merge --argjson b "$st_block" '. + {startup: $b}'
  fi
  if [[ -n "$sec_parsed" ]]; then
    state_merge --argjson b "$sec_parsed" '. + {security: {count: ($b | length), packages: $b}}'
  fi
  printf '%s\n' "$state"                 # answer first: a read-only state dir must not eat the result
  # `return 1` keeps a failed write a failed check for a caller with errexit off.
  printf '%s\n' "$state" | write_state || { [[ -z "$wlocked" ]] || writer_unlock; return 1; }
  [[ -z "$wlocked" ]] || writer_unlock
  # One line per check. The lock-timeout return above records
  # nothing on purpose: it served a previous answer and looked at nothing.
  if [[ "$status" == "ok" ]]; then
    local said
    said="$(jq -r '"Checked: \(.actionable) update\(if .actionable == 1 then "" else "s" end) to install"
                   + (if .held_total > 0 then ", \(.held_total) held" else "" end)' <<<"$state" 2>/dev/null)" \
      || said="Checked"
    log_event "$said"
    # --strict: the apps for you only that could not be listed are not a current answer either,
    # though the check stays ok and keeps their previous items.
    if [[ -n "$strict" && "$fp_scopes" == *'"failed"'* ]]; then return 1; fi
  else
    log_event "Check failed: $error"
    [[ -z "$strict" ]] || return 1
  fi
}

KEMPT_RETRY_DELAY="${KEMPT_RETRY_DELAY:-10}"

# Surfaces are a closed set. An unknown one (a config typo, an older widget's value) must not
# silently mean "wait for the next restart": fall back to the surface that runs and reports now.
resolve_surface() {  # surface → a known surface (single definition: cmd_update and cmd_run must never drift)
  # Trimmed and lower-cased first, which the widget's resolveSurface also does. The warning still
  # names what was written, not what it was read as.
  local s
  s="$(surface_canon "$1")"
  case "$s" in
    popup|offline) printf '%s\n' "$s" ;;
    *) echo "warning: surface='$1' is not a known value, so updates run in the widget" >&2; printf 'popup\n' ;;
  esac
}

# A heading in front of each package manager's output. Without one, flatpak's first line lands
# straight under dnf's "Complete!" and reads as part of the dnf upgrade. Written to the log on every
# surface, and to the terminal only when the output is live. The labels are the ones the summary
# uses, so the reader matches a section to its summary line by name.
# Best-effort, like every write into the run log: the flatpak heading is written AFTER dnf has
# changed the system, and under errexit a log that stopped taking writes (a full home) ended the
# run there - no history entry, no closing check, and the widget left spinning until its guard.
run_heading() {  # log_file title
  if [[ "${KEMPT_LIVE_OUTPUT:-}" == "1" ]]; then
    printf '\n== %s ==\n' "$2" | tee -a "$1" 2>/dev/null || true
  else
    printf '\n== %s ==\n' "$2" 2>/dev/null >> "$1" || true
  fi
}

# A warning for the person AND the run log, and the log half may fail: `echo | tee -a "$log"` is a
# pipeline whose status is tee's, so a log that could not be opened made the warning itself the
# thing that killed the run - on the far side of the update, where most of these are said.
log_warn() {  # log_file message
  printf '%s\n' "$2" >&2
  printf '%s\n' "$2" 2>/dev/null >> "$1" || true
}

# The runner is an argument because the two backends sit on OPPOSITE sides of the privilege
# boundary: dnf through the root helper (priv_apply), flatpak as the user (flatpak_apply). The run
# log, the live tee and the retry are the same for both.
# KEMPT_DNF_LOCK_RE matches the lock-held wordings of dnf5, rpm and PackageKit, listed in
# tests/fixtures/MANIFEST.md. Package names can contain "lock" (kscreenlocker), so a loose
# `package.*lock` retries dependency errors. dnf5's "Waiting for a lock" line is left out: dnf5
# waits and carries on, so it never explains a failure. `can.t` avoids a quote inside quotes.
# KEMPT_FLATPAK_LOCK_RE: the flatpak wordings carry the path in the MIDDLE (`Unable to lock %s`,
# `Locking repo %s failed`, `Opening lock file %s/.lock failed`). So the patterns are joined with
# `.*` rather than literals. `\b` keeps `Unlocking repo failed`, a different error, out of the match.
KEMPT_DNF_LOCK_RE='failed to obtain rpm transaction lock|another transaction is in progress|can.t create [a-z]+ lock on|unable to lock'
KEMPT_FLATPAK_LOCK_RE='unable to lock|\blocking repo.*failed|opening lock file.*failed'
# Lower case at the start like every other reason: it is shown after "Update failed: ".
# The last sentence is swapped for KEMPT_BUSY_ALSO_FAILED when another part of the run failed too.
KEMPT_BUSY_TRY_AGAIN="Try again in a few minutes."
KEMPT_BUSY_ALSO_FAILED="Another part of the update failed too, and the log says what."
KEMPT_BUSY_REASON_DNF="another program is using the package system (PackageKit, Discover or dnf-automatic) and was still busy after three tries. Nothing was installed. $KEMPT_BUSY_TRY_AGAIN"
KEMPT_BUSY_REASON_FLATPAK="another program is using Flatpak (Discover, PackageKit or another flatpak command) and was still busy after three tries. The Flatpak update did not finish. $KEMPT_BUSY_TRY_AGAIN"
# dnf5 runs as a service with no terminal, so it cannot ask. With auto_accept off at a terminal it runs
# once without -y first: it prints what it would do, finds nobody to answer and stops with its own
# "Operation aborted", having changed nothing. Then the person answers here, and only a yes runs it
# with -y. Any other result of that first run is the answer: 0 is nothing to do, the rest a failure.
apply_asking() {  # verb [--exclude=NAME]... ; yflag belongs to cmd_update, which every caller runs inside
  local verb="$1" out rc=0 ans=""; shift
  if [[ ${#yflag[@]} -eq 0 ]]; then
    { out="$(priv_apply "$verb" "$@" 2>&1 | tee /dev/fd/3)" || rc=$?; } 3>&1
    [[ $rc -eq 0 ]] && return 0
    [[ $rc -eq 1 && "$out" == *"Operation aborted"* ]] || return "$rc"
    read -r -p "Go ahead with this? [y/N]: " ans || ans=""
    if [[ "$ans" != [yY]* ]]; then echo "Answered no, so nothing was changed."; return 1; fi
  fi
  priv_apply "$verb" -y "$@"
}
apply_with_retry() {  # log_file runner args... ; retries on foreign package-lock errors
  local log="$1" runner="$2"; shift 2
  local attempt rc before_sz lock_re="$KEMPT_DNF_LOCK_RE" busy="$KEMPT_BUSY_REASON_DNF"
  if [[ "$runner" == flatpak_apply ]]; then
    lock_re="$KEMPT_FLATPAK_LOCK_RE"; busy="$KEMPT_BUSY_REASON_FLATPAK"
  fi
  for attempt in 1 2 3; do
    rc=0
    # Only THIS attempt's output may decide whether to retry: a fixed `tail -n 20` re-reads the
    # previous attempt's lock error and retries a run that failed for another reason entirely.
    before_sz=0; [[ -f "$log" ]] && before_sz="$(stat -c %s "$log" 2>/dev/null || echo 0)"
    if [[ "${KEMPT_LIVE_OUTPUT:-}" == "1" ]]; then
      # At a terminal: the person SEES live output, and any prompt when auto_accept=false.
      # `|| rc=` (not `; rc=`): keeps the pipeline errexit-exempt for a caller that invokes
      # apply_with_retry bare, where `; rc=` would abort the run instead of retrying.
      # -i: Ctrl-C reaches tee too, and what the helper says about it has to get through.
      "$runner" "$@" 2>&1 | tee -i -a "$log" || rc=${PIPESTATUS[0]}
    else
      "$runner" "$@" >>"$log" 2>&1 || rc=$?
    fi
    [[ $rc -eq 0 ]] && return 0
    # Ctrl-C. dnf5 runs on as a service whatever this terminal does, so there is no result to report
    # yet, and calling the run failed would be untrue. The helper has said so; dnf5's history has the rest.
    if [[ $rc -eq 130 ]]; then log_event "Stopped watching. An update that had started carries on"; exit 130; fi
    if tail -c +$(( before_sz + 1 )) "$log" | grep -qiE "$lock_re"; then
      # 3 attempts = 2 retries. The last failure must not promise a retry that never comes.
      if [[ $attempt -lt 3 ]]; then
        log_warn "$log" "Package system busy (PackageKit/Discover?). Retrying in ${KEMPT_RETRY_DELAY}s ($attempt/3)"
        sleep "$KEMPT_RETRY_DELAY"
      else
        log_warn "$log" "Package system still busy after $attempt attempts. Giving up"
        # Kempt's own sentence for the most likely failure it has, in place of dnf's or flatpak's
        # raw line about a lock file, which reads as a broken installation. Set only here, where
        # the evidence is: a lock-specific grep against this attempt's output alone.
        #
        # reason_override, run_busy_reason and run_failed_otherwise belong to cmd_update, which
        # every caller of this runs inside (dynamic scope, so NOT `local`). The reason is claimed
        # only when nothing failed before it: a cleanup after a failure, or flatpak after a dnf
        # failure, must not relabel the run. The flatpak sentence makes no claim about dnf, which
        # ran first and may have installed hundreds of packages.
        if [[ -z "${reason_override:-}" && "${status:-ok}" == ok ]]; then
          reason_override="$busy"
          run_busy_reason="$busy"
        fi
      fi
    else
      # A failure that is not a lock: the run cannot exit as "busy", whatever reason it reports.
      run_failed_otherwise=1
      return "$rc"
    fi
  done
  return "$rc"
}

# Pre-flight failure: nothing has been changed and nothing will be. Loud on stderr, exit 5 (never
# a bare backend rc through errexit), and a notification where nobody reads stderr. Reads $at_terminal.
preflight_abort() {  # message
  echo "$1" >&2
  [[ "$at_terminal" == true ]] || notify "Kempt" "Update did not start: $1"
  # Recorded, because `kempt log` is where somebody looks when a press did nothing and they want to
  # know why. Two of the three things that reach here are deliberate refusals rather than faults,
  # and a refusal that leaves no trace is indistinguishable from a button that does not work.
  # init first: this runs before cmd_update takes the lock, so the state directory may not exist.
  kempt_init_dirs 2>/dev/null || true
  log_event "Update did not start: $1" 2>/dev/null || true
  # Then a check, and it is not a nicety: a state.json write is the ONLY thing that takes the widget
  # out of its updating state, and this path writes no history entry and runs no post-run check.
  # Without it a press of Update Now spins until the popup's three-hour guard fires - on an
  # image-based system, every press, for ever. The check itself only reads, so it is safe on every
  # box that can reach this; `|| true` because a pre-flight that failed because nothing could be
  # read must still exit 5 rather than on the check's rc.
  cmd_check >/dev/null 2>&1 || true
  exit 5
}

# --- the sections of cmd_update ------------------------------------------------------------------
# These four are SECTIONS, not helpers: each is called from exactly one place, in one order, and
# reads and writes the run's locals through bash's DYNAMIC scope rather than arguments. Each
# header says what it reads and what it changes - that is the contract; do not reuse them.

# Two runs stop here while another updater holds the next restart, with system updates waiting.
# A stage asked for, which would download and never install, while the silent fall to a live run
# would cancel what that updater prepared. And a live run with nobody to ask: no terminal, and no
# --risky-ok saying the widget asked. What the widget last read may have said Flatpak alone, and this
# check may find a kernel. Nothing is changed, Flatpak included. With no system updates waiting the
# run carries on. A check that cannot answer refuses too, since either run could meet the same answer.
# Reads: wanted_stage, risky_ok. Exits 3 or 5, or returns.
# The updates a run would install, holds left out. REPLY is the count; non-zero when the check could
# not answer.
run_pending_count() {
  local rc=0
  REPLY="$(dnf_check 2>/dev/null | mark_held dnf | jq '[.[] | select(.held | not)] | length')" || rc=$?
  return "$rc"
}
refuse_run_behind_other_updater() {
  restart_held_by_other || return 0
  if [[ "$wanted_stage" != true ]]; then
    [[ -z "$risky_ok" ]] || return 0
    [[ "$at_terminal" == true ]] && return 0
  fi
  local rc=0
  run_pending_count || rc=$?
  [[ $rc -eq 0 && "$REPLY" == 0 ]] && return 0
  if [[ "$wanted_stage" != true ]]; then
    preflight_abort "another updater has prepared the next restart, and updating now may stop what it prepared from installing, so nothing was changed. Open Kempt to choose, or update now by typing this in a terminal: kempt update --surface=widget"
  fi
  preflight_abort "another updater has prepared the next restart, so nothing was prepared or changed. Restart when you are ready, or update now by typing this in a terminal: kempt update --surface=widget"
}

# The sentence for a step the root helper refused: what the helper said about a folder, else what
# the caller knows.
refusal_words() {  # log what fallback-reason → sentence
  local why
  if why="$(log_folder_refusal "$1")"; then
    printf '%s. %s\n' "$2" "$why"
  else
    printf '%s, because %s. See: kempt doctor\n' "$2" "$3"
  fi
}

log_nothing_to_stage() {  # held dnf names, or nothing
  if [[ -n "$1" ]]; then log_event "Nothing to stage (every pending update is held)"
  else log_event "Nothing to stage"; fi
}

# The root helper refuses to install or stage while these folders are unsafe, and asking it first
# means a password prompt for a refusal this user's reading of the same find already knows about. So
# the run stops here, changing nothing, Flatpak included, as the gate above does. With no system
# updates waiting a live run goes on for Flatpak's sake and leaves the helper out; a stage has nothing
# else to do. A reading that finds nothing proves little, since root sees more: the helper still decides.
# Reads: surface. Sets: dnf_apply_skipped. Exits 3 or 5, or returns.
refuse_run_over_unsafe_folders() {
  local unsafe_dir
  unsafe_dir="$(apply_unsafe_dir 2>/dev/null)" || return 0
  if [[ "$surface" != offline ]]; then
    local rc=0
    run_pending_count || rc=$?
    if [[ $rc -eq 0 && "$REPLY" == 0 ]]; then
      dnf_apply_skipped=true
      return 0
    fi
  fi
  preflight_abort "nothing was changed, because $(apply_unsafe_words "$unsafe_dir"). See: kempt doctor"
}

# The risky-transaction recommendation, run BEFORE the lock is taken so an abort leaves no lock
# residue and no history entry, having changed nothing at all.
# Reads: surface, risky_ok. Writes: surface, risky_advice. Answering "s" at the prompt switches this
# run to offline. risky_advice is the notification, sent only once the run really starts.
recommend_offline_if_risky() {
  # Recommends, never blocks; an offline run IS the recommendation, so it is
  # never nagged.
  #
  # ...and it must never recommend a route that is refused. `[s]tage offline` sets $surface here,
  # and the pre-flight gate for a stored Fedora release upgrade runs AFTER this function - so an
  # offline stage entered through this prompt used to reach dnf5 and cancel the upgrade, logged by
  # Kempt as its own restage. The gate below closes that; this stops the prompt offering it at all,
  # because an option that always ends in a refusal is worse than one that is not there.
  # ...nor while another updater holds the next restart, which the stage could not install behind.
  local relup_blocks=false no_stage_why="" no_stage_answer=""
  if offline_release_upgrade >/dev/null; then
    relup_blocks=true
    no_stage_why="a Fedora release upgrade is stored, and staging would cancel it"
    no_stage_answer="Staging would cancel the stored Fedora release upgrade"
  elif restart_held_by_other; then
    relup_blocks=true
    no_stage_why="another updater has prepared the next restart"
    no_stage_answer="Staging is not available, because another updater has prepared the next restart"
  fi
  if [[ "$surface" != "offline" ]]; then
    local risky_list="" rerr rcount fams
    rerr="$(mktemp)"
    # A pre-check that cannot run is not "nothing risky": say so, then proceed - losing advice
    # must never stop the user updating.
    risky_list="$(dnf_check 2>"$rerr" | mark_held dnf | risky_names)" || {
      risky_list=""
      # same rewrite as cmd_check: a missing root helper must not be announced as a timeout here either
      local why
      why="$(explain_helper_error "$(stderr_tail "$rerr")")"
      echo "warning: could not check for session-critical updates${why:+: $why}" >&2
    }
    rm -f "$rerr"
    if [[ -n "$risky_list" ]]; then
      rcount="$(wc -l <<<"$risky_list")"
      if [[ "$at_terminal" == true ]]; then
        # ONE ROW PER FAMILY, CARRYING ITS OWN COUNT. Same family rule as the notification below -
        # a Qt bump's first eight names alphabetically would otherwise push a pending KERNEL out of
        # sight, and kernel-core and kernel-modules are one decision, not two.
        #
        # The count on the row is the part that was wrong. The listing collapsed a family to one
        # name while the tail counted PACKAGES, so six mesa packages printed "mesa-dri-drivers"
        # and "... and 5 more" - which reads as five hidden, unrelated risks instead of one
        # graphics driver shipped in six pieces. A count that makes a transaction sound worse than
        # it is costs exactly what an undercount does: the next warning is believed a little less.
        # The count now sits on its family's row, and the tail counts the families not shown.
        local fam_rows shown nshown ntotal width
        fam_rows="$(awk '{ n = $0; f = n; sub(/[-.].*/, "", f)
                           if (!(f in cnt)) { order[++k] = f; first[f] = n }
                           cnt[f]++ }
                         END { for (i = 1; i <= k; i++) { f = order[i]
                                 printf "%s\t%d\t%s\n", f, cnt[f], first[f] } }' <<<"$risky_list")"
        ntotal="$(grep -c '' <<<"$fam_rows")"
        shown="$(head -8 <<<"$fam_rows")"    # still capped: a box can always surprise us with 30 families
        nshown="$(grep -c '' <<<"$shown")"
        # Each row is turned into what it will actually SAY before anything is measured, because a
        # plain-language label changes the column width: "graphics drivers (mesa)", not "mesa".
        # A family Kempt does not ship a label for prints bare - see family_label.
        local rows_disp="" fam n first lbl disp
        while IFS=$'\t' read -r fam n first lbl; do
          [[ -z "$fam" ]] && continue
          # a family of one is named outright (mesa-libGL says more than mesa); several are one row
          if (( n == 1 )); then disp="$first"; else disp="$fam"; fi
          [[ -n "$lbl" ]] && disp="$lbl ($disp)"
          rows_disp+="$disp"$'\t'"$n"$'\n'
        done < <(while IFS=$'\t' read -r fam n first; do
                   [[ -z "$fam" ]] && continue
                   printf '%s\t%s\t%s\t%s\n' "$fam" "$n" "$first" "$(family_label "$fam")"
                 done <<<"$shown")
        # the label column width, so the counts line up under one another
        width="$(awk -F'\t' 'NF { if (length($1) > m) m = length($1) } END { print m + 0 }' <<<"$rows_disp")"
        # ...and the counts themselves right-aligned, so 5 sits under the 2 of 12 and the column
        # reads as numbers rather than as ragged text
        local cwidth
        cwidth="$(awk -F'\t' 'NF { if ($2 > 1 && length($2) > m) m = length($2) } END { print m + 0 }' <<<"$rows_disp")"
        echo
        if (( rcount == 1 )); then
          echo "  Heads up: 1 session-critical package is pending."
        else
          echo "  Heads up: $rcount session-critical packages are pending."
        fi
        echo "  Installing these while the desktop is running can break the session until you restart:"
        echo
        awk -F'\t' -v w="$width" -v c="$cwidth" 'NF { if ($2 == 1) printf "      %s\n", $1
                                                      else printf "      %-*s   %*d packages\n", w, $1, c, $2 }' <<<"$rows_disp"
        (( ntotal > nshown )) && echo "      ... and $(( ntotal - nshown )) more"
        echo
        local ans tries prompt="  Your choice [s/u/a]: "
        if [[ "$relup_blocks" == true ]]; then
          echo "  Staging is not available: $no_stage_why."
          echo
          echo "      [u]  update now, live"
          echo "      [a]  abort  (default)"
          echo
          prompt="  Your choice [u/a]: "
        else
          echo "  Staging installs them during your next restart, when nothing is using them."
          echo
          echo "      [s]  stage for the next restart  (recommended)"
          echo "      [u]  update now, live"
          echo "      [a]  abort  (default)"
          echo
        fi
        for tries in 1 2; do
          # `|| ans=""` keeps EOF (Ctrl-D) out of errexit. EOF and Enter both mean "I did not
          # answer", and the safe answer to a risk warning is to NOT proceed.
          read -rp "$prompt" ans || ans=""
          case "${ans,,}" in
            ""|n|no|a|abort)  echo "aborted"; exit 0 ;;
            s|stage)          if [[ "$relup_blocks" == true ]]; then
                                echo "$no_stage_answer. Answer u or a."
                                [[ $tries -eq 2 ]] && { echo "aborted"; exit 0; }
                                continue
                              fi
                              surface="offline"; break ;;
            u|update|y|yes)   break ;;
            *) if [[ $tries -eq 1 ]]; then echo "  Please answer $([[ "$relup_blocks" == true ]] || echo "s, ")u or a."
               else echo "aborted"; exit 0; fi ;;
          esac
        done
      else
        # families, not names - same rule as the terminal listing above.
        # per-line strip on a MULTI-LINE list: ${risky_list//[-.]*/} is a glob, not a regex, and
        # its * crosses newlines - it would eat the whole list from the first - or . onwards.
        # shellcheck disable=SC2001
        fams="$(sed 's/[-.].*//' <<<"$risky_list" | sort -u)"
        local fam_n; fam_n="$(wc -l <<<"$fams")"
        # Kept, not sent: the lock and the pre-flights come after this, and any of them can still
        # stop the run. cmd_update sends it as the run starts, when the install is really happening.
        # No restart advice while a release upgrade is stored: a restart could install that.
        local tail_advice=". Restart after it finishes."
        [[ "$relup_blocks" == true ]] && tail_advice="."
        # The same vocabulary the terminal listing and the popup use: family_label, or the bare
        # family when Kempt ships no label for it. A notification calling mesa "mesa" while the
        # terminal calls it graphics drivers is one transaction described two ways.
        local fam_disp
        fam_disp="$(head -4 <<<"$fams" | while read -r f; do
                      lbl="$(family_label "$f")"
                      if [[ -n "$lbl" ]]; then printf '%s\n' "$lbl"; else printf '%s\n' "$f"; fi
                    done | paste -sd, - | sed 's/,/, /g')"
        (( fam_n > 4 )) && fam_disp="$fam_disp, ..."
        # --risky-ok: the popup already asked, and the person chose Install Now over this advice.
        local pkg_word=packages
        (( rcount == 1 )) && pkg_word=package
        # "session", not "desktop": the kernel is in the list.
        [[ -n "$risky_ok" ]] \
          || risky_advice="This update includes $rcount $pkg_word your running session depends on ($fam_disp)$tail_advice"
      fi
    fi
  fi
}

# The flatpak half of a run. dnf has already run by now, so a flatpak failure is REPORTED and
# never fatal: crashing loses the history entry and notification for a system that already changed.
# The system installation first, then the per-user one when there is one. Each is updated on its
# own, so a failure in one never stops the other, and each failure gets its own log line.
# Reads: include_fp, yflag, log. Writes: fp_status, fp_scopes, and status (which only
# ever moves to "failed").
apply_flatpak_updates() {
  # NOT `local`: this is the caller's variable (see the header). A `local` would shadow it, leave
  # cmd_update's copy unset, and take the run down on the history entry under `set -u`.
  fp_status="skipped"
  fp_scopes='null'
  if is_true "$include_fp"; then
    fp_status="ok"
    run_heading "$log" "Apps (flatpak)"
    local held_fp scope scope_status scope_list outcomes=""
    held_fp="$(holds_for flatpak)"
    scope_list="$(flatpak_scopes)"
    # Found before the run but unreadable: not updated, and reported failed like a failed update.
    if [[ "${fp_user_unreadable:-false}" == true ]]; then
      outcomes="user failed"$'\n'; fp_status="failed"; status="failed"; run_failed_otherwise=1
      log_warn "$log" "warning: the apps for you only could not be listed, so they were not updated"
    fi
    for scope in $scope_list; do
      if [[ "$scope" == user ]]; then run_heading "$log" "Apps for you only (flatpak)"; fi
      scope_status=ok
      apply_flatpak_scope "$scope" || scope_status=failed
      outcomes+="$scope $scope_status"$'\n'
      if [[ "$scope_status" == failed ]]; then
        fp_status="failed"; status="failed"
        if [[ "$scope" == user ]]; then
          log_warn "$log" "warning: updating apps for you only failed"
        elif [[ "$scope_list$outcomes" == *user* ]]; then
          log_warn "$log" "warning: updating system apps failed"
        fi
      fi
    done
    # Each installation's outcome, recorded only when there is a per-user one, so a run without it
    # writes the entry it always did. A jq that fails costs the detail, never the run.
    if [[ "$scope_list$outcomes" == *user* ]]; then
      fp_scopes="$(jq -cSRn '[inputs | select(length > 0) | split(" ") | {(.[0]): .[1]}] | add' \
                   <<<"$outcomes" 2>/dev/null)" || fp_scopes='null'
      [[ -n "$fp_scopes" ]] || fp_scopes='null'
    fi
  fi
}

# One installation's update, with the holds applied by id in both. Non-zero when any part failed.
# Reads: held_fp, yflag, log.
apply_flatpak_scope() {  # system|user
  local scope="$1" rc=0 sflag=() where="system apps"
  [[ "$scope" == user ]] && { sflag=(--user); where="apps for you only"; }
  if [[ -n "$held_fp" ]]; then
    # holds exist → per-app updates of every pending, non-held, INSTALLED app. That pre-filter
    # is the ONLY installed check there is (flatpak errors out on an id it does not have), so an
    # empty installed set means no ids pass and the run reports flatpak failed.
    local installed_fp id pending_fp ids=()
    installed_fp="$(flatpak_snapshot "$scope" | cut -f1 | sed "s/^$KEMPT_FLATPAK_USER_KEY//")" \
      || { installed_fp=""; rc=1; run_failed_otherwise=1; log_warn "$log" "warning: flatpak installed lookup failed for the $where, so none of them were updated"; }
    # ONE capture, read twice below: the apps to name individually, and whether any runtime is
    # pending at all. Asking the backend twice would pay the cached query's cost twice over for an
    # answer that cannot have changed in between.
    # A lookup that FAILS is not "nothing pending": swallowed to an empty list, it updated no app
    # and still reported flatpak `ok`. Failed, like the installed lookup above.
    pending_fp="$(flatpak_check_scope "$scope" 2>/dev/null)" \
      || { pending_fp=""; rc=1; run_failed_otherwise=1; log_warn "$log" "warning: flatpak update lookup failed for the $where, so none of them were updated"; }
    while IFS= read -r id; do
      [[ -n "$id" ]] || continue
      grep -qxF "$id" <<<"$held_fp" && continue
      grep -qxF "$id" <<<"$installed_fp" || continue
      ids+=("$id")
    done < <(jq -r '.[] | select(.kind != "runtime") | .name' <<<"$pending_fp" 2>/dev/null)
    if [[ ${#ids[@]} -gt 0 ]]; then
      apply_with_retry "$log" flatpak_apply "${sflag[@]}" "${yflag[@]}" "${ids[@]}" || rc=1
    fi
    # ...and the runtimes, which the per-app loop above cannot cover. A hold is per app, so a run
    # with holds names the surviving apps one ref at a time - and a ref updates the runtimes that
    # app DEPENDS on, never the ones it does not. Runtimes cannot be held, so the whole set goes
    # in one command, which is what the no-holds branch below already does for everything.
    # Only when one is actually pending, and that condition is the whole point: "every pending app
    # is held" must still mean flatpak is not run at all, rather than run on a set that is empty.
    if jq -e 'any(.[]; .kind == "runtime")' <<<"$pending_fp" >/dev/null 2>&1; then
      apply_with_retry "$log" flatpak_apply "${sflag[@]}" "${yflag[@]}" --runtime || rc=1
    fi
  else
    apply_with_retry "$log" flatpak_apply "${sflag[@]}" "${yflag[@]}" || rc=1
  fi
  return $rc
}

# What a LIVE run owes a stored stage. A run that moved the rpm database leaves a stage dnf5 will refuse
# (the cookie moved), so it goes now rather than sitting on the disk: side effects only, a warning on
# the run's log when it cannot go. Never over a stored release upgrade or behind another updater's
# link, which `dnf5 offline clean` would also remove. A flatpak-only run moved nothing and touches
# nothing. Reads: surface, snapshots_ok, log.
reconcile_stage_after_live_run() {
  [[ "$surface" != offline && "$snapshots_ok" == true && -s "$SNAP_DIR/dnf-after.tsv" ]] || return 0
  case "$(stage_read)" in armed|lost|interrupted|failed|done) ;; *) return 0 ;; esac
  # same_content answers three ways, and only a positive "different" (1) may discard anything.
  local moved=0 clean_rc=0
  same_content "$SNAP_DIR/dnf-before.tsv" "$SNAP_DIR/dnf-after.tsv" || moved=$?
  [[ $moved -eq 1 ]] || return 0
  apply_with_retry "$log" priv_apply dnf-offline-clean || clean_rc=$?
  if [[ $clean_rc -eq 0 ]]; then
    log_event "Staged update dropped (a live update replaced it)"
  else
    log_warn "$log" "warning: this update superseded the staged transaction, but it could not be discarded. See: kempt doctor"
  fi
  return 0
}

cmd_update() {
  local a h surface include_fp="" risky_ok="" answered=""
  surface="$(config_get surface)"
  for a in "$@"; do case "$a" in
    --no-flatpak) include_fp=false ;;
    --risky-ok) risky_ok=1 ;;
    # A press in the widget: kempt run passes this, because the press was the answer.
    --answered) answered=1 ;;
    --surface=*) surface="${a#--surface=}" ;;
    *) echo "unknown option: $a" >&2; exit 2 ;;
  esac; done
  if [[ -z "$include_fp" ]]; then
    if flatpak_included; then include_fp=true; else include_fp=false; fi
  fi
  local auto; auto="$(config_get auto_accept)"
  surface="$(resolve_surface "$surface")"
  # Somebody at a terminal sees the output and can answer the questions. KEMPT_ASSUME_TTY stands in
  # for the terminal in tests.
  local at_terminal=false
  if [[ -n "${KEMPT_ASSUME_TTY:-}" || ( -t 0 && -t 1 ) ]]; then
    at_terminal=true
    KEMPT_LIVE_OUTPUT=1
    export KEMPT_LIVE_OUTPUT
  fi
  # auto_accept=false means a person answers. With nobody here and no press, nothing may install.
  if ! is_true "$auto" && [[ "$at_terminal" != true && -z "$answered" ]]; then
    preflight_abort "auto_accept is off and nobody is at a terminal to answer, so nothing was changed. Type kempt update in a terminal, or set auto_accept to true."
  fi

  # An image-based Fedora - Silverblue, Kinoite, Bazzite, a bootc image - updates through
  # rpm-ostree, and /usr is not dnf's to write. Refused HERE, before the lock, before the
  # risky-transaction prompt and before anything is read, because the danger is precisely that
  # nothing downstream would refuse: Kinoite ships dnf5 and plasma-workspace, so both Kempt
  # packages install cleanly, the widget appears, `dnf5 check-update` lists updates and `dnf5
  # upgrade` RESOLVES a transaction rather than saying no. Left to fail on its own it fails after
  # the download, somewhere in the middle, with a message about a read-only file system and nothing
  # anywhere about rpm-ostree.
  # preflight_abort, so this is the same contract as any other refusal that changed nothing: exit
  # 5, and a notification for the surfaces where nobody is reading stderr.
  if on_ostree; then
    preflight_abort "this system updates with rpm-ostree, not dnf, so Kempt cannot update it. Support for these images is planned. For now use Discover, or: rpm-ostree upgrade (bootc upgrade on a bootc image)"
  fi

  # ...and the same treatment for a stage that would destroy a Fedora release upgrade. dnf5 keeps
  # ONE stored transaction for both kinds, so staging updates over a stored release upgrade cancels
  # it. Measured against real dnf5: the 44 -> 45 transaction is replaced by the ordinary one, dnf5
  # prints "Continuing will cancel the old offline transaction" and then does it anyway under -y,
  # which is how Kempt runs it - AND /system-update is left standing, so the machine still restarts
  # into an update, just not the one that was asked for. Re-downloading a release upgrade is
  # gigabytes, so there is no recovering from it either.
  #
  # PRE-FLIGHT and not a failure inside the run, because that is what this is: nothing is started,
  # nothing is changed, and the documented contract for that is exit 5. Reporting it as a failed
  # run put a `status: failed` entry in the history and a "see the log" notification pointing at a
  # zero-byte file, over a run that correctly did nothing.
  #
  # Only the OFFLINE surface. A live run does not replace the stored transaction, and refusing
  # ordinary updates because a release upgrade is waiting would be a bigger imposition than the one
  # this avoids - which is also why this sits after the surface is resolved rather than before.
  # Another run of this user's holding the update lock is refused HERE, before the pre-flight check:
  # that check goes through the root helper, which would wait on dnf5's lock until the other run's
  # transaction ends, and only then reach acquire_lock below. Non-blocking, and only a probe: the
  # lock itself is still taken by acquire_lock, so a run that starts between the two is refused there.
  if update_running_elsewhere; then
    echo "another kempt update is running" >&2
    exit 3
  fi
  local risky_advice=""
  recommend_offline_if_risky
  # AFTER the recommendation, and that ordering is the whole point: `[s]tage offline` at that prompt
  # SETS $surface, so a gate placed before it is bypassed by Kempt's own advice - and the stage then
  # reached dnf5 and cancelled the upgrade, recorded in the event log as an ordinary restage.
  if [[ "$surface" == "offline" ]]; then
    local relup
    if relup="$(offline_release_upgrade)"; then
      # Refused in all three states - staging cancels a stored transaction whatever state it is in -
      # and the remedy named is the one that applies to the state it is actually in.
      case "$(offline_release_upgrade_state)" in
        armed)      preflight_abort "a Fedora release upgrade ($relup) is already prepared and installs on the next restart. Preparing updates would cancel it. Restart to install it, or remove it with: sudo dnf5 offline clean" ;;
        foreign)    preflight_abort "a Fedora release upgrade ($relup) is stored, and another updater has prepared the next restart. Preparing updates would cancel the upgrade. Remove it with: sudo dnf5 offline clean" ;;
        stranded)   preflight_abort "a Fedora release upgrade ($relup) is stored but no longer set to install, so no restart installs it. Preparing updates would cancel it. Set it to install again with: sudo dnf5 system-upgrade reboot, or remove it with: sudo dnf5 offline clean" ;;
        incomplete) preflight_abort "a Fedora release upgrade ($relup) is stored and did not finish. Preparing updates would cancel it. See what happened with: sudo dnf5 offline log, or remove it with: sudo dnf5 offline clean" ;;
        *)          preflight_abort "a Fedora release upgrade ($relup) has been downloaded but not started. Preparing updates would cancel it. Begin it with: sudo dnf5 system-upgrade reboot, or remove it with: sudo dnf5 offline clean" ;;
      esac
    fi
  fi
  local wanted_stage=false
  [[ "$surface" == offline ]] && wanted_stage=true
  local dnf_apply_skipped=false
  # In this order: the refusal over the other updater offers a terminal run, which root would refuse
  # over the folders.
  refuse_run_over_unsafe_folders
  refuse_run_behind_other_updater
  acquire_lock || { echo "another kempt update is running" >&2; exit 3; }
  trap release_lock EXIT

  kempt_init_dirs
  local ts start log status="ok" reboot=false
  ts="$(date +%Y%m%dT%H%M%S)"; start="$(date +%s)"
  log="$LOG_DIR/$ts.log"

  # snapshots (before). Without one we can never say what changed, so a failure stops the run
  # BEFORE anything is touched (see preflight_abort).
  dnf_installed_lookup > "$SNAP_DIR/dnf-before.tsv" \
    || preflight_abort "cannot read the installed package set, so nothing was changed"
  # A per-user installation that cannot be read drops only itself: the run goes on without it and
  # reports it failed (apply_flatpak_updates). Only the system set can stop the run.
  local fp_user_unreadable=false
  if is_true "$include_fp" && ! flatpak_snapshot > "$SNAP_DIR/fp-before.tsv"; then
    if flatpak_user_present && flatpak_snapshot system > "$SNAP_DIR/fp-before.tsv"; then
      FLATPAK_USER_SKIP=1; fp_user_unreadable=true
    else
      preflight_abort "cannot read the installed flatpak set, so nothing was changed"
    fi
  fi

  # Which services were failing, and which were enabled, before anything changed: what the check
  # after this run, or after the restart that applies a stage, compares against. Read-only and
  # never stops the run; empty when the setting is off or systemd does not answer.
  local startup_base=""
  startup_base="$(startup_baseline 2>/dev/null)" || startup_base=""

  # Recorded here and not a line earlier: everything above can still decline to run without
  # touching the system. Past this point the system changes.
  if [[ "$surface" == offline ]]; then log_event "Update started to stage for the next restart"
  else log_event "Update started"; fi
  [[ -n "$risky_advice" ]] && notify "Kempt" "$risky_advice"

  # dnf
  run_heading "$log" "System (dnf)"
  # unknown until a branch below says ok or failed. One that says neither is failed (after the block).
  local yflag=() excl=() dnf_status="unknown"
  # WHICH dnf5 transaction a live run was, when dnf5's history can say (live_history_attribution).
  # Empty when it cannot, and everything downstream then reports the run from its two snapshots, the
  # way it did before the lookup existed. Declared here because the live branch below is one of two.
  local live_txid="" live_keep=""
  # auto_accept=false asks a person, so it applies only where one can answer: past the refusal
  # above, a run with no terminal is a press.
  if is_true "$auto" || [[ "$at_terminal" != true ]]; then yflag=(-y); fi
  local held_dnf; held_dnf="$(holds_for dnf)"
  while IFS= read -r h; do [[ -n "$h" ]] && excl+=("--exclude=$h"); done <<<"$held_dnf"
  # reason_override - a reason worked out here, because after a failed arm the log's first
  #   error-shaped line is about a symlink.
  # notify_tail - what the FAILED notification says BEYOND the reason, for a cleanup that also
  #   failed and left work only root can do.
  # staged_nothing: the stage ran, succeeded, and had nothing to build. Not a failure, and not a
  # stage either - no promise, no "installs on the next restart".
  local staged_nothing=false
  # stage_discarded: ...and a transaction stored before it was removed, because it held what the
  # empty stage just excluded.
  local stage_discarded=false
  local reason_override="" notify_tail="" staged_fresh=""
  # run_busy_reason: the busy sentence apply_with_retry claimed, if any. run_failed_otherwise: a
  #   failure that was not a lock. Together they decide exit 7 at the end.
  local run_busy_reason="" run_failed_otherwise=""
  if [[ "$surface" == "offline" ]]; then
    # How many updates this stage carries, asked NOW rather than copied from the last check's
    # state.json: it is the only thing anyone is told about a transaction they cannot open. Held
    # packages drop out here exactly as they do from the transaction - the --exclude list above is
    # built from the same holds. A check that cannot answer must not stop the stage: the count
    # degrades to the stale one with a warning.
    local cerr cjson; cerr="$(mktemp)"; cjson="$(mktemp)"
    if dnf_check 2>"$cerr" | mark_held dnf > "$cjson"; then
      # Guarded: inside an `if` body errexit is live again, and a jq that died would take down a
      # stage over a nicety.
      staged_fresh="$(jq '[.[] | select(.held | not)] | length' "$cjson")" || staged_fresh=""
    else
      staged_fresh=""
      # same rewrite as cmd_check: a missing root helper must not be announced as a timeout here either
      echo "warning: could not count the updates being staged: $(explain_helper_error "$(stderr_tail "$cerr")")" >&2
    fi
    rm -f "$cerr" "$cjson"
    # Whether a transaction existed BEFORE this attempt - the one fact every failure path below
    # needs and none can work out afterwards. Staging over an armed transaction is
    # cancel-then-stage: dnf5 destroys the old one as the new one begins, so a FAILED stage leaves
    # no transaction, a toml that is not `ready`, and the `/system-update` symlink still standing
    # over it - and the next restart detours into the offline updater, installing nothing.
    local had_stage=false prev_conflict=""
    if [[ "$(offline_system_status)" != absent ]]; then had_stage=true; fi
    # The holds that conflict with the transaction about to be replaced, read NOW because after the
    # stage it is gone and the question cannot be asked. The only record of what a rebuild was FOR.
    prev_conflict="$(offline_staged_state | jq -r '.holds_conflict[]?' 2>/dev/null || true)"
    # STAGE THEN ARM, and both or neither. `dnf5 upgrade --offline` only downloads - the
    # transaction sits at status="download-complete" and no boot applies it - while `dnf5 offline
    # reboot` (arming) flips it to "ready" and creates /system-update, the only thing systemd's
    # system-update-generator looks for. Arming HERE, not at the restart click, is what makes the
    # promise true: once staged, ANY restart installs. One pkexec flow covers both calls, since
    # auth_admin_keep still holds seconds later.
    # The three statuses below are read with `|| rc=$?` rather than inside an `if`, because exit 3
    # (KEMPT_APPLY_REFUSED) is an answer of its own: the root helper found a release upgrade, a
    # file it could not read, or a dnf5 folder other users can change, and changed nothing. Every
    # path that sees it skips the unwind.
    local stage_rc=0 arm_rc=0 clean_rc=0
    # What is stored now, and where the log ends, both read just before the stage: the only way to
    # tell afterwards whether a stage that exited 0 stored anything over a transaction already
    # there (see offline_stored_fingerprint).
    local pre_stage_fp stage_log_sz=0
    pre_stage_fp="$(offline_stored_fingerprint)"
    [[ -f "$log" ]] && stage_log_sz="$(stat -c %s "$log" 2>/dev/null || echo 0)"
    apply_with_retry "$log" apply_asking dnf-offline-stage "${excl[@]}" || stage_rc=$?
    if [[ $stage_rc -eq $KEMPT_APPLY_REFUSED ]]; then
      dnf_status="failed"; status="failed"
      reason_override="$(refusal_words "$log" "nothing was prepared" "$(apply_refusal_reason) and preparing updates would replace it")"
      log_event "Staging was refused by Kempt's system helper"
    elif [[ $stage_rc -eq 0 ]]; then
      # `dnf5 upgrade --offline` exits 0 and stores NOTHING when the transaction would be empty:
      # every pending update held, or nothing pending at all. Arming then fails with "No offline
      # transaction is stored", and calling THAT "staged but could not arm" blames the arm for a
      # transaction that was never built - a run reported as failed, rc 1, over the user's own
      # holds doing exactly what they asked. Nothing was staged, nothing needed to be, and the run
      # succeeded.
      # Asked of dnf5 rather than inferred from the count this run measured: the count can be
      # stale by the time the stage runs, and dnf5's own answer cannot.
      if [[ "$(offline_system_status)" == absent ]]; then
        staged_nothing=true; dnf_status="ok"
        log_nothing_to_stage "$held_dnf"
      elif [[ -n "$pre_stage_fp" && "$(offline_stored_fingerprint)" == "$pre_stage_fp" ]] \
           && grep -qE '^[[:space:]]*Nothing to do\.?[[:space:]]*$' < <(tail -c +$(( stage_log_sz + 1 )) "$log" 2>/dev/null); then
        # The same empty stage, over a transaction that was ALREADY stored: dnf5 says "Nothing to
        # do.", exits 0, and keeps the old transaction byte for byte, still armed. Arming it again
        # and calling that a restage would install, on the next restart, every package the user
        # has just held. Both signals are required - dnf5's words in THIS stage's output, and the
        # stored files untouched - so a real stage is never mistaken for an empty one.
        # The old transaction goes, through the clean the unwinds below already use, and the run
        # ends exactly as an empty stage over nothing does.
        # Behind another updater's /system-update the clean is skipped: it would remove that
        # symlink too and cancel the other updater's restart install, and the old transaction
        # cannot install behind it anyway.
        local nothing_foreign=false
        if [[ "$(offline_link_state)" == other ]]; then
          nothing_foreign=true
        else
          apply_with_retry "$log" priv_apply dnf-offline-clean || clean_rc=$?
        fi
        if [[ "$nothing_foreign" == true ]]; then
          staged_nothing=true; dnf_status="ok"
          log_nothing_to_stage "$held_dnf"
          log_event "Staged update left in place (another updater has prepared the next restart)"
        elif [[ $clean_rc -eq 0 ]]; then
          staged_nothing=true; stage_discarded=true; dnf_status="ok"
          log_nothing_to_stage "$held_dnf"
          log_event "Staged update discarded (the stored one would have installed what is now held)"
        elif [[ $clean_rc -eq $KEMPT_APPLY_REFUSED ]]; then
          dnf_status="failed"; status="failed"
          reason_override="nothing new was prepared, and the earlier updates were left in place because $(apply_refusal_reason). See: kempt doctor"
        else
          dnf_status="failed"; status="failed"
          reason_override="nothing new was prepared, and the earlier updates could not be removed, so they still install on the next restart, held packages included. See: kempt doctor"
        fi
      elif { apply_with_retry "$log" priv_apply dnf-offline-arm || arm_rc=$?; [[ $arm_rc -eq $KEMPT_APPLY_REFUSED ]]; }; then
        # Refused as root: what is stored now is not the transaction this run built (a release
        # upgrade replaced it), or cannot be read. No unwind - the clean would be refused for the
        # same reason, and it would target the wrong transaction if it were not.
        dnf_status="failed"; status="failed"
        reason_override="$(refusal_words "$log" "the updates were downloaded, but not set to install on the next restart" "$(apply_refusal_reason)")"
      elif [[ $arm_rc -ne 0 ]]; then
        dnf_status="failed"; status="failed"
        reason_override="the updates were downloaded, but could not be set to install on the next restart"
        # Unwind, or the box keeps a downloaded transaction nothing can apply while every later
        # check, doctor run and popup promises an install forever. Best-effort, and a cleanup
        # that also fails must not overwrite the reason with its own.
        # Behind another updater's /system-update the clean is skipped, as on the supersede path:
        # it would remove that symlink and cancel the other updater's restart install.
        if [[ "$(offline_link_state)" == other ]]; then
          # The download is stored and will not install: dnf5 makes /system-update only when it
          # is absent. The words match apply_refusal_reason's for the same link.
          reason_override="the updates were downloaded, but another updater has prepared the next restart, so they will not install then. Try again after the restart"
          log_event "Staged update left in place (another updater has prepared the next restart)"
        else
          apply_with_retry "$log" priv_apply dnf-offline-clean || clean_rc=$?
        fi
        if [[ $clean_rc -eq $KEMPT_APPLY_REFUSED ]]; then
          # Never "run: sudo dnf5 offline clean" here: that is the command the refusal protects against.
          log_warn "$log" "warning: the staged update that could not be set to install was left in place because $(apply_refusal_reason). See: kempt doctor"
          notify_tail=". The stored transaction was left in place. See: kempt doctor"
        elif [[ $clean_rc -ne 0 ]]; then
          log_warn "$log" "warning: could not discard the staged update that could not be set to install. See: kempt doctor"
          # Escalated past stderr because this is state (d): the toml and the boot symlink
          # now disagree and only root can settle it. The reason stays the ARM - the step
          # that failed - so the command travels on the notification instead.
          notify_tail=". These updates could not be removed. See: kempt doctor"
        fi
      else
        # Staged and armed.
        dnf_status="ok"
        # A rebuild that worked. The "Staged N updates" line below reports the new transaction; this line
        # reports that there was an old one, and what it was replaced for.
        if [[ "$had_stage" == true ]]; then
          log_event "Staged update rebuilt${prev_conflict:+ (holds: $(printf '%s\n' "$prev_conflict" | names_phrase))}"
        fi
      fi
    else
      dnf_status="failed"; status="failed"
      # Unwind a failed STAGE too, not only a failed arm (invariant I3): consenting to a rebuild
      # forfeits the old transaction the instant the re-stage begins, so every failure path here
      # must land in "nothing staged, and the user told" - never "the old one is gone and nothing
      # says so". `dnf5 offline clean` is idempotent, so this is best-effort like the arm's.
      if [[ "$had_stage" == true ]]; then
        if [[ "$(offline_system_status)" == ready && "$(offline_link_state)" == other ]]; then
          # The same untouched transaction, behind another updater's symlink. The clean below would
          # remove that symlink too and cancel the other updater's restart install, so nothing is
          # unwound, and the sentence says what the next restart does.
          reason_override="could not replace the prepared updates. The earlier ones are unchanged, but another updater has prepared the next restart, so they will not install then"
          log_event "Rebuilding the staged update failed (previous stage intact)"
        elif [[ "$(stage_read)" == armed ]]; then
          # dnf5 failed BEFORE replacing the previous transaction: a download that cannot complete
          # leaves the armed one untouched, toml and symlink included. Nothing to unwind, and a
          # clean would throw away a stage the user still counts on.
          # BOTH halves of armed, never the status alone: any live dnf5 transaction removes
          # /system-update and leaves the toml at `ready`, and that stage installs on no restart.
          # It is stale, and takes the clean below like any other leftover.
          reason_override="could not replace the prepared updates. The earlier ones are unchanged and still install on the next restart"
          log_event "Rebuilding the staged update failed (previous stage intact)"
        elif [[ "$(offline_link_state)" == other ]]; then
          # dnf5 replaced the previous transaction before failing. The clean would remove another
          # updater's /system-update and cancel its restart install.
          reason_override="could not replace the prepared updates, and the earlier ones are gone. Another updater has prepared the next restart. Try again after that restart"
          log_event "Rebuilding the staged update failed (stage left in place, another updater has prepared the next restart)"
        elif { apply_with_retry "$log" priv_apply dnf-offline-clean || clean_rc=$?; [[ $clean_rc -eq 0 ]]; }; then
          reason_override="the earlier updates were removed and could not be prepared again"
          log_event "Staged update discarded (rebuild failed)"
        elif [[ $clean_rc -eq $KEMPT_APPLY_REFUSED ]]; then
          reason_override="could not replace the prepared updates, and what is stored was left in place because $(apply_refusal_reason). See: kempt doctor"
        else
          reason_override="the earlier updates were removed and could not be prepared again or cleaned up. See: kempt doctor"
        fi
      fi
    fi
  else
    # The two reads that make a live run identifiable, taken as close around the apply as they can
    # be. The command is rebuilt exactly as the root helper builds it (`/usr/bin/dnf5 upgrade` then
    # -y then the excludes, libexec/kempt-apply), because that is the command line dnf5 records,
    # argv[0] and all; the suite takes it from the helper itself, so the two cannot drift apart
    # unnoticed.
    local live_before="" live_cmd live_att
    live_before="$(dnf_history_max_id)" || live_before=""
    local -a live_argv=(/usr/bin/dnf5 upgrade -y "${excl[@]}")
    live_cmd="${live_argv[*]}"
    local live_rc=0 live_status live_was_status="$status" live_was_failed="$run_failed_otherwise"
    [[ "$dnf_apply_skipped" == true ]] \
      || apply_with_retry "$log" apply_asking dnf-upgrade "${excl[@]}" || live_rc=$?
    if [[ $live_rc -eq 0 ]]; then
      dnf_status="ok"
    else
      dnf_status="failed"; status="failed"
      # The helper refuses a live upgrade over dnf5's folders. Nothing ran.
      if [[ $live_rc -eq $KEMPT_APPLY_REFUSED ]]; then
        reason_override="$(refusal_words "$log" "nothing was installed" "$(apply_unsafe_words "dnf's folders")")"
        log_event "The update was refused by Kempt's system helper"
      fi
    fi
    # Asked whatever the run's status: a failed transaction dnf5 recorded is still the transaction
    # this run was, and its packages are still the honest report of what moved.
    if [[ -n "$live_before" ]] && live_att="$(live_history_attribution "$live_before" "$live_cmd")"; then
      live_txid="${live_att%%$'\n'*}"
      live_att="${live_att#*$'\n'}"; live_status="${live_att%%$'\n'*}"
      if [[ "$live_att" == *$'\n'* ]]; then live_keep="${live_att#*$'\n'}"; fi
      # dnf5's history names this run's transaction, and its status is the tiebreaker both ways.
      # Ok over a helper that failed: the run's earlier state comes back. Only for an exit that can
      # follow a dnf5 that ran: 1 (dnf5's own failure), 255 (dnf5 killed) and 128 and up (stopped by
      # a signal). Never 2 or 3, the helper turning the run away, nor pkexec's 126 and 127: nothing
      # ran, so the entry would be another run's.
      # Anything but Ok under a helper that said 0: dnf5 recorded a failure its exit did not show. A
      # status Kempt cannot read (`unknown`) leaves the helper's answer as it is.
      # Either way the log says where the answer came from.
      if [[ "$live_status" == Ok ]] && (( live_rc == 1 || live_rc >= 128 )); then
        dnf_status="ok"; status="$live_was_status"; run_failed_otherwise="$live_was_failed"
        log_event "The update succeeded, as dnf's history records (transaction $live_txid)"
      elif [[ $live_rc -eq 0 && "$live_status" != Ok && "$live_status" != unknown ]]; then
        dnf_status="failed"; status="failed"
        [[ -n "$reason_override" ]] || reason_override="dnf5 recorded this update as failed in its history, though the update seemed to finish"
        log_event "The update failed, as dnf's history records (transaction $live_txid: $live_status)"
      fi
    fi
  fi

  # Fail closed: a dnf path above that set neither answer must not be reported, staged or summed
  # as a success.
  if [[ "$dnf_status" != ok && "$dnf_status" != failed ]]; then
    dnf_status="failed"; status="failed"; run_failed_otherwise=1
  fi

  # flatpak (live even when dnf staged offline - flatpak has no offline mechanism)
  # Runtimes are counted, itemized and updated alongside the apps: `flatpak update` with no ref
  # updates both, so the check asks about both and the summary reports both.
  local fp_status=skipped fp_scopes=null   # apply_flatpak_updates writes these; see its header
  apply_flatpak_updates
  # snapshots (after) + reports
  # Reports must never crash cmd_update after the system already changed - degrade to empty +
  # warning, snapshot as well as diff: the run is over either way, and the history entry (with the
  # notification that carries it) must still be written.
  # `if fn; then` disables errexit inside fn, so both snapshot functions return status explicitly.
  # An empty after-snapshot is NOT usable as a diff input: it reports every package REMOVED.
  local empty_report='{"updated":[],"added":[],"removed":[]}'
  # snapshots_ok gates discarding a superseded stage below and NOTHING else. A snapshot that dies
  # mid-stream leaves a TRUNCATED but non-empty dnf-after.tsv (the redirection creates the file
  # before the command runs) - harmless as a report input, and no evidence the rpm database moved.
  local dnf_report="$empty_report" fp_report="$empty_report" snapshots_ok=true
  if dnf_installed_lookup > "$SNAP_DIR/dnf-after.tsv"; then
    dnf_report="$(tsv_diff_updates "$SNAP_DIR/dnf-before.tsv" "$SNAP_DIR/dnf-after.tsv")" \
      || { dnf_report="$empty_report"; snapshots_ok=false; log_warn "$log" "warning: dnf report diff failed, so the summary is incomplete. See the snapshots in $SNAP_DIR"; }
  else
    snapshots_ok=false
    log_warn "$log" "warning: dnf snapshot after the run failed, so the summary is incomplete. The update itself is unaffected"
  fi
  # Exact attribution, when dnf5's history named the transaction: the report keeps only what that
  # transaction touched, so a package something else moved between the two snapshots is not reported
  # as part of this run. An empty list of names is a filter that could not be built, not a run that
  # changed nothing.
  if [[ -n "$live_txid" && -n "$live_keep" ]]; then
    dnf_report="$(report_keep_names "$dnf_report" "$live_keep")"
  fi
  if is_true "$include_fp"; then
    # A per-user set unreadable only now: the report covers the system apps, and is compared with
    # the system rows of the before-snapshot, so the per-user apps are not reported removed.
    local fp_before="$SNAP_DIR/fp-before.tsv" fp_after_ok=true
    if ! flatpak_snapshot > "$SNAP_DIR/fp-after.tsv"; then
      if flatpak_user_present && flatpak_snapshot system > "$SNAP_DIR/fp-after.tsv"; then
        fp_before="$SNAP_DIR/fp-before-system.tsv"
        { grep -v "^$KEMPT_FLATPAK_USER_KEY" "$SNAP_DIR/fp-before.tsv" || true; } > "$fp_before"
        log_warn "$log" "warning: the apps for you only could not be listed after the run, so the summary leaves them out"
        # The per-user apps that did update are missing from the summary, so the run does not say
        # all went well. The jq only changes the recorded outcome: one that fails keeps the old one.
        # Only a run that was otherwise fine takes this reason: an earlier failure keeps its own.
        [[ "$status" == ok ]] \
          && reason_override="${reason_override:-the apps for you only could not be listed after the run, so the summary leaves them out}"
        # Not a lock: a busy system scope beside this exits 1, not 7.
        fp_status="failed"; status="failed"; run_failed_otherwise=1
        local fp_scopes_after
        if fp_scopes_after="$(jq -cS '(. // {}) + {user: "failed"}' <<<"$fp_scopes" 2>/dev/null)" \
           && [[ -n "$fp_scopes_after" ]]; then
          fp_scopes="$fp_scopes_after"
        fi
      else
        fp_after_ok=false
      fi
    fi
    if [[ "$fp_after_ok" == true ]]; then
      fp_report="$(tsv_diff_updates "$fp_before" "$SNAP_DIR/fp-after.tsv" | flatpak_report_scopes)" \
        || { fp_report="$empty_report"; log_warn "$log" "warning: flatpak report diff failed, so the summary is incomplete"; }
    else
      log_warn "$log" "warning: flatpak snapshot after the run failed, so the summary is incomplete"
    fi
  fi
  # ONE reboot mechanism, owned by the backend: dnf_reboot_needed carries the verdict rule and the
  # -C / --disablerepo / </dev/null hardening (an uncached needs-restarting does network I/O and
  # can prompt on stdin, and this runs from detached surfaces where nobody can answer). Its seam
  # is KEMPT_DNF_CMD. Shape guard: see the twin in cmd_check.
  reboot="$(dnf_reboot_needed)"
  [[ "$reboot" == "true" || "$reboot" == "false" ]] || reboot=false

  # How many updates this stage holds, from dnf5's own list when it can be read: the check beforehand
  # ran on metadata the stage may have refreshed. The run's "Staged N updates" event line reports it.
  local staged="" staged_names
  if [[ "$surface" == offline && "$dnf_status" == ok && "$staged_nothing" != true ]]; then
    if staged_names="$(offline_txjson_names)" && [[ -n "$staged_names" ]]; then
      staged="$(printf '%s\n' "$staged_names" | grep -c .)" || staged=""
    else
      staged="$staged_fresh"
    fi
  fi
  # Why it failed, worked out ONCE and handed to everything that renders it: the history entry
  # (and through it the summary), the notification, and the event log. "See <log>" is no answer
  # when the log is four hundred lines of dnf progress.
  local reason=""
  [[ "$status" == "ok" ]] || reason="${reason_override:-$(run_failure_reason "$log")}"
  # dnf's busy sentence says nothing was installed, which stops being true once Flatpak changed
  # something in the same run. That sentence goes, and the rest stays the busy reason.
  if [[ -n "$run_busy_reason" && "$run_busy_reason" == "$KEMPT_BUSY_REASON_DNF" ]] \
     && jq -e '([.updated, .added, .removed] | map(length) | add) > 0' <<<"$fp_report" >/dev/null 2>&1; then
    local busy_fp="${KEMPT_BUSY_REASON_DNF/ Nothing was installed./}"
    [[ "$reason" == "$run_busy_reason" ]] && reason="$busy_fp"
    run_busy_reason="$busy_fp"
  fi
  # The exit code. 7 only when the reason given is the busy sentence and nothing else failed, so a
  # script can wait and try again; any other failure is 1.
  local run_rc=0
  if [[ "$status" != "ok" ]]; then
    run_rc=1
    if [[ -n "$run_busy_reason" && "$reason" == "$run_busy_reason" ]]; then
      if [[ -z "$run_failed_otherwise" ]]; then
        run_rc=7
      else
        # Busy, and something else failed too: trying again alone would not fix the run, so the
        # reason says so in place of "Try again".
        reason="${reason%" $KEMPT_BUSY_TRY_AGAIN"} $KEMPT_BUSY_ALSO_FAILED"
      fi
    fi
  fi

  # history entry
  local held_dnf_json held_fp_json hist="$HIST_DIR/$ts.json" hist_tmp
  hist_tmp="$(mktemp 2>/dev/null || true)"
  held_dnf_json="$(holds_for dnf | jq -Rn '[inputs]')"
  held_fp_json="$(holds_for flatpak | jq -Rn '[inputs]')"
  # The two reports come through FILES for the reason assemble_state does: they scale with the
  # transaction, argv caps a single entry at 128 KiB, and THIS site is on the far side of the
  # update. An E2BIG here kills the run after dnf5 has installed everything - no history entry, no
  # summary, no notification, no run-done event, and no post-run check, which is the only thing
  # that takes the popup out of its updating state. A successful 1,200-package update presented as
  # a spinner for three hours.
  # ...and the files themselves are a nicety too. A full /tmp here used to end the run under
  # errexit with the same cost; now it costs the entry, through the same `hist_tmp=""` degrade the
  # jq below takes, and the run goes on to its event line and its closing check.
  local dnf_rep_f="" fp_rep_f=""
  if ! { dnf_rep_f="$(mktemp 2>/dev/null)" && fp_rep_f="$(mktemp 2>/dev/null)" \
         && printf '%s' "$dnf_report" 2>/dev/null > "$dnf_rep_f" \
         && printf '%s' "$fp_report" 2>/dev/null > "$fp_rep_f"; }; then
    rm -f ${hist_tmp:+"$hist_tmp"}; hist_tmp=""
  fi
  # Floored at 0: a clock stepped backwards during the run (NTP correcting a fast clock, a resume
  # across a time change) puts the end before the start, and a negative duration is not a
  # measurement. Every reader would otherwise print it as "in -287s".
  local run_dur=$(( $(date +%s) - start ))
  (( run_dur >= 0 )) || run_dur=0
  # WHY nothing was staged, for the surfaces that report this run afterwards. The event line and
  # the notification already say it (both branch on `staged_nothing` above), but they are spoken
  # once and gone; the entry is what the popup's post-run line and its last-update row are rendered
  # from, and those two had only `surface` and `status` to go on. A run that staged nothing is
  # `offline` and `ok`, exactly like one that staged sixty packages, so both said "Updates are
  # staged - they install on the next restart" over a restart that will install nothing.
  #
  # Written ONLY when it happened, never as `false` or `null`: an entry from a build before this
  # field cannot be told apart from one that staged properly, so absence has to keep meaning what
  # it means today. Which of the two reasons it was is the difference between "Kempt did nothing"
  # and "your holds did what you asked" - the first reads as a fault - and it is the same
  # distinction, in the same words, that the notification below makes.
  # A stage that worked behind another updater's symlink: dnf5 makes /system-update only when it is
  # absent, so the arm succeeded and the next restart still installs the other updater's set. The
  # entry says so, or history and summary read "staged for the next restart" over a restart that
  # installs none of it. Keyed on the dnf half, as the staged phrase is: a failed Flatpak half
  # does not undo the stage. Written only when it happened.
  local stage_link_other=false
  if [[ "$surface" == offline && "$dnf_status" == ok && "$staged_nothing" != true \
        && "$(offline_link_state)" == other ]]; then
    stage_link_other=true
  fi
  local staged_nothing_why=""
  if [[ "$surface" == "offline" && "$status" == "ok" && "$staged_nothing" == true ]]; then
    if [[ -n "$held_dnf" ]]; then staged_nothing_why=held; else staged_nothing_why=nothing_pending; fi
  fi
  # `transaction_id` is additive and top-level, exactly as the restart report writes it: the id
  # `dnf5 history info` takes, present only when dnf5's history named the transaction.
  jq -n --arg ts "$(now_iso)" --arg surface "$surface" --arg status "$status" \
        --arg staged_nothing_why "$staged_nothing_why" --arg staged_n "$staged" \
        --arg link_other "$stage_link_other" \
        --arg log "$log" --argjson dur "$run_dur" --arg txid "$live_txid" \
        --argjson reboot "$reboot" --arg error "$reason" \
        --slurpfile dnfa "$dnf_rep_f" --arg dnf_status "$dnf_status" --argjson dnf_held "$held_dnf_json" \
        --slurpfile fpa "$fp_rep_f" --arg fp_status "$fp_status" --argjson fp_held "$held_fp_json" \
        --argjson fp_scopes "$fp_scopes" \
        --arg fb "$startup_base" '
    ($dnfa[0]) as $dnf | ($fpa[0]) as $fp |
    {timestamp:$ts, surface:$surface, status:$status, duration_sec:$dur,
     reboot_needed:$reboot, log:$log, error:$error,
     backends: {
       dnf:     ($dnf | . + {status:$dnf_status, skipped_held:$dnf_held}),
       flatpak: ($fp  | . + {status:$fp_status,  skipped_held:$fp_held}
                      + (if $fp_scopes == null then {} else {scopes: $fp_scopes} end)) }}
    + (if $txid == "" then {} else {transaction_id: ($txid | tonumber)} end)
    + (if $staged_nothing_why == "" then {} else {staged_nothing: $staged_nothing_why} end)
    + (if $link_other == "true" then {stage_blocked: true} else {} end)
    + (if ($staged_n | test("^[1-9][0-9]*$")) then {staged: ($staged_n | tonumber)} else {} end)
    + (if $fb == "" then {} else {failed_before: ($fb | fromjson)} end)' > "$hist_tmp" \
    || { rm -f ${hist_tmp:+"$hist_tmp"}; hist_tmp=""; }
  # Removed whatever happened above: an unguarded write here used to take the whole run down on a
  # full home, on the far side of an update that had already installed everything - no summary, no
  # notification, no run-done event and no post-run check, which is the only thing that takes the
  # widget out of its updating state. A successful update presented as a spinner that never stops.
  rm -f ${dnf_rep_f:+"$dnf_rep_f"} ${fp_rep_f:+"$fp_rep_f"}
  # Built beside the run and INSTALLED into the history, rather than written there directly. What a
  # failure costs is then only the durable record: everything below reads this file to render the
  # summary, the notification and the run-done count, and rendering from the copy that was built
  # keeps the person in front of the machine told. `kempt history` is what will not have it.
  if [[ -n "$hist_tmp" ]] && cp "$hist_tmp" "$hist" 2>/dev/null; then
    rm -f "$hist_tmp"; hist_tmp=""
  else
    # "the run itself", not "the update": on the offline surface nothing has been installed - a
    # transaction was staged, and it installs on the next restart. This line is printed on both.
    log_warn "$log" "warning: the run finished, but it could not be added to the history"
    log_event "Update history not saved (state directory unwritable?)"
    rm -f "$hist"
    hist="$hist_tmp"     # possibly empty; every reader below already tolerates that
  fi

  # A successful OFFLINE run gets its own event line rather than "Update finished": nothing has been
  # applied yet, and the check after the restart is what reports it.
  if [[ "$status" == "ok" ]]; then
    if [[ "$surface" == "offline" ]]; then
      # Not when nothing was staged: "Staged ? updates" over a run that logged "Nothing to stage"
      # is two lines contradicting each other about the same second.
      if [[ "$staged_nothing" != true ]]; then
        local noun=updates
        [[ "$staged" != 1 ]] || noun=update
        log_event "Staged ${staged:-?} $noun for a restart"
      fi
    else
      local upd
      upd="$(jq -r '[.backends[].updated | length] | add // 0' "$hist" 2>/dev/null)" || upd="?"
      log_event "Update finished: $upd updated$([[ "$reboot" != true ]] || echo ", restart needed")"
    fi
  else
    # The same rc this command exits with (the return at the bottom).
    log_event "Update failed (exit code $run_rc): $reason"
  fi

  # The same stage, for the warning: only on a run that succeeded.
  if [[ "$status" == ok && "$stage_link_other" == true ]]; then
    log_warn "$log" "warning: another updater has prepared the next restart, so the updates staged here will not install then. See: kempt doctor"
  fi

  reconcile_stage_after_live_run
  # AFTER the reconciliation above, which is what decides whether a stage still stands, and BEFORE
  # the check below, which is the slow half. The check publishes this too; this is the same fact,
  # tens of seconds earlier, so no surface spends that window offering to stage what is already
  # staged. See publish_staged_state.
  # ...and BEFORE the notification below: the widget leaves its busy state when state.json moves,
  # so a notification that went out first had the popup still busy beside "Updates are staged".
  # Neither reads anything the summary or the notification writes.
  publish_staged_state

  # tell the human. Both readers take the entry as a FILE, and on the one path where neither the
  # history nor a temp file could be written there is no file to give them - so they are skipped
  # rather than handed a path that does not exist, which would end the run here on jq's rc. The
  # notification below still goes out; it just cannot carry the counts.
  [[ -n "$hist" ]] && render_summary "$hist"
  if [[ "$at_terminal" != true ]]; then
    # Same truth as the summary: a run that installed and removed packages is never "0 updated".
    local phrase=""
    [[ -n "$hist" ]] && phrase="$(run_counts_phrase "$hist")"
    # ORDER: a failed offline run takes the failure branch, not the staged one. "Installs on the
    # next restart" is a claim about the future, and a stage that was discarded has none.
    if [[ "$surface" == "offline" && "$status" == "ok" && "$staged_nothing" == true ]]; then
      # Nothing was staged, so there is nothing to install on any restart. Saying which of the two
      # reasons it was is the difference between "Kempt did nothing" and "your holds did what you
      # asked": the first reads as a fault.
      local discarded_tail=""
      [[ "$stage_discarded" == true ]] && discarded_tail=". The updates prepared earlier were removed"
      if [[ -n "$held_dnf" ]]; then
        notify "Kempt" "Every waiting update is held, so the next restart has nothing to install$discarded_tail"
      else
        notify "Kempt" "No updates are waiting, so the next restart has nothing to install$discarded_tail"
      fi
    elif [[ "$status" == ok && "$stage_link_other" == true ]]; then
      notify "Kempt" "Updates are ready, but another updater has prepared the next restart, so they will not install then"
    elif [[ "$surface" == "offline" && "$status" == "ok" ]]; then
      local discover_tail=""
      discover_offer_pending && discover_tail=". Discover's update check can cancel this, so restart soon or run kempt discover-notifier off"
      notify "Kempt" "Updates are ready and install on the next restart$discover_tail"
    elif [[ "$status" == "ok" ]]; then
      notify "Kempt" "${phrase:-Update finished}$([[ "$reboot" == "true" ]] && echo ', restart needed')"
    else
      # The same reason the summary and the event line carry: "see the log" is not an answer.
      # The widget's Last update row has Show Log for this run.
      notify "Kempt" "Update failed${reason:+: ${reason%.}}$notify_tail. Press Show Log in Kempt, or open $log."
    fi
  fi
  # The copy the summary was rendered from, when it could not be installed into the history.
  [[ -n "${hist_tmp:-}" ]] && rm -f "$hist_tmp"
  # Best-effort self-refresh so a CLI-only user is not left staring at a pending list the run
  # already emptied. Never allowed to change the run's verdict. It takes seconds and prints
  # nothing, so a person watching is told what the pause is.
  # The skip this run set for itself covers its apply and its after-snapshot only. The check asks the
  # per-user installation again, so a listing that still fails is recorded there as failed.
  [[ "$fp_user_unreadable" == true ]] && unset FLATPAK_USER_SKIP
  [[ -t 1 ]] && printf '\nChecking for anything left to update…\n'
  cmd_check >/dev/null 2>&1 || true
  return "$run_rc"
}

# What the widget's "Update now" button calls: pick the surface, then get out of the way.
cmd_run() {
  local dry="" surface a named="" named_set="" risky_arg=""
  # An unrecognised argument must never fall through to a real launch.
  for a in "$@"; do case "$a" in
    --print-command) dry=1 ;;
    # The popup asked about session-critical updates and the person chose Install Now.
    --risky-ok) risky_arg=" --risky-ok" ;;
    # One run on a named surface instead of the configured one. The widget stages through this
    # (`run --surface=offline`) so a stage gets the refusals below - the held lock above all -
    # where the widget can read them, rather than inside a detached `kempt update` whose exit
    # status nobody reads. Strict where the setting is lenient: a stored typo falls back to the
    # widget (resolve_surface), but a surface asked for by name is a request, and guessing at it
    # could turn a stage into a live update. Once only, so there is no "which one wins".
    --surface=*)
      [[ -z "$named_set" ]] || { echo "unknown option: $a (--surface given twice)" >&2; exit 2; }
      named_set=1; named="$(surface_canon "${a#--surface=}")"
      case "$named" in
        popup|offline) ;;
        *) echo "unknown --surface value: ${a#--surface=} (use widget or offline)" >&2; exit 2 ;;
      esac ;;
    *) echo "unknown option: $a" >&2; exit 2 ;;
  esac; done
  if [[ -n "$named_set" ]]; then surface="$named"
  else surface="$(resolve_surface "$(config_get surface)")"; fi

  # Refused HERE, before anything is launched, while another update holds the lock. cmd_update
  # refuses too, but inside a window or a detached shell whose status nobody reads: `run` returned
  # 0, and a second widget (tray and panel both, which the README describes) entered its updating
  # pane for a run that was never going to happen, then claimed the other run's result as its own.
  # This only PROBES the lock. cmd_update still takes it for real, so two presses in the same
  # instant are still settled there. -E picks a status that means "held" and nothing else, so an
  # unreadable lock file is not reported as a running update.
  if [[ -e "$LOCK_FILE" ]]; then
    local lock_rc=0
    flock -n -E 75 "$LOCK_FILE" true 2>/dev/null || lock_rc=$?
    [[ $lock_rc -eq 75 ]] && { echo "An update is already running." >&2; exit 3; }
  fi

  if [[ -n "$dry" ]]; then echo "detached: kempt update --answered$risky_arg (surface=$(surface_word "$surface"))"; return 0; fi
  local self_q surface_q
  printf -v self_q '%q' "$SELF"; printf -v surface_q '%q' "$surface"
  setsid bash -c "$self_q update --answered --surface=$surface_q$risky_arg" >/dev/null 2>&1 &
}

cmd_summary() {  # [N] - 1 = latest (default) | --json - the newest run's entry, verbatim
  # --json exists for the popup, which needs what the last run DID as data. It hands over the
  # history entry and derives nothing: re-deriving would put a second, lossier copy of
  # render_summary's rules in the widget.
  local json=false
  if [[ "${1:-}" == "--json" ]]; then json=true; shift; fi
  # N means nothing to --json, which answers one question, about the last run - and ignoring the
  # stray argument would silently serve the WRONG run under exit 0.
  if [[ "$json" == true ]]; then
    [[ $# -eq 0 ]] || { echo "usage: kempt summary --json  (takes no N)" >&2; exit 2; }
  else
    [[ $# -le 1 ]] || { echo "usage: kempt summary [N] | kempt summary --json" >&2; exit 2; }
  fi
  local n="${1:-1}" f out i files=()
  [[ "$n" =~ ^[1-9][0-9]*$ ]] || { echo "usage: kempt summary [N]  (N >= 1, 1 = latest)" >&2; exit 2; }
  # newest first. `|| true`: an empty history dir makes ls exit 2, which pipefail would turn into
  # a dead command. No runs yet is NOT an error.
  # LC_ALL=C on the sort is NOT redundant with lib/common.sh's pin - do not delete it as such.
  # "Newest" is byte order, and the locales disagree: `20260827T120000-offline.json` (a restart report in
  # the same second as a run) sorts BELOW `20260827T120000.json` under C but ABOVE it under
  # en_US.UTF-8, which ignores punctuation at the first level.
  # `ls` is not parsing names: the SHELL expands the glob, ls is the existence filter, sort orders.
  # shellcheck disable=SC2012
  while IFS= read -r f; do [[ -n "$f" ]] && files+=("$f"); done \
    < <(ls -1 "$HIST_DIR"/*.json 2>/dev/null | LC_ALL=C sort -r || true)
  # Nothing recorded is not an error in either mode. --json says it with EMPTY stdout, this
  # project's "no data" convention - never a fabricated empty run a reader would count.
  if [[ ${#files[@]} -eq 0 ]]; then
    [[ "$json" == true ]] || echo "no update runs recorded yet"
    exit 0
  fi
  i=$(( n - 1 ))
  if (( i >= ${#files[@]} )); then   # N past the end → oldest, and SAY so
    i=$(( ${#files[@]} - 1 ))
    echo "note: only ${#files[@]} run(s) recorded, so this is the oldest" >&2
  fi
  # --json answers about ONE run - the newest - and deliberately never walks back to the one
  # underneath, though the human branch below does: the widget asks what the run that just
  # finished DID, and an older entry would be announced as that run. A damaged newest entry is
  # therefore empty stdout under exit 0, the "no data" convention.
  # `cat`, not jq's rendering, so the caller gets exactly what the run recorded - fields this
  # build has never heard of included. Hence the strict guard, since whatever it waves through
  # reaches the widget's JSON.parse:
  #   [inputs] | length == 1   house idiom (see cmd_check) - a MULTI-DOCUMENT file is valid jq
  #     input, so `jq -e .` passes it and `cat` then emits two documents.
  #   .[0] | type == "object"  `jq -e` fails only on null and false, so `[]`, `42` and
  #     `"a string"` would pass here while render_summary below refuses them.
  if [[ "$json" == true ]]; then
    if jq -e -n '[inputs] | length == 1 and (.[0]|type == "object")' "${files[$i]}" >/dev/null 2>&1; then
      cat "${files[$i]}"; return 0
    fi
    echo "warning: corrupt history entry: ${files[$i]}" >&2
    return 0
  fi
  for (( ; i < ${#files[@]}; i++ )); do
    # One damaged entry must not be the last word the PERSON gets: warn, fall back to the next
    # newest. The -n test is load-bearing - render_summary exits 0 having printed NOTHING for a
    # zero-byte entry, and that must not pass for a successful render.
    if out="$(render_summary "${files[$i]}" 2>/dev/null)" && [[ -n "$out" ]]; then
      printf '%s\n' "$out"
      # Below the run, answering the other question: what is about to happen. Human mode only -
      # a staged transaction belongs to the box, not to the run --json hands over.
      staged_summary_line
      return 0
    fi
    echo "warning: corrupt history entry: ${files[$i]}" >&2
  done
  echo "no update runs recorded yet"
}

cmd_history() {  # [--json]: every run, newest first; --json as one array of history entries
  local json=false
  if [[ "${1:-}" == "--json" ]]; then json=true; shift; fi
  [[ $# -eq 0 ]] || { echo "unknown option: $1" >&2; exit 2; }
  local f row files=()
  # same while-read form as cmd_summary: an unquoted $(ls) splits on whitespace and globs
  # shellcheck disable=SC2012   # shell-expanded glob; ls is the existence filter, sort is the order
  while IFS= read -r f; do [[ -n "$f" ]] && files+=("$f"); done \
    < <(ls -1 "$HIST_DIR"/*.json 2>/dev/null | LC_ALL=C sort -r || true)
  if [[ "$json" == true ]]; then
    # Each element is what `summary --json` prints for that run, behind the same guard: one JSON
    # object per file. A damaged entry is named on stderr and left out. No runs is `[]`.
    # Read once per entry, and the array built from what was read: a file pruned or rewritten by
    # a run in the meantime then costs only its own element, never the command.
    local doc docs=()
    for f in "${files[@]}"; do
      if doc="$(jq -c -e -n '[inputs] | select(length == 1 and (.[0]|type == "object")) | .[0]' "$f" 2>/dev/null)" \
         && [[ -n "$doc" ]]; then
        docs+=("$doc")
      elif [[ -e "$f" ]]; then
        echo "warning: corrupt history entry: $f" >&2
      fi
    done
    printf '%s\n' ${docs[@]+"${docs[@]}"} | jq -n '[inputs]' 2>/dev/null || echo '[]'
    return 0
  fi
  local phrase err
  for f in "${files[@]}"; do
    # capture before printing: a damaged entry must not emit half a row, nor take the whole
    # listing down - every other run is still perfectly readable.
    # history_phrase counts installs and removals as well as upgrades, and names what a staging
    # run staged.
    if row="$(jq -r "$KEMPT_JQ_COUNTS"'[.timestamp, surface_label, .status] | join("  ")' "$f" 2>/dev/null)" \
       && [[ -n "$row" ]] \
       && phrase="$(history_phrase "$f" 2>/dev/null)" && [[ -n "$phrase" ]]; then
      # The reason, on the rows that have one, or a failed row sends the reader to a log file
      # to learn the authentication dialog was closed. `// ""` keeps older entries rendering the
      # same.
      err="$(jq -r '.error // ""' "$f" 2>/dev/null || true)"
      printf '%s  %s%s\n' "$row" "$phrase" "${err:+  ($err)}"
    else
      echo "warning: corrupt history entry: $f" >&2
    fi
  done
  # No entries at all is still an answer, in the words `kempt summary` uses: empty output reads as
  # the command having failed. Only when there are no entry files: over entries that all failed to
  # read, "no update runs recorded" would be false, and the warnings above already say what is wrong.
  (( ${#files[@]} )) || echo "no update runs recorded yet"
}

status_last_run() {  # now-epoch → "Last update ..." for the newest history entry, or nothing
  local f files=() line phrase failed
  # The listing cmd_summary uses, and its reasons (byte order, ls as the existence filter).
  # shellcheck disable=SC2012
  while IFS= read -r f; do [[ -n "$f" ]] && files+=("$f"); done \
    < <(ls -1 "$HIST_DIR"/*.json 2>/dev/null | LC_ALL=C sort -r || true)
  # The newest entry only, as `summary --json` and the widget read it: a damaged newest entry gets no
  # line, never an older run passed off as the last one.
  f="${files[0]:-}"
  [[ -n "$f" ]] || return 0
  # An entry that cannot be dated gets no line, as in the widget's Last update row.
  line="$(jq -r -n --argjson now "$1" "$KEMPT_JQ_TIME"'
            [inputs] | select(length == 1 and (.[0] | type == "object")) | .[0]
            | select(.timestamp | renderable_stamp)
            | (.timestamp | rel_time($now)) + "\u001f" + (if .status == "ok" then "" else "failed" end)' \
            "$f" 2>/dev/null)" || line=""
  [[ -n "$line" ]] || return 0
  phrase="$(history_phrase "$f" 2>/dev/null)" || phrase=""
  [[ -n "$phrase" ]] || return 0
  # The stage this names may still be stored, and a restart would not install it now.
  if [[ "$phrase" == *" for a restart" ]]; then
    case "$(stage_read)" in
      other) phrase="${phrase% for a restart}, but another updater has since prepared the next restart" ;;
      lost|interrupted) phrase="${phrase% for a restart}, but no restart will install them now" ;;
      armed) ;;
      *) phrase="${phrase% for a restart}" ;;
    esac
  fi
  failed="${line#*$'\x1f'}"
  printf 'Last update %s · %s%s\n' "${line%%$'\x1f'*}" "$phrase" "${failed:+ · failed}"
}

# kempt status --list: the rows that take the place of the sections and the Held line, as the
# widget lists them (list_records). One name column for the whole list, as wide as the longest name
# up to 40 characters; a longer name prints whole and pushes its versions along. Nothing is cut and
# nothing depends on the terminal, so a pipe gets the same text a person does.
status_list_rows() {  # state-json → the lines
  local rows tag a b c width=0 pad line
  rows="$(jq -r -n "$KEMPT_JQ_STATUS"'[inputs][0] | list_records' <<<"${1:-null}" 2>/dev/null)" || rows=""
  while IFS=$'\x1f' read -r tag a b c; do
    [[ "$tag" == I ]] && (( ${#a} > width )) && width=${#a}
  done <<<"$rows"
  (( width > 40 )) && width=40
  while IFS=$'\x1f' read -r tag a b c; do
    case "$tag" in
      S) if [[ "$a" == Held ]]; then printf 'Held: %s\n' "$b"
         elif [[ "$b" == 1 ]]; then printf '%s: 1 update\n' "$a"
         else printf '%s: %s updates\n' "$a" "$b"; fi ;;
      I) line="  $a"
         if [[ -n "$b$c" ]]; then
           pad=$(( width - ${#a} )); (( pad < 0 )) && pad=0
           line+="$(printf '%*s' "$pad" '')  $b${c:+  $c}"
         fi
         # A row with marks and no versions would otherwise carry the gap meant for them.
         line="${line%"${line##*[! ]}"}"
         printf '%s\n' "$line" ;;
    esac
  done <<<"$rows"
  return 0
}

cmd_status() {  # [--json] [--list]: what the last check found, in words; reads only
  local json=false list=false
  while (( $# )); do
    case "$1" in
      --json) json=true ;;
      --list) list=true ;;
      *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
    shift
  done
  # The state is read once, with the house idiom: the first document, and only if it is an object.
  # A missing, empty or half-written file is no state. No lock is taken and nothing is written, so
  # status answers while a check or an update runs.
  local doc
  doc="$(jq -c -n '[inputs][0] | select(type == "object")' "$STATE_FILE" 2>/dev/null)" || doc=""
  # The stage is read now and not taken from the last check: another updater can take dnf5's restart
  # link between checks, and "ready for the next restart" is the line a person restarts on.
  local stage_word stage_problem
  stage_word="$(stage_read)"
  stage_problem="$(offline_stage_problem_of "$stage_word")" || stage_problem=""
  if [[ -n "$doc" ]]; then
    doc="$(jq -c --arg armed "$stage_word" --arg p "$stage_problem" '
             (if $armed == "armed" then . else del(.offline_staged) end)
             | if $p == "" then del(.offline_stage_problem) else .offline_stage_problem = $p end' <<<"$doc")"
  fi
  # --list adds nothing to --json: the state already carries every row, so the two together print
  # the same document and no second JSON shape exists for scripts to depend on.
  if [[ "$json" == true ]]; then
    [[ -n "$doc" ]] || exit 1
    jq . <<<"$doc"
    return 0
  fi
  # KEMPT_NOW (seconds since the epoch) pins the clock for the tests.
  local now="${KEMPT_NOW:-}"
  [[ "$now" =~ ^[0-9]+$ ]] || now="$(date +%s)"
  local records
  records="$(jq -r -n --argjson now "$now" "$KEMPT_JQ_TIME$KEMPT_JQ_STATUS"'
               [inputs][0] | status_records($now)' <<<"${doc:-null}")" \
    || { echo "kempt: could not read the update state" >&2; exit 1; }
  local tag a b header="" detail="" footer="" restart="" holder="" staged=false security="" held="" rc=1
  local -a sections=() held_names=() names=()
  local title="" count=""
  status_flush_section() {
    [[ -n "$title" ]] || return 0
    local word="updates" phrase
    [[ "$count" == 1 ]] && word="update"
    phrase="$(printf '%s\n' ${names[@]+"${names[@]}"} | names_phrase)"
    sections+=("$title: $count $word${phrase:+ for $phrase}")
    title=""; names=()
  }
  while IFS=$'\x1f' read -r tag a b; do
    case "$tag" in
      H) header="$a" ;;
      P) detail="$a" ;;
      S) status_flush_section; title="$a"; count="$b" ;;
      N) names+=("$a") ;;
      L) held="$a" ;;
      M) held_names+=("$a") ;;
      C) security="$a" ;;
      G) staged=true ;;
      R) restart="$a" ;;
      O) holder="$a" ;;
      F) footer="$a" ;;
      X) rc="$a" ;;
    esac
  done <<<"$records"
  status_flush_section
  printf '%s\n' "$header"
  # The same probe Update Now's wrapper makes: another process holds the update lock, which an
  # update, a reclaim and an unstage all take.
  update_running_elsewhere && echo "Kempt is changing the system right now"
  [[ -n "$detail" ]] && printf '%s\n' "$detail"
  local unsafe_folder
  unsafe_folder="$(jq -r '.unsafe_folder | strings' <<<"${doc:-null}" 2>/dev/null)" || unsafe_folder=""
  if [[ -n "$unsafe_folder" ]]; then
    echo "Updates paused for safety: $(apply_unsafe_words "$unsafe_folder"). Run kempt doctor for the fix."
  fi

  # While a stage is armed the pending sections and the security count read as work still waiting,
  # so they give way to the staged line, as they do in the widget's tooltip.
  local -a body=()
  # --list: every row instead of the sections and the Held line, and still while a stage is armed,
  # since the staged line below says those rows are the ones staged.
  if [[ "$list" == true ]]; then
    local row
    while IFS= read -r row; do [[ -n "$row" ]] && body+=("$row"); done < <(status_list_rows "$doc")
  else
    [[ "$staged" == true ]] || body+=(${sections[@]+"${sections[@]}"})
  fi
  if [[ -n "$held" && "$list" != true ]]; then
    local held_phrase
    held_phrase="$(printf '%s\n' ${held_names[@]+"${held_names[@]}"} | names_phrase)"
    body+=("Held: $held${held_phrase:+ ($held_phrase)}")
  fi
  if [[ -n "$security" && "$staged" != true ]]; then
    if [[ "$security" == 1 ]]; then body+=("Security: 1 update"); else body+=("Security: $security updates"); fi
  fi
  if [[ "$staged" == true ]]; then
    local staged_line
    staged_line="$(staged_summary_line /dev/stdin <<<"$doc")"
    [[ -n "$staged_line" ]] && body+=("$staged_line")
  fi
  case "$stage_problem" in
    lost) body+=("Prepared updates: no restart will install them now. To prepare them again, run: kempt update --surface=offline") ;;
    interrupted) body+=("Prepared updates: a restart began installing them and stopped, and no restart will run them again. To prepare them again, run: kempt update --surface=offline") ;;
    failed) body+=("Prepared updates: a restart ran them and dnf5 recorded a failure. See: kempt doctor") ;;
    unknown) body+=("Prepared updates: Kempt cannot tell what the next restart will do. See: kempt doctor") ;;
  esac
  [[ -n "$holder" ]] && body+=("$holder")
  [[ -n "$restart" ]] && body+=("$restart")
  if (( ${#body[@]} )); then echo; printf '%s\n' "${body[@]}"; fi

  local last
  last="$(status_last_run "$now")"
  if [[ -n "$footer" || -n "$last" ]]; then
    echo
    [[ -n "$footer" ]] && printf '%s\n' "$footer"
    [[ -n "$last" ]] && printf '%s\n' "$last"
  fi
  return "$rc"
}

# --- after a restart -------------------------------------------------------------------------------
# What a restart did to a stage is dnf5's record, read here: its history says what ran and how it
# ended, and rpm says what arrived, because the history lists the plan. One small file remembers what
# has been said, so a person is told once. Nothing else about a stage is kept.
#
#   row=<id>    the newest restart's install this box has reported
#   entry=<fp>  the failed stage already written into Kempt's history (offline_stored_fingerprint)
#   told=<fp>   the lost or failed stage a person has been told about
#
# Deleting the file costs at most one repeat. With no file, only an install from the last two days
# is reported, which is what a restart that also upgraded Kempt itself needs: anything older is taken
# as known. A row PackageKit ran has no command line and is not Kempt's to announce.
STAGE_SHOWN_FILE="$KEMPT_STATE_DIR/stage-shown"
KEMPT_STAGE_FRESH_SECS=172800
stage_shown_get() { { sed -n "s/^$1=//p" "$STAGE_SHOWN_FILE" 2>/dev/null || true; } | head -1; }
stage_shown_set() {  # key value
  { grep -v "^$1=" "$STAGE_SHOWN_FILE" 2>/dev/null || true; printf '%s=%s\n' "$1" "$2"; } \
    | atomic_write "$STAGE_SHOWN_FILE"
}

# One row's report in the shape of a run's: what it changed, read from its package list. For a row
# that did not end Ok the list is only the plan, so rpm decides what counts, and `missing` says how
# much of the plan did not arrive.
stage_row_report() {  # id status → {updated, added, removed, missing, seconds}; rc 1 = no answer
  local info have=""
  info="$(dnf_history_json info "$1")" || return 1
  if [[ "$2" != Ok ]]; then
    if [[ -n "$KEMPT_RPM_QA_CMD" ]]; then
      # shellcheck disable=SC2086  # a seam may carry its own arguments
      have="$($KEMPT_RPM_QA_CMD 2>/dev/null)" || return 1
    else
      have="$(rpm -qa --queryformat '%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}\n' 2>/dev/null)" || return 1
    fi
  fi
  jq -ce --argjson id "$1" --arg st "$2" --rawfile have <(printf '%s' "$have") '
    def split_nevra: capture("^(?<n>.+)-(?<e>[0-9]+):(?<v>[^-:]+)-(?<r>[^-:]+)\\.(?<a>[^.-]+)$")
                     | {name: .n, evr: ((if .e == "0" then "" else .e + ":" end) + .v + "-" + .r)};
    ($have | split("\n")) as $h
    | if (.[0].id != $id) or ((.[0].packages | type) != "array") then error("shape") else .[0] end
    | [.packages[] | (.nevra | split_nevra) + {action, nevra}] as $p
    | [$p[] | select(.action | IN("Upgrade","Downgrade","Install"))] as $planned
    | [$p[] | select(.action | IN("Replaced","Remove"))] as $old
    | [$planned[] | select($st == "Ok" or (.nevra as $x | $h | index($x) != null))] as $in
    | {updated: [$in[] | . as $n | ([$old[] | select(.name == $n.name) | .evr]) as $o
                 | select($o | length > 0) | {name, from: ($o | join(",")), to: .evr}],
       added:   [$in[] | . as $n | select([$old[] | select(.name == $n.name)] | length == 0)
                 | {name, to: .evr}],
       removed: [$old[] | . as $o | select([$planned[] | select(.name == $o.name)] | length == 0)
                 | {name, from: .evr}],
       missing: ([$planned | length, ($in | length)] | .[0] - .[1]),
       seconds: (if (.end_time | type) == "number" and (.start_time | type) == "number"
                    and .end_time >= .start_time then (.end_time - .start_time | floor) else null end)}' \
    <<<"$info" 2>/dev/null
}

# The services' baseline the run that staged this recorded, carried into the restart's entry: the
# first check of a boot compares against the earliest run that changed packages, and that is this
# entry, not the stage.
stage_run_baseline() {
  local files=()
  mapfile -t files < <(startup_hist_names | sed "s|^|$HIST_DIR/|" | tail -n 20)
  [[ ${#files[@]} -gt 0 ]] || return 0
  jq -cn '[inputs | select(type == "object" and .surface == "offline") | .failed_before | objects]
          | last // empty' "${files[@]}" 2>/dev/null || true
}

# A history entry and its log for something a restart did. The log is Kempt's own record, and says so:
# Kempt was not running, so there is no output to capture, and a person who just watched a machine
# install a hundred packages while it booted should still have Show Log. Never fatal: this runs at
# the top of every check, and a check that dies here never runs again.
stage_write_entry() {  # surface status error report-json txid → sets STAGE_ENTRY to the file, or empty
  local ts hist hlog rep_f fb
  STAGE_ENTRY=""
  ts="$(date +%Y%m%dT%H%M%S)"
  # Filenames are per-second, and a live run's own check can land in the same second.
  hist="$HIST_DIR/$ts.json"; [[ -e "$hist" ]] && hist="$HIST_DIR/$ts-offline.json"
  hlog="$LOG_DIR/$ts.log"; [[ -e "$hlog" ]] && hlog="$LOG_DIR/$ts-offline.log"
  fb="$(stage_run_baseline)"
  rep_f="$(mktemp)"
  printf '%s' "$4" > "$rep_f"
  if ! jq -n --arg ts "$(now_iso)" --arg surface "$1" --arg status "$2" --arg error "$3" --arg txid "$5" \
         --arg log "$hlog" --arg fb "$fb" --slurpfile rep "$rep_f" '
      ($rep[0]) as $r |
      {timestamp:$ts, surface:$surface, status:$status, reboot_needed:false, log:$log,
       backends:{dnf:({updated:$r.updated, added:$r.added, removed:$r.removed} + {status:$status, skipped_held:[]}),
                 flatpak:{updated:[],added:[],removed:[],status:"skipped",skipped_held:[]}}}
      + (if $error == "" then {} else {error: $error} end)
      + (if $txid == "" then {} else {transaction_id: ($txid | tonumber)} end)
      + (if ($r.seconds | type) == "number" then {duration_sec: $r.seconds} else {} end)
      + (if $fb == "" then {} else {failed_before: ($fb | fromjson)} end)' > "$hist" 2>/dev/null; then
    rm -f "$hist" "$rep_f"
    echo "warning: the restart's result could not be written into Kempt's history" >&2
    log_event "Restart result not saved (state directory unwritable?)"
    return 0
  fi
  rm -f "$rep_f"
  STAGE_ENTRY="$hist"
  { printf '%s\n' "This is Kempt's own record of what dnf5 did during the restart. Kempt was not running at the" \
                   "time, so nothing was captured: the packages below are read from dnf5's history." ""
    [[ -z "$5" ]] || printf "dnf5's own record of the same transaction:  dnf5 history info %s\n\n" "$5"
    render_summary "$hist"; } > "$hlog" 2>/dev/null || {
    rm -f "$hlog"
    if jq '.log = ""' "$hist" > "$hist.nolog" 2>/dev/null; then mv -f "$hist.nolog" "$hist"; else rm -f "$hist.nolog"; fi
  }
  return 0
}

# One new row of dnf5's history that a restart wrote.
stage_report_row() {  # id status
  local report missing surface="offline (applied on reboot)" status=ok error=""
  # A row that cannot be read is said as what is known about it. The status needs nothing more.
  report="$(stage_row_report "$1" "$2")" \
    || report='{"updated":[],"added":[],"removed":[],"missing":null,"seconds":null}'
  if [[ "$2" != Ok ]]; then
    status=failed
    missing="$(jq -r '.missing // "unknown"' <<<"$report")"
    if [[ "$missing" == 0 ]]; then
      error="the updates were installed, but a package's script failed during the restart"
    else
      surface="offline (restart did not finish)"
      if [[ "$2" == Started ]]; then error="the restart stopped before the install finished"
      else error="the install did not finish on the restart"; fi
    fi
  fi
  stage_write_entry "$surface" "$status" "$error" "$report" "$1"
  local phrase=""
  [[ -z "$STAGE_ENTRY" ]] || phrase="$(run_counts_phrase "$STAGE_ENTRY")"
  log_event "After the restart: transaction $1 $2${phrase:+ ($phrase)}"
  if [[ "$2" == Ok ]]; then
    notify "Kempt" "Your prepared updates were installed during the restart${phrase:+: $phrase}"
  else
    # Failures are told by stage_tell_problem, which remembers whether anyone saw it.
    stage_shown_set entry "$(offline_stored_fingerprint)" || true
  fi
}

# Tell a person, once per stored stage, about a stage no restart will install. Remembered only when
# the notification was really shown: someone with no session at this check is told at the next one.
stage_tell_problem() {  # history-answered(true|false) had-memory(true|false)
  local word fp
  # Asked first: a stage already told about needs no second reading in this check.
  fp="$(offline_stored_fingerprint)"
  [[ -n "$fp" && "$(stage_shown_get told)" != "$fp" ]] || return 0
  word="$(stage_read)"
  case "$word" in failed|lost|interrupted) ;; *) return 0 ;; esac
  # A run in progress replaces these files on purpose.
  update_running_elsewhere && return 0
  if [[ "$word" == failed ]]; then
    if [[ "$2" != true ]] && (( $(date +%s) - $(stat -c %Y "$KEMPT_OFFLINE_TOML" 2>/dev/null || echo 0) > KEMPT_STAGE_FRESH_SECS )); then
      stage_shown_set entry "$fp" && stage_shown_set told "$fp" || true
      return 0
    fi
    # dnf5 said a restart failed and its history has no row to report: still a failed restart.
    if [[ "$1" == true && "$(stage_shown_get entry)" != "$fp" ]] && stage_shown_set entry "$fp"; then
      stage_write_entry "offline (restart did not finish)" failed "the install did not finish on the restart" \
        '{"updated":[],"added":[],"removed":[],"seconds":null}' ""
    fi
  fi
  session_bus_present || return 0
  case "$word" in
    failed)
      # The words the restart's entry already has: a script failing after everything arrived is not
      # an install that did not finish.
      local said="" newest
      newest="$(startup_hist_names | tail -n 1)" || true
      [[ -z "$newest" ]] || said="$(jq -r 'select(.status == "failed" and (.surface | strings | startswith("offline ("))) | .error | strings' "$HIST_DIR/$newest" 2>/dev/null)"
      notify "Kempt" "Prepared updates: ${said:-the install did not finish on the restart}. Kempt's update list shows anything still waiting" ;;
    interrupted) notify "Kempt" "A restart stopped before your prepared updates finished installing, and no restart will run them again. To prepare them again, run kempt update --surface=offline or press Install on Next Restart in Kempt" ;;
    lost) notify "Kempt" "No restart will install your prepared updates now. To prepare them again, run kempt update --surface=offline or press Install on Next Restart in Kempt" ;;
  esac
  [[ "$NOTIFY_SHOWN" != true ]] || stage_shown_set told "$fp" || true
  return 0
}

# The check's first step, inside the check lock: two overlapping checks must not report one restart
# twice. A history that does not answer says nothing, and the next check asks again.
stage_report_restart() {
  local had_memory=false answered=false seen rows id st when now newest
  # What 0.2.0 and earlier kept about a stage. Nothing reads these now.
  rm -f "$KEMPT_STATE_DIR/offline_staged.json" "$KEMPT_STATE_DIR/offline-partial" \
        "$KEMPT_STATE_DIR/stage.lock" "$SNAP_DIR"/offline-pre-*.tsv 2>/dev/null || true
  # No valid row is no memory, whatever else the file holds.
  seen="$(stage_shown_get row)"
  if [[ "$seen" =~ ^[0-9]+$ ]]; then had_memory=true; else seen=0; fi
  now="$(date +%s)"
  local listing
  if listing="$(dnf_history_json list)" && rows="$(jq -r --argjson seen "$seen" "$KEMPT_JQ_OFFLINE_ROW"'
        if type != "array" then error("shape") else . end
        | [.[] | select((.id | type) == "number" and .id > $seen and offline_row)]
        | sort_by(.id)[]
        | [.id, (.status | strings), (if (.end_time // 0) > 0 then .end_time else (.start_time // 0) end)] | @tsv' \
        <<<"$listing" 2>/dev/null)"; then
    answered=true
    # With nothing remembered, several recent rows would be one notification each for old news.
    [[ "$had_memory" == true ]] || rows="$(tail -n 1 <<<"$rows")"
    while IFS=$'\t' read -r id st when; do
      [[ "$id" =~ ^[0-9]+$ && "$st" =~ ^[A-Za-z]{1,20}$ ]] || continue
      # Remembered first: a report lost to a full disk is better than one repeated on every check.
      stage_shown_set row "$id" || return 0
      if [[ "$had_memory" != true && "$when" =~ ^[0-9]+$ ]] && (( now - when > KEMPT_STAGE_FRESH_SECS )); then
        continue
      fi
      # 0.2.0 reported its own restart and kept no row: an upgrade must not report that one again.
      newest="$(startup_hist_names | tail -n 1)" || true
      if [[ -n "$newest" && "$(jq -r '.transaction_id // empty' "$HIST_DIR/$newest" 2>/dev/null)" == "$id" ]]; then
        continue
      fi
      stage_report_row "$id" "$st"
    done <<<"$rows"
  fi
  # The baseline is what a history that answered had to say. Written after a failure, it would make
  # every old row in that history new at the next check.
  if [[ "$answered" == true && "$had_memory" != true && ! "$(stage_shown_get row)" =~ ^[0-9]+$ ]]; then
    stage_shown_set row "$seen" || true
  fi
  stage_tell_problem "$answered" "$had_memory"
}

# A run report narrowed to the named packages. Kept whole when there is nothing to narrow by or the
# filter fails: the identification still stands, only the precision is lost. An empty list is a
# source not saying what it touched, never a restart that touched nothing. `. as $x` before index(),
# for the trap mark_held carries the note about.
report_keep_names() {  # report-json names → report-json
  local keep_f filtered
  if [[ -z "$2" ]]; then printf '%s\n' "$1"; return 0; fi
  keep_f="$(mktemp 2>/dev/null)" || { printf '%s\n' "$1"; return 0; }
  if printf '%s\n' "$2" > "$keep_f" 2>/dev/null \
     && filtered="$(jq -c --rawfile k "$keep_f" '
                   ($k | split("\n") | map(select(length > 0))) as $keep
                   | with_entries(.value |= map(select(.name as $x | $keep | index($x) != null)))' \
                   <<<"$1" 2>/dev/null)" && [[ -n "$filtered" ]]; then
    printf '%s\n' "$filtered"
  else
    printf '%s\n' "$1"
  fi
  rm -f "$keep_f"
}

cmd_config() {
  case "${1:-}" in
    get) [[ -n "${2:-}" && $# -le 3 ]] || { echo "usage: kempt config get <key> [default]" >&2; exit 2; }
         if [[ "$2" == surface ]]; then surface_canon "$(config_get "$2" "${3-}")"
         else config_get "$2" "${3-}"; fi ;;
    set) [[ -n "${2:-}" && -n "${3+x}" && $# -le 3 ]] || { echo "usage: kempt config set <key> <value>" >&2; exit 2; }
         # Warns and stores. See config_warn_unknown: refusing would make this CLI the thing that
         # stops a newer widget writing a key it knows and this build does not.
         # `widget` is the word on screen for the stored `popup`, so both spellings are accepted and
         # the file keeps the one older widgets read.
         local v="$3"
         [[ "$2" != surface || "$(surface_canon "$v")" != popup ]] || v=popup
         config_warn_unknown "$2" "$v"
         config_set "$2" "$v"
         # The two surfaces that merged into the widget are stored as it, which the person should hear.
         case "$2=${3,,}" in
           surface=*terminal*|surface=*background*)
             [[ "$v" != popup ]] || echo "Stored surface=popup, the widget, because $3 is no longer a choice." ;;
         esac ;;
    *) echo "usage: kempt config get <key> [default] | set <key> <value>" >&2; exit 2 ;;
  esac
}

# a missing colon must not silently hold a package named after the backend ("kempt hold dnf")
cmd_hold() {
  [[ "${1:-}" == *:* ]] || { echo "use dnf:<pkg> or flatpak:<app.id>" >&2; exit 2; }
  local b="${1%%:*}" n="${1#*:}"
  [[ "$b" == dnf || "$b" == flatpak ]] || { echo "use dnf:<pkg> or flatpak:<app.id>" >&2; exit 2; }
  # Runtimes cannot be held, and the refusal is here rather than in the backend because it is a
  # decision about the COMMAND, not about a pending list: the answer is the same whether or not an
  # update happens to be waiting. A runtime is shared infrastructure - hold org.kde.Platform and the
  # next KDE app that needs it is the thing that breaks, somewhere else entirely, with nothing on
  # screen connecting the two. Apps are what a person means by "skip this one", and they still work.
  # Exit 2 and nothing written, the same contract an invalid name gets.
  if [[ "$b" == flatpak ]] && flatpak_id_is_runtime "$n"; then
    echo "$n is a Flatpak runtime, and runtimes cannot be held: apps share them, so holding one breaks the next app that needs it. Hold the app instead." >&2
    exit 2
  fi
  # Separate statements, not `hold_add ... && log_event ...`: an AND list swallows hold_add's exit
  # status and reports a rejected name as exit 1 instead of the 2 the contract promises. This way
  # errexit ends the command with the helper's own rc and no event is written.
  hold_add "$b" "$n"
  # AFTER the write, and it changes nothing about it. dnf5 cannot edit a transaction it has already
  # stored, so a hold added over an armed stage applies from the NEXT transaction Kempt builds -
  # correct, and invisible unless said: hold the kernel, restart, and the kernel installs. So this
  # warns on stderr and does nothing else: never prompts, never blocks, never changes the exit
  # status (a hold is bookkeeping, I1), and is identical interactive or not, because the case that
  # needs it most is a pin clicked in the panel. dnf only - the offline surface stages dnf alone,
  # so a flatpak hold can never conflict with an armed transaction.
  local note=""
  if [[ "$b" == dnf ]]; then
    # The SAME predicate state.json publishes for the widget. AFTER hold_add on purpose: the
    # intersection is against the holds as they now stand.
    local staged; staged="$(offline_staged_state)"
    if [[ -n "$staged" ]]; then
      if jq -e --arg n "$n" '.holds_conflict | index($n)' <<<"$staged" >/dev/null 2>&1; then
        hold_staged_warning <<<"$n" >&2
        printf '%s\n' "$KEMPT_STAGED_RECIPE" >&2
        note=" (staged update still contains it)"
      fi
    elif [[ "$(stage_read)" == unknown ]]; then
      # Kempt cannot read what is stored, so the generic warning is what is left: wrong only by warning
      # about a package that is not in the transaction, never by staying quiet about one that is.
      hold_generic_warning "$n" >&2
      # The recipe follows the generic warning too - both remedies belong on every surface.
      printf '%s\n' "$KEMPT_STAGED_RECIPE" >&2
    fi
  fi
  # The suffix is only ever appended to a CONFIRMED conflict: the generic warning is a caveat, not
  # a finding, and the event log must not record it as one.
  log_event "Held $b:$n$note"
}
cmd_unhold() {
  [[ "${1:-}" == *:* ]] || { echo "use dnf:<pkg> or flatpak:<app.id>" >&2; exit 2; }
  local b="${1%%:*}" n="${1#*:}"
  [[ "$b" == dnf || "$b" == flatpak ]] || { echo "use dnf:<pkg> or flatpak:<app.id>" >&2; exit 2; }
  hold_remove "$b" "$n"
  # The mirror: releasing a hold does not put the package back into a transaction that was built
  # without it. Same rules as cmd_hold - after the write, stderr only, dnf only, status untouched.
  local note=""
  if [[ "$b" == dnf ]] && offline_stage_built_without "$n"; then
    unhold_staged_warning "$n" >&2
    note=" (staged update was built without it)"
  fi
  log_event "No longer held: $b:$n$note"
}
# Refuses a stray argument like every other command: `kempt holds --json` silently printing the
# plain list is how a script gets written against an option that does not exist.
cmd_holds() {
  [[ $# -eq 0 ]] || { echo "unknown option: $1" >&2; exit 2; }
  holds_all
}

# `kempt unstage` - discard the staged offline transaction, so the next restart installs nothing.
# The mirror of `kempt update --surface=offline`, through the same root helper verb the failure
# unwinds already use. That verb refuses over a stored Fedora release upgrade, and so does this:
# dnf5 keeps ONE stored transaction, so an ordinary stage and a release upgrade share one slot, and
# discarding the wrong one throws away gigabytes somebody spent hours downloading. Refused HERE and
# again as root, because the CLI runs as the user and anything reaching the helper directly never
# passes through here.
cmd_unstage() {
  [[ $# -eq 0 ]] || { echo "unknown option: $1" >&2; exit 2; }
  kempt_init_dirs
  # exit 5, the status cmd_update's refusals already use: nothing was read, nothing was changed, so
  # this is a refusal rather than a failed run. And never "run: sudo dnf5 offline clean" on any path
  # in this function - that is the command the refusal exists to protect against.
  local relup
  if relup="$(offline_release_upgrade)"; then
    echo "Nothing was discarded, because that would also cancel the Fedora ${relup##* } upgrade. See: kempt doctor" >&2
    log_event "Discard refused (a Fedora release upgrade ($relup) is stored)"
    exit 5
  fi
  # The update lock, for the race it exists for: a stage in flight is building the very transaction
  # this would remove. Same refusal and same status as a second `kempt update`.
  acquire_lock || { echo "Another update is running." >&2; exit 3; }
  trap release_lock EXIT

  local status
  status="$(offline_system_status)"
  # Nothing stored, which is not a failure and needs no root, so it raises no authentication dialog.
  if [[ "$status" == absent ]]; then
    echo "Nothing is waiting for the next restart, so there is nothing to discard."
    log_event "Discard: nothing was staged"
    cmd_check >/dev/null 2>&1 || true
    return 0
  fi

  # `dnf5 offline clean` removes /system-update whoever made it. While another updater's symlink
  # stands, discarding Kempt's stage would cancel that updater's restart install too, so this waits
  # for the restart that runs it.
  if [[ "$(offline_link_state)" == other ]]; then
    echo "Nothing was discarded. Another updater has prepared the next restart, and discarding now would cancel its update too. Try again after that restart." >&2
    log_event "Discard refused (another updater has prepared the next restart)"
    exit 5
  fi
  # NOT through apply_with_retry: that tees into a run log this command does not have, and this is
  # one short verb rather than a transaction. A package lock held by something else fails plainly.
  local rc=0 err=""
  { err="$(priv_apply dnf-offline-clean 2>&1 >&3)" || rc=$?; } 3>&1
  [[ -z "$err" ]] || printf '%s\n' "$err" >&2
  if [[ $rc -eq $KEMPT_APPLY_REFUSED ]]; then
    echo "Nothing was discarded, because $(apply_refusal_reason). See: kempt doctor" >&2
    log_event "Discard was refused by Kempt's system helper"
    exit 5
  fi
  if [[ $rc -ne 0 ]]; then
    echo "These updates could not be discarded. See: kempt doctor" >&2
    log_event "Discard failed (exit code $rc)"
    exit 1
  fi
  # Asked again rather than assumed from rc 0: a helper can exit 0 having changed less than it meant to.
  status="$(offline_system_status)"
  if [[ "$status" != absent ]]; then
    local left="dnf5 still reports a stored transaction (status \"$status\")"
    [[ "$status" != unknown ]] || left="the stored transaction is still there and cannot be read"
    echo "These updates were not fully discarded: $left. See: kempt doctor" >&2
    log_event "Discard left the staged update in place (status ${status/#unknown/could not be read})"
    cmd_check >/dev/null 2>&1 || true
    exit 1
  fi
  echo "Discarded the updates waiting for the next restart. That restart installs nothing."
  log_event "Staged update discarded"
  # state.json is the widget's only channel, so a discarded stage stops being advertised in the
  # panel exactly when this rewrites it.
  cmd_check >/dev/null 2>&1 || true
}

# `kempt reclaim` - remove the Flatpak runtimes no installed app uses, by name, with --no-related.
# Named refs narrow it to those: the widget names what it showed. A ref reaches flatpak only when it
# is on the first list and on the one read just before the removal, so a runtime another tool has
# just deployed is left alone unless it was already shown. Writes no history entry: a removal is not
# an update run.
cmd_reclaim() {
  local list="" yes="" named=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --list) list=1; shift ;;
      -y|--yes) yes=1; shift ;;
      --) shift; named+=("$@"); break ;;
      -*) echo "unknown option: $1" >&2; exit 2 ;;
      *) named+=("$1"); shift ;;
    esac
  done
  kempt_init_dirs
  if reclaim_as_root; then
    echo "Nothing was removed. Run kempt reclaim as yourself, not as root: as root, Flatpak does not see your own apps and could remove a runtime one of them needs." >&2
    exit 5
  fi
  if ! is_true "$(config_get include_flatpak)"; then
    echo "Nothing was removed. Flatpak is not part of Kempt's updates here (include_flatpak is false)." >&2
    exit 5
  fi
  if ! flatpak_present; then
    echo "Nothing was removed. Flatpak is not installed." >&2
    exit 5
  fi
  local listing shown sizes="" bytes=0 fresh refs rc=0
  local no_list="Flatpak did not answer when asked what is unused. Nothing was removed."
  listing="$(flatpak_unused_list 2>/dev/null)" || { echo "$no_list" >&2; exit 1; }
  shown="$(reclaim_unused_refs "$listing")"
  if [[ ${#named[@]} -gt 0 ]]; then
    shown="$(comm -12 <(printf '%s\n' "${named[@]}" | LC_ALL=C sort) <(printf '%s\n' "$shown"))"
  fi
  [[ -n "$shown" ]] || { echo "Nothing to remove."; return 0; }
  echo "No installed app uses these Flatpak runtimes:"
  jq -r --arg shown "$shown" '($shown | split("\n")) as $s | .unused[] | select(.ref | IN($s[]))
    | "  \(.ref)" + (if .eol != null then " (no longer supported)" else "" end)' <<<"$listing"
  if sizes="$(flatpak_unused_sizes "$listing" 2>/dev/null)"; then bytes="$(reclaim_bytes_of "$sizes" "$shown")"; fi
  [[ "$bytes" == 0 ]] || echo "Removing them frees about $(human_bytes "$bytes")."
  [[ -z "$list" ]] || return 0
  if [[ -z "$yes" ]]; then
    # No -y and nobody to ask: never a silent yes.
    if [[ ! -t 0 ]]; then
      echo "Nothing was removed. Run kempt reclaim -y to remove them without being asked." >&2
      exit 5
    fi
    local answer=""
    read -r -p "Remove them? [y/N] " answer || answer=""
    [[ "${answer,,}" == y || "${answer,,}" == yes ]] || { echo "Nothing was removed."; return 0; }
  fi
  # The update lock, without waiting, like a second `kempt update`: a run in progress may be
  # installing the very runtime this would call unused.
  acquire_lock || { echo "another kempt update is running" >&2; exit 3; }
  trap release_lock EXIT
  fresh="$(flatpak_unused_list 2>/dev/null)" || { echo "$no_list" >&2; exit 1; }
  refs="$(comm -12 <(printf '%s\n' "$shown") <(reclaim_unused_refs "$fresh"))"
  if [[ -z "$refs" ]]; then
    echo "Nothing to remove."
  else
    reclaim_remove "$fresh" "$sizes" "$refs" || rc=$?
  fi
  # state.json is the widget's only channel: the offer goes when this rewrites it. Still under the
  # update lock, then check.lock, the order cmd_update takes them in.
  cmd_check >/dev/null 2>&1 || true
  return $rc
}

# `kempt startup` - the services that stopped starting after an update, as the last check saw
# them, each with the read-only command that shows why. Mute and unmute change what Kempt
# mentions; ack is the widget's word that a "starting again" line was seen.
# Kempt only looks: nothing here starts, stops or enables a unit.
cmd_startup() {
  local sub="${1:-}"
  [[ $# -eq 0 ]] || shift
  case "$sub" in
    --all) startup_page_cmd "$@" ;;
    --json) if [[ "${1:-}" == --all ]]; then shift; startup_page_cmd --json "$@"; else startup_list "$sub" "$@"; fi ;;
    "") startup_list "$sub" "$@" ;;
    mute|unmute) startup_mute_cmd "$sub" "$@" ;;
    ack) startup_ack "$@" ;;
    *) echo "usage: kempt startup [--all] [--json] | mute|unmute <unit> [--user] | ack --expect=DIGEST" >&2; exit 2 ;;
  esac
}

startup_status_cmd() {  # scope unit → the command that shows why, quoted when it needs it
  local u="$2"
  [[ "$u" =~ ^[A-Za-z0-9_.@:-]+$ ]] || u="'$u'"
  if [[ "$1" == user ]]; then printf 'systemctl --user status %s' "$u"; else printf 'systemctl status %s' "$u"; fi
}

startup_day() {  # ISO time → "20 Oct"
  LC_ALL=C date -d "$1" '+%-d %b' 2>/dev/null || printf '%s' "${1%%T*}"
}

startup_list() {
  [[ $# -le 1 ]] || { echo "unknown option: $2" >&2; exit 2; }
  if ! startup_on; then
    [[ "$1" == --json ]] && { echo '{}'; return 0; }
    echo "Kempt is not watching for services that stop starting (notify_startup is off)."
    return 0
  fi
  local block
  block="$(startup_block)" || { echo "kempt: could not read $STARTUP_FILE" >&2; exit 1; }
  if [[ "$1" == --json ]]; then printf '%s\n' "$block"; return 0; fi
  # Each line names the day it stopped, not the newest update: an old failure is not the latest
  # update's doing.
  local group last="" scope unit desc since line
  while IFS=$'\t' read -r group scope unit desc since; do
    if [[ "$group" != "$last" ]]; then
      [[ -z "$last" ]] || echo
      case "$group" in
        announced) echo "Not starting since an update:" ;;
        already) echo "Already failing before an update:" ;;
        muted) echo "Muted until they start:" ;;
        recovered) echo "Running again:" ;;
      esac
      last="$group"
    fi
    line="  $desc ($unit)"
    [[ -z "$since" ]] || line+=", since $(startup_day "$since")"
    echo "$line"
    [[ "$group" == recovered ]] || printf '    %s\n' "$(startup_status_cmd "$scope" "$unit")"
  done < <(jq -r "$STARTUP_CLEAN_JQ"'("announced", "already", "muted", "recovered") as $g
                  | .[$g][] | [$g, .scope, (.unit | clean), (.description | clean), (.since // "")] | join("\t")' <<<"$block")
  [[ -z "$last" ]] || return 0
  # The all-clear only once a comparison has happened: before that, there is nothing to vouch for.
  if [[ "$(jq -r '.compared' <<<"$block")" == true ]]; then
    echo "No service has stopped starting since a Kempt update."
  else
    echo "Nothing to report."
  fi
}

# `kempt startup --all` - everything startup_page_gather finds, as text grouped the way a person
# would say it (the widget's Startup Report shows this text), or as JSON.
startup_page_cmd() {
  local json="" a page now today
  for a in "$@"; do case "$a" in
    --json) json=1 ;;
    *) echo "unknown option: $a" >&2; exit 2 ;;
  esac; done
  page="$(startup_page_gather)" || { echo "kempt: could not gather the Startup Report" >&2; exit 1; }
  if [[ -n "$json" ]]; then printf '%s\n' "$page"; return 0; fi
  # Today, yesterday and tomorrow are calendar days, worked out in UTC: the days the clocks change
  # are 23 and 25 hours long. KEMPT_NOW (seconds since the epoch) pins the clock for the tests.
  now="${KEMPT_NOW:-$(date +%s)}"
  today="$(date -d "@$now" +%F)"
  # Every string came from outside (unit files, logs, crontabs), so control characters, which a
  # terminal would act on, are shown as spaces. The JSON keeps them: the widget shows plain text.
  jq -r --arg today "$today" --arg yesterday "$(date -u -d "$today 12:00 UTC 1 day ago" +%F)" \
        --arg tomorrow "$(date -u -d "$today 12:00 UTC 1 day" +%F)" "$STARTUP_CLEAN_JQ"'
    walk(if type == "string" then clean else . end)
    | def ymd: strftime("%Y-%m-%d");
    def local: try (fromdateiso8601 | localtime) catch null;
    def lday: local as $t | if $t == null then .[:10] elif ($t | ymd) == $today then "today"
                            elif ($t | ymd) == $yesterday then "yesterday"
                            else ($t | strftime("%-d %b")) end;
    def when: local as $t
      | if $t == null then .
        else ($t | strftime("%H:%M")) as $hm | ($t | ymd) as $d
          | if $d == $today then "today \($hm)"
            elif $d == $tomorrow then "tomorrow \($hm)"
            elif $d == $yesterday then "yesterday \($hm)"
            else ($t | strftime("%-d %b")) + " " + $hm end end;
    def pad: tonumber | tostring | if length < 2 then "0" + . else . end;
    def num: test("^[0-9]+$");
    def every: ltrimstr("@") as $p
      | {hourly: "every hour", daily: "every day", weekly: "every week", monthly: "every month",
         yearly: "every year", annually: "every year", "1": "every day", "7": "every week"}[$p]
        // (if $p | num then "every \($p) days" else . end);
    def human: if startswith("@") then
        {"@reboot": "at startup", "@hourly": "every hour", "@daily": "every day at 00:00",
         "@midnight": "every day at 00:00", "@weekly": "every week", "@monthly": "every month",
         "@yearly": "every year", "@annually": "every year"}[.] // .
      else . as $raw | [splits(" +")] as $f
        | if ($f | length) != 5 then $raw
          elif ($f[0] | num) and ($f[1] | num) and $f[2:] == ["*", "*", "*"] then "every day at \($f[1] | pad):\($f[0] | pad)"
          elif ($f[0] | num) and ($f[1] | num) and $f[2:4] == ["*", "*"] and ($f[4] | test("^[0-7]$")) then
            "every \(["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"][$f[4] | tonumber]) at \($f[1] | pad):\($f[0] | pad)"
          elif ($f[0] | num) and ($f[1] | num) and ($f[2] | num) and $f[3:] == ["*", "*"] then
            "every month on day \($f[2] | tonumber) at \($f[1] | pad):\($f[0] | pad)"
          elif ($f[0] | num) and $f[1:] == ["*", "*", "*", "*"] then "every hour at :\($f[0] | pad)"
          elif ($f[0] | test("^\\*/[0-9]+$")) and $f[1:] == ["*", "*", "*", "*"] then "every \($f[0][2:]) minutes"
          else $raw end end;
    # A cron command by the program it runs: no redirections, no settings, no folder.
    def program: gsub("[0-9]*>>?&?[ ]*[^ ]+"; "") | gsub("<[ ]*[^ ]+"; "")
      | [splits(" +") | select(. != "" and (test("^[A-Za-z_][A-Za-z0-9_]*=") | not))] | (.[0] // "") | sub(".*/"; "")
      | if . == "" then "a command" else . end;
    def named: if .description == .unit or .description == "" then .unit else "\(.description) (\(.unit))" end;
    def title: if .description == .unit or .description == "" then .unit else .description end;
    def session: if .scope == "user" then ", when you log in" else "" end;
    def entry: if .kind == "rc-local" then .unit elif .kind == "script" then "\(.unit) (autostart script)" else title end;
    # A package heading only over two entries or more; what no package owns is worth seeing first.
    def grouped: [.[] | select(.skipped | not)] as $on | ([.[] | select(.skipped)] | length) as $skip
      | ([$on[] | select(.package == null)] | if length > 0 then ["  Not from a package"] + (map("    " + entry) | sort) else [] end)
        + ([$on[] | select(.package != null)] | group_by(.package | ascii_downcase)
           | map(if length >= 2 then ["  " + .[0].package] + (map("    " + entry) | sort)
                 else ["  \(.[0] | entry) (\(.[0].package))"] end) | add // [])
        + (if $skip == 1 then ["  1 more is set to start but is skipped on this computer."]
           elif $skip > 1 then ["  \($skip) more are set to start but are skipped on this computer."] else [] end);
    def timer: named
      + ([(if .last then "last run \(.last | when)" else empty end), (if .next then "next \(.next | when)" else empty end),
          (if .result != null and .result != "success" then "the last run failed" else empty end)]
         | if length > 0 then ": " + join(", ") else "" end);
    def cronline: if (.source | test("^(cron\\.|anacron$)"))
      then "\(.command | program): \(.schedule | every)" + (if .last then ", last run \(.last | lday)" else "" end)
      else "\(.command | program): \(.schedule | human) ("
           + (if .source == "crontab" then "your crontab" else .source end)
           + (if .user != null then ", as \(.user)" else "" end) + ")" end;
    (.schedule.notes // []) as $notes
    | [ (if (.notes // []) | index("session_slow") then ["Your session did not answer in time; its part is missing."] else empty end),
        (if (.notes // []) | index("session_missing") then ["Your session could not be reached, so its part is missing."] else empty end),
        (.failed // empty
         | ["Didn'"'"'t start this boot:"]
           + [.units[] | "  \(title)" + (if .scope == "user" then " (when you log in)" else "" end),
                         (if .log then "    Its log says: \(.log)" else "    Stopped with an error (\(.result // .state))" end),
                         (if .status_command then "    To see why: \(.status_command)" else empty end)]
           + (if .journal_denied then ["No log lines for system services: you are not allowed to read the system journal."] else [] end)),
        (.changed // empty
         | ["Changed since the last update" + (if .since then " (\(.since | when))" else "" end) + ":"]
           + [.added[] | .description //= .unit | "  Now starts: \(named)\(session)"]
           + [.removed[] | .description //= .unit | "  No longer starts: \(named)\(session)"]),
        (.starts // empty | [.[] | select(.scope == "system")] | select(length > 0) | ["Starts with the computer:"] + grouped),
        (.starts // empty | [.[] | select(.scope == "user")] | select(length > 0) | ["Starts when you log in:"] + grouped),
        (.schedule // empty
         | ["Runs on a schedule:"]
           + ([.timers[] | select(.scope == "system")] | if length > 0 then ["  Timers"] + map("    " + timer) else [] end)
           + ([.timers[] | select(.scope == "user")] | if length > 0 then ["  Your timers"] + map("    " + timer)
                + (if $notes | index("linger_off") then ["    Your timers stop when you log out."] else [] end) else [] end)
           + (.cron | if length > 0 then ["  Cron"] + map("    " + cronline)
                + (if $notes | index("crond_down") then ["    These jobs do not run while crond is stopped."] else [] end) else [] end)
           + (.at | if length > 0 then ["  Waiting at jobs"] + map("    \(if .when then .when | when else "unknown time" end) (job \(.id))") else [] end)) ]
    | if length == 0 then "Kempt found nothing to list." else map(join("\n")) | join("\n\n") end' <<<"$page"
}

startup_mute_cmd() {  # mute|unmute unit [--user]
  local verb="$1" unit="" scope=system a
  shift
  for a in "$@"; do case "$a" in
    --user) scope=user ;;
    -*) echo "unknown option: $a" >&2; exit 2 ;;
    *) [[ -z "$unit" ]] || { echo "kempt startup $verb takes one unit" >&2; exit 2; }; unit="$a" ;;
  esac; done
  [[ -n "$unit" ]] || { echo "usage: kempt startup $verb <unit> [--user]" >&2; exit 2; }
  [[ "$unit" == *.* ]] || unit="$unit.service"
  # systemd's own unit name alphabet (escaped names keep their backslashes); no slash, so the
  # name can never be read as a path, and no newline, which would split the mutes file. A colon
  # is fine after the first character: the scope is read up to the first one.
  if [[ ${#unit} -gt 255 || ! "$unit" =~ ^[A-Za-z0-9_@\\][A-Za-z0-9_.:@\\-]*$ ]]; then
    echo "invalid unit name: $unit" >&2; exit 2
  fi
  # An alias is stored under the unit's own name, the one systemd reports failing; when systemctl
  # does not answer, the name is kept as typed. Unmute drops both spellings.
  # A unit systemd does not know, or one running now, is refused: the next check would end that
  # mute at once, and the mute would have done nothing. Running is exit 6, as ack's: what was shown
  # changed (the widget offers Mute only for a unit that was failing).
  local id show typed="$scope:$unit"
  if startup_on && show="$(startup_systemctl "$scope" show -p Id -p LoadState -p ActiveState -- "$unit")"; then
    id="$(sed -n 's/^Id=//p' <<<"$show" | head -n 1)"
    if [[ "$verb" == mute ]]; then
      if grep -qx 'LoadState=not-found' <<<"$show"; then
        local u="$unit" other
        [[ "$u" == *\\* ]] && u="'$u'"
        if [[ "$scope" == system ]] && other="$(startup_systemctl user show -p LoadState -- "$unit")" \
           && grep -q '^LoadState=' <<<"$other" && ! grep -qx 'LoadState=not-found' <<<"$other"; then
          echo "$unit is a service in your session. To mute it, run: kempt startup mute $u --user" >&2; exit 2
        fi
        echo "Kempt does not know a service called $unit." >&2; exit 2
      elif grep -qx 'ActiveState=active' <<<"$show"; then
        echo "$unit is running, so there is nothing to mute." >&2; exit 6
      fi
    fi
    [[ ${#id} -gt 255 || ! "$id" =~ ^[A-Za-z0-9_@\\][A-Za-z0-9_.:@\\-]*\.[a-z]+$ ]] || unit="$id"
  fi
  kempt_init_dirs
  writer_lock "$WRITER_LOCK_WAIT" || exit 1
  local key="$scope:$unit" rc=0 out
  if [[ "$verb" == mute ]]; then
    grep -qxF "$key" "$STARTUP_MUTES_FILE" 2>/dev/null \
      || printf '%s\n' "$key" >> "$STARTUP_MUTES_FILE" || rc=1
  elif [[ -f "$STARTUP_MUTES_FILE" ]]; then
    out="$(grep -vxF -e "$key" -e "$typed" "$STARTUP_MUTES_FILE")" || [[ $? -eq 1 ]] || rc=1
    [[ $rc -ne 0 ]] || printf '%s' "${out:+$out$'\n'}" | atomic_write "$STARTUP_MUTES_FILE" || rc=1
  fi
  [[ $rc -ne 0 ]] || startup_patch_state || true
  writer_unlock
  [[ $rc -eq 0 ]] || { echo "kempt: could not write $STARTUP_MUTES_FILE" >&2; exit 1; }
  if [[ "$verb" == mute ]]; then log_event "Stopped mentioning $key until it starts"
  else log_event "Mentioning $key again"; fi
}

startup_ack() {
  local expect=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --expect=*) expect="${1#--expect=}"; shift
                  [[ "$expect" =~ ^[0-9a-f]{16}$ ]] || { echo "--expect takes the 16-character digest from kempt check" >&2; exit 2; } ;;
      *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
  done
  [[ -n "$expect" ]] || { echo "usage: kempt startup ack --expect=DIGEST" >&2; exit 2; }
  writer_lock "$WRITER_LOCK_WAIT" || exit 1
  local st rc=0
  st="$(startup_read)"
  if [[ "$(startup_digest <<<"$st")" != "$expect" ]]; then
    rc=6
  elif ! jq -c '.recovered = []' <<<"$st" | atomic_write "$STARTUP_FILE"; then
    rc=1
  else
    startup_patch_state || rc=1
  fi
  writer_unlock
  return "$rc"
}

# One row: WARN for what stopped starting (muted units excluded), dated rather than tied to the
# newest update; ok once a comparison found nothing; info before any comparison, and without
# systemctl. Info, not a warning, so a build root without systemd counts no warning.
doctor_startup_row() {
  startup_on || return 0
  if ! startup_systemctl system --version >/dev/null; then
    doctor_info "startup: systemctl did not answer, so Kempt cannot tell whether services still start after an update"
    return 0
  fi
  local block n first since compared
  block="$(startup_block 2>/dev/null)" || block='{}'
  { IFS= read -r n; IFS= read -r first; IFS= read -r since; IFS= read -r compared; } < <(jq -r '
      (.announced // []) as $a | ($a | length), ($a[0].description // ""),
      ([$a[].since | strings] | min // ""), (.compared // false)' <<<"$block" 2>/dev/null)
  if [[ "${n:-0}" -eq 1 ]]; then
    doctor_warn "startup: $first has not started since an update on $(startup_day "$since"). See: kempt startup"
  elif [[ "${n:-0}" -gt 1 ]]; then
    doctor_warn "startup: $n services have not started since an update on $(startup_day "$since"). See: kempt startup"
  elif [[ "$compared" == true ]]; then
    doctor_ok "startup: no service has stopped starting since a Kempt update"
  else
    doctor_info "startup: no Kempt update compared yet"
  fi
}

# `kempt log` - the end of the event log, newest last. Lines from older versions print as stored.
cmd_log() {
  local n=30
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n) [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] \
            || { echo "usage: kempt log [-n N]  (N >= 1)" >&2; exit 2; }
          n="$2"; shift 2 ;;
      *)  echo "unknown option: $1" >&2; echo "usage: kempt log [-n N]" >&2; exit 2 ;;
    esac
  done
  # No file yet is the ordinary state of a fresh install, not an error - same answer shape as
  # `kempt summary` on a box with no runs: a sentence on STDOUT and exit 0.
  [[ -s "$EVENTS_FILE" ]] || { echo "No events recorded yet."; return 0; }
  tail -n "$n" "$EVENTS_FILE" | events_safe
}

# --- kempt doctor ---
# The trap this closes: with the root helpers missing, `kempt check` exits 0 with status "stale"
# and 0 pending, which reads to a human and to a badge as "you are up to date". Every other command
# degrades instead of crashing, deliberately, so doctor is the one that says the install is broken.
# Every check runs and every problem is printed: stopping at the first sends the user round the
# loop once per problem.
DOCTOR_FAILS=0
DOCTOR_WARNS=0
doctor_ok()   { printf 'ok    %s\n' "$1"; }
doctor_info() { printf 'info  %s\n' "$1"; }
# Something that works against what the settings ask for, without being broken. Not a failure:
# the exit status and the widget's verdict count only FAIL.
doctor_warn() { printf 'WARN  %s\n' "$1"; DOCTOR_WARNS=$(( DOCTOR_WARNS + 1 )); }
doctor_fail() { printf 'FAIL  %s\n' "$1"; DOCTOR_FAILS=$(( DOCTOR_FAILS + 1 )); }

# The hold that arrived after the stage. INFO and not FAIL: a package installing despite a hold is
# a legitimate state (see cmd_hold), and a FAIL for something legitimate teaches readers to skip
# FAILs - the bluntness lives in the sentence instead. It carries BOTH remedies through the one
# copy of them, KEMPT_STAGED_RECIPE, since someone who held a kernel may want the stage gone
# rather than rebuilt.
# Read from offline_staged_state: doctor must not grow a second opinion about which list may answer.
doctor_staged_conflict_row() {
  local staged names total phrase
  staged="$(offline_staged_state)" || return 0
  [[ -n "$staged" ]] || return 0
  names="$(jq -r '.holds_conflict[]?' <<<"$staged" 2>/dev/null || true)"
  if [[ -n "$names" ]]; then
    total="$(printf '%s' "$names" | grep -c '' || true)"
    phrase="$(printf '%s' "$names" | names_phrase)"
    # The verb moves with the noun, as in the staged count line and the hold warning.
    if [[ "$total" == 1 ]]; then
      doctor_info "staged update: it installs $phrase on the next restart despite the hold. The hold was recorded after the transaction was staged, and dnf5 offers no way to edit a stored one. $KEMPT_STAGED_RECIPE"
    else
      doctor_info "staged update: it installs $phrase on the next restart despite the holds. The holds were recorded after the transaction was staged, and dnf5 offers no way to edit a stored one. $KEMPT_STAGED_RECIPE"
    fi
  fi
}

# The `exec.path` annotation the installed policy pins for one action id - the only half of that
# file worth comparing, since pkexec matches an action by that path and by nothing else.
# awk rather than xmllint: a checkup must not need a dependency the rest of the tool does not have.
# It reads only the one-line form this project ships, `<annotate key="...">path</annotate>`; a
# policy with the value on its own line reads as "no annotation" and lands on the info branch.
policy_exec_path() {  # action_id file -> the annotated path, or "" if there is none
  awk -v want="$1" '
    /<action[ \t]+id="/ {
      id = ""
      if (match($0, /id="[^"]*"/)) id = substr($0, RSTART + 4, RLENGTH - 5)
    }
    id == want && /org\.freedesktop\.policykit\.exec\.path/ {
      if (match($0, />[^<]*</)) { print substr($0, RSTART + 1, RLENGTH - 2); exit }
    }
  ' "$2" 2>/dev/null || true
}

# The half of the polkit action a readable file can still get wrong. The RPM installs the helpers
# under /usr/libexec and rewrites the annotation to match (kempt.spec); an old checkout install used
# /usr/local/libexec. A box carrying both hands pkexec a path no action names, so it falls back to
# an authentication dialog a background check cannot answer: priv_refresh times out after 120s and
# the check reports stale, forever.
# Compared only when the helper seam IS the annotated path (as doctor_helper does for ownership):
# with a stub in play, what this CLI runs is not what polkit was asked about.
doctor_exec_path() {  # label action_id helper_seam annotated_path
  local label="$1" action="$2" seam="$3" annotated="$4" pinned
  [[ "$seam" == "$annotated" ]] || return 0
  # Missing or unreadable is already a FAIL above; one problem must not be counted twice.
  if [[ ! -r "$KEMPT_POLICY_FILE" ]]; then
    doctor_info "polkit exec.path ($label): not compared, because $KEMPT_POLICY_FILE is not readable"
    return 0
  fi
  pinned="$(policy_exec_path "$action" "$KEMPT_POLICY_FILE")"
  if [[ -z "$pinned" ]]; then
    doctor_info "polkit exec.path ($label): $KEMPT_POLICY_FILE pins no exec.path for $action"
  elif [[ "$pinned" == "$annotated" ]]; then
    doctor_ok "polkit exec.path ($label): $pinned"
  else
    # Both paths and both remedies: which one is wrong depends on the install the reader meant.
    doctor_fail "polkit exec.path ($label): the policy pins $pinned, this CLI runs $annotated. pkexec has no action for that path, so every privileged run falls back to an authentication dialog and background checks time out. Fix it with: sudo dnf reinstall kempt"
  fi
}

# ...and the other half of a split install, on the widget's side. The panel runs the CLI through
# its own PATH order (see KEMPT_WIDGET_PATH), so the kempt the widget uses and the kempt that
# printed this report can be two different files. Nothing here is executed.
doctor_widget_engine() {
  local w
  # A subshell, so the widget's PATH order decides this one lookup and nothing else in the run.
  # shellcheck disable=SC2123  # assigning PATH IS the check: it is the widget's own lookup order
  w="$(PATH="$KEMPT_WIDGET_PATH"; command -v kempt 2>/dev/null || true)"
  if [[ -z "$w" ]]; then
    # info, not FAIL: main.qml turns rc 127 into engineMissing, a message in the panel already.
    doctor_info "widget engine: no kempt on the widget's PATH ($KEMPT_WIDGET_PATH), so the panel reports the engine as missing"
    return 0
  fi
  # Resolved, because ~/.local/bin/kempt may be a symlink: the question is which FILE runs, not
  # which name came first.
  w="$(readlink -f "$w" 2>/dev/null || printf '%s' "$w")"
  if [[ "$w" == "$SELF" ]]; then
    doctor_ok "widget engine: $w"
  else
    doctor_fail "widget engine: the widget would run $w; this report describes $SELF. Remove the one you do not want, or point the ~/.local/bin/kempt symlink at the install you mean"
  fi
}

doctor_helper() {  # label seam_path annotated_path
  local label="$1" path="$2" annotated="$3" own dir down
  if [[ ! -e "$path" ]]; then
    doctor_fail "root helper ($label) not installed: $path. $KEMPT_REINSTALL_HINT"
    return 0
  fi
  # Not the path polkit execs, so its ownership says nothing about what root would run.
  [[ "$path" == "$annotated" ]] || return 0
  # stat can fail on an unreachable path, and a helper we cannot inspect is not a broken one.
  own="$(stat -c '%U:%G %a' "$path" 2>/dev/null)" || return 0
  if [[ "$own" == "root:root 755" ]]; then
    doctor_ok "root helper ($label): $path (root:root 0755)"
  else
    doctor_fail "root helper ($label) is $own, expected root:root 755: $path. $KEMPT_REINSTALL_HINT"
  fi
  # The directory, too: whoever can write to it can rename the helper away and put their own file
  # at the path polkit runs as root, however the helper itself is owned. Quiet when it is sound, so
  # every install does not grow a line; an unreadable directory is not reported as a broken one.
  dir="$(dirname "$path")"
  down="$(stat -L -c '%U:%G %a' "$dir" 2>/dev/null)" || return 0
  if [[ "${down%%:*}" != root ]] || (( 8#${down##* } & 8#022 )); then
    doctor_fail "root helper directory ($label) is $down, expected root-owned and not group- or world-writable: $dir. Fix it with: sudo chown root:root $dir && sudo chmod 755 $dir"
  fi
}

# --- the rows of `kempt doctor`, one function per group ------------------------------------------
# cmd_doctor below is the ORDER of the report and nothing else. Each function here owns one group
# of rows, keeps its own locals, and communicates only through DOCTOR_FAILS - which doctor_fail
# increments and the summary reads. Keep it that way: the rows share no other state.

doctor_privileged_rows() {
  doctor_helper refresh "$KEMPT_REFRESH_HELPER" "$KEMPT_REFRESH_HELPER_PATH"
  doctor_helper apply   "$KEMPT_APPLY_HELPER"   "$KEMPT_APPLY_HELPER_PATH"

  # Without the action file pkexec has no policy for these helpers and falls back to an
  # authentication DIALOG - see doctor_exec_path.
  if [[ -r "$KEMPT_POLICY_FILE" ]]; then
    doctor_ok "polkit action: $KEMPT_POLICY_FILE"
  else
    doctor_fail "polkit action not installed: $KEMPT_POLICY_FILE. $KEMPT_REINSTALL_HINT"
  fi
  # ...and the half a readable file can still get wrong: which helper path it pins.
  doctor_exec_path refresh io.github.erez_c137.kempt.refresh \
    "$KEMPT_REFRESH_HELPER" "$KEMPT_REFRESH_HELPER_PATH"
  doctor_exec_path apply   io.github.erez_c137.kempt.apply \
    "$KEMPT_APPLY_HELPER"   "$KEMPT_APPLY_HELPER_PATH"
}

# Directly under the version line and above every check, because it is the one row that decides
# whether the rest of the report means anything. On an image-based Fedora - Silverblue, Kinoite,
# Bazzite, a bootc image - rpm-ostree owns /usr and dnf is not how the machine updates, and nothing
# else here would ever say so: those images ship dnf5 and plasma-workspace, so both Kempt packages
# install cleanly, every row below passes honestly, and the report used to end "all checks passed"
# about a tool that cannot update that box.
# FAIL and not info: "everything is fine" is precisely the sentence that must not be printed here.
doctor_image_based_row() {
  on_ostree || return 0
  doctor_fail "Kempt does not update atomic Fedora (Kinoite, Silverblue, bootc image mode); use Discover, rpm-ostree or bootc upgrade. This system updates with rpm-ostree, not dnf ($KEMPT_OSTREE_MARKER exists). Support for these images is planned. The dnf checks below describe a tool that is not what installs updates on this machine."
}

doctor_tool_rows() {
  # flatpak: ask about the command the BACKEND runs (first word of its seam), never a hardcoded
  # name a test or a power user may have redirected.
  local fp_cmd; fp_cmd="${KEMPT_FLATPAK_LIST_CMD%% *}"
  if command -v "$fp_cmd" >/dev/null; then
    doctor_ok "flatpak: $(command -v "$fp_cmd")"
  elif ! is_true "$(config_get include_flatpak)"; then
    doctor_info "flatpak command '$fp_cmd' not found. Kempt does not need it while include_flatpak=false"
  elif config_is_set include_flatpak; then
    # Check and update skip it either way (flatpak_included). Set by hand, the setting asks for
    # something this box cannot do, so it is a WARN: worth settling, and nothing is broken.
    doctor_warn "Flatpak is not installed, so Kempt skips it although include_flatpak is on. Install flatpak, or run: kempt config set include_flatpak false"
  else
    doctor_info "Flatpak is not installed, so Kempt checks system packages only"
  fi
}

# How old the metadata behind every count is. Nothing else in this report would say: a check
# answers from a cache it refreshes at most once every three hours and skips on battery and on a
# metered link, so a box can go a week on one fetch with every surface looking freshly checked.
# info and never FAIL - old metadata is what the battery and metering rules are FOR, so it is a
# fact to put in front of the reader, not a fault to count against the install.
# The other updater in the same session. plasma-discover-notifier checks on its own schedule from
# PackageKit's separate cache, so its count and Kempt's can differ and both be right, and
# PackageKit's background work takes the dnf5 lock, which makes a Kempt run wait until it lets go.
# info, never FAIL: running both is a legitimate choice. Silent when it is not installed, or when
# its entry does not start in Plasma (lib/common.sh, discover_entry_starts).
doctor_other_updater_row() {
  discover_installed || return 0
  local entry
  entry="$(discover_effective_entry)"
  # Discover installing updates by itself, while its notifier is there to do it. Its prepared
  # update takes /system-update, and dnf5 then leaves that symlink alone, so the next restart
  # installs Discover's update and not a stage of Kempt's. WARN only when Kempt is set to stage.
  local decided
  if decided="$(discover_unattended_active)"; then
    local unattended="Discover is set to install updates by itself on restart ($decided). Once it has prepared an update, the next restart installs that and not an update Kempt staged. To leave updates to Kempt, run kempt discover-notifier off"
    if [[ "$(config_get surface)" == offline ]]; then
      doctor_warn "$unattended"
    else
      doctor_info "$unattended"
    fi
  fi
  if discover_entry_starts "$entry"; then
    doctor_info "Discover's update notifier also starts with your session ($entry). It counts updates on its own schedule, so its number can differ from Kempt's. Its background work can make a Kempt run wait. To turn it off, run kempt discover-notifier off or use Turn Off Discover's Notifier in the widget"
    return 0
  fi
  # Off by Kempt's entry, by the person's own, or by a desktop list that leaves Plasma out.
  if grep -qiE '^[[:space:]]*Hidden[[:space:]]*=[[:space:]]*true' "$entry"; then
    doctor_ok "Discover's update notifier: turned off for this user ($entry)"
  fi
}

doctor_metadata_row() {
  local iso days failed="" warned=""
  iso="$(metadata_refreshed_iso)"
  # The latest dnf fetch failed (offline, or the servers would not answer). A WARN, beside the age
  # row below: every check answers from the lists already here, and those can be old or missing.
  # Not while refreshing is off: the marker is from a download Kempt no longer tries, and the
  # advice below would fetch nothing. The widget stays quiet then too.
  local refresh_off=""
  [[ -n "${KEMPT_SKIP_REFRESH:-}" ]] && refresh_off=1
  [[ -s "$STATE_FILE" ]] \
    && [[ "$(jq -r -n '[inputs][0] | select(type == "object") | .refresh_skipped // empty | tostring' "$STATE_FILE" 2>/dev/null)" == off ]] \
    && refresh_off=1
  if [[ -f "$REFRESH_DNF_FAILED_FILE" && -z "$refresh_off" ]]; then
    failed="$(head -n 1 "$REFRESH_DNF_FAILED_FILE" 2>/dev/null | tr -d '[:cntrl:]' | cap_bytes 200)" || failed=""
    doctor_warn "package lists: the last download failed${failed:+ ($failed)}. Checks answer from the lists already on this computer. Check the network connection, then run: kempt check --refresh"
    warned=1
  fi
  # With no dnf fetch on record, the WARN above already says what the rows below would: one row.
  [[ -z "$iso" && -n "$warned" ]] && return 0
  # No dnf fetch on record: none has run, or only a Flatpak one has worked. The row is true for both.
  if [[ -z "$iso" ]]; then
    doctor_info "package lists: no dnf refresh recorded yet. Fetch them now with: kempt check --refresh, on mains power and an unmetered connection. If this row stays after that, dnf cannot refresh its package lists, and sudo dnf5 makecache --refresh shows why"
    return 0
  fi
  days="$(metadata_age_days)"
  if [[ "$days" == 0 ]]; then
    doctor_ok "package lists: refreshed $iso"
  else
    local word=days
    if [[ "$days" == 1 ]]; then word=day; fi
    doctor_info "package lists are $days $word old ($iso). Checks answer from them. A refresh runs at most once every 3 hours, and never on battery or a metered connection. To fetch them now, on mains power and an unmetered connection, run: kempt check --refresh"
  fi
}

# The last check failed. A WARN with the first line of its error, so a box where every check fails
# (offline, a broken repo) cannot read "no problems" with nothing beside it. dnf's no-cache text
# reads as kempt status words it, through the same jq def (check_problem).
doctor_last_check_row() {
  local line
  [[ -s "$STATE_FILE" ]] || return 0
  line="$(jq -r -n "$KEMPT_JQ_TIME$KEMPT_JQ_STATUS"'
            [inputs][0] | select(type == "object" and .status == "stale")
            | check_problem as $why
            | ((.last_success | type) == "string" and (.last_success | sub("^\\s+"; "")) != "") as $ever
            | "last check failed" + (if $why != "" then ": " + $why else "" end) + ". "
              + (if $ever then "The counts Kempt shows are from an earlier check"
                 else "There are no counts yet" end)' "$STATE_FILE" 2>/dev/null \
          | tr -d '[:cntrl:]' | cap_bytes 400)" || line=""
  [[ -n "$line" ]] && doctor_warn "$line"
  return 0
}

# Root's rule for dnf5's three folders. The test is the find in kempt-apply's check_folders with its
# owner and group at 0, and tests/test_doctor_folders.sh runs both on the same trees, so there is one
# rule set. An entry counts when root does not own it, since its owner can change it whatever its
# mode, or when it is world-writable and not a link. Group-writable counts only with a group other
# than root: root's files belong to group root, and a common Fedora umask of 002 sets that bit
# harmlessly. find -P never follows a link, so a link planted there cannot point the search elsewhere.
# Run as the user this sees less than root and nothing root would not, so what it finds root refuses
# over too, and what it does not find proves little: the helper still decides.
# A check that fails is an answer of its own, except a name that vanished: dnf-makecache rewrites
# the cache while this runs. Run as a user, "Permission denied" is not one either. dnf5's temporary
# folders are root-only on a stock system, and root reads them when the helper checks. The words
# are read in the C locale, and bfs's come out in the same last field.
DOCTOR_CHECK_ERROR=""
doctor_first_check_error() {  # find's output → DOCTOR_CHECK_ERROR, or ""
  local line
  DOCTOR_CHECK_ERROR=""
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    line="${line%.}"
    line="${line##*: }"
    [[ "$line" == "No such file or directory" ]] && continue
    [[ "$line" == "Permission denied" && $EUID -ne 0 ]] && continue
    DOCTOR_CHECK_ERROR="$line"
    return 0
  done <<<"$1"
}
DOCTOR_TREE_HIT=""
doctor_scan_tree() {  # dir → DOCTOR_TREE_HIT, the first entry another user could change, or ""; rc 1
                      # with DOCTOR_CHECK_ERROR set when the check itself failed
  local out rc=0 line
  DOCTOR_TREE_HIT=""
  [[ -e "$1" ]] || return 0
  out="$(LC_ALL=C "$KEMPT_FIND" -P "$1" -ignore_readdir_race \( ! -uid 0 -o \( ! -type l \( -perm -0002 -o \
    \( -perm -0020 ! -gid 0 \) \) \) \) -printf 'HIT %p\n' -quit 2>&1)" || rc=$?
  while IFS= read -r line; do
    if [[ "$line" == "HIT "* ]]; then DOCTOR_TREE_HIT="${line#HIT }"; return 0; fi
  done <<<"$out"
  if (( rc )); then
    doctor_first_check_error "$out"
    if (( rc != 1 )) || [[ -n "$DOCTOR_CHECK_ERROR" || -z "$out" ]]; then DOCTOR_CHECK_ERROR="${DOCTOR_CHECK_ERROR:-the check failed}"; return 1; fi
  fi
  return 0
}
# The folder the helper would refuse over, for a refusal before any password prompt and for what check
# and status say. A check that fails here is no answer, so that is the helper's to decide.
apply_unsafe_dir() {  # → the first such folder; rc 1 when there is none
  local d
  for d in "$KEMPT_DNF_SYSIMAGE_DIR" "$KEMPT_DNF_OFFLINE_PKG_DIR" "$KEMPT_DNF_CACHE_DIR"; do
    doctor_scan_tree "$d" || continue
    [[ -n "$DOCTOR_TREE_HIT" ]] && { doctor_plain_name "$d"; echo; return 0; }
  done
  return 1
}
apply_unsafe_words() {  # folder → the end of a sentence
  printf 'other users can change files in %s' "$(doctor_plain_name "$1")"
}
# The helper's own sentence for a refusal over the folders. It alone knows
# which: a user's reading cannot see what root was denied, and what is stored may be a second problem
# the helper never reached. Its line is the last thing it prints.
log_folder_refusal() {  # run log → the sentence; rc 1 when the last line is about something else
  [[ -f "$1" ]] || return 1
  local line
  line="$(tail -n 1 -- "$1")"
  case "$line" in
    "kempt-apply: Updates paused for safety: "*|"kempt-apply: Kempt could not check "*)
      doctor_plain_name "${line#kempt-apply: }"; echo ;;
    *) return 1 ;;
  esac
}
# Every byte outside printable ASCII becomes ?: control characters, C1 bytes and Unicode bidi
# controls alike, so a planted name cannot move the cursor or reorder the line. Root's dnf5 paths
# are ASCII, so nothing real is lost.
doctor_plain_name() {  # text → the text, safe to print
  local LC_ALL=C
  printf '%s' "${1//[^ -~]/?}"
}
doctor_dnf_cache_fix() {
  local dir_q fix
  printf -v dir_q '%q' "$KEMPT_DNF_CACHE_DIR"
  # Not dnf5 clean all: it follows links planted at <repo>/packages or <repo>/repodata and deletes
  # what they point at, outside the cache. The cache moves into a fresh root-only directory on the
  # same file system, so another user cannot reach it mid-delete, and rm stays on that file system.
  # --no-copy makes mv fail rather than fall back to a copy.
  fix="t=\$(sudo mktemp -d $dir_q-unsafe.XXXXXX) && sudo mv -T --no-copy $dir_q \"\$t/old\""
  fix+=" && sudo mkdir -m 0755 $dir_q && sudo restorecon $dir_q && sudo rm -rf --one-file-system \"\$t\""
  # A staged update is unaffected: dnf5 keeps its packages in /var/lib/dnf/offline/packages and
  # records their full paths, so it still installs from an empty cache. Another user still writing
  # into the old cache can make the last rm fail with "Directory not empty", which leaves a root-only
  # <dir>-unsafe.XXXXXX behind; the glob reaches it again.
  printf '%s' "Do not use dnf5 clean all on it, because it can delete files outside the cache. Replace the cache with: $fix. If the last step says the directory is not empty, run this again later: sudo rm -rf --one-file-system $dir_q-unsafe.*."
}
doctor_dnf_state_fix() {
  local dir_q lock_dirs drop_hard
  printf -v dir_q '%q' "$KEMPT_DNF_SYSIMAGE_DIR"
  # The directories first, and only them: once each is root's, with no group or world write, nobody
  # else can add, rename or remove a name anywhere in the tree. They are locked one at a time from
  # the top, each from inside its parent (-execdir with \;, which runs before find reads that
  # directory), so every path root acts on sits in a folder already locked: a batched -exec + would
  # act on full paths later, while another user could still swap a listed folder for a link and have
  # chmod, which always follows links, change its target. Then the hard links go. A file with more
  # than one name may be another user's file linked in from outside, and chown -R or chmod -R would
  # change that file itself, since a hard link is the same file. Deleting the name here leaves the
  # file outside as it was. dnf5 keeps no file with a second name in its state, so nothing of dnf5's
  # is lost. Doing this before the directories are locked would let another user link a file in again
  # behind the delete.
  # Then chown before chmod: chmod alone leaves another user's files theirs, and chmod before chown
  # leaves a moment where that owner can still open them for writing, or chmod them back. -h changes
  # a link, not its target. Links go last, once nobody else can add one: dnf5 keeps none in its state,
  # so one was planted, and chown -h would leave root's dnf5 going through it. find -P -delete removes
  # a link, never its target. Nothing here revokes a file another user already holds open for writing,
  # hence the restart. The lock-down keeps a staged update's record, and a changed record installs as
  # root, so the fix discards it last; dnf5 offline clean exits 0 when nothing is staged.
  lock_dirs="sudo find -P $dir_q -type d -execdir chown -h root:root {} \; -execdir chmod go-w {} \;"
  drop_hard="sudo find -P $dir_q ! -type d -links +1 -print -delete"
  printf '%s' "Fix it with: $lock_dirs && $drop_hard && sudo chown -R -h root:root $dir_q && sudo chmod -R go-w $dir_q && sudo find -P $dir_q -type l -print -delete && sudo dnf5 offline clean. The last step discards any update staged for the next restart, because its record may have been changed; stage it again afterwards. Then restart the computer. A program that opened one of these files earlier can still write to it until it stops. Run kempt doctor again afterwards, and repeat the fix if this line is still there."
}
doctor_dnf_staged_fix() {
  local dir_q
  printf -v dir_q '%q' "$KEMPT_DNF_OFFLINE_PKG_DIR"
  # The restart installs these packages as root without checking their signatures again, so a
  # swapped one runs its scripts as root. Their contents cannot be trusted, so the fix discards
  # the stage and the directory; dnf5 makes a new one at the next stage. dnf5 offline clean does
  # not follow links (checked on dnf5 5.4.6), and rm -rf never does.
  printf '%s' "A changed package there installs as root at the next restart. Before you restart, discard the staged update and remove the folder: sudo dnf5 offline clean && sudo rm -rf --one-file-system $dir_q. Then stage the updates again."
}
# A row only on a failure, from the find above. Reported, never repaired, because the fix needs root.
# Clean says nothing: this reading cannot vouch for a writable parent, a write ACL or a link.
doctor_dnf_folders_row() {
  local d fix
  for d in "$KEMPT_DNF_CACHE_DIR" "$KEMPT_DNF_SYSIMAGE_DIR" "$KEMPT_DNF_OFFLINE_PKG_DIR"; do
    if ! doctor_scan_tree "$d"; then
      doctor_fail "dnf folders: Kempt could not check $(doctor_plain_name "$d") ($DOCTOR_CHECK_ERROR). Root checks again before any update, and refuses if it cannot check either."
    elif [[ -n "$DOCTOR_TREE_HIT" ]]; then
      case "$d" in
        "$KEMPT_DNF_CACHE_DIR") fix="$(doctor_dnf_cache_fix)" ;;
        "$KEMPT_DNF_SYSIMAGE_DIR") fix="$(doctor_dnf_state_fix)" ;;
        *) fix="$(doctor_dnf_staged_fix)" ;;
      esac
      # Another user picks the entry's name, so it never reaches the terminal raw.
      doctor_fail "dnf folders: other users can change files in $(doctor_plain_name "$d") (for example $(doctor_plain_name "$DOCTOR_TREE_HIT")). Kempt 0.1.7 or earlier may have left them that way. $fix Until this is fixed, Kempt will not install or stage updates."
    fi
  done
}
# PID 1 starts dnf5, so in a namespace of its own this process would read folders dnf5 does not use. A
# user cannot read /proc/1/ns/mnt. PID 1's mount table is readable, and a different namespace shows a
# different one.
doctor_mount_ns_read() {  # → 0 when this process and PID 1 look like one namespace, or nobody can tell
  local self init a b
  self="$(readlink /proc/self/ns/mnt 2>/dev/null)" || return 0
  if init="$(readlink -- "$KEMPT_MNT_NS_INIT" 2>/dev/null)"; then
    [[ "$self" == "$init" ]]
    return
  fi
  a="$(cat /proc/1/mountinfo 2>/dev/null)" && [[ -n "$a" ]] || return 0
  b="$(cat /proc/self/mountinfo 2>/dev/null)" && [[ -n "$b" ]] || return 0
  [[ "$a" == "$b" ]]
}
doctor_mount_ns_row() {
  [[ -d "${KEMPT_SYSTEMD_BOOTED:-/run/systemd/system}" ]] || return 0
  # Twice, for the second table: a mount made between the two reads is not a namespace.
  doctor_mount_ns_read || doctor_mount_ns_read && return 0
  doctor_fail "mount namespace: Kempt is running in a different mount namespace from the system (as in a toolbox, or a sandboxed terminal), so what it checks is not what dnf5 uses. Run Kempt from a terminal or session on the host."
}

doctor_config_row() {
  # The config file is read with `grep "^key="`, so a line that is not key=value is ignored and the
  # setting the user believes they wrote never applies. Validated exactly as config_set validates.
  local line n=0 bad=0 keys=0 k
  if [[ ! -e "$CONFIG_FILE" ]]; then
    doctor_ok "config file: none yet, built-in defaults apply ($CONFIG_FILE)"
  elif [[ ! -r "$CONFIG_FILE" ]]; then
    doctor_fail "config file is not readable: $CONFIG_FILE. Every command silently falls back to defaults"
  else
    # `|| [[ -n "$line" ]]`: a final line with no trailing newline is still a line.
    while IFS= read -r line || [[ -n "$line" ]]; do
      n=$(( n + 1 ))
      [[ -z "${line//[[:space:]]/}" ]] && continue
      k="${line%%=*}"
      if [[ "$line" != *=* || ! "$k" =~ ^[a-z][a-z0-9_]+$ ]]; then
        doctor_fail "config file line $n is not key=value: $line ($CONFIG_FILE)"
        bad=$(( bad + 1 ))
      else
        keys=$(( keys + 1 ))
      fi
    done < "$CONFIG_FILE"
    # The `if` form, not `[[ ... ]] && x=y`: a false test as a branch's last command returns 1 and
    # errexit would kill the checkup halfway through.
    if [[ $bad -eq 0 ]]; then
      local sword=settings
      if [[ $keys -eq 1 ]]; then sword=setting; fi
      doctor_ok "config file: $CONFIG_FILE ($keys $sword)"
    fi
  fi
}

doctor_state_dir_row() {
  # "Writable" means "can be written OR created": nothing has run yet on a fresh install, and a
  # checkup must not CREATE the directory it checks - so walk up to the nearest existing ancestor.
  local probe="$KEMPT_STATE_DIR"
  while [[ ! -e "$probe" ]]; do
    [[ "$probe" == */* && "$probe" != / ]] || break
    probe="${probe%/*}"; [[ -n "$probe" ]] || probe=/
  done
  if [[ -d "$probe" && -w "$probe" ]]; then
    if [[ "$probe" == "$KEMPT_STATE_DIR" ]]; then
      doctor_ok "state dir writable: $KEMPT_STATE_DIR"
    else
      doctor_ok "state dir writable: $KEMPT_STATE_DIR (created on first use)"
    fi
  else
    doctor_fail "state dir not writable: $KEMPT_STATE_DIR. No state, history or logs can be written"
  fi
}

# dnf5 still holds a transaction at `ready` whose packages are all installed, with no symlink of
# its own in front of it: another updater installed the same updates. Nothing will run it again.
# Advice only. `kempt unstage` removes it, but `dnf5 offline clean` also removes another updater's
# symlink, so while one stands the advice waits for the restart.
doctor_stale_done_row() {  # link-state
  if [[ "$1" == other ]]; then
    doctor_info "dnf5 still keeps an offline transaction whose updates are already installed. It will not run again. To remove it after the next restart, run: kempt unstage"
  else
    doctor_info "dnf5 still keeps an offline transaction whose updates are already installed. It will not run again. To remove it, run: kempt unstage"
  fi
}

# While another updater holds the restart, Kempt refuses to stage or unstage, and a clean would remove
# that updater's link. The row about the link says who holds it, so these rows offer nothing then.
doctor_fix_unless_held() {  # holder, the advice → " advice", or nothing
  [[ "$1" == other ]] || printf ' %s' "$2"
}

doctor_offline_rows() {
  # The stored transaction, one row for what stage_read says it is. Silent when nothing is stored,
  # which is most boxes.
  local dr_word dr_toml dr_link dr_holder dr_names dr_count=""
  dr_word="$(stage_read)"
  dr_toml="$(offline_system_status)"
  dr_holder="$(restart_holder)"
  dr_link="$(offline_link_state)"
  case "$dr_word" in
    armed)
      dr_count="$(offline_txjson_names | grep -c . || true)"
      # One package is its own sentence, verb included.
      if [[ "$dr_count" == 1 ]]; then
        doctor_info "staged update: 1 package installs on the next restart. To remove it, run: kempt unstage. If that fails: sudo dnf5 offline clean"
      else
        doctor_info "staged update: $dr_count packages install on the next restart. To remove them, run: kempt unstage. If that fails: sudo dnf5 offline clean"
      fi
      doctor_staged_conflict_row ;;
    done) doctor_stale_done_row "$dr_link" ;;
    lost)
      doctor_warn "prepared updates will not install: dnf5 says \"$dr_toml\", and no restart will install them now.$(doctor_fix_unless_held "$dr_holder" "Prepare them again with: kempt update --surface=offline. To remove them, run: kempt unstage. If that fails: sudo dnf5 offline clean")" ;;
    interrupted)
      doctor_warn "prepared updates will not install: a restart began them and stopped, and dnf5 does not run them again. See what happened with: dnf5 history info. Prepare them again with: kempt update --surface=offline. To remove them, run: kempt unstage. If that fails: sudo dnf5 offline clean" ;;
    failed)
      doctor_fail "staged update failed: a restart ran it and dnf5 recorded a failure (status \"$dr_toml\"), and no restart runs it again. See what happened with: sudo dnf5 offline log.$(doctor_fix_unless_held "$dr_holder" "Clear it with: kempt unstage. If that fails: sudo dnf5 offline clean")" ;;
    unknown)
      doctor_warn "staged update: Kempt cannot tell what the stored update will do, because $KEMPT_OFFLINE_TOML cannot be read or says something this version does not know. It may be a Fedora release upgrade. See it with: sudo dnf5 offline status.$(doctor_fix_unless_held "$dr_holder" "Clear it with: sudo dnf5 offline clean")" ;;
    upgrade)
      # A release upgrade answers for the whole section: dnf5 has one slot, and Kempt's own stage is
      # not in it. Which of the states it is in decides the sentence.
      local dr_relup
      dr_relup="$(offline_release_upgrade)"
      case "$(offline_release_upgrade_state)" in
        armed)
          doctor_info "a Fedora release upgrade ($dr_relup) is prepared outside Kempt and installs on the next restart. Remove it with: sudo dnf5 offline clean. Kempt will not prepare updates over it, because that would cancel it" ;;
        foreign)
          doctor_info "a Fedora release upgrade ($dr_relup) is stored outside Kempt and set to install, but another updater has prepared the next restart, so it will not install then. After that restart, install it with: sudo dnf5 system-upgrade reboot, or remove it with: sudo dnf5 offline clean. Kempt will not prepare updates while it is there, because that would cancel it" ;;
        stranded)
          # The FAIL row further down gives the remedy.
          doctor_info "a Fedora release upgrade ($dr_relup) is stored outside Kempt and was set to install, but the restart marker $KEMPT_OFFLINE_LINK is not in place. A restart went by without installing it, and no restart will install it now. Kempt will not prepare updates while it is there, because that would cancel it" ;;
        incomplete)
          doctor_info "a Fedora release upgrade ($dr_relup) is stored outside Kempt and did not finish (status \"$dr_toml\"). See what happened with: sudo dnf5 offline log, or remove it with: sudo dnf5 offline clean. Kempt will not prepare updates while it is there, because that would cancel it" ;;
        *)
          doctor_info "a Fedora release upgrade ($dr_relup) has been downloaded outside Kempt but not started (status \"$dr_toml\"), so no restart installs it yet. Begin it with: sudo dnf5 system-upgrade reboot, or remove it with: sudo dnf5 offline clean. Kempt will not prepare updates while it is there, because that would cancel it" ;;
      esac ;;
  esac

  # The boot symlink, the half of arming that decides what the next restart does. A symlink over a
  # transaction that is not `ready` is a state the box reaches on its own: re-staging destroys the
  # old transaction before the new one exists, so a stage failing in between leaves exactly this,
  # and the boot detours into the offline updater and installs nothing.
  # -L is lstat: system-update-generator does not resolve it either, so a dangling one detours the
  # boot exactly as a live one does. Another updater's link is that updater's business: what it
  # changes for Kempt is said here, once. A plain file holds the restart just the same.
  if [[ "$dr_holder" == other ]]; then
    local dr_target dr_where
    dr_target="$(readlink "$KEMPT_OFFLINE_LINK" 2>/dev/null || true)"
    dr_where="$KEMPT_OFFLINE_LINK points to $dr_target"
    [[ -n "$dr_target" ]] || dr_where="$KEMPT_OFFLINE_LINK is not dnf5's"
    if [[ "$dr_word" == other ]]; then
      doctor_warn "another updater has prepared the next restart ($dr_where), so the transaction dnf5 holds will not install then"
    else
      doctor_warn "another updater has prepared the next restart: $dr_where"
    fi
  elif [[ "$dr_link" == dnf5 && "$dr_toml" != ready && "$dr_toml" != unknown ]]; then
    if [[ "$dr_toml" == absent ]]; then
      doctor_fail "boot symlink is live with nothing prepared behind it: $KEMPT_OFFLINE_LINK. The next restart detours into the offline updater and installs nothing. Remove it with: sudo dnf5 offline clean"
    else
      doctor_fail "boot symlink is live over a transaction that is not set to install (status \"$dr_toml\"): $KEMPT_OFFLINE_LINK. The next restart detours into the offline updater and installs nothing. Clear it with: sudo dnf5 offline clean"
    fi
  elif [[ "$dr_word" == upgrade && "$dr_toml" == ready && "$dr_link" == none ]]; then
    doctor_fail "the stored Fedora release upgrade can never install: dnf5 says \"ready\" but the restart marker $KEMPT_OFFLINE_LINK is not in place, so a restart has already been past it. Set it to install again with: sudo dnf5 system-upgrade reboot, or clear it with: sudo dnf5 offline clean"
  fi
}

doctor_install_rows() {
  # The RPM ships bin/, lib/ and backends/ under /usr/share/kempt, and the package manager keeps the
  # helpers, the policy and the widget in step. What it cannot see is a widget in the user's own
  # directory. kpackagetool6 (the KDE Store route) installs there, and Plasma PREFERS that copy, so
  # a store install predating the package stays the widget Plasma loads, and no other row catches it.
  # Shadowing needs TWO copies: with only the CLI package installed, the store copy is the one
  # widget on the box, and failing the checkup over it tells somebody to delete their only panel.
  # That case gets the same remedy as a pointer instead: install the widget package, THEN remove
  # the store copy.
  if [[ -d "$KEMPT_PLASMOID_DIR" && ! -d "$KEMPT_SYSTEM_PLASMOID_DIR" ]]; then
    doctor_info "store widget in use: the panel runs the KDE Store copy in $KEMPT_PLASMOID_DIR, and package updates do not reach it. Install the widget package with: sudo dnf install kempt-plasmoid, then remove the store copy with: kpackagetool6 -t Plasma/Applet -r io.github.erez_c137.kempt, then plasmashell --replace"
  elif [[ -d "$KEMPT_PLASMOID_DIR" ]]; then
    doctor_fail "user widget copy shadows the package: $KEMPT_PLASMOID_DIR. Plasma loads this copy instead of the packaged widget, so package updates never reach your panel. Remove it with: kpackagetool6 -t Plasma/Applet -r io.github.erez_c137.kempt, then plasmashell --replace"
  elif [[ ! -d "$KEMPT_SYSTEM_PLASMOID_DIR" ]]; then
    # The panel half is its own package, so a working CLI can sit on a box with no widget and
    # nothing would say why. info, not FAIL: the CLI is the whole tool for anyone who wanted it.
    # ...and what going without it means, because the CLI alone is not a quieter widget.
    doctor_info "panel widget not installed. It is a separate package: sudo dnf install kempt-plasmoid. Without it nothing runs checks on a schedule, so the CLI checks only when you run it, from an active local session (not over SSH)"
  fi
}

doctor_recent_events() {
  # Not a check, and deliberately below every check that is: doctor answers "is this install
  # sound", and the next question is "then why did my change not take effect?". The last five
  # events answer that in place, without anyone needing to know `kempt log` exists. Indented, so
  # nothing here can be mistaken for a report line.
  echo
  echo "Recent events (kempt log):"
  if [[ -s "$EVENTS_FILE" ]]; then
    tail -n 5 "$EVENTS_FILE" | events_safe | sed 's/^/  /'
  else
    echo "  none"
  fi
  echo
}

cmd_doctor() {
  DOCTOR_FAILS=0
  # First line, and info rather than ok: not a check that can pass or fail, but the fact every
  # other line has to be read against - a report pasted into a bug report without it describes an
  # unknown build.
  doctor_info "kempt $(kempt_version) ($KEMPT_ROOT)"
  doctor_image_based_row
  doctor_privileged_rows

  doctor_tool_rows
  doctor_other_updater_row
  doctor_metadata_row
  doctor_last_check_row
  doctor_mount_ns_row
  doctor_dnf_folders_row
  doctor_config_row
  doctor_state_dir_row
  doctor_offline_rows
  doctor_startup_row
  doctor_install_rows
  # A leftover ~/.local/bin/kempt wins over /usr/bin/kempt for the panel and for nothing else.
  doctor_widget_engine

  doctor_recent_events

  # Warnings never change the exit status, but the last line counts them: "all checks passed"
  # right under a WARN reads as if the WARN did not count.
  local warned=""
  if [[ $DOCTOR_WARNS -eq 1 ]]; then warned="1 warning"
  elif [[ $DOCTOR_WARNS -gt 1 ]]; then warned="$DOCTOR_WARNS warnings"; fi
  if [[ $DOCTOR_FAILS -eq 0 ]]; then
    if [[ -n "$warned" ]]; then echo "kempt doctor: no problems, $warned"
    else echo "kempt doctor: all checks passed"; fi
    return 0
  fi
  local word=problems
  if [[ $DOCTOR_FAILS -eq 1 ]]; then word=problem; fi
  echo "kempt doctor: $DOCTOR_FAILS $word found${warned:+, $warned}"
  return 1
}

# Turns Discover's update notifier off or on for this user, or says where it stands. The work is
# in lib/common.sh.
cmd_discover_notifier() {
  case "${1:-}" in
    off|on|keep) [[ $# -eq 1 ]] || { echo "unknown option: $2" >&2; exit 2; }
            # The widget and Settings run these on separate queues: one at a time, so two offs
            # cannot both find no kept copy and overwrite each other's.
            writer_lock || exit 1
            "discover_notifier_$1" ;;
    seen)   [[ $# -eq 1 ]] || { echo "unknown option: $2" >&2; exit 2; }
            discover_notifier_seen ;;
    status) [[ $# -eq 1 || ( $# -eq 2 && "$2" == --json ) ]] || { echo "unknown option: $2" >&2; exit 2; }
            discover_notifier_status "${2:-}" ;;
    *) echo "usage: kempt discover-notifier off | on | keep | status [--json] | seen" >&2; exit 2 ;;
  esac
}

# Exit codes (one contract, every command):
#   0 success - including a user who declines at the risky-transaction prompt
#   1 the run itself failed (a backend returned non-zero), `check --strict` had a backend fail,
#     could not list the Flatpak apps installed for you only or served the previous state, `doctor` found a
#     problem, or a writer
#     (config set / hold / unhold / discover-notifier off|on|keep) could not take the writers' lock. docs/usage.md carries the
#     same table. Keep the two in step.
#     Also reclaim when flatpak failed or a runtime it was given is still there
#   2 usage error (unknown command, option or argument)
#   3 cannot start: jq missing, or another kempt update already holds the lock
#   5 aborted during pre-flight - nothing was changed
#   7 update only: another program held the dnf or Flatpak lock through all three tries
#   8 run as root: every command but help, version and `discover-notifier status` refuses
# One block per command, in the order `kempt help` lists them. A block is the command's synopsis
# lines (two spaces in), each followed by its description at column 24. `kempt help` prints them
# all; `kempt <command> --help` and `kempt help <command>` print one (usage_of).
KEMPT_USAGE_ORDER="check update run status summary history log doctor hold unhold holds unstage reclaim startup config
discover-notifier version help"
usage_block() {  # command → its block, or nothing for a command Kempt does not have
  case "$1" in
    check) cat <<'EOF'
  check [--refresh] [--anyway] [--coalesce] [--strict]
                        refresh pending-updates state (JSON to stdout). --refresh fetches package
                        metadata now, ignoring the 3-hour interval but never the battery or
                        metered-connection rules. --anyway downloads package lists now, even on
                        battery or a metered connection. --coalesce accepts the answer of a check
                        that finished while this one waited (the widget's automatic checks).
                        --strict exits 1 when dnf or Flatpak failed, the Flatpak apps installed
                        for you only could not be listed, or the previous state was served
EOF
    ;;
    update) cat <<'EOF'
  update [--no-flatpak] [--surface=X] [--risky-ok] [--answered]
                        run the update now, in this process. The options override the config
                        for this run. --no-flatpak updates system packages only. --surface=X
                        picks where it runs: widget, or offline, which stages it for
                        the next restart. At a terminal it shows the output and asks
                        before session-critical updates. --risky-ok leaves out the
                        session-critical notification. With auto_accept off and no
                        terminal it refuses, unless --answered says the person already chose
EOF
    ;;
    run) cat <<'EOF'
  run [--print-command] [--surface=X] [--risky-ok]
                        start an update where the config says, as Update Now does, and return.
                        --print-command prints the launch command and starts nothing.
                        --surface=X runs this one elsewhere: widget or offline.
                        --risky-ok as for update
EOF
    ;;
    status) cat <<'EOF'
  status [--list] [--json]
                        what the last check found, in words: pending, held, staged, restart owed.
                        Reads only. Exits 1 when there is no state, it cannot be read, or the
                        last check failed. --list prints every update with both versions, held
                        ones marked held. --json prints the published state, and exits 1 only
                        when there is none
EOF
    ;;
    summary) cat <<'EOF'
  summary [N | --json]  human summary of the last (or Nth-last) run. --json prints the newest
                        run's history entry, verbatim JSON (nothing if no runs yet, or if the
                        newest entry is damaged)
EOF
    ;;
    history) cat <<'EOF'
  history [--json]      list past runs, newest first; --json prints them as a JSON array of
                        history entries
EOF
    ;;
    log) cat <<'EOF'
  log [-n N]            recent events: what Kempt did, when, and from where (default 30).
EOF
    ;;
    doctor) cat <<'EOF'
  doctor                check this install: helpers, polkit action, tools, config, state
EOF
    ;;
    hold) cat <<'EOF'
  hold dnf:<pkg> | flatpak:<app.id>
                        skip in updates, still listed
EOF
    ;;
    unhold) cat <<'EOF'
  unhold dnf:<pkg> | flatpak:<app.id>
                        remove a hold
EOF
    ;;
    holds) cat <<'EOF'
  holds                 list holds
                        arguments, on one line, to reuse by hand
EOF
    ;;
    unstage) cat <<'EOF'
  unstage               discard the staged offline update; the next restart installs nothing
EOF
    ;;
    reclaim) cat <<'EOF'
  reclaim [--list] [-y] [REF...]
                        remove the Flatpak runtimes no installed app uses (--list only shows them)
EOF
    ;;
    startup) cat <<'EOF'
  startup [--json]      services that stopped starting after an update, and how to see why
                        (read only)
  startup mute|unmute <unit> [--user]
                        hide one until it starts again, or show it again
EOF
    ;;
    config) cat <<'EOF'
  config get <key> [default]
  config set <key> <value>
                        read or write a setting. surface takes widget or offline
EOF
    ;;
    discover-notifier) cat <<'EOF'
  discover-notifier off | on | keep | status [--json] | seen
                        turn Discover's own update notifier off or back on for this user, keep
                        it as it is (the widget's answer), record that the widget showed its
                        warning, or say whether it is installed, on and running
EOF
    ;;
    version|--version|-V) cat <<'EOF'
  --version | version | -V   print the version and exit
EOF
    ;;
    help|--help|-h) cat <<'EOF'
  help [command] | --help | -h
                        print this list, or one command's usage
EOF
    ;;
  esac
}

usage() {
  local c
  echo "usage: kempt <command>"
  for c in $KEMPT_USAGE_ORDER; do usage_block "$c"; done
  printf '\nMore: man kempt\n'
}

# One command's usage: its synopsis lines as "usage: kempt ...", then its description. Returns 1,
# printing nothing, for a command Kempt does not have.
usage_of() {  # command
  local block
  block="$(usage_block "$1")"
  [[ -n "$block" ]] || return 1
  awk '
    /^  [^ ]/ {
      line = substr($0, 3); desc = ""
      if (match(line, /   *[^ ]/)) { desc = substr(line, RSTART); line = substr(line, 1, RSTART - 1) }
      sub(/^ +/, "", desc)
      print (n++ ? "       kempt " : "usage: kempt ") line
      if (desc != "") d[nd++] = desc
      next
    }
    { sub(/^ +/, ""); d[nd++] = $0 }
    END { if (nd) print ""; for (i = 0; i < nd; i++) print "  " d[i] }' <<<"$block"
  printf '\nMore: man kempt\n'
}

# --help or -h right after any command asks for help, and gets it before the command runs or
# parses anything, so `kempt update --help` can never start an update. The help is that command's
# own. A command Kempt does not have is a usage error, as it is without the flag.
if [[ $# -ge 2 && ( "$2" == --help || "$2" == -h ) ]]; then
  usage_of "$1" && exit 0
  echo "unknown command: ${1:-''}" >&2; usage >&2; exit 2
fi

# Kempt is a per-user tool: as root it would read and write root's config and state, and the
# polkit rule it renders would name root. Help, the version and the read-only notifier status
# stay open, since they change nothing.
if [[ $EUID -eq 0 && "${KEMPT_ALLOW_ROOT:-}" != 1 ]]; then
  case "${1:-help} ${2:-}" in
    "help "*|"--help "*|"-h "*|"version "*|"--version "*|"-V "*|"discover-notifier status") ;;
    *) echo "kempt: run Kempt as your own user, without sudo. It asks for a password when it needs one." >&2
       exit 8 ;;
  esac
fi

case "${1:-help}" in
  check)   shift; cmd_check "$@" ;;
  update)  shift; cmd_update "$@" ;;
  run)     shift; cmd_run "$@" ;;
  status)  shift; cmd_status "$@" ;;
  summary) shift; cmd_summary "$@" ;;
  history) shift; cmd_history "$@" ;;
  log)     shift; cmd_log "$@" ;;
  doctor)  shift; [[ $# -eq 0 ]] || { echo "unknown option: $1" >&2; exit 2; }; cmd_doctor ;;
  config)  shift; cmd_config "$@" ;;
  hold)    shift; cmd_hold "$@" ;;
  unhold)  shift; cmd_unhold "$@" ;;
  holds)   shift; cmd_holds "$@" ;;
  unstage) shift; cmd_unstage "$@" ;;
  reclaim) shift; cmd_reclaim "$@" ;;
  startup) shift; cmd_startup "$@" ;;
  discover-notifier) shift; cmd_discover_notifier "$@" ;;
  version|--version|-V) shift; cmd_version "$@" ;;
  help|--help|-h)
    if [[ $# -le 1 ]]; then usage
    elif ! usage_of "$2" >/dev/null; then
      echo "unknown command: ${2:-''}" >&2; usage >&2; exit 2
    elif [[ $# -gt 2 ]]; then echo "unknown option: $3" >&2; exit 2
    else usage_of "$2"
    fi ;;
  *) echo "unknown command: ${1:-''}" >&2; usage >&2; exit 2 ;;
esac

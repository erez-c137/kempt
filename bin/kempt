#!/usr/bin/env bash
# Kempt - one-click system updates. See docs/architecture.md
set -euo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(dirname "$(dirname "$SELF")")"
source "$ROOT/lib/common.sh"
source "$ROOT/backends/dnf.sh"
source "$ROOT/backends/flatpak.sh"

command -v jq >/dev/null || { echo "kempt: requires jq" >&2; exit 3; }

# Both spellings, because both get typed.
cmd_version() {
  [[ $# -eq 0 ]] || { echo "unknown option: $1" >&2; exit 2; }
  printf 'kempt %s\n' "$(kempt_version)"
}

# --- reclaiming disk space ------------------------------------------------------------------------
# The error line of a removal that stopped because the list of unused runtimes could not be read.
KEMPT_RECLAIM_NO_LIST="Flatpak did not answer when asked what is unused"
# How long a ref must stay unused, with the same commit, before Kempt offers or removes it. flatpak
# deploys a runtime BEFORE the app that needs it, and nothing locks the whole transaction, so a
# runtime another tool is installing right now can look unused for a moment. An hour keeps that
# moment out of every offer and every removal.
KEMPT_RECLAIM_SETTLE=3600

# The unused refs with the time each was first seen unused, carried over from the last check's
# state.json when the ref still has the same commit. `since` is UTC with a Z, because jq can read
# that form back and the offerable test below is done in jq. A since that cannot be read, or lies
# in the future (a clock stepped back), starts again now: the safe direction.
reclaim_classify() {  # $1 = listing JSON → [{ref, commit, since, eol, offerable}]
  local prev
  prev="$(jq -c -n '[inputs][0].reclaim.refs? // []
                    | if type == "array" then [.[] | select(type == "object"
                        and (.ref | type == "string") and (.commit | type == "string"))] else [] end' \
          "$STATE_FILE" 2>/dev/null)" || prev='[]'
  [[ "$prev" == \[* ]] || prev='[]'
  # Every listing and ref list goes to jq as a file, never as an argument: Linux caps one argument
  # at 128 KiB, which a machine with a few hundred installed refs passes.
  jq -c -n --slurpfile l <(printf '%s\n' "$1") --slurpfile prev <(printf '%s\n' "$prev") \
        --argjson now "$(date +%s)" \
        --arg nowiso "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson settle "$KEMPT_RECLAIM_SETTLE" '
    $l[0] as $l | $prev[0] as $prev
    | ($prev | map({key: (.ref + " " + .commit), value: .since}) | from_entries) as $p
    | [$l.unused[]
       | ($p[.ref + " " + .commit] // null) as $s
       | (if ($s | type) == "string" then (try ($s | fromdateiso8601) catch null) else null end) as $se
       | (if $se == null or $se > $now then {since: $nowiso, age: 0}
          else {since: $s, age: ($now - $se)} end) as $t
       | {ref, commit, since: $t.since, eol, offerable: ($t.age >= $settle)}]'
}

# The reclaim object for state.json, or nothing when the feature does not apply here: flatpak off
# or absent, reclaim=off, or a process running as root. Called from cmd_check, which must never fail
# because of it, so every step degrades instead of returning an error: a listing that fails is
# status `failed`, a size that cannot be worked out is status `unknown_size`.
reclaim_check_block() {  # fp_enabled(true|false) → JSON object, or nothing
  [[ "$1" == true ]] || return 0
  reclaim_as_root && return 0
  flatpak_present || return 0
  local mode last listing classified sizes_tsv sizes='{}' sized=true digest
  mode="$(reclaim_effective_mode)"
  [[ "$mode" != off ]] || return 0
  last="$(reclaim_last_read)"
  if ! listing="$(flatpak_unused_list 2>/dev/null)"; then
    jq -cn --arg mode "$mode" --slurpfile last <(printf '%s\n' "$last") \
      '$last[0] as $last
       | {mode: $mode, refs: [], offerable_bytes: null, digest: "", status: "failed"}
       + (if $last == {} then {} else {last: $last} end)' 2>/dev/null || true
    return 0
  fi
  classified="$(reclaim_classify "$listing")" || return 0
  # The removal takes the whole list or nothing, so while any ref has been unused for less than
  # an hour there is no offer at all: the refs are listed with their since, the digest is empty,
  # and there is no size to estimate.
  if ! jq -e 'all(.offerable)' <<<"$classified" >/dev/null 2>&1; then
    jq -cn --arg mode "$mode" --slurpfile c <(printf '%s\n' "$classified") --slurpfile last <(printf '%s\n' "$last") \
      '$c[0] as $c | $last[0] as $last
       | {mode: $mode, refs: [$c[] | {ref, commit, since, eol}], offerable_bytes: null, digest: "", status: "ok"}
       + (if $last == {} then {} else {last: $last} end)' 2>/dev/null || true
    return 0
  fi
  if sizes_tsv="$(flatpak_unused_sizes "$listing" 2>/dev/null)"; then
    sizes="$(jq -R -n -c '[inputs | split("\t") | select(length == 2)
                           | {key: .[0], value: (.[1] | tonumber)}] | from_entries' <<<"$sizes_tsv" 2>/dev/null)" \
      || { sizes='{}'; sized=false; }
  else
    sized=false
  fi
  digest="$(jq -r '.[] | select(.offerable) | "\(.ref)\t\(.commit)"' <<<"$classified" 2>/dev/null | reclaim_digest)" \
    || return 0
  # needs_auth and failed are carried from the last removal only while the set it tried is still
  # the set on offer: a failure is shown once per set, and a new set gets a fresh chance.
  jq -cn --arg mode "$mode" --slurpfile c <(printf '%s\n' "$classified") --slurpfile sz <(printf '%s\n' "$sizes") \
         --argjson sized "$sized" --arg digest "$digest" --slurpfile last <(printf '%s\n' "$last") '
    $c[0] as $c | $sz[0] as $sz | $last[0] as $last
    | ($c | map(select(.offerable))) as $off
    | {mode: $mode,
       refs: [$c[] | {ref, commit, since, eol}],
       offerable_bytes: (if ($off | length) == 0 then 0
                         elif $sized then ($off | map($sz[.ref] // 0) | add)
                         else null end),
       digest: $digest,
       status: (if ($off | length) > 0 and ($sized | not) then "unknown_size"
                elif $digest != "" and $last.digest? == $digest
                     and ($last.result? == "needs_auth" or $last.result? == "failed") then $last.result
                else "ok" end)}
    + (if $last == {} then {} else {last: $last} end)' 2>/dev/null || true
}

# May this process remove runtimes without anyone being asked? pkcheck answers for this process
# WITHOUT --allow-user-interaction, so it never raises a dialog: yes only where polkit already says
# yes (Fedora's rule: an active local session of a wheel member). Anything else, including a
# missing pkcheck or one that does not answer in time, is "no", and the removal becomes needs_auth.
# Every removal asks this first.
reclaim_authorized() {
  # shellcheck disable=SC2086  # the seam may carry its own arguments
  timeout "$KEMPT_RECLAIM_PKCHECK_TIMEOUT" $KEMPT_PKCHECK --action-id org.freedesktop.Flatpak.runtime-uninstall --process $$ \
    </dev/null >/dev/null 2>&1 9>&-
}

# The one removal, shared by `kempt reclaim` and the automatic step after an update. The caller
# holds the update lock. Prints flatpak's own output on stdout and returns 0 whatever happened: the
# outcome is in the globals below, because this runs on the far side of an update, where nothing
# it does may fail the run.
#   RECLAIM_RESULT  removed | nothing | changed | needs_auth | failed
#   RECLAIM_WHY     for changed: digest | unstable | new (not in the run's before-snapshot)
#   RECLAIM_GONE    JSON array of the refs that are really gone, or null when that is unknown
#   RECLAIM_PARTIAL 1 when flatpak failed after the removal began: some refs may be gone, not all
#   RECLAIM_BYTES   their cached sizes added up, or empty when unknown
#   RECLAIM_ERROR   why it failed: flatpak's error line (error_line_of), or empty
#   RECLAIM_IN_USE  JSON array of id//branch: extensions flatpak said an app uses and removed anyway,
#                   or empty when there were none
#
# The refs are removed by name, so what goes is always part of the set the person agreed to. The
# list is taken again first, and the removal goes ahead only when ALL of it is that set (the digest)
# and all of it has been unused for the settle time. The slow steps (polkit, du) come first; the
# last look, and its comparison, is the only thing between the list and the removal.
# Then two passes. A runtime that an app started needing after that last look stays: flatpak
# refuses to remove a runtime an installed app uses, and no --force-remove is passed. An extension
# is not protected the same way: flatpak prints that an app uses it and removes it anyway (seen on a
# VM, a Locale extension; a GL extension works the same, and an app without it may not start). So
# the first pass removes everything that is not an extension (reclaim_extensions_in), the list is
# taken once more, and the second removes only the agreed extensions still unused: an app installed
# meanwhile made its runtime used, and that runtime's extensions are off the list. What is left is
# an app installed in the moment before the second pass; flatpak's Info line for it is read back
# into RECLAIM_IN_USE, and `flatpak update` puts the extension back.
# A first pass that ran out of time ends the removal. One that failed otherwise (flatpak refused a
# runtime now needed) still goes on to the extensions nothing uses; the outcome is partial either
# way. RECLAIM_RC and RECLAIM_ERROR are the first failing pass's: that is the pass whose reason says
# what went wrong (a refused runtime), and a second pass failing too usually fails for the same one.
reclaim_remove() {  # via expected-digest [before-snapshot.tsv]
  local via="$1" expected="$2" before="${3:-}"
  RECLAIM_RESULT=failed RECLAIM_WHY="" RECLAIM_GONE='[]' RECLAIM_BYTES="" RECLAIM_RC="" RECLAIM_ERROR=""
  RECLAIM_PARTIAL="" RECLAIM_IN_USE="" RECLAIM_SKIPPED=""
  local listing sizes_tsv="" after mid rc=0 prc out_file="" saved_trap="" prev_cmd=""
  local pass1=() pass2=() tried=() skip2="" ran2="" t0 used limit mark=0
  if ! listing="$(flatpak_unused_list 2>/dev/null)"; then
    RECLAIM_ERROR="$KEMPT_RECLAIM_NO_LIST"; reclaim_record "$via" "$expected"; return 0
  fi
  reclaim_compare "$listing" "$expected" "$before" || return 0
  if ! reclaim_authorized; then
    RECLAIM_RESULT=needs_auth; reclaim_record "$via" "$RECLAIM_DIGEST"; return 0
  fi
  # Sizes BEFORE the removal: afterwards the directories are gone and du has nothing to measure.
  sizes_tsv="$(flatpak_unused_sizes "$listing" 2>/dev/null)" || sizes_tsv=""
  if ! listing="$(flatpak_unused_list 2>/dev/null)"; then
    RECLAIM_RESULT=failed RECLAIM_ERROR="$KEMPT_RECLAIM_NO_LIST"; reclaim_record "$via" "$expected"; return 0
  fi
  reclaim_compare "$listing" "$expected" "$before" || return 0
  readarray -t pass2 < <(reclaim_extensions_in "$listing")
  readarray -t pass1 < <(jq -r --args '.unused[].ref | select(. as $r | $ARGS.positional | index($r) | not)' \
                           "${pass2[@]}" <<<"$listing")
  # A copy of flatpak's output goes to a file, so its error line can be kept after it has scrolled
  # past (or, for the widget, gone nowhere), and its Info lines read back. The file is in Kempt's
  # state dir, and the caller's EXIT trap is extended to remove it if kempt dies meanwhile. A kill
  # no trap sees leaves it to kempt_init_dirs' sweep.
  out_file="$(mktemp "$KEMPT_STATE_DIR/reclaim-out.XXXXXX" 2>/dev/null)" || out_file=""
  if [[ -n "$out_file" ]]; then
    saved_trap="$(trap -p EXIT)"
    [[ -z "$saved_trap" ]] || { eval "set -- $saved_trap"; prev_cmd="$3"; }
    # shellcheck disable=SC2064  # the path is fixed now, on purpose
    trap "rm -f -- $(printf '%q' "$out_file"); ${prev_cmd:-:}" EXIT
  fi
  # Ten minutes for both passes together: this holds the update lock, and a removal that hangs (a
  # stuck system helper) must not keep every later run out. With extensions to follow, the first
  # pass leaves them KEMPT_RECLAIM_SECOND_PASS_MIN; the second gets whatever the first did not use.
  # Time running out is exit 124, recorded as a failure like any other.
  limit="$KEMPT_RECLAIM_UNINSTALL_TIMEOUT"
  if [[ ${#pass1[@]} -gt 0 ]]; then
    [[ ${#pass2[@]} -eq 0 ]] || limit=$(( limit - KEMPT_RECLAIM_SECOND_PASS_MIN ))
    t0="${EPOCHREALTIME/[.,]/}"
    prc=0; reclaim_uninstall "$limit" "$out_file" "${pass1[@]}" || prc=$?
    tried+=("${pass1[@]}")
    if [[ $prc -ne 0 ]]; then
      rc=$prc
      [[ -z "$out_file" ]] || RECLAIM_ERROR="$(error_line_of <"$out_file" 2>/dev/null)" || RECLAIM_ERROR=""
    fi
    if [[ $prc -eq 124 ]]; then
      pass2=()
    elif [[ ${#pass2[@]} -gt 0 ]]; then
      if mid="$(flatpak_unused_list 2>/dev/null)"; then
        readarray -t pass2 < <(jq -r --args '.unused[].ref | select(. as $r | $ARGS.positional | index($r))' \
                                 "${pass2[@]}" <<<"$mid")
      else
        pass2=() skip2=1
      fi
      used=$(( (${EPOCHREALTIME/[.,]/} - t0 + 999999) / 1000000 ))
      limit=$(( KEMPT_RECLAIM_UNINSTALL_TIMEOUT - used ))
      [[ $limit -ge $KEMPT_RECLAIM_SECOND_PASS_MIN ]] || limit=$KEMPT_RECLAIM_SECOND_PASS_MIN
    fi
  fi
  if [[ ${#pass2[@]} -gt 0 ]]; then
    [[ -z "$out_file" ]] || mark="$(stat -c %s "$out_file" 2>/dev/null)" || mark=0
    ran2=1
    prc=0; reclaim_uninstall "$limit" "$out_file" "${pass2[@]}" || prc=$?
    tried+=("${pass2[@]}")
    if [[ $prc -ne 0 && $rc -eq 0 ]]; then
      rc=$prc
      [[ -z "$out_file" ]] \
        || RECLAIM_ERROR="$(tail -c +$(( mark + 1 )) "$out_file" | error_line_of 2>/dev/null)" || RECLAIM_ERROR=""
    fi
  fi
  RECLAIM_RC=$rc
  # The list between the passes failed after the first pass succeeded: the extensions were never
  # tried, and nothing was refused. RECLAIM_SKIPPED is set below, once the result is known.
  [[ -z "$skip2" || $rc -ne 0 ]] || RECLAIM_ERROR="$KEMPT_RECLAIM_NO_LIST"
  # What is really gone: every ref installed before the removal that is not installed after it,
  # used ones included, so a removal that took more than the list says so. flatpak's status alone
  # does not say: it can fail part-way, after some refs are gone.
  if after="$(flatpak_unused_list 2>/dev/null)"; then
    # Files, not --argjson: one argument is capped at 128 KiB, a few hundred refs.
    RECLAIM_GONE="$(jq -c -n --slurpfile b <(printf '%s\n' "$listing") --slurpfile a <(printf '%s\n' "$after") \
      '[$a[0].unused[].ref, $a[0].used[].ref] as $left
       | [$b[0].unused[].ref, $b[0].used[].ref] | map(select(. as $r | $left | index($r) | not))' 2>/dev/null)" \
      || RECLAIM_GONE='[]'
  elif [[ $rc -eq 0 ]]; then
    # flatpak removed every ref it was named and cannot be asked again: take its word for those
    RECLAIM_GONE="$(printf '%s\n' "${tried[@]}" | jq -R -s -c 'split("\n") | map(select(. != ""))' 2>/dev/null)" \
      || RECLAIM_GONE='[]'
  else
    # flatpak failed and cannot be asked what is left: anything from none to all may be gone
    RECLAIM_GONE=null
  fi
  [[ "$RECLAIM_GONE" == \[* || "$RECLAIM_GONE" == null ]] || RECLAIM_GONE='[]'
  # Each pass's Info lines are read against the listing taken just before it: an app named there
  # that was already installed does not make the extension in use (reclaim_in_use_new).
  if [[ -n "$out_file" && "$RECLAIM_GONE" != null && "$RECLAIM_GONE" != '[]' ]]; then
    RECLAIM_IN_USE="$( { if [[ -z "$ran2" ]]; then reclaim_in_use_new "$listing" <"$out_file"
                         else head -c "$mark" "$out_file" | reclaim_in_use_new "$listing"
                              tail -c +$(( mark + 1 )) "$out_file" | reclaim_in_use_new "${mid:-$listing}"
                         fi; } \
      | jq -R -s -c --slurpfile g <(printf '%s\n' "$RECLAIM_GONE") '
          [$g[0][] | split("/") | select(length == 4) | "\(.[1])//\(.[3])"] as $gone
          | split("\n") | map(select(. != "" and (. as $e | $gone | index($e)))) | unique
          | select(length > 0)' 2>/dev/null)" || RECLAIM_IN_USE=""
  fi
  if [[ -n "$out_file" ]]; then
    rm -f -- "$out_file" || true
    if [[ -n "$saved_trap" ]]; then eval "$saved_trap"; else trap - EXIT; fi
  fi
  if [[ -n "$sizes_tsv" && "$RECLAIM_GONE" != null ]]; then
    RECLAIM_BYTES="$(jq -R -n -r --slurpfile g <(printf '%s\n' "$RECLAIM_GONE") \
      '[inputs | split("\t") | select(length == 2) | select(.[0] as $r | $g[0] | index($r)) | (.[1] | tonumber)] | add // 0' \
      <<<"$sizes_tsv" 2>/dev/null)" || RECLAIM_BYTES=""
  fi
  # polkit can still refuse flatpak's system helper after pkcheck said yes (a rule that changed in
  # between). That is the same answer as the gate's no, so it is needs_auth too.
  # A failure after some refs went is still `removed`, with partial set and flatpak's error kept;
  # so is a removal whose extensions were never tried because the list between the passes failed.
  if [[ "$RECLAIM_GONE" == null ]]; then RECLAIM_RESULT=failed RECLAIM_PARTIAL=1
  elif [[ "$RECLAIM_GONE" != '[]' ]]; then
    RECLAIM_RESULT=removed
    [[ $rc -eq 0 && -z "$skip2" ]] || RECLAIM_PARTIAL=1
  elif [[ $rc -eq 0 && -z "$skip2" ]]; then RECLAIM_RESULT=nothing
  elif [[ "${RECLAIM_ERROR,,}" == *"not allowed for user"* ]]; then RECLAIM_RESULT=needs_auth
  else RECLAIM_RESULT=failed
  fi
  # Only for a first pass that succeeded and removed something, so the flag in reclaim-last.json
  # and the sentence reclaim_outcome_lines prints for it always agree.
  if [[ -n "$skip2" && $rc -eq 0 && "$RECLAIM_RESULT" == removed ]]; then RECLAIM_SKIPPED=1; fi
  reclaim_record "$via" "$RECLAIM_DIGEST"
  return 0
}

# The unused refs that are extensions, one per line. flatpak protects a runtime an app needs, not
# these (reclaim_remove). The helper says which, from flatpak's metadata (its `extension` field,
# libexec/kempt-flatpak-unused). A ref without that field, from an older helper, falls back to its
# id: another installed ref's id (runtime or app, used or unused) followed by a dot and more, as
# org.freedesktop.Platform.GL.default is of org.freedesktop.Platform. That misses a theme
# (org.gtk.Gtk3theme.*), whose id does not start with its runtime's.
reclaim_extensions_in() {  # listing JSON → refs
  jq -r '([.unused[], .used[] | .ref | split("/")[1] | {key: ., value: true}] | from_entries) as $have
         | .unused[]
         | select(if has("extension") then .extension == true
                  else .ref | split("/")[1] | split(".") as $p
                       | [range(1; $p | length) as $i | $have[$p[:$i] | join(".")] // false] | any
                  end)
         | .ref' \
    <<<"$1" 2>/dev/null
}

# One `flatpak uninstall` of the named refs, within $1 seconds. Its output goes to stdout and is
# appended to $2 (no copy when $2 is empty). Returns flatpak's own exit code, whatever tee does.
# </dev/null so no prompt waits on a terminal. 9>&- keeps check.lock's descriptor out of flatpak and
# tee, so a check never waits on them. The update lock (fd 8) is inherited on purpose: if kempt is
# killed mid-removal, flatpak keeps the lock and no update starts until flatpak exits. The seam's
# --noninteractive makes flatpak's transaction non-interactive, so polkit never raises a dialog for
# it: the pkcheck in reclaim_remove is the whole permission decision.
# Messages in English, for the Info lines reclaim_in_use_of reads: lib/common.sh already sets
# LC_ALL=C.UTF-8, but gettext still follows LANGUAGE under any locale but plain C. LC_MESSAGES
# says the same for a caller without LC_ALL. Not LC_ALL=C: ref names and paths stay UTF-8.
reclaim_uninstall() {  # seconds out-file refs... → flatpak's exit code
  local secs="$1" out="${2:-/dev/null}"; shift 2
  # shellcheck disable=SC2086  # the seam carries its own arguments
  if LC_MESSAGES=C LANGUAGE=C timeout "$secs" $KEMPT_FLATPAK_UNINSTALL_CMD "$@" </dev/null 2>&1 9>&- \
       | tee -a "$out" 9>&-; then
    return 0
  else
    return "${PIPESTATUS[0]}"
  fi
}

# The extensions flatpak said an app uses, from its saved output, as "id//branch<TAB>app ids" lines
# (the app ids space-separated). flatpak prints "Info: applications using the extension ID branch
# BRANCH:" and then the app ids, indented and comma-separated, on the next line (1.16 and 1.18,
# app/flatpak-builtins-uninstall.c), in bold on a terminal. It removes the extension anyway under
# --noninteractive. Indented lines after the first are read as more ids, in case the list wraps.
reclaim_in_use_of() {  # stdin: flatpak's output
  LC_ALL=C sed -e 's/\x1b\[[0-9;]*m//g' -e 's/\r$//' \
    | LC_ALL=C awk '
        function flush() { if (ext != "") { sub(/^ +/, "", apps); print ext "\t" apps }; ext = "" }
        ext != "" && /^[ \t]/ { l = $0; gsub(/[, \t]+/, " ", l); sub(/^ /, "", l); apps = apps " " l; next }
        { flush() }
        match($0, /^Info: applications using the extension [A-Za-z0-9._-]+ branch [A-Za-z0-9._-]+:[ \t]*$/) {
          n = split($0, w, /[ \t]+/); b = w[8]; sub(/:$/, "", b); ext = w[6] "//" b; apps = "" }
        END { flush() }'
}

# The extensions in flatpak's Info lines that an app new since the listing uses, as id//branch
# lines. flatpak names every installed app whose extension points match, even for an extension it
# lists as unused because it is pruned (an old GL driver with autoprune-unless), so an app that was
# already installed when the listing was taken is no sign of a race. A listing jq cannot read
# names no app as installed before, so every extension an Info line names counts: the warning errs
# toward being said.
reclaim_in_use_new() {  # listing-json; stdin: flatpak's output
  local info
  info="$(reclaim_in_use_of)" || info=""
  [[ -n "$info" ]] || return 0
  if ! jq -e 'type == "object"' >/dev/null 2>&1 <<<"$1"; then
    cut -f1 <<<"$info"
    return 0
  fi
  jq -R -r --slurpfile l <(printf '%s\n' "$1") '
      [$l[0].unused[]?, $l[0].used[]? | .ref | split("/") | select(.[0] == "app") | .[1]] as $had
      | split("\t") | select(length == 2)
      | select(.[1] | split(" ") | map(select(. != "")) | any(. as $a | $had | index($a) | not))
      | .[0]' <<<"$info" 2>/dev/null || cut -f1 <<<"$info"
}

# One look at the list against what was agreed to. Non-zero when the removal must stop, with the
# outcome already recorded (nothing unused, or changed and why). Sets RECLAIM_DIGEST. Called only
# from reclaim_remove, whose local `via` it records under.
reclaim_compare() {  # listing expected-digest [before-snapshot.tsv]
  local classified
  RECLAIM_DIGEST=""
  if ! classified="$(reclaim_classify "$1" 2>/dev/null)"; then
    RECLAIM_RESULT=failed RECLAIM_ERROR="$KEMPT_RECLAIM_NO_LIST"; reclaim_record "$via" "$2"; return 1
  fi
  # Nothing unused any more. After an update that is simply nothing to do. For kempt reclaim, the
  # set the person agreed to went back into use since they were shown it: changed, as cmd_reclaim
  # says when it sees the same first, never "nothing unused was found" (a success in the widget).
  if [[ "$(jq -r 'length' <<<"$classified" 2>/dev/null)" == 0 ]]; then
    if [[ "$via" != update && -n "$2" ]]; then RECLAIM_RESULT=changed RECLAIM_WHY=digest
    else RECLAIM_RESULT=nothing
    fi
    reclaim_record "$via" "$2"; return 1
  fi
  RECLAIM_DIGEST="$(jq -r '.[] | "\(.ref)\t\(.commit)"' <<<"$classified" 2>/dev/null | reclaim_digest)" \
    || RECLAIM_DIGEST=""
  if [[ -z "$RECLAIM_DIGEST" || "$RECLAIM_DIGEST" != "$2" ]]; then
    RECLAIM_RESULT=changed RECLAIM_WHY=digest
  elif ! jq -e 'all(.offerable)' <<<"$classified" >/dev/null 2>&1; then
    RECLAIM_RESULT=changed RECLAIM_WHY=unstable
  elif [[ -n "${3:-}" ]] && ! reclaim_all_in_snapshot "$classified" "$3"; then
    # After an update: a ref that was not installed when the run began was put there by the run, or
    # by something running beside it, and the hour it has "been unused" belongs to another ref.
    RECLAIM_RESULT=changed RECLAIM_WHY=new
  else
    return 0
  fi
  reclaim_record "$via" "$RECLAIM_DIGEST"
  return 1
}

# Every listed ref present in the run's before-snapshot, whose rows are `id/branch` for a runtime
# and `id` for an app (flatpak_snapshot). `flatpak list` hides the .Locale, .Debug and .Sources
# extensions without --all, so one of those counts as present when its parent is: a runtime on the
# same branch, or an app (whose row has no branch). An extension whose parent is gone too is
# present when a check saw it unused before the run began (its since predates the snapshot).
reclaim_all_in_snapshot() {  # classified-json snapshot.tsv → 0 when all are there
  local keys missing start
  # An empty snapshot would put every key in the lookup table below, not none of them.
  [[ -s "$2" ]] || return 1
  start="$(date -r "$2" +%s 2>/dev/null)" || return 1
  # One line per ref: the snapshot rows that would prove it present, tab-separated. `*` (never a
  # row) stands for "seen unused before the run began".
  keys="$(jq -r --argjson start "$start" '
            .[] | (.ref | split("/")) as $r
            | if $r[0] != "runtime" then $r[1]
              elif ($r[1] | test("[.](Locale|Debug|Sources)$")) then
                ($r[1] | sub("[.](Locale|Debug|Sources)$"; "")) as $p
                | ((try (.since | fromdateiso8601) catch null) // $start) as $s
                | [$p + "/" + $r[3], $p] + (if $s < $start then ["*"] else [] end) | join("\t")
              else $r[1] + "/" + $r[3] end' \
          <<<"$1" 2>/dev/null)" || return 1
  [[ -n "$keys" ]] || return 1
  missing="$(awk -F'\t' 'NR == FNR { have[$1] = 1; next }
                         { for (i = 1; i <= NF; i++) if ($i in have || $i == "*") next; print }' \
             "$2" - <<<"$keys" 2>/dev/null)" || return 1
  [[ -z "$missing" ]]
}

# The outcome, in the two places that keep it: reclaim-last.json (the next check carries it into
# state.json) and the event log. Both best-effort. A failure carries its error line in both.
reclaim_record() {  # via digest
  reclaim_last_write "$1" "$RECLAIM_RESULT" "$RECLAIM_GONE" "$RECLAIM_BYTES" "$2" "${RECLAIM_ERROR:-}" \
    "${RECLAIM_PARTIAL:-}" "${RECLAIM_IN_USE:-}" "${RECLAIM_SKIPPED:-}"
  local n in_use=""
  n="$(jq -r 'length' <<<"$RECLAIM_GONE" 2>/dev/null)" || n="?"
  [[ -z "${RECLAIM_IN_USE:-}" ]] || in_use="$(jq -r 'join(" ")' <<<"$RECLAIM_IN_USE" 2>/dev/null)" || in_use=""
  case "$RECLAIM_RESULT" in
    removed)    log_event "reclaim removed $n runtimes (${RECLAIM_BYTES:-?} bytes) rc=${RECLAIM_RC:-0}${RECLAIM_PARTIAL:+, not all of them}${in_use:+, in use: $in_use}${RECLAIM_ERROR:+: $RECLAIM_ERROR}" ;;
    nothing)    log_event "reclaim found nothing to remove" ;;
    changed)    log_event "reclaim changed ($RECLAIM_WHY), nothing removed" ;;
    needs_auth) log_event "reclaim needs authorization, nothing removed" ;;
    *)          log_event "reclaim failed rc=${RECLAIM_RC:-?}${RECLAIM_PARTIAL:+, what was removed is unknown}${RECLAIM_ERROR:+: $RECLAIM_ERROR}" ;;
  esac
}

# reclaim=automatic: remove the set the last check offered, after a successful run. Called AFTER
# the run's fp-after snapshot, so runtimes removed here are not reported as removed by the update,
# and only when every ref is in the run's fp-before snapshot (reclaim_remove). A removal that
# fails or needs an administrator is recorded once (reclaim-last.json, then status in state.json)
# and this step skips while the same set is on offer, so it is never a failure on every run.
# Sets RECLAIM_RUN_JSON to {refs, bytes, status} for the history entry, or empty when nothing was
# attempted. flatpak's output goes to the run log only; the outcome sentence to the log, and to the
# terminal too when the output is live. Never fails: the run is over.
reclaim_after_run() {  # log_file
  RECLAIM_RUN_JSON=""
  reclaim_as_root && return 0
  flatpak_present || return 0
  [[ "$(reclaim_effective_mode)" == automatic ]] || return 0
  local offer digest
  offer="$(jq -r -n '[inputs][0].reclaim | select(type == "object")
                     | select(.status != "needs_auth" and .status != "failed") | .digest // ""' \
           "$STATE_FILE" 2>/dev/null)" || return 0
  digest="$offer"
  [[ "$digest" =~ ^[0-9a-f]{16}$ ]] || return 0
  run_heading "$1" "Unused Flatpak runtimes"
  reclaim_remove update "$digest" "$SNAP_DIR/fp-before.tsv" >>"$1" 2>&1 || return 0
  # The outcome in kempt reclaim's words: always into the log after flatpak's lines, and under the
  # heading on a live terminal, where flatpak's own lines are not shown.
  reclaim_outcome_lines update >>"$1" 2>&1 || true
  [[ "${KEMPT_LIVE_OUTPUT:-}" != "1" ]] || reclaim_outcome_lines update || true
  RECLAIM_RUN_JSON="$(jq -cn --slurpfile g <(printf '%s\n' "$RECLAIM_GONE") --arg b "$RECLAIM_BYTES" --arg s "$RECLAIM_RESULT" \
    --arg p "${RECLAIM_PARTIAL:-}" --arg u "${RECLAIM_IN_USE:-}" \
    '{refs: $g[0], bytes: (if $b == "" then null else ($b | tonumber) end), status: $s}
     + (if $p == "" then {} else {partial: true} end)
     + (if $u == "" then {} else {in_use: ($u | fromjson)} end)' 2>/dev/null)" \
    || RECLAIM_RUN_JSON=""
  return 0
}

cmd_check() {
  # NOTE: `if x="$(fn)"` disables errexit inside fn's whole body - backends must therefore
  # return status EXPLICITLY (they do) and never rely on set -e for error propagation.
  # --refresh overrules the three-hour interval and NOTHING else: the battery and metering rules
  # are about the person's hardware and their bill, not about being polite to a mirror, so a flag
  # that quietly spent either would be worse than no flag. maybe_refresh_metadata carries the rule.
  # --coalesce is the widget's automatic checks (timer, watcher, popup open, startup, post-run
  # fallback): "any check that finishes after I asked answers me too". Two widget instances (one
  # per panel tray) otherwise turn every automatic trigger into two dnf queries back to back, the
  # second queued on the lock behind the first. Never with --refresh: that flag asks for a FETCH,
  # and a state someone else produced from the old metadata does not answer it.
  # --strict is for scripts: an answer that is not current (a backend failed, the per-user listing
  # failed, or the previous state was served) exits 1 instead of 0, after the state is printed.
  local force_refresh="" coalesce="" strict=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --refresh) force_refresh=force; shift ;;
      --coalesce) coalesce=1; shift ;;
      --strict) strict=1; shift ;;
      *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
  done
  [[ -n "$force_refresh" ]] && coalesce=""
  # Taken BEFORE the lock wait: the question is whether a check finished after this one was asked
  # for, and the wait is exactly where that other check runs.
  local requested_at=""
  [[ -n "$coalesce" ]] && requested_at="$(date +%s)"
  kempt_init_dirs
  # serialize checks: without this the last FINISHER wins and a stale result overwrites a fresh one
  exec 9>"$KEMPT_STATE_DIR/check.lock"
  if ! flock -w "$KEMPT_CHECK_LOCK_WAIT" 9; then
    echo "warning: another check holds the lock; serving previous state" >&2
    # `[inputs][0]`, and NOT `jq -e .`: a multi-document state file is valid input to jq, so the
    # plain form prints BOTH documents under exit 0 and the widget's JSON.parse throws on the
    # second. House idiom - same guard on prev_ls below, in state_prev_items and `summary --json`.
    jq -e -n '[inputs][0] | select(type == "object")' "$STATE_FILE" 2>/dev/null || true
    # --strict: an answer nobody checked just now is not a current one.
    [[ -z "$strict" ]] || return 1
    return 0
  fi
  local shared
  if [[ -n "$coalesce" ]] && shared="$(state_checked_since "$requested_at")"; then
    # The state that check wrote IS the answer. Nothing is written and nothing is harvested (that
    # check did both), and the event is its own word: `check shared` asked no backend, so it is not
    # a `check ok` and nothing counting checks counts it.
    printf '%s\n' "$shared"
    log_event "check shared last_check=$(jq -r '.last_check' <<<"$shared" 2>/dev/null)"
    # state_checked_since adopts only an ok state today; --strict does not rely on that.
    # A failed per-user listing leaves status ok, so the scopes are asked as well.
    if [[ -n "$strict" ]] \
       && ! jq -e '.status == "ok" and ((.backends.flatpak.scopes // {}) | all(.[]; . != "failed"))' \
            <<<"$shared" >/dev/null 2>&1; then
      return 1
    fi
    return 0
  fi
  # inside the check lock, before anything reads the world: two overlapping checks must not turn
  # one staged transaction into two history entries
  harvest_offline
  maybe_refresh_metadata "$force_refresh"
  local status="ok" error="" dnf_items fp_items fp_enabled=true prev_ls serr errf
  # Download sizes, in files because attach_sizes joins against a TSV. Empty on any failure, and
  # nothing below may change `status`: the check must answer with or without a size.
  local dnf_sz fp_sz fp_scopes_f dnf_priced=false fp_priced=false
  dnf_sz="$(mktemp)"; fp_sz="$(mktemp)"; fp_scopes_f="$(mktemp)"
  # -n/[inputs][0]: the corrupt-tolerance idiom above (a multi-doc file joins one last_success per
  # document into one string).
  prev_ls="$(jq -r -n '[inputs][0].last_success? // empty' "$STATE_FILE" 2>/dev/null || true)"
  errf="$(mktemp)"
  if dnf_items="$(dnf_check 2>"$errf")"; then
    # Priced only when the check ANSWERED: a stale backend serves the previous state's items,
    # which carry their own sizes - re-pricing puts today's bytes on yesterday's list.
    dnf_priced=true
    dnf_sizes > "$dnf_sz" 2>/dev/null || : > "$dnf_sz"
  else
    # explain_helper_error rewrites the one case the raw text gets WRONG: a missing root helper,
    # which `timeout` reports as a failure to run a command and reads as a timeout. dnf only -
    # the one check path that goes through a root helper.
    serr="$(explain_helper_error "$(stderr_tail "$errf")")"
    status="stale"; error="dnf check failed${serr:+: $serr}"; dnf_items="$(state_prev_items dnf)"
  fi
  if is_true "$(config_get include_flatpak)"; then
    if fp_items="$(flatpak_check "$fp_sz" "$fp_scopes_f" 2>"$errf")"; then fp_priced=true; else
      serr="$(stderr_tail "$errf")"
      status="stale"; error="${error:+$error; }flatpak check failed${serr:+: $serr}"; fp_items="$(state_prev_items flatpak)"
    fi
    # A per-user listing that failed keeps the previous check's per-user items, as a stale backend
    # keeps all of its own: pending updates must not vanish because a listing failed. They carry
    # their own sizes, and attach_sizes leaves an item it has no row for as it is. Through stdin,
    # never --argjson, for the argv cap assemble_state names.
    local fp_kept
    if grep -qx 'user failed' "$fp_scopes_f" 2>/dev/null \
       && fp_kept="$({ printf '%s\n' "$fp_items"; state_prev_items flatpak; } \
                     | jq -c -s '.[0] + [.[1][] | select(.scope == "user")]' 2>/dev/null)" \
       && [[ "$fp_kept" == \[* ]]; then
      fp_items="$fp_kept"
    fi
  else
    fp_enabled=false; fp_items='[]'
  fi
  rm -f "$errf"
  dnf_items="$(mark_held dnf <<<"$dnf_items")"
  # flatpak_runtimes_never_held is the second half of the refusal cmd_hold makes: a holds file can
  # already name a runtime (it was writable long before runtimes were counted), and mark_held keys
  # on the bare name, so without this a stale line would start holding a runtime today.
  fp_items="$(mark_held flatpak <<<"$fp_items" | flatpak_runtimes_never_held)"
  # After mark_held, because the coverage rule below counts NON-HELD items only.
  [[ "$dnf_priced" == true ]] && dnf_items="$(attach_sizes "$dnf_sz" <<<"$dnf_items")"
  [[ "$fp_priced"  == true ]] && fp_items="$(attach_sizes "$fp_sz"  <<<"$fp_items")"
  # Each installation's outcome, written by flatpak_check only when there is a per-user one.
  local fp_scopes=""
  if [[ -s "$fp_scopes_f" ]]; then
    fp_scopes="$(jq -cSRn '[inputs | select(length > 0) | split(" ") | {(.[0]): .[1]}] | add' \
                 < "$fp_scopes_f" 2>/dev/null)" || fp_scopes=""
  fi
  rm -f "$dnf_sz" "$fp_sz" "$fp_scopes_f"
  local dnf_bytes fp_bytes=""
  dnf_bytes="$(backend_download_bytes <<<"$dnf_items")"
  # A switched-off backend gets no figure rather than a zero: `download_bytes: 0` would claim
  # "nothing to download from it" where the truth is that nobody asked.
  [[ "$fp_enabled" == true ]] && fp_bytes="$(backend_download_bytes <<<"$fp_items")"
  # Published so the widget can offer "Install on Next Restart" without re-deriving the rule.
  # dnf only: a flatpak app cannot take the session down mid-transaction.
  local risky
  risky="$(risky_names <<<"$dnf_items" | jq -Rn '[inputs]')"
  # Whether a restart is owed RIGHT NOW - unlike a history entry's reboot_needed, which is about
  # the moment one run finished. Rewritten by every check, so it clears itself after a restart and
  # notices a `sudo dnf5 upgrade` typed in a terminal.
  # Safe here: dnf_reboot_needed is cache-only, repo-less and closes its own stdin, so it cannot
  # reach the network or prompt (do NOT add a second redirect - it fights the backend's own).
  # Unconditional because this CLI has no include_dnf key; THE RULE: if dnf gains one, this call
  # goes behind it, next to the flatpak gate above. Same in cmd_update.
  local reboot
  reboot="$(dnf_reboot_needed)"
  # Shape guard, twinned with cmd_update's: a surprise value reaching --argjson fails jq and loses
  # the whole check. Nothing reaches it today - it is a boundary on the backend contract.
  [[ "$reboot" == "true" || "$reboot" == "false" ]] || reboot=false
  # AFTER harvest_offline, where the marker's lifecycle is decided: a stage it just consumed or
  # cleared must not be published one line later as still pending.
  local staged_state
  staged_state="$(offline_staged_state)"
  # dnf5 keeps ONE stored transaction for ordinary offline updates and Fedora release upgrades
  # alike, so a staged release upgrade is a fact about what the offline surface can do right now:
  # staging over it cancels it, and Kempt refuses to. Published so the widget can say so and stop
  # offering the button, rather than the CLI explaining it after the press.
  # ...and the same for a machine dnf cannot update at all. Published rather than left to the
  # update to discover, so the widget can say what this box is and stop offering a button that
  # only ever ends in a refusal.
  local image_based=null
  on_ostree && image_based=true
  # Never both: a box that cannot be updated by dnf at all has nothing useful to say about what is
  # in dnf5's transaction slot, and the two messages contradict each other in a popup that shows
  # two at a time.
  local relup_json="" relup_pair
  if [[ "$image_based" == null ]] && relup_pair="$(offline_release_upgrade)"; then
    # `state` and not a boolean, and inside this object rather than beside it: three states, and a
    # reader holding two of the three would word its sentence wrongly for the one it cannot name.
    # Always present when the object is - it qualifies the fact rather than adding a new one.
    relup_json="$(jq -cn --arg from "${relup_pair%% *}" --arg to "${relup_pair##* }" \
                    --arg st "$(offline_release_upgrade_state)" \
                    '{from:$from, to:$to, state:$st}')" || relup_json=""
  fi
  local state
  # Read AFTER maybe_refresh_metadata, so a check that has just fetched publishes the fetch it
  # made rather than the one before it.
  state="$(assemble_state "$dnf_items" "$fp_items" "$status" "$error" "$fp_enabled" "$prev_ls" "$risky" "$reboot" "$dnf_bytes" "$fp_bytes" "$staged_state" "$relup_json" "$image_based" "$(metadata_refreshed_iso)")"
  # A per-user installation that failed leaves the system answer standing and says so here, as
  # the history's `scopes` does, rather than marking the whole backend stale.
  local scoped
  if [[ -n "$fp_scopes" ]] \
     && scoped="$(jq -c --argjson s "$fp_scopes" '.backends.flatpak.scopes = $s' <<<"$state" 2>/dev/null)" \
     && [[ -n "$scoped" ]]; then
    state="$scoped"
  fi
  # The unused Flatpak runtimes, merged in after assembly because the block is optional and has no
  # say in the check's status. Guarded at every step (set -e, and this runs inside the check lock):
  # a helper, du or jq that fails leaves the state exactly as assembled, never a failed check.
  local reclaim_json merged
  reclaim_json="$(reclaim_check_block "$fp_enabled" 2>/dev/null)" || reclaim_json=""
  if [[ -n "$reclaim_json" ]] \
     && merged="$(jq --slurpfile r <(printf '%s\n' "$reclaim_json") '. + {reclaim: $r[0]}' <<<"$state" 2>/dev/null)" \
     && [[ -n "$merged" ]]; then
    state="$merged"
  fi
  # true or absent, like image_based: the popup's one offer of the popup default, to an install
  # surface_migrate kept on the terminal.
  if surface_offer_pending \
     && merged="$(jq '. + {surface_offer: true}' <<<"$state" 2>/dev/null)" && [[ -n "$merged" ]]; then
    state="$merged"
  fi
  # true or absent: the widget's one offer to turn off Discover's notifier, while it starts with
  # the session and nobody has answered.
  if discover_offer_pending \
     && merged="$(jq '. + {discover_offer: true}' <<<"$state" 2>/dev/null)" && [[ -n "$merged" ]]; then
    state="$merged"
  fi
  printf '%s\n' "$state"                 # answer first: a read-only state dir must not eat the result
  # CHECK_WROTE_STATE tells cmd_update, in this same shell, that state.json was replaced. The exit
  # status cannot: the lock-timeout branch above returns 0 without writing. `return 1` keeps a
  # failed write a failed check for a caller with errexit off.
  if printf '%s\n' "$state" | write_state; then CHECK_WROTE_STATE=1; else return 1; fi
  # One line per check, in the event log's fixed vocabulary. The lock-timeout return above records
  # nothing on purpose: it served a previous answer and looked at nothing.
  if [[ "$status" == "ok" ]]; then
    local counts
    counts="$(jq -r '"actionable=\(.actionable) held=\(.held_total)"' <<<"$state" 2>/dev/null)" \
      || counts="actionable=? held=?"
    log_event "check ok $counts"
    # --strict: the apps for you only that could not be listed are not a current answer either,
    # though the check stays ok and keeps their previous items.
    if [[ -n "$strict" && "$fp_scopes" == *'"failed"'* ]]; then return 1; fi
  else
    log_event "check $status $error"
    [[ -z "$strict" ]] || return 1
  fi
}

KEMPT_RETRY_DELAY="${KEMPT_RETRY_DELAY:-10}"

# Surfaces are a closed set. An unknown one (a config typo, an older widget's value) must not
# silently mean "detached": fall back to the surface that can show a human what happened.
resolve_surface() {  # surface → a known surface (single definition: cmd_update and cmd_run must never drift)
  # Trimmed and lower-cased first, which the widget's resolveSurface has always done. Without it
  # the two disagreed about a value `kempt config set surface " OFFLINE "` will happily store -
  # config_set validates the KEY and stores the value as given - and the popup would then hide
  # Update Now for a box whose runs go to the terminal. The warning still names what was written,
  # not what it was read as.
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"
  s="${s,,}"
  case "$s" in
    terminal|popup|background|offline) printf '%s\n' "$s" ;;
    *) echo "warning: surface='$1' is not a known value, so updates run in a terminal window" >&2; printf 'terminal\n' ;;
  esac
}

# A heading in front of each package manager's output. Without one, flatpak's first line lands
# straight under dnf's "Complete!" and reads as part of the dnf upgrade. Written to the log on every
# surface, and to the terminal only when the output is live. The labels are the ones the summary
# uses, so the reader matches a section to its summary line by name.
# Best-effort, like every write into the run log: the flatpak heading is written AFTER dnf has
# changed the system, and under errexit a log that stopped taking writes (a full home) ended the
# run there - no history entry, no closing check, and the widget left spinning until its guard.
run_heading() {  # log_file title
  if [[ "${KEMPT_LIVE_OUTPUT:-}" == "1" ]]; then
    printf '\n== %s ==\n' "$2" | tee -a "$1" 2>/dev/null || true
  else
    printf '\n== %s ==\n' "$2" 2>/dev/null >> "$1" || true
  fi
}

# A warning for the person AND the run log, and the log half may fail: `echo | tee -a "$log"` is a
# pipeline whose status is tee's, so a log that could not be opened made the warning itself the
# thing that killed the run - on the far side of the update, where most of these are said.
log_warn() {  # log_file message
  printf '%s\n' "$2" >&2
  printf '%s\n' "$2" 2>/dev/null >> "$1" || true
}

# The runner is an argument because the two backends sit on OPPOSITE sides of the privilege
# boundary: dnf through the root helper (priv_apply), flatpak as the user (flatpak_apply). The run
# log, the live tee and the retry are the same for both.
# KEMPT_DNF_LOCK_RE matches the lock-held wordings of dnf5, rpm and PackageKit, listed in
# tests/fixtures/MANIFEST.md. Package names can contain "lock" (kscreenlocker), so a loose
# `package.*lock` retries dependency errors. dnf5's "Waiting for a lock" line is left out: dnf5
# waits and carries on, so it never explains a failure. `can.t` avoids a quote inside quotes.
# KEMPT_FLATPAK_LOCK_RE: the flatpak wordings carry the path in the MIDDLE (`Unable to lock %s`,
# `Locking repo %s failed`, `Opening lock file %s/.lock failed`) - hence `.*`-joined patterns
# rather than literals. `\b` keeps `Unlocking repo failed`, a different error, out of the match.
KEMPT_DNF_LOCK_RE='failed to obtain rpm transaction lock|another transaction is in progress|can.t create [a-z]+ lock on|unable to lock'
KEMPT_FLATPAK_LOCK_RE='unable to lock|\blocking repo.*failed|opening lock file.*failed'
# Lower case at the start like every other reason: it is shown after "Update failed: ".
# The last sentence is swapped for KEMPT_BUSY_ALSO_FAILED when another part of the run failed too.
KEMPT_BUSY_TRY_AGAIN="Try again in a few minutes."
KEMPT_BUSY_ALSO_FAILED="Another part of the update failed too, and the log says what."
KEMPT_BUSY_REASON_DNF="another program is using the package system (PackageKit, Discover or dnf-automatic) and was still busy after three tries. Nothing was installed. $KEMPT_BUSY_TRY_AGAIN"
KEMPT_BUSY_REASON_FLATPAK="another program is using Flatpak (Discover, PackageKit or another flatpak command) and was still busy after three tries. The Flatpak update did not finish. $KEMPT_BUSY_TRY_AGAIN"
apply_with_retry() {  # log_file runner args... ; retries on foreign package-lock errors
  local log="$1" runner="$2"; shift 2
  local attempt rc before_sz lock_re="$KEMPT_DNF_LOCK_RE" busy="$KEMPT_BUSY_REASON_DNF"
  if [[ "$runner" == flatpak_apply ]]; then
    lock_re="$KEMPT_FLATPAK_LOCK_RE"; busy="$KEMPT_BUSY_REASON_FLATPAK"
  fi
  for attempt in 1 2 3; do
    rc=0
    # Only THIS attempt's output may decide whether to retry: a fixed `tail -n 20` re-reads the
    # previous attempt's lock error and retries a run that failed for another reason entirely.
    before_sz=0; [[ -f "$log" ]] && before_sz="$(stat -c %s "$log" 2>/dev/null || echo 0)"
    if [[ "${KEMPT_LIVE_OUTPUT:-}" == "1" ]]; then
      # terminal surface: the user must SEE live output, and any prompt when auto_accept=false.
      # `|| rc=` (not `; rc=`): keeps the pipeline errexit-exempt for a caller that invokes
      # apply_with_retry bare, where `; rc=` would abort the run instead of retrying.
      "$runner" "$@" 2>&1 | tee -a "$log" || rc=${PIPESTATUS[0]}
    else
      "$runner" "$@" >>"$log" 2>&1 || rc=$?
    fi
    [[ $rc -eq 0 ]] && return 0
    if tail -c +$(( before_sz + 1 )) "$log" | grep -qiE "$lock_re"; then
      # 3 attempts = 2 retries. The last failure must not promise a retry that never comes.
      if [[ $attempt -lt 3 ]]; then
        log_warn "$log" "Package system busy (PackageKit/Discover?). Retrying in ${KEMPT_RETRY_DELAY}s ($attempt/3)"
        sleep "$KEMPT_RETRY_DELAY"
      else
        log_warn "$log" "Package system still busy after $attempt attempts. Giving up"
        # Kempt's own sentence for the most likely failure it has, in place of dnf's or flatpak's
        # raw line about a lock file, which reads as a broken installation. Set only here, where
        # the evidence is: a lock-specific grep against this attempt's output alone.
        #
        # reason_override, run_busy_reason and run_failed_otherwise belong to cmd_update, which
        # every caller of this runs inside (dynamic scope, so NOT `local`). The reason is claimed
        # only when nothing failed before it: a cleanup after a failure, or flatpak after a dnf
        # failure, must not relabel the run. The flatpak sentence makes no claim about dnf, which
        # ran first and may have installed hundreds of packages.
        if [[ -z "${reason_override:-}" && "${status:-ok}" == ok ]]; then
          reason_override="$busy"
          run_busy_reason="$busy"
        fi
      fi
    else
      # A failure that is not a lock: the run cannot exit as "busy", whatever reason it reports.
      run_failed_otherwise=1
      return "$rc"
    fi
  done
  return "$rc"
}

# Pre-flight failure: nothing has been changed and nothing will be. Loud on stderr, exit 5 (never
# a bare backend rc through errexit), and a notification where nobody reads stderr. Reads $surface.
preflight_abort() {  # message
  echo "$1" >&2
  [[ "$surface" != "terminal" ]] && notify "Kempt" "Update did not start: $1"
  # Recorded, because `kempt log` is where somebody looks when a press did nothing and they want to
  # know why. Two of the three things that reach here are deliberate refusals rather than faults,
  # and a refusal that leaves no trace is indistinguishable from a button that does not work.
  # init first: this runs before cmd_update takes the lock, so the state directory may not exist.
  kempt_init_dirs 2>/dev/null || true
  log_event "run did not start: $1" 2>/dev/null || true
  # Then a check, and it is not a nicety: a state.json write is the ONLY thing that takes the widget
  # out of its updating state, and this path writes no history entry and runs no post-run check.
  # Without it a press of Update Now spins until the popup's three-hour guard fires - on an
  # image-based system, every press, for ever. The check itself only reads, so it is safe on every
  # box that can reach this; `|| true` because a pre-flight that failed because nothing could be
  # read must still exit 5 rather than on the check's rc.
  cmd_check >/dev/null 2>&1 || true
  exit 5
}

# --- the sections of cmd_update ------------------------------------------------------------------
# These four are SECTIONS, not helpers: each is called from exactly one place, in one order, and
# reads and writes the run's locals through bash's DYNAMIC scope rather than arguments. Each
# header says what it reads and what it changes - that is the contract; do not reuse them.

# The risky-transaction recommendation, run BEFORE the lock is taken so an abort leaves no lock
# residue and no history entry, having changed nothing at all.
# Reads: surface, risky_ok. Writes: surface - answering "s" at the prompt switches this run to
# offline.
recommend_offline_if_risky() {
  # Recommends, never blocks; an offline run IS the recommendation, so it is
  # never nagged.
  #
  # ...and it must never recommend a route that is refused. `[s]tage offline` sets $surface here,
  # and the pre-flight gate for a stored Fedora release upgrade runs AFTER this function - so an
  # offline stage entered through this prompt used to reach dnf5 and cancel the upgrade, logged by
  # Kempt as its own restage. The gate below closes that; this stops the prompt offering it at all,
  # because an option that always ends in a refusal is worse than one that is not there.
  local relup_blocks=false
  offline_release_upgrade >/dev/null && relup_blocks=true
  if [[ "$surface" != "offline" ]]; then
    local risky_list="" rerr rcount fams
    rerr="$(mktemp)"
    # A pre-check that cannot run is not "nothing risky": say so, then proceed - losing advice
    # must never stop the user updating.
    risky_list="$(dnf_check 2>"$rerr" | mark_held dnf | risky_names)" || {
      risky_list=""
      # same rewrite as cmd_check: a missing root helper must not be announced as a timeout here either
      echo "warning: could not check for session-critical updates: $(explain_helper_error "$(stderr_tail "$rerr")")" >&2
    }
    rm -f "$rerr"
    if [[ -n "$risky_list" ]]; then
      rcount="$(wc -l <<<"$risky_list")"
      if [[ "$surface" == "terminal" && ( -t 0 || -n "${KEMPT_ASSUME_TTY:-}" ) ]]; then
        # ONE ROW PER FAMILY, CARRYING ITS OWN COUNT. Same family rule as the notification below -
        # a Qt bump's first eight names alphabetically would otherwise push a pending KERNEL out of
        # sight, and kernel-core and kernel-modules are one decision, not two.
        #
        # The count on the row is the part that was wrong. The listing collapsed a family to one
        # name while the tail counted PACKAGES, so six mesa packages printed "mesa-dri-drivers"
        # and "... and 5 more" - which reads as five hidden, unrelated risks instead of one
        # graphics driver shipped in six pieces. A count that makes a transaction sound worse than
        # it is costs exactly what an undercount does: the next warning is believed a little less.
        # The count now sits on its family's row, and the tail counts the families not shown.
        local fam_rows shown nshown ntotal width
        fam_rows="$(awk '{ n = $0; f = n; sub(/[-.].*/, "", f)
                           if (!(f in cnt)) { order[++k] = f; first[f] = n }
                           cnt[f]++ }
                         END { for (i = 1; i <= k; i++) { f = order[i]
                                 printf "%s\t%d\t%s\n", f, cnt[f], first[f] } }' <<<"$risky_list")"
        ntotal="$(grep -c '' <<<"$fam_rows")"
        shown="$(head -8 <<<"$fam_rows")"    # still capped: a box can always surprise us with 30 families
        nshown="$(grep -c '' <<<"$shown")"
        # Each row is turned into what it will actually SAY before anything is measured, because a
        # plain-language label changes the column width: "graphics drivers (mesa)", not "mesa".
        # A family Kempt does not ship a label for prints bare - see family_label.
        local rows_disp="" fam n first lbl disp
        while IFS=$'\t' read -r fam n first lbl; do
          [[ -z "$fam" ]] && continue
          # a family of one is named outright (mesa-libGL says more than mesa); several are one row
          if (( n == 1 )); then disp="$first"; else disp="$fam"; fi
          [[ -n "$lbl" ]] && disp="$lbl ($disp)"
          rows_disp+="$disp"$'\t'"$n"$'\n'
        done < <(while IFS=$'\t' read -r fam n first; do
                   [[ -z "$fam" ]] && continue
                   printf '%s\t%s\t%s\t%s\n' "$fam" "$n" "$first" "$(family_label "$fam")"
                 done <<<"$shown")
        # the label column width, so the counts line up under one another
        width="$(awk -F'\t' 'NF { if (length($1) > m) m = length($1) } END { print m + 0 }' <<<"$rows_disp")"
        # ...and the counts themselves right-aligned, so 5 sits under the 2 of 12 and the column
        # reads as numbers rather than as ragged text
        local cwidth
        cwidth="$(awk -F'\t' 'NF { if ($2 > 1 && length($2) > m) m = length($2) } END { print m + 0 }' <<<"$rows_disp")"
        echo
        if (( rcount == 1 )); then
          echo "  Heads up: 1 session-critical package is pending."
        else
          echo "  Heads up: $rcount session-critical packages are pending."
        fi
        echo "  Installing these while the desktop is running can break the session until you restart:"
        echo
        awk -F'\t' -v w="$width" -v c="$cwidth" 'NF { if ($2 == 1) printf "      %s\n", $1
                                                      else printf "      %-*s   %*d packages\n", w, $1, c, $2 }' <<<"$rows_disp"
        (( ntotal > nshown )) && echo "      ... and $(( ntotal - nshown )) more"
        echo
        local ans tries prompt="  Your choice [s/u/a]: "
        if [[ "$relup_blocks" == true ]]; then
          echo "  Staging is not available: a Fedora release upgrade is stored, and staging would cancel it."
          echo
          echo "      [u]  update now, live"
          echo "      [a]  abort  (default)"
          echo
          prompt="  Your choice [u/a]: "
        else
          echo "  Staging installs them during your next restart, when nothing is using them."
          echo
          echo "      [s]  stage for the next restart  (recommended)"
          echo "      [u]  update now, live"
          echo "      [a]  abort  (default)"
          echo
        fi
        for tries in 1 2; do
          # `|| ans=""` keeps EOF (Ctrl-D) out of errexit. EOF and Enter both mean "I did not
          # answer", and the safe answer to a risk warning is to NOT proceed.
          read -rp "$prompt" ans || ans=""
          case "${ans,,}" in
            ""|n|no|a|abort)  echo "aborted"; exit 0 ;;
            s|stage)          if [[ "$relup_blocks" == true ]]; then
                                echo "Staging would cancel the stored Fedora release upgrade. Answer u or a."
                                [[ $tries -eq 2 ]] && { echo "aborted"; exit 0; }
                                continue
                              fi
                              surface="offline"; break ;;
            u|update|y|yes)   break ;;
            *) if [[ $tries -eq 1 ]]; then echo "  Please answer $([[ "$relup_blocks" == true ]] || echo "s, ")u or a."
               else echo "aborted"; exit 0; fi ;;
          esac
        done
      else
        # families, not names - same rule as the terminal listing above.
        # per-line strip on a MULTI-LINE list: ${risky_list//[-.]*/} is a glob, not a regex, and
        # its * crosses newlines - it would eat the whole list from the first - or . onwards.
        # shellcheck disable=SC2001
        fams="$(sed 's/[-.].*//' <<<"$risky_list" | sort -u)"
        local fam_n; fam_n="$(wc -l <<<"$fams")"
        # The tail names the offline surface only when it is available: recommending it while a
        # release upgrade is stored points at a run that aborts in pre-flight.
        local tail_advice=". Consider Install on Next Restart"
        [[ "$relup_blocks" == true ]] && tail_advice=""
        # The same vocabulary the terminal listing and the popup use: family_label, or the bare
        # family when Kempt ships no label for it. A notification calling mesa "mesa" while the
        # terminal calls it graphics drivers is one transaction described two ways.
        local fam_disp
        fam_disp="$(head -4 <<<"$fams" | while read -r f; do
                      lbl="$(family_label "$f")"
                      if [[ -n "$lbl" ]]; then printf '%s\n' "$lbl"; else printf '%s\n' "$f"; fi
                    done | paste -sd, - | sed 's/,/, /g')"
        (( fam_n > 4 )) && fam_disp="$fam_disp, ..."
        # --risky-ok: the popup already asked, and the person chose Install Now over this advice.
        [[ -n "$risky_ok" ]] \
          || notify "Kempt" "$rcount session-critical packages pending ($fam_disp)$tail_advice"
      fi
    fi
  fi
}

# The flatpak half of a run. dnf has already run by now, so a flatpak failure is REPORTED and
# never fatal: crashing loses the history entry and notification for a system that already changed.
# The system installation first, then the per-user one when there is one. Each is updated on its
# own, so a failure in one never stops the other, and each failure gets its own log line.
# Reads: include_fp, yflag, log. Writes: fp_status, fp_scopes, fp_eol, and status (which only
# ever moves to "failed").
apply_flatpak_updates() {
  # NOT `local`: this is the caller's variable (see the header). A `local` would shadow it, leave
  # cmd_update's copy unset, and take the run down on the history entry under `set -u`.
  fp_status="skipped"
  fp_scopes='null'
  fp_eol='[]'
  if is_true "$include_fp"; then
    fp_status="ok"
    run_heading "$log" "Apps (flatpak)"
    # Where flatpak's output starts in the log, so the end-of-life scan below reads flatpak's lines
    # and nothing dnf printed.
    local fp_from=0
    [[ -f "$log" ]] && fp_from="$(stat -c %s "$log" 2>/dev/null || echo 0)"
    local held_fp scope scope_status scope_list outcomes=""
    held_fp="$(holds_for flatpak)"
    scope_list="$(flatpak_scopes)"
    # Found before the run but unreadable: not updated, and reported failed like a failed update.
    if [[ "${fp_user_unreadable:-false}" == true ]]; then
      outcomes="user failed"$'\n'; fp_status="failed"; status="failed"; run_failed_otherwise=1
      log_warn "$log" "warning: the apps for you only could not be listed, so they were not updated"
    fi
    for scope in $scope_list; do
      if [[ "$scope" == user ]]; then run_heading "$log" "Apps for you only (flatpak)"; fi
      scope_status=ok
      apply_flatpak_scope "$scope" || scope_status=failed
      outcomes+="$scope $scope_status"$'\n'
      if [[ "$scope_status" == failed ]]; then
        fp_status="failed"; status="failed"
        if [[ "$scope" == user ]]; then
          log_warn "$log" "warning: updating apps for you only failed"
        elif [[ "$scope_list$outcomes" == *user* ]]; then
          log_warn "$log" "warning: updating system apps failed"
        fi
      fi
    done
    # Each installation's outcome, recorded only when there is a per-user one, so a run without it
    # writes the entry it always did. A jq that fails costs the detail, never the run.
    if [[ "$scope_list$outcomes" == *user* ]]; then
      fp_scopes="$(jq -cSRn '[inputs | select(length > 0) | split(" ") | {(.[0]): .[1]}] | add' \
                   <<<"$outcomes" 2>/dev/null)" || fp_scopes='null'
      [[ -n "$fp_scopes" ]] || fp_scopes='null'
    fi
    # The update is over by now, so nothing here may fail the run: a lookup that fails, or prints
    # something that is not a JSON array, means no notes and nothing else.
    local eol
    if eol="$(tail -c +$(( fp_from + 1 )) "$log" 2>/dev/null | flatpak_eol_notices 2>/dev/null)" \
       && jq -e 'type == "array"' <<<"$eol" >/dev/null 2>&1; then
      fp_eol="$eol"
    fi
  fi
}

# One installation's update, with the holds applied by id in both. Non-zero when any part failed.
# Reads: held_fp, yflag, log.
apply_flatpak_scope() {  # system|user
  local scope="$1" rc=0 sflag=() where="system apps"
  [[ "$scope" == user ]] && { sflag=(--user); where="apps for you only"; }
  if [[ -n "$held_fp" ]]; then
    # holds exist → per-app updates of every pending, non-held, INSTALLED app. That pre-filter
    # is the ONLY installed check there is (flatpak errors out on an id it does not have), so an
    # empty installed set means no ids pass and the run reports flatpak failed.
    local installed_fp id pending_fp ids=()
    installed_fp="$(flatpak_snapshot "$scope" | cut -f1 | sed "s/^$KEMPT_FLATPAK_USER_KEY//")" \
      || { installed_fp=""; rc=1; run_failed_otherwise=1; log_warn "$log" "warning: flatpak installed lookup failed for the $where, so none of them were updated"; }
    # ONE capture, read twice below: the apps to name individually, and whether any runtime is
    # pending at all. Asking the backend twice would pay the cached query's cost twice over for an
    # answer that cannot have changed in between.
    # A lookup that FAILS is not "nothing pending": swallowed to an empty list, it updated no app
    # and still reported flatpak `ok`. Failed, like the installed lookup above.
    pending_fp="$(flatpak_check_scope "$scope" 2>/dev/null)" \
      || { pending_fp=""; rc=1; run_failed_otherwise=1; log_warn "$log" "warning: flatpak update lookup failed for the $where, so none of them were updated"; }
    while IFS= read -r id; do
      [[ -n "$id" ]] || continue
      grep -qxF "$id" <<<"$held_fp" && continue
      grep -qxF "$id" <<<"$installed_fp" || continue
      ids+=("$id")
    done < <(jq -r '.[] | select(.kind != "runtime") | .name' <<<"$pending_fp" 2>/dev/null)
    if [[ ${#ids[@]} -gt 0 ]]; then
      apply_with_retry "$log" flatpak_apply "${sflag[@]}" "${yflag[@]}" "${ids[@]}" || rc=1
    fi
    # ...and the runtimes, which the per-app loop above cannot cover. A hold is per app, so a run
    # with holds names the surviving apps one ref at a time - and a ref updates the runtimes that
    # app DEPENDS on, never the ones it does not. Runtimes cannot be held, so the whole set goes
    # in one command, which is what the no-holds branch below already does for everything.
    # Only when one is actually pending, and that condition is the whole point: "every pending app
    # is held" must still mean flatpak is not run at all, rather than run on a set that is empty.
    if jq -e 'any(.[]; .kind == "runtime")' <<<"$pending_fp" >/dev/null 2>&1; then
      apply_with_retry "$log" flatpak_apply "${sflag[@]}" "${yflag[@]}" --runtime || rc=1
    fi
  else
    apply_with_retry "$log" flatpak_apply "${sflag[@]}" "${yflag[@]}" || rc=1
  fi
  return $rc
}

# The offline marker: what Kempt records about a stage it has just made, and all any later reader
# has to go on.
# Reads: surface, dnf_status, staged_fresh, staged_check_names, staged_check_ok,
# staged_excluded_json, ts. Writes: staged, the count the run's own event line reports.
write_stage_marker() {
  # NOT `local`: the run's `offline staged N` event line reports it, so it is the caller's variable.
  staged=""
  # ...and neither is this. Empty when the stage was recorded; otherwise WHY it was not, for the
  # notification and the event line.
  #
  # Everything in this function happens AFTER `dnf5 offline reboot` has armed the machine, and that
  # is what decides how its failures are handled: the transaction WILL install on the next restart
  # whatever happens here. A failure that took the run down - and under errexit a full home is
  # enough, since the copy and the marker write are both writes - would leave a box that is armed
  # and a Kempt that knows nothing about it: no banner, no doctor row, no harvest, no notification,
  # and the update arriving unannounced during a restart the person thought was ordinary.
  #
  # So nothing here may escape, and nothing here is swallowed either. It degrades in the order the
  # readers can tolerate: a marker without its snapshot is a supported shape (every reader takes
  # `.pre_snapshot // empty`), and only a marker that cannot be written at all is unrecoverable.
  stage_untracked=""
  # ...and this, for the lesser of the two: recorded, but without the baseline the restart report
  # would have been diffed against.
  stage_unlisted=""
  if [[ "$surface" == "offline" && "$dnf_status" == "ok" && "$staged_nothing" != true ]]; then
    staged="$staged_fresh"
    [[ -n "$staged" ]] \
      || staged="$(jq -r -n '[inputs][0].backends.dnf.actionable? // empty' "$STATE_FILE" 2>/dev/null || true)"
    local staged_json="null"
    [[ "$staged" =~ ^[0-9]+$ ]] && staged_json="$staged"
    # marker owns its snapshot copy - a later update run overwrites dnf-before.tsv. Sweep first:
    # only the newest staging can be harvested, so older copies accumulate forever.
    # The sweep and the copy are ONE step and can only half-happen: the sweep throws away the
    # previous stage's baseline, so a copy that fails after it leaves neither. The marker is then
    # written WITHOUT pre_snapshot rather than not at all - the harvest degrades to reporting that
    # the stage was applied without naming its packages, which is worth more than a restart that
    # installs sixty packages and says nothing.
    local snap="$SNAP_DIR/offline-pre-$ts.tsv"
    rm -f "$SNAP_DIR"/offline-pre-*.tsv
    cp "$SNAP_DIR/dnf-before.tsv" "$snap" 2>/dev/null || { rm -f "$snap"; snap=""; }
    # WHICH packages, alongside how many: a hold added after this moment cannot change the stored
    # transaction, so all Kempt can do is name what is in it. Read from dnf5's own transaction -
    # the only source that sees packages the resolver added, or one someone else replaced. The
    # check is the fallback and LABELLED so: it may confirm a conflict and may never deny one.
    local staged_names="" staged_names_source=none
    if staged_names="$(offline_txjson_names)"; then
      staged_names_source=transaction
    elif [[ "$staged_check_ok" == true ]]; then
      staged_names="$staged_check_names"; staged_names_source=check
    fi
    # The one gate, at the one moment a name is written down, and all-or-nothing: a list with one
    # name filtered out could still be used to deny a conflict it never saw.
    # printf '%s', never <<<: a here-string on an empty list produces one empty line, which fails
    # the gate and would drop a legitimately empty list.
    if [[ "$staged_names_source" != none ]] && ! printf '%s' "$staged_names" | names_all_valid; then
      staged_names=""; staged_names_source=none
    fi
    # The excluded list comes from the holds file, which architecture.md promises is the user's to
    # edit by hand, so it gets the same gate rather than being trusted to hold_add's past checks.
    if ! jq -e 'type == "array" and all(.[]; type == "string")' <<<"$staged_excluded_json" >/dev/null 2>&1 \
       || ! jq -r '.[]' <<<"$staged_excluded_json" | names_all_valid; then
      staged_excluded_json='[]'
    fi
    # Through a FILE, not an argument: this list is a whole staged transaction, and a release
    # upgrade stages every package on the box. Past roughly 6,800 names it is bigger than the
    # 128 KiB Linux allows one argv entry, and the marker would not be written at all - leaving a
    # transaction armed that Kempt has no record of making, so nothing harvests it after the
    # restart and doctor reports a staged update it cannot explain.
    # A temp file that cannot be made means a full or unwritable /tmp, which the marker write is
    # about to hit too - but the names are the part that can be given up, so it is given up here
    # rather than taking the marker with it. Absent, never empty: `staged_names: []` would claim
    # the transaction installs nothing.
    # WHICH transaction, alongside what is in it: the cookie and the command dnf5 recorded for the
    # transaction just armed. After the restart they are what tells this stage apart from anything
    # that replaced it (offline_history_attribution). Only the keys that read cleanly are written.
    local identity
    identity="$(offline_toml_identity 2>/dev/null)" || identity='{}'
    jq -e 'type == "object"' <<<"$identity" >/dev/null 2>&1 || identity='{}'
    local staged_names_f=/dev/null
    if [[ "$staged_names_source" != none ]]; then
      local f
      if f="$(mktemp 2>/dev/null)" && printf '%s' "$staged_names" > "$f" 2>/dev/null; then
        staged_names_f="$f"
      else
        rm -f "${f:-}"; staged_names_source=none
      fi
    fi
    # boot_id: only a REBOOT applies a stage, so the harvest compares boot sessions rather than
    # guessing from the package set (see harvest_offline).
    # Fields are ADDITIVE and absent when unknown - `staged_names: []` would claim "the
    # transaction installs nothing" where the truth is that nobody could find out. Every reader
    # follows that rule, so a marker written before these fields existed still works.
    # The one failure with nothing left to degrade to. Guarded rather than left to errexit, and
    # `if !` is what makes that true: inside an if-condition errexit stands down, so a jq that dies
    # or an unwritable state directory lands HERE instead of ending the run.
    if ! jq -n --arg ts "$(now_iso)" --arg snap "$snap" \
      --arg boot "$(current_boot_id)" --argjson staged "$staged_json" \
      --arg nsrc "$staged_names_source" --rawfile namesraw "$staged_names_f" \
      --argjson excl "$staged_excluded_json" --argjson ident "$identity" \
      --argjson mver "$KEMPT_MARKER_VERSION" \
      '($namesraw | split("\n") | map(select(length > 0))) as $names |
       {version:$mver, staged_at:$ts, boot_id:$boot, staged:$staged, armed:true,
        staged_names_source:$nsrc, staged_excluded:$excl}
       + $ident
       + (if $snap == "" then {} else {pre_snapshot:$snap} end)
       + (if $nsrc == "none" then {} else {staged_names:$names} end)' \
      | write_offline_marker
    then
      # Hedged, like the sibling message for the run's own entry: the pipeline can fail for reasons
      # this line cannot see, and the notification carries these words to the person.
      stage_untracked="the state directory could not be written, or the record could not be built"
      rm -f "$snap"
    elif [[ -z "$snap" ]]; then
      # Recorded, and honest about what it can no longer do. The stage installs, and every surface
      # BEFORE the restart still reports it - the banner, doctor, the staged count. What is gone is
      # the baseline the harvest diffs, and harvest_offline clears a marker it cannot diff, so
      # after the restart there is no history entry and no notification. Said here because this is
      # the last moment anything can say it.
      stage_unlisted="the restart result will not be reported"
      log_event "offline stage recorded without its package baseline - the restart result will not be reported"
    fi
    [[ "$staged_names_f" == /dev/null ]] || rm -f "$staged_names_f"   # never the placeholder
  fi
}

# What a LIVE run owes a staged transaction it found sitting there. Side effects only: it may
# discard the stage, rebase its baseline, or leave it alone, and it warns on the run's log.
# Reads: surface, snapshots_ok, dnf_status, log.
reconcile_stage_after_live_run() {
  # The lifecycle this sits inside: staging downloads AND arms, so any restart installs it, and
  # the check after that restart harvests it. A live run can arrive at any point in that, and the
  # three cases below are three situations, not variations on one rule. snapshots_ok (plus -s as
  # a floor): none may be decided on a truncated or empty snapshot.
  if [[ "$surface" != "offline" && -f "$OFFLINE_MARKER" && "$snapshots_ok" == true && -s "$SNAP_DIR/dnf-after.tsv" ]]; then
    # Declared here, and named apart from cmd_update's own: these extracted sections run inside
    # cmd_update's scope on purpose, and a name shared with one of its variables would either
    # shadow it or leak out as a global depending on which branch the caller took.
    local mpre stored_relup sup_clean_rc=0
    mpre="$(jq -r '.pre_snapshot // empty' "$OFFLINE_MARKER" 2>/dev/null || true)"
    if [[ -z "$mpre" || ! -f "$mpre" ]]; then
      # Leave the marker alone: harvest_offline handles a dead pointer on its own (it clears the
      # marker), and guessing here could throw away a real staged transaction.
      echo "warning: unreadable offline marker, so the staged-update baseline was not rebased" >&2
    elif same_content "$mpre" "$SNAP_DIR/dnf-before.tsv"; then
      # STILL PENDING: staging writes no rpm changes of its own, so a baseline that still matches
      # the world this run started from means no restart has applied it yet.
      # same_content answers THREE ways - equal, different, unreadable - and the branch below
      # DISCARDS a staged transaction, so only a positive "different" (rc 1) may reach it.
      # `! same_content` would collapse "unreadable" into "different".
      local moved=0
      same_content "$SNAP_DIR/dnf-before.tsv" "$SNAP_DIR/dnf-after.tsv" || moved=$?
      if [[ $moved -eq 2 ]]; then
        log_warn "$log" "warning: could not compare this run's package snapshots, so the staged update was left as it was"
      fi
      if [[ $moved -eq 1 ]]; then
        # SUPERSEDED. The staged transaction carries the rpmdb cookie it was built against and
        # dnf5 refuses one whose cookie has moved, so after a live install the armed stage is a
        # failed offline boot waiting to happen.
        # Whatever the run's status: a live run that failed part way can still have moved the
        # rpm database, and any live dnf5 transaction removes /system-update by itself, leaving
        # the toml at `ready` over a stage no restart will run. Rebasing onto that kept
        # advertising a dead stage.
        # ORDER: the marker goes with the stage, never before it - a marker without a stage
        # promises the popup and the doctor an install nothing can deliver.
        # ...but never clean a transaction that is not ours. Kempt's marker and dnf5's stored
        # transaction can come apart: the user stages a release upgrade after Kempt staged one, and
        # dnf5 cancels Kempt's as it stores theirs, leaving our marker over their transaction. A
        # clean here would then destroy a Fedora release upgrade to tidy up a stage that dnf5 had
        # already thrown away. The marker is the only thing that is ours, so the marker is what
        # goes; the transaction is left exactly where it is.
        if ! stored_relup="$(offline_release_upgrade)"; then
          apply_with_retry "$log" priv_apply dnf-offline-clean || sup_clean_rc=$?
          # The helper checks again as root. A release upgrade stored between the check above and
          # the clean is refused there, and then the marker goes exactly as it does above.
          if [[ $sup_clean_rc -eq $KEMPT_APPLY_REFUSED ]]; then
            stored_relup="$(offline_release_upgrade)" || stored_relup=""
          fi
        fi
        if [[ -n "$stored_relup" ]]; then
          rm -f "$OFFLINE_MARKER" "$mpre"
          log_event "offline marker dropped (a release upgrade ($stored_relup) replaced our stage)"
        elif [[ $sup_clean_rc -eq 0 ]]; then
          rm -f "$OFFLINE_MARKER" "$mpre"
          log_event "offline stage dropped (superseded by live update)"
        elif [[ $sup_clean_rc -eq $KEMPT_APPLY_REFUSED ]]; then
          # Marker kept, like the failure below: doctor reads it against what is stored.
          log_warn "$log" "warning: this update superseded the staged transaction, but it was left in place because $(apply_refusal_reason). See: kempt doctor"
        else
          # Keep the marker: the stage may still be there, and `kempt doctor` reads the two
          # together and says which of them is wrong. Kept DEMOTED, though: the stage can no
          # longer install, and a marker still marked armed goes on telling the widget it will.
          log_warn "$log" "warning: this update superseded the staged transaction, but it could not be discarded. Run: sudo dnf5 offline clean"
          local sup_marker
          if sup_marker="$(offline_marker_read)" && [[ -n "$sup_marker" ]]; then
            jq -c '. + {armed: false}' <<<"$sup_marker" | write_offline_marker \
              || echo "warning: could not record that the staged update can no longer install" >&2
          fi
        fi
      elif [[ $moved -eq 0 ]]; then
        # No rpm moved (a flatpak-only run), so the cookie still matches and the stage is good.
        # Rebasing the baseline onto the after-snapshot keeps the post-reboot harvest diffing the
        # staged transaction and nothing else. atomic_write, not cp: the widget's timer can read
        # this baseline at any moment, and a half-copied one would diff as a real transaction.
        atomic_write "$mpre" < "$SNAP_DIR/dnf-after.tsv" \
          || echo "warning: could not rebase the staged-update baseline. The next check may report this run as the staged one" >&2
      fi
    fi
    # ALREADY APPLIED (baselines differ): a restart ran the stage and no check has harvested it.
    # Nothing to supersede or rebase - either folds that delta into the baseline and the
    # transaction is never reported. The self-refresh below harvests it.
  fi
}

cmd_update() {
  local a h surface include_fp="" risky_ok=""
  surface="$(config_get surface)"
  for a in "$@"; do case "$a" in
    --no-flatpak) include_fp=false ;;
    --risky-ok) risky_ok=1 ;;
    --surface=*) surface="${a#--surface=}" ;;
    *) echo "unknown option: $a" >&2; exit 2 ;;
  esac; done
  [[ -z "$include_fp" ]] && include_fp="$(config_get include_flatpak)"
  local auto; auto="$(config_get auto_accept)"
  # validate BEFORE the auto-accept guard so the two compose (unknown → terminal → still terminal)
  surface="$(resolve_surface "$surface")"
  # only a terminal can prompt - enforced HERE too (cmd_run also guards, but update can be invoked directly)
  # The one exception is a stage asked for at a terminal (what `kempt run --surface=offline` opens
  # with auto_accept off): dnf5 asks before staging there, and turning a request to install on the
  # next restart into a live update is the surprise this guard exists to prevent.
  is_true "$auto" || { [[ "$surface" == "offline" && -t 0 && -t 1 ]] || surface="terminal"; KEMPT_LIVE_OUTPUT=1; }
  [[ "$surface" == "terminal" ]] && KEMPT_LIVE_OUTPUT=1
  export KEMPT_LIVE_OUTPUT

  # An image-based Fedora - Silverblue, Kinoite, Bazzite, a bootc image - updates through
  # rpm-ostree, and /usr is not dnf's to write. Refused HERE, before the lock, before the
  # risky-transaction prompt and before anything is read, because the danger is precisely that
  # nothing downstream would refuse: Kinoite ships dnf5 and plasma-workspace, so both Kempt
  # packages install cleanly, the widget appears, `dnf5 check-update` lists updates and `dnf5
  # upgrade` RESOLVES a transaction rather than saying no. Left to fail on its own it fails after
  # the download, somewhere in the middle, with a message about a read-only file system and nothing
  # anywhere about rpm-ostree.
  # preflight_abort, so this is the same contract as any other refusal that changed nothing: exit
  # 5, and a notification for the surfaces where nobody is reading stderr.
  if on_ostree; then
    preflight_abort "this system updates with rpm-ostree, not dnf, so Kempt cannot update it. Support for these images is planned. For now use Discover, or: rpm-ostree upgrade (bootc upgrade on a bootc image)"
  fi

  # ...and the same treatment for a stage that would destroy a Fedora release upgrade. dnf5 keeps
  # ONE stored transaction for both kinds, so staging updates over a stored release upgrade cancels
  # it. Measured against real dnf5: the 44 -> 45 transaction is replaced by the ordinary one, dnf5
  # prints "Continuing will cancel the old offline transaction" and then does it anyway under -y,
  # which is how Kempt runs it - AND /system-update is left standing, so the machine still restarts
  # into an update, just not the one that was asked for. Re-downloading a release upgrade is
  # gigabytes, so there is no recovering from it either.
  #
  # PRE-FLIGHT and not a failure inside the run, because that is what this is: nothing is started,
  # nothing is changed, and the documented contract for that is exit 5. Reporting it as a failed
  # run put a `status: failed` entry in the history and a "see the log" notification pointing at a
  # zero-byte file, over a run that correctly did nothing.
  #
  # Only the OFFLINE surface. A live run does not replace the stored transaction, and refusing
  # ordinary updates because a release upgrade is waiting would be a bigger imposition than the one
  # this avoids - which is also why this sits after the surface is resolved rather than before.
  recommend_offline_if_risky
  # AFTER the recommendation, and that ordering is the whole point: `[s]tage offline` at that prompt
  # SETS $surface, so a gate placed before it is bypassed by Kempt's own advice - and the stage then
  # reached dnf5 and cancelled the upgrade, recorded in the event log as an ordinary restage.
  if [[ "$surface" == "offline" ]]; then
    local relup
    if relup="$(offline_release_upgrade)"; then
      # Refused in all three states - staging cancels a stored transaction whatever state it is in -
      # and the remedy named is the one that applies to the state it is actually in.
      case "$(offline_release_upgrade_state)" in
        armed)      preflight_abort "a Fedora release upgrade ($relup) is already staged and installs on the next restart. Staging updates would cancel it. Restart to install it, or remove it with: sudo dnf5 offline clean" ;;
        stranded)   preflight_abort "a Fedora release upgrade ($relup) is stored but no longer set to install, so no restart installs it. Staging updates would cancel it. Set it to install again with: sudo dnf5 system-upgrade reboot, or remove it with: sudo dnf5 offline clean" ;;
        incomplete) preflight_abort "a Fedora release upgrade ($relup) is stored and did not finish (dnf5 says \"$(offline_system_status)\"). Staging updates would cancel it. See what happened with: sudo dnf5 offline log, or remove it with: sudo dnf5 offline clean" ;;
        *)          preflight_abort "a Fedora release upgrade ($relup) has been downloaded but not started. Staging updates would cancel it. Begin it with: sudo dnf5 system-upgrade reboot, or remove it with: sudo dnf5 offline clean" ;;
      esac
    fi
  fi
  acquire_lock || { echo "another kempt update is running" >&2; exit 3; }
  trap release_lock EXIT

  kempt_init_dirs
  local ts start log status="ok" reboot=false
  ts="$(date +%Y%m%dT%H%M%S)"; start="$(date +%s)"
  log="$LOG_DIR/$ts.log"

  # snapshots (before). Without one we can never say what changed, so a failure stops the run
  # BEFORE anything is touched (see preflight_abort).
  dnf_snapshot > "$SNAP_DIR/dnf-before.tsv" \
    || preflight_abort "cannot read the installed package set, so nothing was changed"
  # A per-user installation that cannot be read drops only itself: the run goes on without it and
  # reports it failed (apply_flatpak_updates). Only the system set can stop the run.
  local fp_user_unreadable=false
  if is_true "$include_fp" && ! flatpak_snapshot > "$SNAP_DIR/fp-before.tsv"; then
    if flatpak_user_present && flatpak_snapshot system > "$SNAP_DIR/fp-before.tsv"; then
      KEMPT_FLATPAK_USER_SKIP=1; fp_user_unreadable=true
    else
      preflight_abort "cannot read the installed flatpak set, so nothing was changed"
    fi
  fi

  # Recorded here and not a line earlier: everything above can still decline to run without
  # touching the system. Past this point the system changes.
  log_event "run start surface=$surface"

  # dnf
  run_heading "$log" "System (dnf)"
  local yflag=() excl=() dnf_status="ok"
  # WHICH dnf5 transaction a live run was, when dnf5's history can say (live_history_attribution).
  # Empty when it cannot, and everything downstream then reports the run from its two snapshots, the
  # way it did before the lookup existed. Declared here because the live branch below is one of two.
  local live_txid="" live_keep=""
  is_true "$auto" && yflag=(-y)
  local held_dnf; held_dnf="$(holds_for dnf)"
  while IFS= read -r h; do [[ -n "$h" ]] && excl+=("--exclude=$h"); done <<<"$held_dnf"
  # reason_override - a reason worked out here, because after a failed arm the log's first
  #   error-shaped line is about a symlink.
  # staged_check_names / staged_excluded_json - the pre-stage check's two lists, kept with the
  #   count because all three come out of ONE answer and describe one transaction.
  # staged_check_ok - "nothing is pending" as against "the check could not answer".
  # notify_tail - what the FAILED notification says BEYOND the reason, for a cleanup that also
  #   failed and left work only root can do.
  # staged_nothing: the stage ran, succeeded, and had nothing to build. Not a failure, and not a
  # stage either - no marker, no promise, no "installs on the next restart".
  local staged_nothing=false
  # stage_discarded: ...and a transaction stored before it was removed, because it held what the
  # empty stage just excluded.
  local stage_discarded=false
  local reason_override="" notify_tail="" staged_fresh="" staged_check_names="" staged_check_ok=false
  # run_busy_reason: the busy sentence apply_with_retry claimed, if any. run_failed_otherwise: a
  #   failure that was not a lock. Together they decide exit 7 at the end.
  local run_busy_reason="" run_failed_otherwise=""
  local staged_excluded_json='[]'
  if [[ "$surface" == "offline" ]]; then
    # How many updates this stage carries, asked NOW rather than copied from the last check's
    # state.json: it is the only thing anyone is told about a transaction they cannot open. Held
    # packages drop out here exactly as they do from the transaction - the --exclude list above is
    # built from the same holds. A check that cannot answer must not stop the stage: the count
    # degrades to the stale one with a warning.
    # Captured ONCE into a file, not asked three times: the count, the held-and-pending set and
    # the pending names must describe one transaction, and three checks could disagree.
    local cerr cjson; cerr="$(mktemp)"; cjson="$(mktemp)"
    if dnf_check 2>"$cerr" | mark_held dnf > "$cjson"; then
      staged_check_ok=true
      # Each read guarded: inside an `if` body errexit is live again, and a jq that died would
      # take down a stage over a nicety.
      staged_fresh="$(jq '[.[] | select(.held | not)] | length' "$cjson")" || staged_fresh=""
      staged_check_names="$(jq -r '.[] | select(.held | not) | .name' "$cjson")" || staged_check_names=""
      staged_excluded_json="$(jq -c '[.[] | select(.held) | .name]' "$cjson")" || staged_excluded_json='[]'
    else
      staged_fresh=""
      # same rewrite as cmd_check: a missing root helper must not be announced as a timeout here either
      echo "warning: could not count the updates being staged: $(explain_helper_error "$(stderr_tail "$cerr")")" >&2
    fi
    rm -f "$cerr" "$cjson"
    # Whether a transaction existed BEFORE this attempt - the one fact every failure path below
    # needs and none can work out afterwards. Staging over an armed transaction is
    # cancel-then-stage: dnf5 destroys the old one as the new one begins, so a FAILED stage leaves
    # no transaction, a toml that is not `ready`, and the `/system-update` symlink still standing
    # over it - and the next restart detours into the offline updater, installing nothing.
    # Two sources, either enough alone: Kempt's marker and dnf5's status - the second covers a
    # transaction Kempt did not stage, which the re-stage destroys identically.
    local had_stage=false prev_marker prev_pre="" prev_conflict=""
    prev_marker="$(offline_marker_read)"
    [[ -n "$prev_marker" || "$(offline_system_status)" != absent ]] && had_stage=true
    if [[ -n "$prev_marker" ]]; then
      prev_pre="$(jq -r '.pre_snapshot // empty' <<<"$prev_marker" 2>/dev/null || true)"
      # The holds that conflict with the transaction about to be replaced, read NOW because after
      # the stage it is gone and the question cannot be asked. The only record of what a rebuild
      # was FOR.
      prev_conflict="$(offline_staged_state | jq -r '.holds_conflict[]?' 2>/dev/null || true)"
    fi
    # STAGE THEN ARM, and both or neither. `dnf5 upgrade --offline` only downloads - the
    # transaction sits at status="download-complete" and no boot applies it - while `dnf5 offline
    # reboot` (arming) flips it to "ready" and creates /system-update, the only thing systemd's
    # system-update-generator looks for. Arming HERE, not at the restart click, is what makes the
    # promise true: once staged, ANY restart installs. One pkexec flow covers both calls, since
    # auth_admin_keep still holds seconds later.
    # The three statuses below are read with `|| rc=$?` rather than inside an `if`, because exit 3
    # (KEMPT_APPLY_REFUSED) is an answer of its own: the root helper found a release upgrade, or a
    # file it could not read, and changed nothing. Every path that sees it skips the unwind.
    local stage_rc=0 arm_rc=0 clean_rc=0
    # From here until write_stage_marker, dnf5's record is this run's and the marker is still the
    # previous stage's. A check comparing the two in that window must not call this rebuild
    # somebody else's (stage_lock). Released right after the marker is written.
    stage_lock
    # What is stored now, and where the log ends, both read just before the stage: the only way to
    # tell afterwards whether a stage that exited 0 stored anything over a transaction already
    # there (see offline_stored_fingerprint).
    local pre_stage_fp stage_log_sz=0
    pre_stage_fp="$(offline_stored_fingerprint)"
    [[ -f "$log" ]] && stage_log_sz="$(stat -c %s "$log" 2>/dev/null || echo 0)"
    apply_with_retry "$log" priv_apply dnf-offline-stage "${yflag[@]}" "${excl[@]}" || stage_rc=$?
    if [[ $stage_rc -eq $KEMPT_APPLY_REFUSED ]]; then
      dnf_status="failed"; status="failed"
      reason_override="nothing was staged, because $(apply_refusal_reason) and staging would replace it. See: kempt doctor"
      log_event "offline stage refused by the root helper"
    elif [[ $stage_rc -eq 0 ]]; then
      # `dnf5 upgrade --offline` exits 0 and stores NOTHING when the transaction would be empty:
      # every pending update held, or nothing pending at all. Arming then fails with "No offline
      # transaction is stored", and calling THAT "staged but could not arm" blames the arm for a
      # transaction that was never built - a run reported as failed, rc 1, over the user's own
      # holds doing exactly what they asked. Nothing was staged, nothing needed to be, and the run
      # succeeded.
      # Asked of dnf5 rather than inferred from the count this run measured: the count can be
      # stale by the time the stage runs, and dnf5's own answer cannot.
      if [[ "$(offline_system_status)" == absent ]]; then
        staged_nothing=true
        if [[ -n "$held_dnf" ]]; then
          log_event "offline stage found nothing to stage (every pending update is held)"
        else
          log_event "offline stage found nothing to stage"
        fi
      elif [[ -n "$pre_stage_fp" && "$(offline_stored_fingerprint)" == "$pre_stage_fp" ]] \
           && grep -qE '^[[:space:]]*Nothing to do\.?[[:space:]]*$' < <(tail -c +$(( stage_log_sz + 1 )) "$log" 2>/dev/null); then
        # The same empty stage, over a transaction that was ALREADY stored: dnf5 says "Nothing to
        # do.", exits 0, and keeps the old transaction byte for byte, still armed. Arming it again
        # and calling that a restage would install, on the next restart, every package the user
        # has just held. Both signals are required - dnf5's words in THIS stage's output, and the
        # stored files untouched - so a real stage is never mistaken for an empty one.
        # The old transaction goes, through the clean the unwinds below already use, and the run
        # ends exactly as an empty stage over nothing does.
        apply_with_retry "$log" priv_apply dnf-offline-clean || clean_rc=$?
        if [[ $clean_rc -eq 0 ]]; then
          staged_nothing=true; stage_discarded=true
          if [[ -n "$prev_marker" ]]; then rm -f "$OFFLINE_MARKER" ${prev_pre:+"$prev_pre"}; fi
          if [[ -n "$held_dnf" ]]; then
            log_event "offline stage found nothing to stage (every pending update is held)"
          else
            log_event "offline stage found nothing to stage"
          fi
          log_event "offline stage discarded (the stored one would have installed what is now held)"
        elif [[ $clean_rc -eq $KEMPT_APPLY_REFUSED ]]; then
          dnf_status="failed"; status="failed"
          reason_override="nothing new was staged, and the previous staged update was left in place because $(apply_refusal_reason). See: kempt doctor"
        else
          dnf_status="failed"; status="failed"
          reason_override="nothing new was staged, and the previous staged update could not be removed, so it still installs on the next restart, held packages included. Run: sudo dnf5 offline clean"
        fi
      elif { apply_with_retry "$log" priv_apply dnf-offline-arm || arm_rc=$?; [[ $arm_rc -eq $KEMPT_APPLY_REFUSED ]]; }; then
        # Refused as root: what is stored now is not the transaction this run built (a release
        # upgrade replaced it), or cannot be read. No unwind - the clean would be refused for the
        # same reason, and it would target the wrong transaction if it were not.
        dnf_status="failed"; status="failed"
        reason_override="staged, but not set to install on the restart, because $(apply_refusal_reason). See: kempt doctor"
      elif [[ $arm_rc -ne 0 ]]; then
        dnf_status="failed"; status="failed"
        reason_override="staged, but could not set it to install on the restart"
        # Unwind, or the box keeps a downloaded transaction nothing can apply while every later
        # check, doctor run and popup promises an install forever. Best-effort, and a cleanup
        # that also fails must not overwrite the reason with its own.
        apply_with_retry "$log" priv_apply dnf-offline-clean || clean_rc=$?
        if [[ $clean_rc -eq $KEMPT_APPLY_REFUSED ]]; then
          # Never "run: sudo dnf5 offline clean" here: that is the command the refusal protects against.
          log_warn "$log" "warning: the staged update that could not be set to install was left in place because $(apply_refusal_reason). See: kempt doctor"
          notify_tail=". The stored transaction was left in place. See: kempt doctor"
        elif [[ $clean_rc -ne 0 ]]; then
          log_warn "$log" "warning: could not discard the staged update that could not be set to install. Run: sudo dnf5 offline clean"
          # Escalated past stderr because this is state (d): the toml and the boot symlink
          # now disagree and only root can settle it. The reason stays the ARM - the step
          # that failed - so the command travels on the notification instead.
          notify_tail=". The staged update could not be removed. Run: sudo dnf5 offline clean"
        fi
      elif [[ "$had_stage" == true ]]; then
        # A rebuild that worked. `offline staged N` below reports the new transaction; this line
        # reports that there was an old one, and what it was replaced for.
        log_event "offline restage${prev_conflict:+ (holds: $(printf '%s\n' "$prev_conflict" | names_phrase))}"
      fi
    else
      dnf_status="failed"; status="failed"
      # Unwind a failed STAGE too, not only a failed arm (invariant I3): consenting to a rebuild
      # forfeits the old transaction the instant the re-stage begins, so every failure path here
      # must land in "nothing staged, and the user told" - never "the old one is gone and nothing
      # says so". `dnf5 offline clean` is idempotent, so this is best-effort like the arm's.
      if [[ "$had_stage" == true ]]; then
        if offline_armed; then
          # dnf5 failed BEFORE replacing the previous transaction: a download that cannot complete
          # leaves the armed one untouched, toml and symlink included. Nothing to unwind, and a
          # clean would throw away a stage the user still counts on. The marker stays.
          # BOTH halves of armed, never the status alone: any live dnf5 transaction removes
          # /system-update and leaves the toml at `ready`, and that stage installs on no restart.
          # It is stale, and takes the clean below like any other leftover.
          reason_override="could not rebuild the staged update. The previous one is unchanged and still installs on the next restart"
          log_event "offline restage failed (previous stage intact)"
        elif { apply_with_retry "$log" priv_apply dnf-offline-clean || clean_rc=$?; [[ $clean_rc -eq 0 ]]; }; then
          reason_override="the previous staged update was discarded and could not be rebuilt"
          # The marker described a transaction that no longer exists: the re-stage destroyed it,
          # the clean took the remains. Left in place it promises an install nothing can deliver.
          if [[ -n "$prev_marker" ]]; then
            rm -f "$OFFLINE_MARKER" ${prev_pre:+"$prev_pre"}
            log_event "offline marker cleared (rebuild failed, stage discarded)"
          fi
        elif [[ $clean_rc -eq $KEMPT_APPLY_REFUSED ]]; then
          # Marker kept, as in the branch below, so doctor can compare it with what is stored.
          reason_override="could not rebuild the staged update, and what is stored was left in place because $(apply_refusal_reason). See: kempt doctor"
        else
          reason_override="the previous staged update was discarded and could not be rebuilt or cleaned up. Run: sudo dnf5 offline clean"
          # Marker KEPT here, deliberately - state (d) again. doctor reads it against the toml
          # and FAILs on that row, the boot-symlink row FAILs beside it, and both name the command
          # that fixes it. Clearing it downgrades the first to a benign "staged outside Kempt".
        fi
      fi
    fi
  else
    # The two reads that make a live run identifiable, taken as close around the apply as they can
    # be. The command is rebuilt exactly as the root helper builds it (`dnf5 upgrade` then -y then
    # the excludes, libexec/kempt-apply), because that is the command line dnf5 records; the suite
    # takes it from the helper itself, so the two cannot drift apart unnoticed.
    local live_before="" live_cmd live_att
    live_before="$(dnf_history_max_id)" || live_before=""
    local -a live_argv=(dnf5 upgrade "${yflag[@]}" "${excl[@]}")
    live_cmd="${live_argv[*]}"
    apply_with_retry "$log" priv_apply dnf-upgrade "${yflag[@]}" "${excl[@]}" || { dnf_status="failed"; status="failed"; }
    # Asked whatever the run's status: a failed transaction dnf5 recorded is still the transaction
    # this run was, and its packages are still the honest report of what moved.
    if [[ -n "$live_before" ]] && live_att="$(live_history_attribution "$live_before" "$live_cmd")"; then
      live_txid="${live_att%%$'\n'*}"
      if [[ "$live_att" == *$'\n'* ]]; then live_keep="${live_att#*$'\n'}"; fi
    fi
  fi

  # flatpak (live even when dnf staged offline - flatpak has no offline mechanism)
  # Runtimes are counted, itemized and updated alongside the apps: `flatpak update` with no ref
  # updates both, so the check asks about both and the summary reports both.
  local fp_status=skipped fp_scopes=null fp_eol='[]'   # apply_flatpak_updates writes these; see its header
  local RECLAIM_RUN_JSON=""              # reclaim_after_run writes this
  apply_flatpak_updates
  # snapshots (after) + reports
  # Reports must never crash cmd_update after the system already changed - degrade to empty +
  # warning, snapshot as well as diff: the run is over either way, and the history entry (with the
  # notification that carries it) must still be written.
  # `if fn; then` disables errexit inside fn, so both snapshot functions return status explicitly.
  # An empty after-snapshot is NOT usable as a diff input: it reports every package REMOVED.
  local empty_report='{"updated":[],"added":[],"removed":[]}'
  # snapshots_ok gates the offline-marker rebase below and NOTHING else. A snapshot that dies
  # mid-stream leaves a TRUNCATED but non-empty dnf-after.tsv (the redirection creates the file
  # before the command runs) - harmless as a report input, fatal as a harvest baseline, where
  # every package missing from the truncation comes back as newly installed.
  local dnf_report="$empty_report" fp_report="$empty_report" snapshots_ok=true
  if dnf_snapshot > "$SNAP_DIR/dnf-after.tsv"; then
    dnf_report="$(tsv_diff_updates "$SNAP_DIR/dnf-before.tsv" "$SNAP_DIR/dnf-after.tsv")" \
      || { dnf_report="$empty_report"; snapshots_ok=false; log_warn "$log" "warning: dnf report diff failed, so the summary is incomplete. See the snapshots in $SNAP_DIR"; }
  else
    snapshots_ok=false
    log_warn "$log" "warning: dnf snapshot after the run failed, so the summary is incomplete. The update itself is unaffected"
  fi
  # Exact attribution, when dnf5's history named the transaction: the report keeps only what that
  # transaction touched, so a package something else moved between the two snapshots is not reported
  # as part of this run. Same filter, same reason, as the harvest's (harvest_offline). A filter that
  # fails keeps the whole diff - the identification still stands, only the precision is lost.
  # The mktemp is part of the condition, like every other file this far past the apply: a temp file
  # that cannot be created costs the precision, never the run.
  # An empty list of names is NOT a filter that keeps nothing. dnf5 naming no packages for a
  # transaction is a filter that could not be built, and filtering a diff down to it would report a
  # run that installed six hundred megabytes as having changed nothing at all - so it is the same
  # degradation as a jq that fails: keep the whole diff, keep the id.
  local keep_f live_filtered
  if [[ -n "$live_txid" && -n "$live_keep" ]] && keep_f="$(mktemp 2>/dev/null)"; then
    # `. as $x` before index(), for the trap mark_held carries the note about.
    if printf '%s\n' "$live_keep" > "$keep_f" 2>/dev/null \
       && live_filtered="$(jq -c --rawfile k "$keep_f" '
                          ($k | split("\n") | map(select(length > 0))) as $keep
                          | with_entries(.value |= map(select(.name as $x | $keep | index($x) != null)))' \
                          <<<"$dnf_report" 2>/dev/null)" && [[ -n "$live_filtered" ]]; then
      dnf_report="$live_filtered"
    fi
    rm -f "$keep_f"
  fi
  if is_true "$include_fp"; then
    # A per-user set unreadable only now: the report covers the system apps, and is compared with
    # the system rows of the before-snapshot, so the per-user apps are not reported removed.
    local fp_before="$SNAP_DIR/fp-before.tsv" fp_after_ok=true
    if ! flatpak_snapshot > "$SNAP_DIR/fp-after.tsv"; then
      if flatpak_user_present && flatpak_snapshot system > "$SNAP_DIR/fp-after.tsv"; then
        fp_before="$SNAP_DIR/fp-before-system.tsv"
        { grep -v "^$KEMPT_FLATPAK_USER_KEY" "$SNAP_DIR/fp-before.tsv" || true; } > "$fp_before"
        log_warn "$log" "warning: the apps for you only could not be listed after the run, so the summary leaves them out"
        # The per-user apps that did update are missing from the summary, so the run does not say
        # all went well. The jq only changes the recorded outcome: one that fails keeps the old one.
        # Only a run that was otherwise fine takes this reason: an earlier failure keeps its own.
        [[ "$status" == ok ]] \
          && reason_override="${reason_override:-the apps for you only could not be listed after the run, so the summary leaves them out}"
        # Not a lock: a busy system scope beside this exits 1, not 7.
        fp_status="failed"; status="failed"; run_failed_otherwise=1
        local fp_scopes_after
        if fp_scopes_after="$(jq -cS '(. // {}) + {user: "failed"}' <<<"$fp_scopes" 2>/dev/null)" \
           && [[ -n "$fp_scopes_after" ]]; then
          fp_scopes="$fp_scopes_after"
        fi
      else
        fp_after_ok=false
      fi
    fi
    if [[ "$fp_after_ok" == true ]]; then
      fp_report="$(tsv_diff_updates "$fp_before" "$SNAP_DIR/fp-after.tsv" | flatpak_report_scopes)" \
        || { fp_report="$empty_report"; log_warn "$log" "warning: flatpak report diff failed, so the summary is incomplete"; }
      # Only here: after the snapshot the report is built from, and only on a run that worked.
      [[ "$status" == ok ]] && { reclaim_after_run "$log" || true; }
    else
      log_warn "$log" "warning: flatpak snapshot after the run failed, so the summary is incomplete"
    fi
  fi
  # ONE reboot mechanism, owned by the backend: dnf_reboot_needed carries the verdict rule and the
  # -C / --disablerepo / </dev/null hardening (an uncached needs-restarting does network I/O and
  # can prompt on stdin, and this runs from detached surfaces where nobody can answer). Its seam
  # is KEMPT_DNF_CMD. Shape guard: see the twin in cmd_check.
  reboot="$(dnf_reboot_needed)"
  [[ "$reboot" == "true" || "$reboot" == "false" ]] || reboot=false

  # offline staging marker (harvested by cmd_check after reboot). Only ever written for a stage
  # that ARMED: an unarmed transaction installs on no restart, and a marker promises every later
  # reader - the harvest, the doctor, the popup - that one is coming.
  # Read into one variable here, not at the event line below, so the two cannot disagree.
  local staged=""   # write_stage_marker fills this in; the event line below reports it
  local stage_untracked=""   # ...and this, when the stage is real and Kempt could not record it
  local stage_unlisted=""    # ...and this, when it recorded it without the baseline to report on
  write_stage_marker
  stage_unlock   # taken before the stage; harmless on a run that never took it
  # Why it failed, worked out ONCE and handed to everything that renders it: the history entry
  # (and through it the summary), the notification, and the event log. "See <log>" is no answer
  # when the log is four hundred lines of dnf progress.
  local reason=""
  [[ "$status" == "ok" ]] || reason="${reason_override:-$(run_failure_reason "$log")}"
  # The exit code. 7 only when the reason given is the busy sentence and nothing else failed, so a
  # script can wait and try again; any other failure is 1.
  local run_rc=0
  if [[ "$status" != "ok" ]]; then
    run_rc=1
    if [[ -n "$run_busy_reason" && "$reason" == "$run_busy_reason" ]]; then
      if [[ -z "$run_failed_otherwise" ]]; then
        run_rc=7
      else
        # Busy, and something else failed too: trying again alone would not fix the run, so the
        # reason says so in place of "Try again".
        reason="${reason%" $KEMPT_BUSY_TRY_AGAIN"} $KEMPT_BUSY_ALSO_FAILED"
      fi
    fi
  fi

  # history entry
  local held_dnf_json held_fp_json hist="$HIST_DIR/$ts.json" hist_tmp
  hist_tmp="$(mktemp 2>/dev/null || true)"
  held_dnf_json="$(holds_for dnf | jq -Rn '[inputs]')"
  held_fp_json="$(holds_for flatpak | jq -Rn '[inputs]')"
  # The two reports come through FILES for the reason assemble_state does: they scale with the
  # transaction, argv caps a single entry at 128 KiB, and THIS site is on the far side of the
  # update. An E2BIG here kills the run after dnf5 has installed everything - no history entry, no
  # summary, no notification, no run-done event, and no post-run check, which is the only thing
  # that takes the popup out of its updating state. A successful 1,200-package update presented as
  # a spinner for three hours.
  # ...and the files themselves are a nicety too. A full /tmp here used to end the run under
  # errexit with the same cost; now it costs the entry, through the same `hist_tmp=""` degrade the
  # jq below takes, and the run goes on to its event line and its closing check.
  local dnf_rep_f="" fp_rep_f=""
  if ! { dnf_rep_f="$(mktemp 2>/dev/null)" && fp_rep_f="$(mktemp 2>/dev/null)" \
         && printf '%s' "$dnf_report" 2>/dev/null > "$dnf_rep_f" \
         && printf '%s' "$fp_report" 2>/dev/null > "$fp_rep_f"; }; then
    rm -f ${hist_tmp:+"$hist_tmp"}; hist_tmp=""
  fi
  # Floored at 0: a clock stepped backwards during the run (NTP correcting a fast clock, a resume
  # across a time change) puts the end before the start, and a negative duration is not a
  # measurement. Every reader would otherwise print it as "in -287s".
  local run_dur=$(( $(date +%s) - start ))
  (( run_dur >= 0 )) || run_dur=0
  # WHY nothing was staged, for the surfaces that report this run afterwards. The event line and
  # the notification already say it (both branch on `staged_nothing` above), but they are spoken
  # once and gone; the entry is what the popup's post-run line and its last-update row are rendered
  # from, and those two had only `surface` and `status` to go on. A run that staged nothing is
  # `offline` and `ok`, exactly like one that staged sixty packages, so both said "Updates are
  # staged - they install on the next restart" over a restart that will install nothing.
  #
  # Written ONLY when it happened, never as `false` or `null`: an entry from a build before this
  # field cannot be told apart from one that staged properly, so absence has to keep meaning what
  # it means today. Which of the two reasons it was is the difference between "Kempt did nothing"
  # and "your holds did what you asked" - the first reads as a fault - and it is the same
  # distinction, in the same words, that the notification below makes.
  local staged_nothing_why=""
  if [[ "$surface" == "offline" && "$status" == "ok" && "$staged_nothing" == true ]]; then
    if [[ -n "$held_dnf" ]]; then staged_nothing_why=held; else staged_nothing_why=nothing_pending; fi
  fi
  # `transaction_id` is additive and top-level, exactly as the harvest writes it: the id
  # `dnf5 history info` takes, present only when dnf5's history named the transaction.
  jq -n --arg ts "$(now_iso)" --arg surface "$surface" --arg status "$status" \
        --arg staged_nothing_why "$staged_nothing_why" \
        --arg log "$log" --argjson dur "$run_dur" --arg txid "$live_txid" \
        --argjson reboot "$reboot" --arg error "$reason" \
        --slurpfile dnfa "$dnf_rep_f" --arg dnf_status "$dnf_status" --argjson dnf_held "$held_dnf_json" \
        --slurpfile fpa "$fp_rep_f" --arg fp_status "$fp_status" --argjson fp_held "$held_fp_json" \
        --argjson fp_eol "$fp_eol" --argjson fp_scopes "$fp_scopes" --slurpfile fp_reclaimed <(printf '%s\n' "${RECLAIM_RUN_JSON:-null}") '
    ($dnfa[0]) as $dnf | ($fpa[0]) as $fp | ($fp_reclaimed[0]) as $fp_reclaimed |
    {timestamp:$ts, surface:$surface, status:$status, duration_sec:$dur,
     reboot_needed:$reboot, log:$log, error:$error,
     backends: {
       dnf:     ($dnf | . + {status:$dnf_status, skipped_held:$dnf_held}),
       flatpak: ($fp  | . + {status:$fp_status,  skipped_held:$fp_held, eol:$fp_eol}
                      + (if $fp_reclaimed == null then {} else {reclaimed: $fp_reclaimed} end)
                      + (if $fp_scopes == null then {} else {scopes: $fp_scopes} end)) }}
    + (if $txid == "" then {} else {transaction_id: ($txid | tonumber)} end)
    + (if $staged_nothing_why == "" then {} else {staged_nothing: $staged_nothing_why} end)' > "$hist_tmp" \
    || { rm -f ${hist_tmp:+"$hist_tmp"}; hist_tmp=""; }
  # Removed whatever happened above: an unguarded write here used to take the whole run down on a
  # full home, on the far side of an update that had already installed everything - no summary, no
  # notification, no run-done event and no post-run check, which is the only thing that takes the
  # widget out of its updating state. A successful update presented as a spinner that never stops.
  rm -f ${dnf_rep_f:+"$dnf_rep_f"} ${fp_rep_f:+"$fp_rep_f"}
  # Built beside the run and INSTALLED into the history, rather than written there directly. What a
  # failure costs is then only the durable record: everything below reads this file to render the
  # summary, the notification and the run-done count, and rendering from the copy that was built
  # keeps the person in front of the machine told. `kempt history` is what will not have it.
  if [[ -n "$hist_tmp" ]] && cp "$hist_tmp" "$hist" 2>/dev/null; then
    rm -f "$hist_tmp"; hist_tmp=""
  else
    # "the run itself", not "the update": on the offline surface nothing has been installed - a
    # transaction was staged, and it installs on the next restart. This line is printed on both.
    log_warn "$log" "warning: this run is not in the history. The run itself finished"
    log_event "history entry not written (state directory unwritable?)"
    rm -f "$hist"
    hist="$hist_tmp"     # possibly empty; every reader below already tolerates that
  fi

  # A successful OFFLINE run gets its own event line rather than "run done": nothing has been
  # applied yet, and the harvest after the restart is what reports it.
  if [[ "$status" == "ok" ]]; then
    if [[ "$surface" == "offline" ]]; then
      # Not when nothing was staged: "offline staged ?" over a run that logged "found nothing to
      # stage" is two lines contradicting each other about the same second.
      if [[ "$staged_nothing" != true ]]; then
        log_event "offline staged ${staged:-?}${stage_untracked:+ (NOT recorded: $stage_untracked)}"
      fi
    else
      local upd
      upd="$(jq -r '[.backends[].updated | length] | add // 0' "$hist" 2>/dev/null)" || upd="?"
      log_event "run done rc=0 updated=$upd reboot=$([[ "$reboot" == true ]] && echo needed || echo no)"
    fi
  else
    # The same rc this command exits with (the return at the bottom).
    log_event "run failed rc=$run_rc: $reason"
  fi

  # tell the human. Both readers take the entry as a FILE, and on the one path where neither the
  # history nor a temp file could be written there is no file to give them - so they are skipped
  # rather than handed a path that does not exist, which would end the run here on jq's rc. The
  # notification below still goes out; it just cannot carry the counts.
  [[ -n "$hist" ]] && render_summary "$hist"
  if [[ "$surface" != "terminal" ]]; then
    # Same truth as the summary: a run that installed and removed packages is never "0 updated".
    local phrase=""
    [[ -n "$hist" ]] && phrase="$(run_counts_phrase "$hist")"
    # ORDER: a failed offline run takes the failure branch, not the staged one. "Installs on the
    # next restart" is a claim about the future, and a stage that was discarded has none.
    if [[ "$surface" == "offline" && "$status" == "ok" && "$staged_nothing" == true ]]; then
      # Nothing was staged, so there is nothing to install on any restart. Saying which of the two
      # reasons it was is the difference between "Kempt did nothing" and "your holds did what you
      # asked": the first reads as a fault.
      local discarded_tail=""
      [[ "$stage_discarded" == true ]] && discarded_tail=". The update staged earlier was removed"
      if [[ -n "$held_dnf" ]]; then
        notify "Kempt" "Nothing to stage, because every pending update is held$discarded_tail"
      else
        notify "Kempt" "Nothing to stage, because no updates are pending$discarded_tail"
      fi
    elif [[ "$surface" == "offline" && "$status" == "ok" && -n "$stage_untracked" ]]; then
      # The stage is REAL: it is downloaded, armed, and the next restart installs it. What failed is
      # Kempt's record of it, so the promise is kept and the limit stated in the same breath - this
      # is the one notification that has to carry both, because every later surface will be silent.
      notify "Kempt" "Updates are staged and install on the next restart. Kempt could not record them ($stage_untracked), so it will not report the result afterwards"
    elif [[ "$surface" == "offline" && "$status" == "ok" ]]; then
      notify "Kempt" "Updates are staged and install on the next restart${stage_unlisted:+ ($stage_unlisted)}"
    elif [[ "$status" == "ok" ]]; then
      # The space an automatic removal freed, when it freed some: the one moment it is news.
      local freed_tail=""
      if [[ -n "$RECLAIM_RUN_JSON" && "${RECLAIM_RESULT:-}" == removed && -n "${RECLAIM_BYTES:-}" \
            && "${RECLAIM_BYTES:-0}" != 0 ]]; then
        freed_tail=", ~$(human_bytes "$RECLAIM_BYTES") freed"
      fi
      notify "Kempt" "${phrase:-Update finished}$freed_tail$([[ "$reboot" == "true" ]] && echo ', reboot needed')"
    else
      # The same reason the summary and the event line carry: "see the log" is not an answer.
      notify "Kempt" "Update FAILED${reason:+ ($reason)}. See $log$notify_tail"
    fi
  fi
  # The copy the summary was rendered from, when it could not be installed into the history.
  [[ -n "${hist_tmp:-}" ]] && rm -f "$hist_tmp"
  reconcile_stage_after_live_run
  # AFTER the reconciliation above, which is what decides whether a stage still stands, and BEFORE
  # the check below, which is the slow half. The check publishes this too; this is the same fact,
  # tens of seconds earlier, so no surface spends that window offering to stage what is already
  # staged. See publish_staged_state.
  publish_staged_state
  # Best-effort self-refresh so a CLI-only user is not left staring at a pending list the run
  # already emptied. Never allowed to change the run's verdict. It takes seconds and prints
  # nothing, so a person watching is told what the pause is.
  CHECK_WROTE_STATE=""
  # The skip this run set for itself covers its apply and its after-snapshot only. The check asks the
  # per-user installation again, so a listing that still fails is recorded there as failed.
  [[ "$fp_user_unreadable" == true ]] && unset KEMPT_FLATPAK_USER_SKIP
  [[ -t 1 ]] && printf '\nChecking for anything left to update…\n'
  cmd_check >/dev/null 2>&1 || true
  # Tells the terminal wrapper (cmd_run) that this run has had its closing check, so it does not
  # run a second one. Set only by that wrapper. Only after a check that wrote state: one that lost
  # the check lock served the old state, so the window's own check is the one that counts.
  if [[ -n "${KEMPT_CLOSING_CHECK_MARK:-}" && -n "$CHECK_WROTE_STATE" ]]; then
    : > "$KEMPT_CLOSING_CHECK_MARK" 2>/dev/null || true
  fi
  return "$run_rc"
}

# Waits for a launched update window to START, the one thing `kempt run` cannot otherwise see: the
# emulator is detached and its streams go to /dev/null. The window's first act is to delete the
# token, so the token going away IS the window starting. rm is atomic, so exactly one side gets the
# token, and that is what stops a window arriving after this gave up from starting an update behind
# a report that said none started.
# 0: the window started, or its launcher is still running at the deadline (a slow start is not a
#    failure, and the token is left for the window to claim).
# 1: it will not start. RUN_LAUNCH_RC holds the launcher's status, 0 for one that handed the window
#    to another process that never opened it.
wait_for_window() {  # pid token seconds
  local pid="$1" token="$2" ticks=$(( $3 * 10 )) i
  RUN_LAUNCH_RC=""
  for ((i = 0; i < ticks; i++)); do
    [[ -e "$token" ]] || return 0
    if [[ -z "$RUN_LAUNCH_RC" ]] && ! kill -0 "$pid" 2>/dev/null; then
      RUN_LAUNCH_RC=0; wait "$pid" 2>/dev/null || RUN_LAUNCH_RC=$?
      # An error means nothing is coming. Exit 0 may be an emulator that handed the window to an
      # instance it already had running, so the token still gets the rest of the wait.
      [[ "$RUN_LAUNCH_RC" -ne 0 ]] && break
    fi
    sleep 0.1
  done
  if [[ -z "$RUN_LAUNCH_RC" ]]; then
    kill -0 "$pid" 2>/dev/null && return 0
    RUN_LAUNCH_RC=0; wait "$pid" 2>/dev/null || RUN_LAUNCH_RC=$?
  fi
  rm -- "$token" 2>/dev/null || return 0    # claimed in the last instant: it started
  return 1
}

# What the widget's "Update now" button calls: pick the surface, then get out of the way.
# cmd_update re-checks auto_accept itself; this guard is the LAUNCH decision, since a detached run
# can never answer a prompt.
cmd_run() {
  local dry="" surface auto a named="" named_set="" risky_arg=""
  # An unrecognised argument must never fall through to a real launch.
  for a in "$@"; do case "$a" in
    --print-command) dry=1 ;;
    # The popup asked about session-critical updates and the person chose Install Now. Passed on
    # to a detached update only: a terminal run asks its own question whatever the popup heard.
    --risky-ok) risky_arg=" --risky-ok" ;;
    # The old spelling, accepted for one release and advertised nowhere - it is deliberately absent
    # from the usage text above and from the man page. The flag prints the LAUNCHER and never a
    # transaction, so "dry run" promised a preview of the update itself, which is the one thing
    # somebody would reach for it to get.
    --dry-run) dry=1 ;;
    # One run on a named surface instead of the configured one. The widget stages through this
    # (`run --surface=offline`) so a stage gets the refusals below - the held lock above all -
    # where the widget can read them, rather than inside a detached `kempt update` whose exit
    # status nobody reads. Strict where the setting is lenient: a stored typo falls back to the
    # terminal (resolve_surface), but a surface asked for by name is a request, and guessing at it
    # could turn a stage into a live update. Once only, so there is no "which one wins".
    --surface=*)
      [[ -z "$named_set" ]] || { echo "unknown option: $a (--surface given twice)" >&2; exit 2; }
      named_set=1; named="${a#--surface=}"
      named="${named#"${named%%[![:space:]]*}"}"; named="${named%"${named##*[![:space:]]}"}"
      named="${named,,}"
      case "$named" in
        terminal|popup|background|offline) ;;
        *) echo "unknown --surface value: ${a#--surface=} (use terminal, popup, background or offline)" >&2; exit 2 ;;
      esac ;;
    *) echo "unknown option: $a" >&2; exit 2 ;;
  esac; done
  if [[ -n "$named_set" ]]; then surface="$named"
  else surface="$(resolve_surface "$(config_get surface)")"; fi
  auto="$(config_get auto_accept)"
  # A named surface obeys this too, the same rule cmd_update applies to its own --surface.
  is_true "$auto" || surface="terminal"   # only a terminal can prompt

  # Refused HERE, before anything is launched, while another update holds the lock. cmd_update
  # refuses too, but inside a window or a detached shell whose status nobody reads: `run` returned
  # 0, and a second widget (tray and panel both, which the README describes) entered its updating
  # pane for a run that was never going to happen, then claimed the other run's result as its own.
  # This only PROBES the lock. cmd_update still takes it for real, so two presses in the same
  # instant are still settled there. -E picks a status that means "held" and nothing else, so an
  # unreadable lock file is not reported as a running update.
  if [[ -e "$LOCK_FILE" ]]; then
    local lock_rc=0
    flock -n -E 75 "$LOCK_FILE" true 2>/dev/null || lock_rc=$?
    [[ $lock_rc -eq 75 ]] && { echo "An update is already running." >&2; exit 3; }
  fi

  if [[ "$surface" == "terminal" ]]; then
    # Checked before the dry run too: "what would happen" must include "nothing, you have no
    # terminal emulator".
    command -v "$KEMPT_TERMINAL" >/dev/null \
      || { echo "Kempt could not find $KEMPT_TERMINAL. Install it, or run updates another way: kempt config set surface background (Settings > Run updates in > In the background)" >&2; exit 4; }
    # A named surface is passed on to the update in the window, because `kempt update` reads the
    # configured surface itself: without it, a terminal asked for by name on a box configured to
    # stage would stage in that window. Nothing is added without one, so the default launch is
    # the command it always was.
    # A stage asked for by name stays a stage: with auto_accept off it runs in this window, where
    # dnf5 can show the transaction and ask, and never turns into a live update.
    local upd_arg=""
    if [[ "$named" == "offline" ]]; then upd_arg=" --surface=offline"
    elif [[ -n "$named_set" ]]; then upd_arg=" --surface=terminal"; fi
    if [[ -n "$dry" ]]; then echo "terminal: $KEMPT_TERMINAL -e kempt update$upd_arg"; return 0; fi
    # INVARIANT: the widget leaves its updating state on ONE event - state.json changing under its
    # watcher (plasmoid/contents/ui/main.qml, pollWatch), or a three-hour guard. So EVERY exit
    # from this window must rewrite state.json, or the popup sits on an empty "Updating…" pane for
    # up to three hours. The two easy to miss: the risky prompt's abort (cmd_update exits 0 there,
    # BEFORE its own post-run check) and the user closing the window mid-run.
    # Hence two traps, NOT redundant: EXIT covers every ordinary exit whatever the status, and
    # HUP/INT/TERM make the signal path certain: closing a terminal window SIGHUPs the foreground
    # process group, and whether bash runs the EXIT trap when it dies of an untrapped fatal signal
    # has differed between versions. They do nothing but `exit`, which is what makes EXIT fire.
    # The check is quiet and its status discarded, so it cannot turn a good run into a failed one;
    # $ec, the UPDATE's status, is what leaves this shell on both paths. run_check is guarded so
    # the ordinary path checks once BEFORE the "press any key" prompt - the window must not be
    # closable until the state has been rewritten.
    # printf %q, not hand-written quotes: this builds a script for ANOTHER shell, and a checkout
    # path containing an apostrophe would close the quote early and yield a wrapper that fails
    # `bash -n`. Same in the detached branch below.
    local wrapper self_q
    printf -v self_q '%q' "$SELF"
    # TWO ways to run the same check, and the difference is the whole point.
    #   run_check   - the ordinary path, synchronous, before the "press any key" prompt, so the
    #                 window cannot be closed until the state has been rewritten.
    #   detach_check - the signal path. This shell and everything in its process group are about
    #                 to be killed, and the check is the ONE event that takes the popup out of its
    #                 updating state. Run in the group, it dies mid-flight: closing a terminal
    #                 SIGHUPs the group and the emulator SIGKILLs whatever is still there moments
    #                 later, while a real check takes SECONDS because it talks to dnf. setsid puts
    #                 it in a session of its own, where neither signal reaches it.
    #   `checked` makes them exclusive: whichever runs first, the other returns.
    # The start token (see wait_for_window), claimed before anything else and BEFORE the traps: a
    # window that finds it already taken back was reported as never having started, so it starts
    # nothing, and it runs no check either, because there is no run for the check to end.
    local token token_q launcher wait_s="${KEMPT_RUN_START_WAIT:-5}"
    [[ "$wait_s" =~ ^[0-9]+$ ]] || wait_s=5
    kempt_init_dirs
    token="$(mktemp "$KEMPT_STATE_DIR/run-start.XXXXXX")"
    printf -v token_q '%q' "$token"
    wrapper="rm -- $token_q 2>/dev/null || { echo 'Kempt stopped waiting for this window, so the update was not started. Start it again from Kempt.'; read -rn1 -s -p 'Press any key to close…'; exit 1; }; "
    # A finished update has already checked on its way out (the end of cmd_update), and a second
    # check here only doubled the wait before the prompt and put one more check in the log. So the
    # wrapper checks only when the update did not leave its closing-check mark, which is the abort
    # and the early exits. A mark, not a comparison of state.json: the update writes that file
    # twice, and the second write can get the first one's inode back, so an inode test read a
    # checked run as unchecked; mtime has one-second granularity on some filesystems.
    local mark_q
    printf -v mark_q '%q' "$STATE_FILE.closing-check"
    wrapper+="mark=$mark_q.\$\$; rm -f \"\$mark\"; "
    wrapper+="checked=0; run_check() { [ \$checked = 1 ] && return 0; checked=1; echo; echo 'Checking for anything left to update…'; $self_q check >/dev/null 2>&1 || true; }; "
    wrapper+="detach_check() { [ \$checked = 1 ] && return 0; checked=1; setsid $self_q check >/dev/null 2>&1 & }; "
    wrapper+="trap 'ec=\$?; rm -f \"\$mark\"; detach_check; exit \$ec' EXIT; trap 'exit' HUP INT TERM; "
    wrapper+="KEMPT_CLOSING_CHECK_MARK=\"\$mark\" $self_q update$upd_arg; ec=\$?; [ -e \"\$mark\" ] && checked=1; run_check; echo; read -rn1 -s -p 'Press any key to close…'; exit \$ec"
    setsid "$KEMPT_TERMINAL" -e bash -c "$wrapper" >/dev/null 2>&1 &
    launcher=$!
    # A window that never opens used to be a complete no-op that said 0: no event, no history, and
    # a widget sitting on its updating pane for three hours. Found installed is not the same as able
    # to draw (an SSH session has no display), so the only honest answer is to wait for the start.
    if ! wait_for_window "$launcher" "$token" "$wait_s"; then
      local why
      if [[ "$RUN_LAUNCH_RC" -ne 0 ]]; then why="$KEMPT_TERMINAL exited $RUN_LAUNCH_RC"
      else why="$KEMPT_TERMINAL opened no window within ${wait_s}s"; fi
      echo "The terminal window did not open, so the update did not start ($why). Run updates another way: kempt config set surface background (Settings > Run updates in > In the background)" >&2
      log_event "run did not start: $why"
      exit 5
    fi
  else
    if [[ -n "$dry" ]]; then echo "detached: kempt update$risky_arg (surface=$surface)"; return 0; fi
    local self_q surface_q
    printf -v self_q '%q' "$SELF"; printf -v surface_q '%q' "$surface"
    setsid bash -c "$self_q update --surface=$surface_q$risky_arg" >/dev/null 2>&1 &
  fi
}

cmd_summary() {  # [N] - 1 = latest (default) | --json - the newest run's entry, verbatim
  # --json exists for the popup, which needs what the last run DID as data. It hands over the
  # history entry and derives nothing: re-deriving would put a second, lossier copy of
  # render_summary's rules in the widget.
  local json=false
  if [[ "${1:-}" == "--json" ]]; then json=true; shift; fi
  # N means nothing to --json, which answers one question, about the last run - and ignoring the
  # stray argument would silently serve the WRONG run under exit 0.
  if [[ "$json" == true ]]; then
    [[ $# -eq 0 ]] || { echo "usage: kempt summary --json  (takes no N)" >&2; exit 2; }
  else
    [[ $# -le 1 ]] || { echo "usage: kempt summary [N] | kempt summary --json" >&2; exit 2; }
  fi
  local n="${1:-1}" f out i files=()
  [[ "$n" =~ ^[1-9][0-9]*$ ]] || { echo "usage: kempt summary [N]  (N >= 1, 1 = latest)" >&2; exit 2; }
  # newest first. `|| true`: an empty history dir makes ls exit 2, which pipefail would turn into
  # a dead command. No runs yet is NOT an error.
  # LC_ALL=C on the sort is NOT redundant with lib/common.sh's pin - do not delete it as such.
  # "Newest" is byte order, and the locales disagree: `20260827T120000-offline.json` (a harvest in
  # the same second as a run) sorts BELOW `20260827T120000.json` under C but ABOVE it under
  # en_US.UTF-8, which ignores punctuation at the first level.
  # `ls` is not parsing names: the SHELL expands the glob, ls is the existence filter, sort orders.
  # shellcheck disable=SC2012
  while IFS= read -r f; do [[ -n "$f" ]] && files+=("$f"); done \
    < <(ls -1 "$HIST_DIR"/*.json 2>/dev/null | LC_ALL=C sort -r || true)
  # Nothing recorded is not an error in either mode. --json says it with EMPTY stdout, this
  # project's "no data" convention - never a fabricated empty run a reader would count.
  if [[ ${#files[@]} -eq 0 ]]; then
    [[ "$json" == true ]] || echo "no update runs recorded yet"
    exit 0
  fi
  i=$(( n - 1 ))
  if (( i >= ${#files[@]} )); then   # N past the end → oldest, and SAY so
    i=$(( ${#files[@]} - 1 ))
    echo "note: only ${#files[@]} run(s) recorded, so this is the oldest" >&2
  fi
  # --json answers about ONE run - the newest - and deliberately never walks back to the one
  # underneath, though the human branch below does: the widget asks what the run that just
  # finished DID, and an older entry would be announced as that run. A damaged newest entry is
  # therefore empty stdout under exit 0, the "no data" convention.
  # `cat`, not jq's rendering, so the caller gets exactly what the run recorded - fields this
  # build has never heard of included. Hence the strict guard, since whatever it waves through
  # reaches the widget's JSON.parse:
  #   [inputs] | length == 1   house idiom (see cmd_check) - a MULTI-DOCUMENT file is valid jq
  #     input, so `jq -e .` passes it and `cat` then emits two documents.
  #   .[0] | type == "object"  `jq -e` fails only on null and false, so `[]`, `42` and
  #     `"a string"` would pass here while render_summary below refuses them.
  if [[ "$json" == true ]]; then
    if jq -e -n '[inputs] | length == 1 and (.[0]|type == "object")' "${files[$i]}" >/dev/null 2>&1; then
      cat "${files[$i]}"; return 0
    fi
    echo "warning: corrupt history entry: ${files[$i]}" >&2
    return 0
  fi
  for (( ; i < ${#files[@]}; i++ )); do
    # One damaged entry must not be the last word the PERSON gets: warn, fall back to the next
    # newest. The -n test is load-bearing - render_summary exits 0 having printed NOTHING for a
    # zero-byte entry, and that must not pass for a successful render.
    if out="$(render_summary "${files[$i]}" 2>/dev/null)" && [[ -n "$out" ]]; then
      printf '%s\n' "$out"
      # Below the run, answering the other question: what is about to happen. Human mode only -
      # a staged transaction belongs to the box, not to the run --json hands over.
      staged_summary_line
      return 0
    fi
    echo "warning: corrupt history entry: ${files[$i]}" >&2
  done
  echo "no update runs recorded yet"
}

cmd_history() {  # [--json] - every run, newest first; --json as one array of history entries
  local json=false
  if [[ "${1:-}" == "--json" ]]; then json=true; shift; fi
  [[ $# -eq 0 ]] || { echo "unknown option: $1" >&2; exit 2; }
  local f row files=()
  # same while-read form as cmd_summary: an unquoted $(ls) splits on whitespace and globs
  # shellcheck disable=SC2012   # shell-expanded glob; ls is the existence filter, sort is the order
  while IFS= read -r f; do [[ -n "$f" ]] && files+=("$f"); done \
    < <(ls -1 "$HIST_DIR"/*.json 2>/dev/null | LC_ALL=C sort -r || true)
  if [[ "$json" == true ]]; then
    # Each element is what `summary --json` prints for that run, behind the same guard: one JSON
    # object per file. A damaged entry is named on stderr and left out. No runs is `[]`.
    # Read once per entry, and the array built from what was read: a file pruned or rewritten by
    # a run in the meantime then costs only its own element, never the command.
    local doc docs=()
    for f in "${files[@]}"; do
      if doc="$(jq -c -e -n '[inputs] | select(length == 1 and (.[0]|type == "object")) | .[0]' "$f" 2>/dev/null)" \
         && [[ -n "$doc" ]]; then
        docs+=("$doc")
      elif [[ -e "$f" ]]; then
        echo "warning: corrupt history entry: $f" >&2
      fi
    done
    printf '%s\n' ${docs[@]+"${docs[@]}"} | jq -n '[inputs]' 2>/dev/null || echo '[]'
    return 0
  fi
  local phrase err
  for f in "${files[@]}"; do
    # capture before printing: a damaged entry must not emit half a row, nor take the whole
    # listing down - every other run is still perfectly readable.
    # run_counts_phrase, not a local ".updated | length": counting upgrades alone prints
    # "0 updated" for a run whose own summary says "+2 installed, -1 removed".
    if row="$(jq -r '[.timestamp, .surface, .status] | join("  ")' "$f" 2>/dev/null)" \
       && [[ -n "$row" ]] \
       && phrase="$(run_counts_phrase "$f" 2>/dev/null)" && [[ -n "$phrase" ]]; then
      # The reason, on the rows that have one, or a failed row sends the reader to a log file
      # to learn the authentication dialog was closed. `// ""` keeps older entries rendering the
      # same.
      err="$(jq -r '.error // ""' "$f" 2>/dev/null || true)"
      printf '%s  %s%s\n' "$row" "$phrase" "${err:+  ($err)}"
    else
      echo "warning: corrupt history entry: $f" >&2
    fi
  done
  # No entries at all is still an answer, in the words `kempt summary` uses: empty output reads as
  # the command having failed. Only when there are no entry files: over entries that all failed to
  # read, "no update runs recorded" would be false, and the warnings above already say what is wrong.
  (( ${#files[@]} )) || echo "no update runs recorded yet"
}

# The staged-offline result is only visible AFTER the reboot that applied it, so the next check is
# what turns it into a normal history entry.
# GATED ON THE BOOT SESSION: "the installed set moved" is no evidence the stage applied - a live
# kempt run or a manual `dnf install cowsay` trips it too, and would label someone else's change
# "offline (applied on reboot)". Only a reboot can apply a stage, so same boot = still pending.
#
# clear_gone_stage: a stage that is no longer there is not pending, whatever the boot session or
# package set says, and nothing is reported but the event line. Its own function because
# harvest_offline reaches it from two directions and they must not drift about what "clearing"
# removes: the snapshot copy belongs to the marker, so it goes too or it is orphaned.
clear_gone_stage() {  # marker-owned pre-snapshot path (possibly empty), the marker it came from
  # Never delete a marker somebody else wrote while this ran: see offline_marker_still.
  if [[ -n "${2:-}" ]] && ! offline_marker_still "$2"; then
    rm -f ${1:+"$1"}
    log_event "offline marker kept (a new stage arrived while the check ran)"
    return 0
  fi
  rm -f "$OFFLINE_MARKER" ${1:+"$1"}
  log_event "offline marker cleared (stage gone)"
}

# The restart happened, the package set did not move, and the transaction is still there but is
# not `ready`: the boot symlink stood over a transaction nothing could apply, so the restart
# detoured into the offline updater, installed nothing and came back - and no later restart can
# install it either, because only `dnf5 offline reboot` arms one.
# The one branch that must NOT CLEAR: the marker is what lets `kempt doctor` say "staged update
# can never install"; without it that row degrades to "staged outside Kempt".
# The announce-once key is the marker itself - `armed: false` IS the record that this was said,
# and a box checking every ten minutes would otherwise repeat it 144 times a day.
reconcile_detour_stage() {  # marker-json toml-status
  # `.armed == false` and never `.armed // true`: jq's alternative operator treats FALSE as empty,
  # so `//` would read the demoted marker as armed and announce it again on every check. Absent
  # means announce - a marker written before this field existed describes a stage that was armed.
  if jq -e '.armed == false' <<<"$1" >/dev/null 2>&1; then return 0; fi
  # ...and never write the OLD marker back over a stage made while this check was running: the
  # write below is a read-modify-write of a file `kempt update` owns under a different lock.
  offline_marker_still "$1" || {
    log_event "offline marker kept (a new stage arrived while the check ran)"; return 0; }
  notify "Kempt" "Your staged update can no longer install on a restart. Re-stage it, or run sudo dnf5 offline clean."
  log_event "offline stage cannot install (status $2) - announced"
  # Additive, like every field of this file: everything already there is kept, so the pre-snapshot
  # pointer, the names and the boot id survive for the doctor rows that read them.
  jq -c '. + {armed: false}' <<<"$1" | write_offline_marker \
    || echo "warning: could not record that the staged update was announced. The next check may repeat it" >&2
}

# Before the restart: the transaction dnf5 holds is no longer the stage this marker records.
# Something replaced it - `sudo dnf5 offline clean` and a stage of its own, or a second admin staging
# over it - and the next restart installs THAT. Said once, and recorded on the marker as `replaced`,
# which is both the announce-once key and what tells the harvest after the restart that whatever ran
# was not Kempt's stage. Never cleared here: the marker is still what doctor and the popup read.
# Skipped while a Kempt stage is in flight (stage_lock): a rebuild replaces dnf5's transaction well
# before it rewrites this marker, and in between the two disagree for the most ordinary reason.
# Reads and writes harvest_offline's `marker`, so every branch after it carries the flag forward.
reconcile_replaced_stage() {
  if jq -e '.replaced == true' <<<"$marker" >/dev/null 2>&1; then return 0; fi
  stage_lock_try || return 0
  local why updated
  if why="$(offline_stage_replaced "$marker")" && offline_marker_still "$marker"; then
    notify "Kempt" "Your staged update was replaced outside Kempt. The next restart installs a different transaction. Rebuild it with Install on Next Restart, or see: kempt doctor"
    log_event "offline stage replaced outside Kempt (${why//$'\n'/, }) - announced"
    updated="$(jq -c '. + {replaced: true}' <<<"$marker" 2>/dev/null)" || updated=""
    if [[ -n "$updated" ]] && printf '%s\n' "$updated" | write_offline_marker; then
      marker="$updated"
    else
      echo "warning: could not record that the staged update was replaced. The next check may repeat it" >&2
    fi
  fi
  stage_unlock
  return 0
}

harvest_offline() {
  local pre now_snap ts report hist boot toml_status marker
  # ONE defensive read, and nothing below runs without it. Every branch here either clears the
  # marker or turns it into a history entry, both far too destructive to do on a file we could not
  # parse (see offline_marker_read): falling through disowns an armed stage that will still
  # install, with every surface silent about it.
  marker="$(offline_marker_read)"
  [[ -n "$marker" ]] || return 0
  # Legacy markers (staged before this gate existed) and an unreadable boot_id fall back to the
  # snapshot comparison below - never to "never harvest".
  boot="$(jq -r '.boot_id // empty' <<<"$marker")"
  pre="$(jq -r '.pre_snapshot // empty' <<<"$marker")"
  # dnf5's own view, because the marker cannot tell "waiting for a restart" from "the transaction
  # is gone" - and a manual `dnf5 offline clean` would otherwise leave one every check waits on.
  toml_status="$(offline_system_status)"
  # First, whatever the boot: is the transaction dnf5 still holds the one this marker records?
  if [[ "$toml_status" != absent ]]; then reconcile_replaced_stage; fi
  if [[ -n "$boot" && "$boot" != unknown && "$boot" == "$(current_boot_id)" ]]; then
    # Same boot: nothing can have APPLIED the stage, whatever the package set says - but it can
    # still have been thrown away, the one thing worth acting on here.
    [[ "$toml_status" == absent ]] && clear_gone_stage "$pre" "$marker"
    return 0
  fi
  # A marker whose snapshot is gone can never be harvested: clear it rather than re-read a dead
  # pointer on every check forever.
  [[ -n "$pre" && -f "$pre" ]] || {
    rm -f "$OFFLINE_MARKER"
    log_event "harvest cleared stale marker"
    return 0; }
  now_snap="$(mktemp)"
  # never take the check down with it - a failed harvest must still leave a working check
  dnf_snapshot > "$now_snap" \
    || { rm -f "$now_snap"; echo "warning: the restart's result was not recorded (snapshot failed)" >&2
         log_event "harvest skipped snapshot failed"; return 0; }
  # The package set did not move across a reboot. With the transaction still there that is the
  # honest "not applied yet" (the offline-update screen can be declined); with it GONE there is
  # nothing left to wait for.
  if same_content "$pre" "$now_snap"; then
    rm -f "$now_snap"
    if [[ "$toml_status" == absent ]]; then
      clear_gone_stage "$pre" "$marker"
    elif [[ "$toml_status" != ready ]]; then
      # Present but not armed, across a boot that changed: the detour above. Anything but `ready`
      # counts, including a status this build has never heard of - the only one a restart can
      # install is the one that made the symlink.
      reconcile_detour_stage "$marker" "$toml_status"
    elif [[ -n "$boot" && "$boot" != unknown && ! -L "$KEMPT_OFFLINE_LINK" ]]; then
      # `ready` and yet no /system-update: arming is TWO things, the status and the symlink, and
      # systemd removes the symlink once system-update.target is reached
      # (systemd.offline-updates(7)) - so a boot that came and went leaving `ready` did not run
      # the transaction, and no later one will either.
      reconcile_detour_stage "$marker" "ready, but the restart marker is gone"
    fi
    return 0
  fi

  # The package set MOVED across a reboot, which is evidence of an apply ONLY when dnf5's
  # transaction is gone with it: applying one removes all three of the toml, the /system-update
  # symlink and transaction.json. While any of that is still there, something ELSE moved the set,
  # and harvesting would name the other tool's packages and drop a still-armed marker.
  if [[ "$toml_status" != absent ]]; then
    rm -f "$now_snap"
    if [[ "$toml_status" != ready ]] \
       || [[ -n "$boot" && "$boot" != unknown && ! -L "$KEMPT_OFFLINE_LINK" ]]; then
      reconcile_detour_stage "$marker" "$toml_status"
    elif ! jq -e '.set_moved == true' <<<"$marker" >/dev/null 2>&1; then
      # Once, not once per check: this lasts until the restart that installs it. The baseline is
      # now stale - a later harvest diffs against a set the other tool already moved - which is why
      # that harvest keeps only what dnf5's history says the stage touched, when the history can say.
      offline_marker_still "$marker" || return 0   # a newer stage owns the file now
      log_event "harvest deferred: packages moved outside Kempt while the stage is still armed"
      jq -c '. + {set_moved: true}' <<<"$marker" | write_offline_marker \
        || echo "warning: could not record that the package set moved under a staged update" >&2
    fi
    return 0
  fi
  ts="$(date +%Y%m%dT%H%M%S)"
  report="$(tsv_diff_updates "$pre" "$now_snap")" \
    || { report='{"updated":[],"added":[],"removed":[]}'; echo "warning: the restart's result could not be compared, so the summary is incomplete" >&2; }
  # WHICH transaction ran, when dnf5's history can say (offline_history_attribution). Three outcomes,
  # and the third is the harvest as it was before identity existed:
  #   applied      the report keeps only what that history entry touched, so a package another tool
  #                moved across the same restart is not reported as part of the stage
  #   did-not-run  the report stays the whole snapshot diff, and the entry says it is not the stage
  #   cannot tell  the whole snapshot diff under the usual surface
  local attribution="" verdict="" txid="" hsurface="offline (applied on reboot)"
  if attribution="$(offline_history_attribution "$marker")"; then
    verdict="${attribution%%$'\n'*}"
  fi
  case "$verdict" in
    "applied "*)
      txid="${verdict#applied }"
      local keep_f filtered keep=""
      if [[ "$attribution" == *$'\n'* ]]; then keep="${attribution#*$'\n'}"; fi
      # `. as $x` before index(), for the trap mark_held carries the note about. A filter that fails
      # keeps the whole diff: the identification still stands, only the precision is lost. So does
      # a filter with nothing in it - an entry naming no packages is dnf5 not saying what it
      # touched, never a restart that touched nothing. Same trade as the live twin in cmd_update.
      if [[ -n "$keep" ]]; then
        keep_f="$(mktemp)"
        if printf '%s\n' "$keep" > "$keep_f" \
           && filtered="$(jq -c --rawfile k "$keep_f" '
                         ($k | split("\n") | map(select(length > 0))) as $keep
                         | with_entries(.value |= map(select(.name as $x | $keep | index($x) != null)))' \
                         <<<"$report" 2>/dev/null)" && [[ -n "$filtered" ]]; then
          report="$filtered"
        fi
        rm -f "$keep_f"
      fi ;;
    did-not-run)
      hsurface="restart (staged update did not run)" ;;
  esac
  # History filenames are per-second and this harvest runs inside a check a live run may have
  # triggered in the same second. Never overwrite an existing entry - it destroys that run's own.
  hist="$HIST_DIR/$ts.json"
  [[ -e "$hist" ]] && hist="$HIST_DIR/$ts-offline.json"
  # Through a file, like the other two, and this site is the worst of the three: harvest_offline
  # runs at the top of EVERY check and the marker is deleted ten lines below, so a failure here
  # leaves the marker in place and repeats on every check for good - the box never checks again.
  local rep_f; rep_f="$(mktemp)"
  printf '%s' "$report" > "$rep_f"
  # Guarded for the reason written above: this runs at the top of EVERY check and the marker is
  # deleted a few lines below, so a failure that escapes leaves the marker in place and lands here
  # again on the next check, and the next, for good. The box stops checking at all - no state file,
  # no widget, and a bash line-number error where the answer used to be. The entry is worth losing;
  # the check is not, and the marker is cleared either way so this cannot repeat.
  # `transaction_id` is additive and present only when the history named the entry: it is the id
  # `dnf5 history info` takes, so the person can see dnf5's own record of the same transaction.
  # A LOG FOR THE ONE RUN NOBODY WATCHED. Every other surface's log is captured command output,
  # tee'd as dnf speaks. This transaction was installed by dnf5 during the restart with Kempt not
  # running, so there is no output to capture, and the entry used to carry log:"" - which left the
  # popup hiding its Show Log action on the very run a person is most curious about, having just
  # watched their machine install a hundred packages while it booted.
  #
  # So Kempt writes its OWN record, and the file says that is what it is: the package list is the
  # snapshot diff, not dnf's words, and dnf5's record of the same transaction is named by the
  # command that prints it. A file that LOOKED like captured output and was not would be worse
  # than the missing button.
  local hlog="$LOG_DIR/$ts.log"
  # Same guard, same reason as $hist above: this harvest runs inside a check a live run may have
  # triggered in the same second, and that run's log must not be overwritten.
  [[ -e "$hlog" ]] && hlog="$LOG_DIR/$ts-offline.log"
  # How long the restart's transaction took, from dnf5's record of it. Unknown without that record,
  # and then left out: 0 would say a restart that installed packages took no time.
  local hdur=""
  if [[ -n "$txid" ]]; then hdur="$(dnf_history_duration "$txid")" || hdur=""; fi
  jq -n --arg ts "$(now_iso)" --slurpfile repa "$rep_f" --arg surface "$hsurface" --arg txid "$txid" \
        --arg log "$hlog" --arg dur "$hdur" '
    ($repa[0]) as $dnf |
    {timestamp:$ts, surface:$surface, status:"ok",
     reboot_needed:false, log:$log,
     backends:{dnf:($dnf + {status:"ok", skipped_held:[]}),
               flatpak:{updated:[],added:[],removed:[],status:"skipped",skipped_held:[]}}}
    + (if $txid == "" then {} else {transaction_id: ($txid | tonumber)} end)
    + (if $dur == "" then {} else {duration_sec: ($dur | tonumber)} end)' > "$hist" \
    || { rm -f "$hist"; hist=""
         echo "warning: the staged update was applied, but its history entry could not be written" >&2
         log_event "harvest entry not written (state directory unwritable?)"; }
  # Written AFTER the entry because render_summary reads it, and reconciled immediately: an entry
  # naming a file that is not there is a Show Log button that opens nothing, which is worse than no
  # button. If the log cannot be written the entry goes back to log:"" and the popup hides the
  # action again. Never fatal, for the reason written above this block - the marker is cleared
  # either way, and a check that dies here never runs again.
  if [[ -n "$hist" ]]; then
    if { printf '%s\n' \
           "Kempt staged this update and dnf5 installed it during the restart." \
           "Kempt was not running at the time, so this file is Kempt's own record rather than" \
           "captured output: the packages below are the difference between the snapshot taken when" \
           "the transaction was staged and the packages present after the restart." \
           "" \
         && { [[ -z "$txid" ]] \
              || printf "dnf5's own record of the same transaction:  dnf5 history info %s\n\n" "$txid"; } \
         && render_summary "$hist"; } > "$hlog" 2>/dev/null; then
      :
    else
      rm -f "$hlog"
      if jq '.log = ""' "$hist" > "$hist.nolog" 2>/dev/null; then mv -f "$hist.nolog" "$hist"
      else rm -f "$hist.nolog"; fi
      log_event "harvest log not written (state directory unwritable?)"
    fi
  fi
  rm -f "$rep_f"
  rm -f "$now_snap"
  # The history entry above is honest whatever happened next, but the MARKER may no longer be the
  # one this harvest read: a stage made while the snapshot and diff ran owns the file now, and
  # deleting it makes the panel forget an armed transaction.
  if offline_marker_still "$marker"; then
    rm -f "$OFFLINE_MARKER"
  else
    log_event "offline marker kept (a new stage arrived while the check ran)"
  fi
  rm -f "$pre"   # $pre is this harvest's own marker-owned copy either way
  # Same counts phrase as a live run's notification: a transaction that only installed or removed
  # packages must not be announced as "0 packages".
  local harvested=""
  [[ -n "$hist" ]] && harvested="$(run_counts_phrase "$hist")"
  # The only place the reboot's own result is recorded: the run that staged it ended a boot ago. So
  # it is said even when the entry above could not be written - a restart that installed sixty
  # packages must not pass in silence just because there was nowhere to file the details.
  if [[ "$verdict" == did-not-run ]]; then
    # Nothing here says what DID happen to the stage, because the history does not say it either:
    # removed, or replaced by a transaction that then ran. What it does say is that this was not it.
    log_event "harvest found the staged transaction did not run${harvested:+ ($harvested)}"
    notify "Kempt" "The update Kempt staged did not run on the restart. Changes seen across the restart came from somewhere else${harvested:+: $harvested}"
  elif [[ -n "$harvested" ]]; then
    log_event "harvest applied ($harvested)"
    notify "Kempt" "Staged updates were applied on reboot: $harvested"
  else
    log_event "harvest applied (the result could not be recorded)"
    notify "Kempt" "Staged updates were applied on reboot"
  fi
}

cmd_config() {
  case "${1:-}" in
    get) [[ -n "${2:-}" && $# -le 3 ]] || { echo "usage: kempt config get <key> [default]" >&2; exit 2; }
         config_get "$2" "${3-}" ;;
    set) [[ -n "${2:-}" && -n "${3+x}" && $# -le 3 ]] || { echo "usage: kempt config set <key> <value>" >&2; exit 2; }
         # Warns and stores. See config_warn_unknown: refusing would make this CLI the thing that
         # stops a newer widget writing a key it knows and this build does not.
         config_warn_unknown "$2" "$3"
         config_set "$2" "$3"
         # Choosing how updates run, here or in Settings, answers the popup's one offer.
         [[ "$2" != surface ]] || rm -f "$SURFACE_OFFER_FILE" ;;
    *) echo "usage: kempt config get <key> [default] | set <key> <value>" >&2; exit 2 ;;
  esac
}

# a missing colon must not silently hold a package named after the backend ("kempt hold dnf")
cmd_hold() {
  [[ "${1:-}" == *:* ]] || { echo "use dnf:<pkg> or flatpak:<app.id>" >&2; exit 2; }
  local b="${1%%:*}" n="${1#*:}"
  [[ "$b" == dnf || "$b" == flatpak ]] || { echo "use dnf:<pkg> or flatpak:<app.id>" >&2; exit 2; }
  # Runtimes cannot be held, and the refusal is here rather than in the backend because it is a
  # decision about the COMMAND, not about a pending list: the answer is the same whether or not an
  # update happens to be waiting. A runtime is shared infrastructure - hold org.kde.Platform and the
  # next KDE app that needs it is the thing that breaks, somewhere else entirely, with nothing on
  # screen connecting the two. Apps are what a person means by "skip this one", and they still work.
  # Exit 2 and nothing written, the same contract an invalid name gets.
  if [[ "$b" == flatpak ]] && flatpak_id_is_runtime "$n"; then
    echo "$n is a Flatpak runtime, and runtimes cannot be held: apps share them, so holding one breaks the next app that needs it. Hold the app instead." >&2
    exit 2
  fi
  # Separate statements, not `hold_add ... && log_event ...`: an AND list swallows hold_add's exit
  # status and reports a rejected name as exit 1 instead of the 2 the contract promises. This way
  # errexit ends the command with the helper's own rc and no event is written.
  hold_add "$b" "$n"
  # AFTER the write, and it changes nothing about it. dnf5 cannot edit a transaction it has already
  # stored, so a hold added over an armed stage applies from the NEXT transaction Kempt builds -
  # correct, and invisible unless said: hold the kernel, restart, and the kernel installs. So this
  # warns on stderr and does nothing else: never prompts, never blocks, never changes the exit
  # status (a hold is bookkeeping, I1), and is identical interactive or not, because the case that
  # needs it most is a pin clicked in the panel. dnf only - the offline surface stages dnf alone,
  # so a flatpak hold can never conflict with an armed transaction.
  local note=""
  if [[ "$b" == dnf ]]; then
    # The SAME predicate state.json publishes for the widget, from the one reader that reconciles
    # the marker, dnf5's status and its stored transaction. AFTER hold_add on purpose: the
    # intersection is against the holds as they now stand.
    local staged; staged="$(offline_staged_state)"
    if [[ -n "$staged" ]]; then
      if jq -e --arg n "$n" '.holds_conflict | index($n)' <<<"$staged" >/dev/null 2>&1; then
        hold_staged_warning <<<"$n" >&2
        printf '%s\n' "$KEMPT_STAGED_RECIPE" >&2
        note=" (staged update still contains it)"
      elif [[ "$(jq -r '.names_source' <<<"$staged" 2>/dev/null || echo none)" == none ]]; then
        # No list may be trusted here (a legacy marker, or names that came from a check), so the
        # generic warning is what is left: wrong only by warning about a package that is not in
        # the transaction, never by staying quiet about one that is.
        hold_generic_warning "$n" >&2
        # The recipe follows the generic warning too - both remedies belong on every surface.
        printf '%s\n' "$KEMPT_STAGED_RECIPE" >&2
      fi
    fi
  fi
  # The suffix is only ever appended to a CONFIRMED conflict: the generic warning is a caveat, not
  # a finding, and the event log must not record it as one.
  log_event "hold $b:$n$note"
}
cmd_unhold() {
  [[ "${1:-}" == *:* ]] || { echo "use dnf:<pkg> or flatpak:<app.id>" >&2; exit 2; }
  local b="${1%%:*}" n="${1#*:}"
  [[ "$b" == dnf || "$b" == flatpak ]] || { echo "use dnf:<pkg> or flatpak:<app.id>" >&2; exit 2; }
  hold_remove "$b" "$n"
  # The mirror: releasing a hold does not put the package back into a transaction that was built
  # without it. Same rules as cmd_hold - after the write, stderr only, dnf only, status untouched.
  local note=""
  if [[ "$b" == dnf ]] && offline_stage_built_without "$n"; then
    unhold_staged_warning "$n" >&2
    note=" (staged update was built without it)"
  fi
  log_event "unhold $b:$n$note"
}
# Refuses a stray argument like every other command: `kempt holds --json` silently printing the
# plain list is how a script gets written against an option that does not exist.
cmd_holds() {
  local exclude_args=false
  case "${1:-}" in
    "") ;;
    # The holds as dnf5 arguments, so somebody running a transaction OUTSIDE Kempt can honour the
    # same list without retyping it - which is the gap the line below in usage.md describes: a
    # manual `sudo dnf5 upgrade` ignores this file entirely.
    --exclude-args) exclude_args=true; shift ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  [[ $# -eq 0 ]] || { echo "unknown option: $1" >&2; exit 2; }
  if [[ "$exclude_args" == true ]]; then
    # dnf ONLY, and not as a convenience: `--exclude=` is a dnf5 argument, so a flatpak app id in
    # this list would reach dnf5 as the name of a package that does not exist.
    # ONE line, because the whole point is pasting it after a command. Empty when nothing is held,
    # which keeps `$(kempt holds --exclude-args)` safe to wrap around: it expands to no arguments
    # rather than to an error.
    local h out=""
    while IFS= read -r h; do
      [[ -n "$h" ]] || continue
      out+="${out:+ }--exclude=$h"
    done < <(holds_for dnf)
    printf '%s\n' "$out"
    return 0
  fi
  holds_all
}

# `kempt unstage` - discard the staged offline transaction, so the next restart installs nothing.
# The mirror of `kempt update --surface=offline`, through the same root helper verb the failure
# unwinds already use. That verb refuses over a stored Fedora release upgrade, and so does this:
# dnf5 keeps ONE stored transaction, so an ordinary stage and a release upgrade share one slot, and
# discarding the wrong one throws away gigabytes somebody spent hours downloading. Refused HERE and
# again as root, because the CLI runs as the user and anything reaching the helper directly never
# passes through here.
cmd_unstage() {
  [[ $# -eq 0 ]] || { echo "unknown option: $1" >&2; exit 2; }
  kempt_init_dirs
  # exit 5, the status cmd_update's refusals already use: nothing was read, nothing was changed, so
  # this is a refusal rather than a failed run. And never "run: sudo dnf5 offline clean" on any path
  # in this function - that is the command the refusal exists to protect against.
  local relup
  if relup="$(offline_release_upgrade)"; then
    echo "Nothing was discarded. A Fedora release upgrade ($relup) is stored, and dnf5 keeps one stored transaction, so discarding it would cancel the upgrade. See: kempt doctor" >&2
    log_event "unstage refused (a Fedora release upgrade ($relup) is stored)"
    exit 5
  fi
  # The update lock, for the race it exists for: a stage in flight is building the very transaction
  # this would remove. Same refusal and same status as a second `kempt update`.
  acquire_lock || { echo "another kempt update is running" >&2; exit 3; }
  trap release_lock EXIT

  local marker pre status
  marker="$(offline_marker_read)"
  status="$(offline_system_status)"
  # Nothing stored. Either a marker is left over and this tidies it, or there is nothing at all;
  # neither is a failure and neither needs root, so neither raises an authentication dialog.
  if [[ "$status" == absent ]]; then
    if [[ -n "$marker" ]]; then
      pre="$(jq -r '.pre_snapshot // empty' <<<"$marker" 2>/dev/null || true)"
      clear_gone_stage "$pre" "$marker"
      echo "The staged update was already gone. Kempt's record of it has been cleared."
      log_event "unstage cleared a marker with no transaction under it"
    else
      echo "Nothing is staged, so there is nothing to discard."
      log_event "unstage found nothing staged"
    fi
    cmd_check >/dev/null 2>&1 || true
    return 0
  fi

  # NOT through apply_with_retry: that tees into a run log this command does not have, and this is
  # one short verb rather than a transaction. A package lock held by something else fails plainly.
  local rc=0
  priv_apply dnf-offline-clean || rc=$?
  if [[ $rc -eq $KEMPT_APPLY_REFUSED ]]; then
    echo "Nothing was discarded, because $(apply_refusal_reason). See: kempt doctor" >&2
    log_event "unstage refused by the root helper"
    exit 5
  fi
  if [[ $rc -ne 0 ]]; then
    echo "The staged update could not be discarded. See: kempt doctor" >&2
    log_event "unstage failed rc=$rc"
    exit 1
  fi
  # The marker goes ONLY when dnf5's transaction is really gone, and it is asked again rather than
  # assumed from rc 0: a helper can exit 0 having changed less than it meant to, and a marker
  # cleared over a transaction that is still armed leaves an install coming that no surface
  # mentions - the same failure the harvest's own clearing rule avoids from the other side.
  status="$(offline_system_status)"
  if [[ "$status" != absent ]]; then
    echo "The staged update was not fully discarded: dnf5 still reports a stored transaction (status \"$status\"). Kempt's record of it has been kept. See: kempt doctor" >&2
    log_event "unstage left a transaction behind (status $status)"
    cmd_check >/dev/null 2>&1 || true
    exit 1
  fi
  if [[ -n "$marker" ]]; then
    pre="$(jq -r '.pre_snapshot // empty' <<<"$marker" 2>/dev/null || true)"
    clear_gone_stage "$pre" "$marker"
  fi
  echo "Discarded the staged update. The next restart installs nothing."
  log_event "unstage discarded the staged update"
  # state.json is the widget's only channel, so a discarded stage stops being advertised in the
  # panel exactly when this rewrites it.
  cmd_check >/dev/null 2>&1 || true
}

# What a removal came to, in words: success on stdout, anything else on stderr. Returns the exit
# code `kempt reclaim` gives it. Reads only the RECLAIM_* globals reclaim_remove set, so the
# automatic step after an update says the same sentences (reclaim_after_run). With "update", the
# refusals are worded for a run where nothing was listed to the person first.
reclaim_outcome_lines() {  # [update]
  local rc=0 ctx="${1:-}"
  case "$RECLAIM_RESULT" in
    removed)
      if [[ -n "$RECLAIM_BYTES" && "$RECLAIM_BYTES" != 0 ]]; then
        echo "Freed about $(human_bytes "$RECLAIM_BYTES")."
      else
        local n; n="$(jq -r 'length' <<<"$RECLAIM_GONE")"
        if [[ "$n" == 1 ]]; then echo "Removed 1 runtime."; else echo "Removed $n runtimes."; fi
      fi
      # flatpak stopped part-way: what went is said above, and it was not everything agreed to. Or
      # the extensions were never tried, because the list between the passes failed (skipped).
      if [[ -n "$RECLAIM_PARTIAL" ]]; then
        if [[ -n "${RECLAIM_SKIPPED:-}" ]]; then
          echo "Some extensions were left in place because Flatpak did not answer when asked what is unused. Run kempt reclaim again." >&2
        elif [[ -n "$RECLAIM_ERROR" ]]; then
          echo "Flatpak could not remove all of them: $RECLAIM_ERROR" >&2
        else
          echo "Flatpak could not remove all of them (exit code ${RECLAIM_RC:-unknown}). See: kempt log" >&2
        fi
        rc=1
      fi
      # The race the second pass leaves (reclaim_remove): flatpak removed an extension an app had
      # just started using. `flatpak update` installs it again; the next Kempt update may not (an
      # app held back, or a theme installed by hand).
      if [[ -n "${RECLAIM_IN_USE:-}" ]]; then
        local k; k="$(jq -r 'length' <<<"$RECLAIM_IN_USE" 2>/dev/null)" || k="?"
        if [[ "$k" == 1 ]]; then
          echo "Flatpak also removed an extension that an app installed during the removal uses. Run flatpak update to put it back." >&2
        else
          echo "Flatpak also removed $k extensions that apps installed during the removal use. Run flatpak update to put them back." >&2
        fi
      fi ;;
    nothing) echo "Nothing was removed. Flatpak found nothing unused to remove." ;;
    changed)
      if [[ "$ctx" == update ]]; then
        if [[ "$RECLAIM_WHY" == unstable ]]; then
          echo "Nothing was removed. Some runtimes became unused less than an hour ago." >&2
        else
          echo "Nothing was removed. The unused runtimes changed since the last check." >&2
        fi
      elif [[ "$RECLAIM_WHY" == unstable ]]; then
        echo "Nothing was removed. Some of these became unused less than an hour ago, and Kempt waits an hour in case something is still being installed." >&2
      else
        echo "What Flatpak can remove changed since this was shown. Nothing was removed." >&2
      fi
      rc=6 ;;
    needs_auth)
      if [[ "$ctx" == update ]]; then
        echo "Removing the unused runtimes needs an administrator. Nothing was removed." >&2
      else
        echo "Removing these needs an administrator. Nothing was removed." >&2
      fi
      rc=5 ;;
    # The event log holds the same line with flatpak's exit code, for after this has scrolled away.
    # With RECLAIM_PARTIAL set here, flatpak failed and the list afterwards could not be read, so
    # some runtimes may be gone: never "nothing was removed".
    *) if [[ -n "$RECLAIM_PARTIAL" ]]; then
         echo "Flatpak stopped with an error${RECLAIM_ERROR:+: $RECLAIM_ERROR}" >&2
         echo "Kempt could not check what was removed, so the removal may be partial. Check again with: kempt reclaim --list" >&2
       elif [[ -n "$RECLAIM_ERROR" ]]; then
         echo "Flatpak could not remove them: $RECLAIM_ERROR" >&2
       else
         echo "Flatpak could not remove them (exit code ${RECLAIM_RC:-unknown}). See: kempt log" >&2
       fi
       rc=1 ;;
  esac
  return $rc
}

# Whether state.json holds a list of unused refs from a check that could read one, so each ref's
# since is on record.
reclaim_on_record() {
  jq -e -n '[inputs][0].reclaim | type == "object" and (.refs | type) == "array" and .status != "failed"' \
    "$STATE_FILE" >/dev/null 2>&1
}

# `kempt reclaim` - remove the Flatpak runtimes no installed app uses. Run as the desktop user,
# never as root (reclaim_as_root says why). Exit 6 is this command's own: the set Flatpak would
# remove is not the one that was shown (or part of it is too new to trust), so nothing was removed
# and the person should look again. It writes no history entry: `kempt summary` and the widget's
# last-run line read the newest history file, and a removal is not an update run.
cmd_reclaim() {
  local list="" yes="" expect=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --list) list=1; shift ;;
      -y|--yes) yes=1; shift ;;
      --expect=*) expect="${1#--expect=}"; shift
                  [[ "$expect" =~ ^[0-9a-f]{16}$ ]] || { echo "--expect takes the 16-character digest from kempt check" >&2; exit 2; } ;;
      *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
  done
  kempt_init_dirs
  if reclaim_as_root; then
    echo "Nothing was removed. Run kempt reclaim as yourself, not as root: as root, Flatpak does not see your own apps and could remove a runtime one of them needs." >&2
    log_event "reclaim refused (running as root)"
    exit 5
  fi
  if ! is_true "$(config_get include_flatpak)"; then
    echo "Nothing was removed. Flatpak is not part of Kempt's updates here (include_flatpak is false)." >&2
    exit 5
  fi
  if ! flatpak_present; then
    echo "Nothing was removed. Flatpak is not installed." >&2
    exit 5
  fi
  # With no check on record, nothing says when any ref became unused, so every ref is first seen
  # now and the removal is refused. Run a check first so the hour starts now. The update lock comes
  # before check.lock, as in cmd_update, and both are let go before anything below takes one.
  # With an update running, its own closing check does this instead.
  local first=""
  if [[ "$(reclaim_mode)" != off ]] && ! reclaim_on_record; then
    first=1
    if acquire_lock; then
      cmd_check >/dev/null 2>&1 || true
      { flock -u 9; exec 9>&-; } 2>/dev/null || true
      release_lock
    fi
  fi
  # reclaim=off refuses any removal before anything is listed; --list still shows what could go.
  if [[ -z "$list" && "$(reclaim_mode)" == off ]]; then
    echo "Nothing was removed. Removing unused runtimes is turned off (reclaim is off)." >&2
    log_event "reclaim refused (reclaim=off)"
    exit 5
  fi
  local listing classified sizes_tsv bytes="" digest
  if ! listing="$(flatpak_unused_list 2>/dev/null)" \
     || ! classified="$(reclaim_classify "$listing" 2>/dev/null)"; then
    echo "Flatpak did not answer when asked what is unused. Nothing was removed." >&2
    log_event "reclaim failed (flatpak did not answer)"
    exit 1
  fi
  if [[ "$(jq -r 'length' <<<"$classified")" == 0 ]]; then
    # An offer was acted on (the widget's button, a script with the digest), and every runtime on
    # it is in use again: the set changed, as below. The check rewrites state.json, so the widget
    # stops offering what is gone instead of offering it until the next scheduled check. That check
    # needs the update lock: with an update holding it, this is busy (exit 3), like any removal
    # then, and that update's own closing check clears the offer. Not for --list, which only lists.
    if [[ -n "$expect" && -z "$list" ]]; then
      acquire_lock || { echo "another kempt update is running" >&2; exit 3; }
      echo "What Flatpak can remove changed since this was shown. Nothing was removed." >&2
      local via_e=cli
      [[ "${KEMPT_VIA:-}" == widget ]] && via_e=widget
      reclaim_last_write "$via_e" changed '[]' "" "$expect"
      log_event "reclaim changed (digest), nothing removed"
      cmd_check >/dev/null 2>&1 || true
      { flock -u 9; exec 9>&-; } 2>/dev/null || true
      release_lock
      exit 6
    fi
    echo "Nothing to remove. Every installed Flatpak runtime is in use."
    return 0
  fi
  echo "No installed app uses these Flatpak runtimes:"
  jq -r --arg young "$([[ -n "$first" ]] && echo "first seen just now" || echo "unused for less than an hour")" '
    .[] | "  \(.ref)" + (if .eol != null then " (no longer supported)" else "" end)
                     + (if .offerable then "" else " (\($young))" end)' <<<"$classified"
  if sizes_tsv="$(flatpak_unused_sizes "$listing" 2>/dev/null)"; then
    bytes="$(jq -R -n -r '[inputs | split("\t") | select(length == 2) | (.[1] | tonumber)] | add // 0' \
             <<<"$sizes_tsv" 2>/dev/null)" || bytes=""
  fi
  [[ -n "$bytes" && "$bytes" != 0 ]] && echo "Removing them frees about $(human_bytes "$bytes")."
  if [[ -n "$list" ]]; then
    [[ -n "$first" ]] && echo "These were first seen just now. They can be removed in an hour."
    return 0
  fi

  # Said before any question: agreeing to a set that is not yet removable would only end in a refusal.
  if ! jq -e 'all(.offerable)' <<<"$classified" >/dev/null 2>&1; then
    if [[ -n "$first" ]]; then
      echo "Nothing was removed. These were first seen just now, and Kempt waits an hour in case something is still being installed. Try again in an hour." >&2
    else
      echo "Nothing was removed. Some of these became unused less than an hour ago, and Kempt waits an hour in case something is still being installed." >&2
    fi
    log_event "reclaim changed (unstable), nothing removed"
    exit 6
  fi
  if [[ -z "$yes" ]]; then
    # No -y and nobody to ask: never a silent yes.
    if [[ ! -t 0 ]]; then
      echo "Nothing was removed. Run kempt reclaim -y to remove them without being asked." >&2
      exit 5
    fi
    local answer=""
    read -r -p "Remove them? [y/N] " answer || answer=""
    [[ "${answer,,}" == y || "${answer,,}" == yes ]] || { echo "Nothing was removed."; return 0; }
  fi
  # What is agreed to: the digest the widget showed, or the set just printed.
  if [[ -z "$expect" ]]; then
    digest="$(jq -r '.[] | "\(.ref)\t\(.commit)"' <<<"$classified" | reclaim_digest)"
    expect="$digest"
  fi
  # The update lock, without waiting, like a second `kempt update`: a run in progress may be
  # installing the very runtime this would call unused.
  acquire_lock || { echo "another kempt update is running" >&2; exit 3; }
  trap release_lock EXIT
  local via=cli
  [[ "${KEMPT_VIA:-}" == widget ]] && via=widget
  reclaim_remove "$via" "$expect"
  local rc=0
  reclaim_outcome_lines || rc=$?
  # state.json is the widget's only channel: the offer disappears when this rewrites it. Still
  # under the update lock, then check.lock, the order cmd_update takes them in.
  cmd_check >/dev/null 2>&1 || true
  return $rc
}

# `kempt log` - the event log, newest last. Deliberately the plainest command here: the file is
# already one fact per line in a fixed vocabulary, meant to be read with grep.
cmd_log() {
  local n=30
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n) [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] \
            || { echo "usage: kempt log [-n N]  (N >= 1)" >&2; exit 2; }
          n="$2"; shift 2 ;;
      *)  echo "unknown option: $1" >&2; echo "usage: kempt log [-n N]" >&2; exit 2 ;;
    esac
  done
  # No file yet is the ordinary state of a fresh install, not an error - same answer shape as
  # `kempt summary` on a box with no runs: a sentence on STDOUT and exit 0.
  [[ -s "$EVENTS_FILE" ]] || { echo "No events recorded yet."; return 0; }
  tail -n "$n" "$EVENTS_FILE"
}

# --- kempt doctor ---
# The trap this closes: with the root helpers missing, `kempt check` exits 0 with status "stale"
# and 0 pending, which reads to a human and to a badge as "you are up to date". Every other command
# degrades instead of crashing, deliberately, so doctor is the one that says the install is broken.
# Every check runs and every problem is printed: stopping at the first sends the user round the
# loop once per problem.
DOCTOR_FAILS=0
doctor_ok()   { printf 'ok    %s\n' "$1"; }
doctor_info() { printf 'info  %s\n' "$1"; }
doctor_fail() { printf 'FAIL  %s\n' "$1"; DOCTOR_FAILS=$(( DOCTOR_FAILS + 1 )); }

# The hold that arrived after the stage. INFO and not FAIL: a package installing despite a hold is
# a legitimate state (see cmd_hold), and a FAIL for something legitimate teaches readers to skip
# FAILs - the bluntness lives in the sentence instead. It carries BOTH remedies through the one
# copy of them, KEMPT_STAGED_RECIPE, since someone who held a kernel may want the stage gone
# rather than rebuilt.
# Read from offline_staged_state, never the marker: that is the one function applying the
# suppression rule, and doctor must not grow a second opinion about which list may answer.
doctor_staged_conflict_row() {
  local staged names total phrase
  staged="$(offline_staged_state)" || return 0
  [[ -n "$staged" ]] || return 0
  names="$(jq -r '.holds_conflict[]?' <<<"$staged" 2>/dev/null || true)"
  if [[ -n "$names" ]]; then
    total="$(printf '%s' "$names" | grep -c '' || true)"
    phrase="$(printf '%s' "$names" | names_phrase)"
    # The verb moves with the noun, as in the staged count line and the hold warning.
    if [[ "$total" == 1 ]]; then
      doctor_info "staged update: it installs $phrase on the next restart despite the hold. The hold was recorded after the transaction was staged, and dnf5 offers no way to edit a stored one. $KEMPT_STAGED_RECIPE"
    else
      doctor_info "staged update: it installs $phrase on the next restart despite the holds. The holds were recorded after the transaction was staged, and dnf5 offers no way to edit a stored one. $KEMPT_STAGED_RECIPE"
    fi
    return 0
  fi
  # Nothing may be DENIED here: names_source `none` means the list came from a check (blind to
  # what the resolver added) or from nowhere, so the generic line is the honest one.
  [[ "$(jq -r '.names_source' <<<"$staged" 2>/dev/null || echo none)" == none ]] || return 0
  [[ -n "$(holds_for dnf)" ]] || return 0
  doctor_info "staged update: it may still install held packages on the next restart. Kempt cannot read what this transaction contains, and a hold recorded after it was staged cannot change it. $KEMPT_STAGED_RECIPE"
}

# What Kempt staged against what dnf5 has stored right now - the LIVE record, never anything
# remembered. FAIL, because unlike the row above this is nothing anyone chose: within the
# authentication keep window anything running as this user can replace an armed transaction, and
# every Kempt surface then describes a set that is not there.
# Only a transaction-derived marker list may be compared: a check-derived one disagrees with the
# stored transaction routinely and legitimately, so it would FAIL weekly on a healthy box.
doctor_staged_drift_row() {  # marker json
  local msrc live plus minus
  msrc="$(jq -r '.staged_names_source // empty' <<<"$1" 2>/dev/null || true)"
  [[ "$msrc" == transaction ]] || return 0
  live="$(offline_txjson_names)" || return 0
  # Both lists are whole staged transactions, so both reach jq as FILES rather than as arguments:
  # a release upgrade stages every package on the box, and one argv entry stops at 128 KiB. In a
  # doctor row the cost of getting that wrong is the row's own - `kempt doctor` would die partway
  # through its report on the machine whose staged update most needs explaining.
  # One directory for both, so the single rm below cannot miss one however this returns.
  local d; d="$(mktemp -d)"
  # jq for the set arithmetic, not sort/comm: `unique` orders by codepoint and `sort` by locale,
  # and two lists ordered by different rules compare as different.
  { printf '%s' "$live" | jq -Rn '[inputs] | unique' > "$d/live.json" \
    && jq -c '[.staged_names[]? | select(type == "string")] | unique' <<<"$1" > "$d/rec.json" 2>/dev/null \
    && [[ "$(jq -n --slurpfile a "$d/live.json" --slurpfile b "$d/rec.json" '$a[0] == $b[0]')" != true ]]
  } || { rm -rf "$d"; return 0; }
  # `. as $x` before index(): jq evaluates index()'s argument against index()'s OWN input, so the
  # inline form reads the wrong thing (the trap mark_held carries a note about).
  # `|| true` on both, so the directory is removed however they end: a jq that dies here would
  # otherwise leave a temp directory behind on every check that reaches this row.
  plus="$(jq -r --slurpfile b "$d/rec.json" '.[] | select(. as $x | $b[0] | index($x) | not)' < "$d/live.json" || true)"
  minus="$(jq -r --slurpfile a "$d/live.json" '.[] | select(. as $x | $a[0] | index($x) | not)' < "$d/rec.json" || true)"
  rm -rf "$d"
  # Both empty means the comparison could not be made, not that the two lists agree - the equality
  # test above already returned for that case.
  [[ -n "$plus" || -n "$minus" ]] || return 0
  local -a clauses=()
  # Capped and counted by the shared renderer: a Qt bump puts dozens of names on each side.
  [[ -n "$plus" ]] && clauses+=("$(printf '%s\n' "$plus" | sed 's/^/+/' | names_phrase) in dnf5's record only")
  [[ -n "$minus" ]] && clauses+=("$(printf '%s\n' "$minus" | sed 's/^/-/' | names_phrase) in Kempt's only")
  local diff; diff="$(printf '%s, ' "${clauses[@]}")"
  doctor_fail "staged update is not the one Kempt built: dnf5's record differs from what Kempt staged (${diff%, }). The transaction was replaced after Kempt staged it, so the next restart installs a set Kempt does not show. Rebuild it with: kempt update --surface=offline, or remove it with: sudo dnf5 offline clean"
}

# The `exec.path` annotation the installed policy pins for one action id - the only half of that
# file worth comparing, since pkexec matches an action by that path and by nothing else.
# awk rather than xmllint: a checkup must not need a dependency the rest of the tool does not have.
# It reads only the one-line form this project ships, `<annotate key="...">path</annotate>`; a
# policy with the value on its own line reads as "no annotation" and lands on the info branch.
policy_exec_path() {  # action_id file -> the annotated path, or "" if there is none
  awk -v want="$1" '
    /<action[ \t]+id="/ {
      id = ""
      if (match($0, /id="[^"]*"/)) id = substr($0, RSTART + 4, RLENGTH - 5)
    }
    id == want && /org\.freedesktop\.policykit\.exec\.path/ {
      if (match($0, />[^<]*</)) { print substr($0, RSTART + 1, RLENGTH - 2); exit }
    }
  ' "$2" 2>/dev/null || true
}

# The half of the polkit action a readable file can still get wrong. The RPM installs the helpers
# under /usr/libexec and rewrites the annotation to match (kempt.spec); install.sh uses
# /usr/local/libexec. A box carrying both hands pkexec a path no action names, so it falls back to
# an authentication dialog a background check cannot answer: priv_refresh times out after 120s and
# the check reports stale, forever.
# Compared only when the helper seam IS the annotated path (as doctor_helper does for ownership):
# with a stub in play, what this CLI runs is not what polkit was asked about.
doctor_exec_path() {  # label action_id helper_seam annotated_path
  local label="$1" action="$2" seam="$3" annotated="$4" pinned
  if [[ "$seam" != "$annotated" ]]; then
    doctor_info "polkit exec.path ($label): not compared, because a KEMPT_ setting points the helper elsewhere ($seam)"
    return 0
  fi
  # Missing or unreadable is already a FAIL above; one problem must not be counted twice.
  if [[ ! -r "$KEMPT_POLICY_FILE" ]]; then
    doctor_info "polkit exec.path ($label): not compared, because $KEMPT_POLICY_FILE is not readable"
    return 0
  fi
  pinned="$(policy_exec_path "$action" "$KEMPT_POLICY_FILE")"
  if [[ -z "$pinned" ]]; then
    doctor_info "polkit exec.path ($label): $KEMPT_POLICY_FILE pins no exec.path for $action"
  elif [[ "$pinned" == "$annotated" ]]; then
    doctor_ok "polkit exec.path ($label): $pinned"
  else
    # Both paths and both remedies: which one is wrong depends on the install the reader meant.
    doctor_fail "polkit exec.path ($label): the policy pins $pinned, this CLI runs $annotated. pkexec has no action for that path, so every privileged run falls back to an authentication dialog and background checks time out. Fix it with ./install.sh in a checkout, or: sudo dnf reinstall kempt for the package"
  fi
}

# ...and the other half of a split install, on the widget's side. The panel runs the CLI through
# its own PATH order (see KEMPT_WIDGET_PATH), so the kempt the widget uses and the kempt that
# printed this report can be two different files. Nothing here is executed.
doctor_widget_engine() {
  local w
  # A subshell, so the widget's PATH order decides this one lookup and nothing else in the run.
  # shellcheck disable=SC2123  # assigning PATH IS the check: it is the widget's own lookup order
  w="$(PATH="$KEMPT_WIDGET_PATH"; command -v kempt 2>/dev/null || true)"
  if [[ -z "$w" ]]; then
    # info, not FAIL: main.qml turns rc 127 into engineMissing, a message in the panel already.
    doctor_info "widget engine: no kempt on the widget's PATH ($KEMPT_WIDGET_PATH), so the panel reports the engine as missing"
    return 0
  fi
  # Resolved, because ~/.local/bin/kempt is a symlink on every checkout install: the question is
  # which FILE runs, not which name came first.
  w="$(readlink -f "$w" 2>/dev/null || printf '%s' "$w")"
  if [[ "$w" == "$SELF" ]]; then
    doctor_ok "widget engine: $w"
  else
    doctor_fail "widget engine: the widget would run $w; this report describes $SELF. Remove the one you do not want, or point the ~/.local/bin/kempt symlink at the install you mean"
  fi
}

doctor_helper() {  # label seam_path annotated_path
  local label="$1" path="$2" annotated="$3" own dir down
  if [[ ! -e "$path" ]]; then
    doctor_fail "root helper ($label) not installed: $path. Run ./install.sh"
    return 0
  fi
  if [[ "$path" != "$annotated" ]]; then
    # Not the path polkit execs, so its ownership says nothing about what root would run.
    doctor_info "root helper ($label): $path (set by a KEMPT_ variable, ownership not checked)"
    return 0
  fi
  # stat can fail on an unreachable path, and a helper we cannot INSPECT is not a broken one.
  own="$(stat -c '%U:%G %a' "$path" 2>/dev/null)" || {
    doctor_info "root helper ($label): $path (present, ownership not readable)"; return 0; }
  if [[ "$own" == "root:root 755" ]]; then
    doctor_ok "root helper ($label): $path (root:root 0755)"
  else
    doctor_fail "root helper ($label) is $own, expected root:root 755: $path. Run ./install.sh again"
  fi
  # The directory, too: whoever can write to it can rename the helper away and put their own file
  # at the path polkit runs as root, however the helper itself is owned. Quiet when it is sound, so
  # every install does not grow a line; an unreadable directory is not reported as a broken one.
  dir="$(dirname "$path")"
  down="$(stat -L -c '%U:%G %a' "$dir" 2>/dev/null)" || return 0
  if [[ "${down%%:*}" != root ]] || (( 8#${down##* } & 8#022 )); then
    doctor_fail "root helper directory ($label) is $down, expected root-owned and not group- or world-writable: $dir. Fix it with: sudo chown root:root $dir && sudo chmod 755 $dir"
  fi
}

# --- install skew -------------------------------------------------------------------------------
# A checkout install is a SYMLINK for the CLI and a COPY for everything that cannot be one: the two
# root helpers (root execs a file it owns, never a link into a user's tree), the polkit action, and
# the widget kpackagetool6 copies into the user's plasmoid directory. So `git pull` moves the CLI
# and silently leaves those three behind, root still running the last ./install.sh's code.
# Compared by CONTENT, never mtime: the installer rewrites files it did not change, and a fresh
# clone is younger than a correct install. No privilege needed - the copies are world-readable.
doctor_install_files() {  # label src dst [src dst ...]
  local label="$1"; shift
  local src dst missing=0 differ=0 nosrc=0
  while [[ $# -gt 1 ]]; do
    src="$1"; dst="$2"; shift 2
    if [[ ! -r "$src" ]]; then nosrc=1
    elif [[ ! -e "$dst" ]]; then missing=1
    elif ! same_content "$src" "$dst"; then differ=1; fi
  done
  # One label covers several files (the helpers are two) because the fix is one command.
  if [[ $nosrc -eq 1 ]]; then
    doctor_info "$label: not compared, because the checkout has no copy to compare against"
  elif [[ $missing -eq 1 ]]; then
    # info, not FAIL: a missing installed copy is already a FAIL above, and one problem must not
    # be counted twice.
    doctor_info "$label: not installed. Run ./install.sh"
  elif [[ $differ -eq 1 ]]; then
    doctor_fail "$label: DIFFER from checkout. Run ./install.sh"
  else
    doctor_ok "$label: match checkout"
  fi
}

doctor_install_dir() {  # label src dst
  local label="$1" src="$2" dst="$3"
  if [[ ! -d "$src" ]]; then
    doctor_info "$label: not compared, because the checkout has no copy to compare against"
  elif [[ ! -d "$dst" ]]; then
    # The widget is optional: a box with no kpackagetool6 gets a working CLI and no plasmoid.
    doctor_info "$label: not installed (the CLI works without it)"
  elif ! command -v diff >/dev/null; then
    doctor_info "$label: not compared, because diff is not installed"
  elif diff -rq "$src" "$dst" >/dev/null 2>&1; then
    doctor_ok "$label: match checkout"
  else
    # `plasmashell --replace` as well as the installer: kpackagetool6 upgrades the package in
    # place and Plasma keeps the QML it already loaded, so a re-install alone changes nothing the
    # user can see.
    doctor_fail "$label: DIFFER from checkout. Run ./install.sh, then plasmashell --replace"
  fi
}

# --- the rows of `kempt doctor`, one function per group ------------------------------------------
# cmd_doctor below is the ORDER of the report and nothing else. Each function here owns one group
# of rows, keeps its own locals, and communicates only through DOCTOR_FAILS - which doctor_fail
# increments and the summary reads. Keep it that way: the rows share no other state.

doctor_privileged_rows() {
  doctor_helper refresh "$KEMPT_REFRESH_HELPER" "$KEMPT_REFRESH_HELPER_PATH"
  doctor_helper apply   "$KEMPT_APPLY_HELPER"   "$KEMPT_APPLY_HELPER_PATH"

  # Without the action file pkexec has no policy for these helpers and falls back to an
  # authentication DIALOG - see doctor_exec_path.
  if [[ -r "$KEMPT_POLICY_FILE" ]]; then
    doctor_ok "polkit action: $KEMPT_POLICY_FILE"
  else
    doctor_fail "polkit action not installed: $KEMPT_POLICY_FILE. Run ./install.sh"
  fi
  # ...and the half a readable file can still get wrong: which helper path it pins.
  doctor_exec_path refresh io.github.erez_c137.kempt.refresh \
    "$KEMPT_REFRESH_HELPER" "$KEMPT_REFRESH_HELPER_PATH"
  doctor_exec_path apply   io.github.erez_c137.kempt.apply \
    "$KEMPT_APPLY_HELPER"   "$KEMPT_APPLY_HELPER_PATH"
}

# Directly under the version line and above every check, because it is the one row that decides
# whether the rest of the report means anything. On an image-based Fedora - Silverblue, Kinoite,
# Bazzite, a bootc image - rpm-ostree owns /usr and dnf is not how the machine updates, and nothing
# else here would ever say so: those images ship dnf5 and plasma-workspace, so both Kempt packages
# install cleanly, every row below passes honestly, and the report used to end "all checks passed"
# about a tool that cannot update that box.
# FAIL and not info: "everything is fine" is precisely the sentence that must not be printed here.
doctor_image_based_row() {
  on_ostree || return 0
  doctor_fail "this system updates with rpm-ostree, not dnf ($KEMPT_OSTREE_MARKER exists), so Kempt cannot update it. Support for these images is planned. The dnf checks below describe a tool that is not what installs updates on this machine. Use Discover, or: rpm-ostree upgrade (bootc upgrade on a bootc image)"
}

doctor_tool_rows() {
  # jq: a missing one exits 3 before this command runs, so this line only ever says ok - it names
  # WHICH jq answered rather than catching an absence.
  doctor_ok "jq: $(command -v jq) ($(jq --version 2>/dev/null || echo 'version unknown'))"

  # The terminal emulator matters only where it is launched: surface=terminal, plus any surface
  # when auto_accept=false (which forces terminal). A FAIL on a detached surface would be a
  # warning nobody can act on.
  local surface auto term_needed=false
  surface="$(config_get surface)"; auto="$(config_get auto_accept)"
  case "$surface" in popup|background|offline) ;; *) term_needed=true ;; esac   # unknown → terminal, same as resolve_surface
  is_true "$auto" || term_needed=true
  if command -v "$KEMPT_TERMINAL" >/dev/null; then
    doctor_ok "terminal emulator: $(command -v "$KEMPT_TERMINAL")"
  elif [[ "$term_needed" == true ]]; then
    doctor_fail "terminal emulator '$KEMPT_TERMINAL' not found, so 'kempt run' exits 4 with surface=terminal. Install it, or run updates another way: kempt config set surface background (Settings > Run updates in > In the background)"
  else
    doctor_info "terminal emulator '$KEMPT_TERMINAL' not found, and surface=$surface does not need it"
  fi

  # flatpak: ask about the command the BACKEND runs (first word of its seam), never a hardcoded
  # name a test or a power user may have redirected.
  local fp_cmd; fp_cmd="${KEMPT_FLATPAK_LIST_CMD%% *}"
  if command -v "$fp_cmd" >/dev/null; then
    doctor_ok "flatpak: $(command -v "$fp_cmd")"
  elif is_true "$(config_get include_flatpak)"; then
    doctor_fail "flatpak command '$fp_cmd' not found. With include_flatpak=true, every check reports Flatpak stale. Install flatpak or run: kempt config set include_flatpak false"
  else
    doctor_info "flatpak command '$fp_cmd' not found, and include_flatpak=false does not need it"
  fi
  # Apps installed with `flatpak install --user`. Listed only when that installation exists,
  # because any --user command creates one.
  if command -v "$fp_cmd" >/dev/null && is_true "$(config_get include_flatpak)"; then
    local fp_user_n=0
    if flatpak_user_present; then
      # shellcheck disable=SC2086  # the seam may carry its own arguments
      fp_user_n="$($KEMPT_FLATPAK_USER_LIST_CMD 2>/dev/null </dev/null | awk -F'\t' 'NF && $1 !~ /^#/' | wc -l)" \
        || fp_user_n="?"
    fi
    case "$fp_user_n" in
      0) doctor_info "per-user Flatpak apps: none" ;;
      \?) doctor_info "per-user Flatpak apps: the list failed, so updates skip them and checks keep their last known updates" ;;
      1) doctor_info "per-user Flatpak apps: 1, checked and updated with the system ones" ;;
      *) doctor_info "per-user Flatpak apps: $fp_user_n, checked and updated with the system ones" ;;
    esac
  fi

  # The reboot verdict is the one thing Kempt asks a dnf command directly, on the hourly DETACHED
  # path where its "reboot check failed (rc=127)" reaches a stderr nobody reads and no event line -
  # so a permanently broken check looks exactly like a permanently answered one: reboot_needed
  # false, forever. This row is where it becomes visible. First word of the seam, like flatpak
  # above. info, not FAIL: updates are untouched and it degrades in the safe direction.
  local dnf_cmd; dnf_cmd="${KEMPT_DNF_CMD%% *}"
  if command -v "$dnf_cmd" >/dev/null; then
    doctor_ok "dnf: $(command -v "$dnf_cmd")"
  else
    doctor_info "dnf command '$dnf_cmd' not found. Updates still work (they go through the root helper), but reboot_needed answers false on every check whether or not a restart is owed; install dnf5, or point KEMPT_DNF_CMD at the right command"
  fi
}

# The listing behind `kempt reclaim` and the widget's offer. Its Python bindings come from two
# packages, and the flatpak command needs neither, so without them every check just reports the
# listing failed. Asked only where the feature is on: flatpak present, include_flatpak true and
# reclaim not off. Exit 3 is the helper's "cannot load libflatpak from Python".
doctor_reclaim_row() {
  flatpak_present || return 0
  is_true "$(config_get include_flatpak)" || return 0
  [[ "$(reclaim_mode)" != off ]] || return 0
  # As root the helper would list against root's apps, which is not the listing a check makes.
  if reclaim_as_root; then
    doctor_info "unused Flatpak runtimes: not checked as root. Run kempt doctor as yourself to check the listing"
    return 0
  fi
  local out rc=0 why
  # shellcheck disable=SC2086  # the seam may carry its own arguments
  out="$(timeout "$KEMPT_RECLAIM_LIST_TIMEOUT" $KEMPT_FLATPAK_UNUSED_CMD 2>&1 >/dev/null </dev/null 9>&-)" || rc=$?
  if [[ $rc -eq 0 ]]; then
    doctor_ok "unused Flatpak runtimes: Kempt can list them"
    return 0
  fi
  why="$(error_line_of <<<"$out")" || why=""
  if [[ $rc -eq 3 ]]; then
    doctor_fail "unused Flatpak runtimes: Kempt cannot list them because Python cannot load libflatpak${why:+ ($why)}. Install the missing packages: sudo dnf install flatpak-libs python3-gobject-base"
  else
    # Not a missing package but flatpak itself failing (no system bus, a damaged installation):
    # worth saying, not Kempt's to fail on.
    doctor_info "unused Flatpak runtimes: the listing failed (rc=$rc${why:+: $why}), so kempt reclaim and the widget cannot offer to free space"
  fi
}

# How old the metadata behind every count is. Nothing else in this report would say: a check
# answers from a cache it refreshes at most once every three hours and skips on battery and on a
# metered link, so a box can go a week on one fetch with every surface looking freshly checked.
# info and never FAIL - old metadata is what the battery and metering rules are FOR, so it is a
# fact to put in front of the reader, not a fault to count against the install.
# The other updater in the same session. plasma-discover-notifier checks on its own schedule from
# PackageKit's separate cache, so its count and Kempt's can differ and both be right, and
# PackageKit's background work takes the dnf5 lock, which makes a Kempt run wait until it lets go.
# info, never FAIL: running both is a legitimate choice. Silent when it is not installed, or when
# its entry does not start in Plasma (lib/common.sh, discover_entry_starts).
doctor_other_updater_row() {
  discover_installed || return 0
  local entry
  entry="$(discover_effective_entry)"
  if discover_entry_starts "$entry"; then
    doctor_info "Discover's update notifier also starts with your session ($entry). It counts updates on its own schedule, so its number can differ from Kempt's. Its background work can make a Kempt run wait. To turn it off, run kempt discover-notifier off or use Turn Off Discover's Notifier in the widget"
    return 0
  fi
  # Off by Kempt's entry, by the person's own, or by a desktop list that leaves Plasma out.
  if grep -qiE '^[[:space:]]*Hidden[[:space:]]*=[[:space:]]*true' "$entry"; then
    doctor_ok "Discover's update notifier: turned off for this user ($entry)"
  fi
}

doctor_metadata_row() {
  local iso days
  iso="$(metadata_refreshed_iso)"
  if [[ -z "$iso" ]]; then
    doctor_info "package metadata: never refreshed on this box. The next check on mains power and an unmetered connection fetches it"
    return 0
  fi
  days="$(metadata_age_days)"
  if [[ "$days" == 0 ]]; then
    doctor_ok "package metadata: refreshed $iso"
  else
    local word=days
    if [[ "$days" == 1 ]]; then word=day; fi
    doctor_info "package metadata is $days $word old ($iso). Checks answer from this cache. A refresh runs at most once every 3 hours, and never on battery or a metered connection. Force one with: kempt check --refresh"
  fi
}

doctor_config_row() {
  # The config file is read with `grep "^key="`, so a line that is not key=value is ignored and the
  # setting the user believes they wrote never applies. Validated exactly as config_set validates.
  local line n=0 bad=0 keys=0 k
  if [[ ! -e "$CONFIG_FILE" ]]; then
    doctor_ok "config file: none yet, built-in defaults apply ($CONFIG_FILE)"
  elif [[ ! -r "$CONFIG_FILE" ]]; then
    doctor_fail "config file is not readable: $CONFIG_FILE. Every command silently falls back to defaults"
  else
    # `|| [[ -n "$line" ]]`: a final line with no trailing newline is still a line.
    while IFS= read -r line || [[ -n "$line" ]]; do
      n=$(( n + 1 ))
      [[ -z "${line//[[:space:]]/}" ]] && continue
      k="${line%%=*}"
      if [[ "$line" != *=* || ! "$k" =~ ^[a-z][a-z0-9_]+$ ]]; then
        doctor_fail "config file line $n is not key=value: $line ($CONFIG_FILE)"
        bad=$(( bad + 1 ))
      else
        keys=$(( keys + 1 ))
      fi
    done < "$CONFIG_FILE"
    # The `if` form, not `[[ ... ]] && x=y`: a false test as a branch's last command returns 1 and
    # errexit would kill the checkup halfway through.
    if [[ $bad -eq 0 ]]; then
      local sword=settings
      if [[ $keys -eq 1 ]]; then sword=setting; fi
      doctor_ok "config file: $CONFIG_FILE ($keys $sword)"
    fi
  fi
}

doctor_state_dir_row() {
  # "Writable" means "can be written OR created": nothing has run yet on a fresh install, and a
  # checkup must not CREATE the directory it checks - so walk up to the nearest existing ancestor.
  local probe="$KEMPT_STATE_DIR"
  while [[ ! -e "$probe" ]]; do
    [[ "$probe" == */* && "$probe" != / ]] || break
    probe="${probe%/*}"; [[ -n "$probe" ]] || probe=/
  done
  if [[ -d "$probe" && -w "$probe" ]]; then
    if [[ "$probe" == "$KEMPT_STATE_DIR" ]]; then
      doctor_ok "state dir writable: $KEMPT_STATE_DIR"
    else
      doctor_ok "state dir writable: $KEMPT_STATE_DIR (created on first use)"
    fi
  else
    doctor_fail "state dir not writable: $KEMPT_STATE_DIR. No state, history or logs can be written"
  fi
}

# Which kind of install this is. install.sh is the file a checkout has and a package does not: it
# is what a fix message would tell you to run, and exactly what a packaged tree does not ship.
# One definition, because two rows ask the question and a report that called itself packaged on one
# line and a checkout on the next is worse than either answer alone.
install_is_packaged() { [[ ! -r "$ROOT/install.sh" ]]; }

doctor_files_row() {
  # Whatever tree the CLI resolved, whole. What is sourced fails at startup; what is not (the
  # passwordless rules template) fails only on the day somebody runs the command that needs it.
  local missing=() rel kind=checkout
  install_is_packaged && kind="program files"
  for rel in lib/common.sh backends/dnf.sh backends/flatpak.sh polkit/49-kempt.rules.in; do
    [[ -r "$ROOT/$rel" ]] || missing+=("$rel")
  done
  if [[ ${#missing[@]} -eq 0 ]]; then
    doctor_ok "$kind intact: $ROOT"
  else
    doctor_fail "$kind incomplete: missing ${missing[*]} (in $ROOT)"
  fi
}

doctor_offline_rows() {
  # The staged offline transaction, read as TWO facts side by side rather than reconciled - which
  # makes this doctor's line and nobody else's. Every other surface reads them together and
  # publishes one answer, so a marker over a transaction that can never install looks from outside
  # exactly like a pending update. Silent when there is neither, which is most boxes.
  local dr_toml dr_count dr_marker
  dr_toml="$(offline_system_status)"
  # Read the way every other reader reads it - never raw jq, which answers `empty` for a torn file
  # and would fall through to the armed row below. offline_marker_read refuses an empty,
  # unparsable or over-1 MB marker, and that means "skip", not "the stage is gone".
  dr_marker="$(offline_marker_read)"
  # A stored release upgrade answers for the whole section: dnf5 has one slot, ours is not in it,
  # and every sentence below would be about a transaction that no longer exists. Reported as
  # somebody else's, which is what it is, by the branch further down.
  local dr_relup_owns=false
  if [[ -f "$OFFLINE_MARKER" ]] && offline_release_upgrade >/dev/null; then
    dr_marker=""; dr_relup_owns=true
    doctor_info "staged update: Kempt has a marker for a transaction that is no longer stored. A Fedora release upgrade replaced it, and the next check or run clears the marker ($OFFLINE_MARKER)"
  fi
  # A FLAG rather than an empty marker, because the chain below has a branch for a marker that is
  # on disk and would not parse - and blanking the variable dropped straight into it, so a perfectly
  # readable marker was reported as unreadable and the release upgrade was never named at all.
  if [[ "$dr_relup_owns" == false && -n "$dr_marker" ]]; then
    dr_count="$(jq -r '.staged // empty' <<<"$dr_marker" 2>/dev/null || true)"
    case "$dr_toml" in
      ready)
        # One package is its own sentence, verb included; zero is plural.
        if [[ "$dr_count" == 1 ]]; then
          doctor_info "staged update: 1 package installs on the next restart"
        elif [[ "$dr_count" =~ ^[0-9]+$ ]]; then
          doctor_info "staged update: $dr_count packages install on the next restart"
        else
          doctor_info "staged update: it installs on the next restart"
        fi
        # Both only for `ready`: what an unarmed transaction holds, and whether Kempt built it,
        # are questions about a transaction that is not going to run.
        doctor_staged_conflict_row
        doctor_staged_drift_row "$dr_marker" ;;
      absent)
        # Nothing for anyone to do: harvest_offline clears a marker with no transaction under it.
        doctor_info "staged update: the transaction is gone, so the next check clears the marker ($OFFLINE_MARKER)" ;;
      *)
        # Not `ready` means not armed, and no restart applies it. FAIL rather than info: a real
        # defect with an exact remedy, spelled out because the remedy needs root.
        doctor_fail "staged update can never install: the transaction was downloaded but never set to install (status \"$dr_toml\"), so no restart applies it. Clear it with: sudo dnf5 offline clean" ;;
    esac
  elif [[ "$dr_relup_owns" == false && -f "$OFFLINE_MARKER" ]]; then
    # A marker is there and cannot be read. Reported as itself, not through the line below, which
    # would attribute Kempt's own stage to somebody else. info, not FAIL: a torn read is a moment
    # (update and check hold different locks, so a check can arrive mid-write).
    doctor_info "staged update: the marker cannot be read, so nothing here describes what Kempt staged: $OFFLINE_MARKER (dnf5 says \"$dr_toml\"). A marker that will not parse is skipped rather than cleared, so the next check leaves it where it is"
  elif [[ "$dr_toml" != absent ]] || offline_release_upgrade >/dev/null; then
    # `|| offline_release_upgrade` is not redundant: a transaction-state file that is READABLE but
    # carries no `status` key reads as `absent` here, while the two releasever keys are right there
    # to be compared - so `kempt check` published a release upgrade and this report said nothing at
    # all about one.
    # Not Kempt's: it staged nothing and will harvest nothing. Still worth a line for somebody
    # reading this because a restart installed things they did not expect.
    # Named when it can be: "a release upgrade is waiting" is a different thing to be told than
    # "something is staged", and it is the case where Kempt's own offline button is refused.
    local dr_relup
    if dr_relup="$(offline_release_upgrade)"; then
      # Which of the two it is decides the sentence. Saying "it installs on the next restart" over
      # a status of "download-complete" prints the claim and its own refutation in one line - and
      # the row twelve lines up says the opposite about the identical status when the transaction
      # happens to be Kempt's own.
      case "$(offline_release_upgrade_state)" in
        armed)
          doctor_info "a Fedora release upgrade ($dr_relup) is staged outside Kempt and installs on the next restart. Kempt will not stage updates over it, because that would cancel it" ;;
        stranded)
          # `ready` with no boot symlink. Its own state, because the other sentences each say
          # something this one disproves: it is not waiting for a restart, and "downloaded but not
          # started" quotes a status word that says the opposite. The FAIL row further down is the
          # one that gives the remedy - two rows repeating the same two commands is one too many.
          doctor_info "a Fedora release upgrade ($dr_relup) is stored outside Kempt and was set to install, but the restart marker $KEMPT_OFFLINE_LINK is not in place. A restart has already been past it. Kempt will not stage updates while it is there, because that would cancel it" ;;
        incomplete)
          # `absent` here is a readable file with no `status` key, not a missing one - a missing one
          # never reaches this branch, because offline_release_upgrade cannot read its releasevers.
          local dr_word="status \"$dr_toml\""
          [[ "$dr_toml" == absent ]] && dr_word="no status recorded"
          doctor_info "a Fedora release upgrade ($dr_relup) is stored outside Kempt and did not finish ($dr_word). See what happened with: sudo dnf5 offline log, or remove it with: sudo dnf5 offline clean. Kempt will not stage updates while it is there, because that would cancel it" ;;
        *)
          doctor_info "a Fedora release upgrade ($dr_relup) has been downloaded outside Kempt but not started (status \"$dr_toml\"), so no restart installs it yet. Begin it with: sudo dnf5 system-upgrade reboot, or remove it with: sudo dnf5 offline clean. Kempt will not stage updates while it is there, because that would cancel it" ;;
      esac
    else
      doctor_info "an offline transaction is staged outside Kempt (status \"$dr_toml\"). See: dnf5 offline status"
    fi
  fi

  # The boot symlink, the half of arming that decides what the next restart does. A symlink over a
  # transaction that is not `ready` is a state the box reaches on its own: re-staging destroys the
  # old transaction before the new one exists, so a stage failing in between leaves exactly this,
  # and the boot detours into the offline updater and installs nothing. Checked marker or no
  # marker - the symlink is the boot's business, the marker is Kempt's.
  # -L is lstat: the symlink itself, never its target. system-update-generator does not resolve it
  # either, so a dangling one detours the boot exactly as a live one does.
  if [[ -L "$KEMPT_OFFLINE_LINK" && "$dr_toml" != ready ]]; then
    if [[ "$dr_toml" == absent ]]; then
      doctor_fail "boot symlink is live with nothing staged behind it: $KEMPT_OFFLINE_LINK. The next restart detours into the offline updater and installs nothing. Remove it with: sudo dnf5 offline clean"
    else
      doctor_fail "boot symlink is live over a transaction that is not set to install (status \"$dr_toml\"): $KEMPT_OFFLINE_LINK. The next restart detours into the offline updater and installs nothing. Clear it with: sudo dnf5 offline clean"
    fi
  elif [[ "$dr_toml" == ready && ! -L "$KEMPT_OFFLINE_LINK" ]]; then
    # The INVERSE: `ready` with no symlink in front of it. A restart has already walked past this
    # transaction and no future one can install it either - see reconcile_detour_stage. Without
    # this row every surface calls it a pending install, forever.
    # Whose transaction it is decides both the noun and the remedy. `kempt update --surface=offline`
    # is refused while a release upgrade is stored, so offering it there would be one more command
    # that always ends in a no - and calling a Fedora release upgrade "staged update" attributes
    # somebody else's transaction to Kempt, which the row two above has just said it is not.
    if offline_release_upgrade >/dev/null; then
      doctor_fail "the stored Fedora release upgrade can never install: dnf5 says \"ready\" but the restart marker $KEMPT_OFFLINE_LINK is not in place, so a restart has already been past it. Set it to install again with: sudo dnf5 system-upgrade reboot, or clear it with: sudo dnf5 offline clean"
    else
      doctor_fail "staged update can never install: dnf5 says \"ready\" but $KEMPT_OFFLINE_LINK is gone, and only \`dnf5 offline reboot\` sets it to install again. Stage it again with: kempt update --surface=offline, or clear it with: sudo dnf5 offline clean"
    fi
  fi
}

doctor_version_row() {
  # Which build this is. The opening line already names the release and the tree; this one names
  # the COMMIT, the difference between "0.1.0" and the twelve commits of 0.1.0 a reporter might be
  # running. `dirty` covers untracked files too - a new backend file changes behaviour as much as
  # an edited one. Every git call is tolerated failing: a tarball install has no .git, a packaged
  # one need not have git, and a version line must never be the thing that stops the checkup.
  local ver_line sha tree
  ver_line="version: kempt $(kempt_version)"
  sha=""
  # The `if` form, not `[[ ... ]] && x=y`: see doctor_config_row - errexit would kill the checkup.
  if [[ -e "$ROOT/.git" ]]; then
    sha="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || true)"
  fi
  if [[ -n "$sha" ]]; then
    tree=clean
    [[ -z "$(git -C "$ROOT" status --porcelain 2>/dev/null)" ]] || tree=dirty
    ver_line="$ver_line (checkout $sha $tree)"
  fi
  doctor_info "$ver_line"
}

doctor_install_rows() {
  # A packaged install has nothing to compare and nothing to drift: the RPM ships bin/, lib/ and
  # backends/ under /usr/share/kempt and none of libexec/, polkit/ or plasmoid/, because the
  # package manager owns those three and keeps them in step. install.sh's absence is what says
  # which kind of install this is - it is the file the fix message would name, and exactly what a
  # packaged tree does not ship.
  if install_is_packaged; then
    doctor_info "install: packaged, so the package manager keeps these files in step"
    # ...and the one thing a packaged install can be silently wrong about. kpackagetool6 (the KDE
    # Store route) installs into the USER's plasmoid directory, the package into /usr/share, and
    # Plasma PREFERS the user one - so a store install predating the package stays the widget
    # Plasma loads, invisibly, and no other row would catch it.
    # Only in this branch: on a checkout that directory IS the install, and the message would tell
    # a developer to delete their own widget. The skew comparison below covers that case.
    if [[ -d "$KEMPT_PLASMOID_DIR" ]]; then
      doctor_fail "user widget copy shadows the package: $KEMPT_PLASMOID_DIR. Plasma loads this copy instead of the packaged widget, so package updates never reach your panel. Remove it with: kpackagetool6 -t Plasma/Applet -r io.github.erez_c137.kempt, then plasmashell --replace"
    elif [[ ! -d "$KEMPT_SYSTEM_PLASMOID_DIR" ]]; then
      # The panel half is its own package, so a working CLI can sit on a box with no widget and
      # nothing would say why. info, not FAIL: the CLI is the whole tool for anyone who wanted it.
      # ...and what going without it means, because the CLI alone is not a quieter widget.
      doctor_info "panel widget not installed. It is a separate package: sudo dnf install kempt-plasmoid. Without it nothing runs checks on a schedule, so the CLI checks only when you run it, from an active local session (not over SSH)"
    fi

    # The environment can point this process at a different update path than the rows above
    # describe, and on a PACKAGED install nothing else notices: a few lines in
    # ~/.config/environment.d make `kempt update` report "0 updated" while running nothing, under
    # a report that still says "all checks passed". Only the three seams that decide what RUNS -
    # the others change what is READ, and the rows above cover those.
    # Gated on a tree this user cannot WRITE, the one packaged-ness test an environment variable
    # cannot fake. Without that gate the suite's own sandbox, which sets all three seams by
    # design, trips the row on every run.
    local overridden=() seam
    for seam in KEMPT_PKEXEC KEMPT_APPLY_HELPER KEMPT_REFRESH_HELPER; do
      [[ " $KEMPT_ENV_OVERRIDES " == *" $seam "* ]] && overridden+=("$seam")
    done
    if [[ ${#overridden[@]} -gt 0 && ! -w "$ROOT" ]]; then
      doctor_fail "privileged path overridden in the environment: ${overridden[*]}. These are test settings, and while they are set this report describes a path that is not the one 'kempt update' takes. Unset them (look in ~/.config/environment.d and your shell profile) and run this again"
    fi
  else
    doctor_install_files helpers \
      "$ROOT/libexec/kempt-refresh" "$KEMPT_REFRESH_HELPER_PATH" \
      "$ROOT/libexec/kempt-apply"   "$KEMPT_APPLY_HELPER_PATH"
    doctor_install_files policy \
      "$ROOT/polkit/io.github.erez_c137.kempt.policy" "$KEMPT_POLICY_FILE"
    doctor_install_dir widget "$ROOT/plasmoid" "$KEMPT_PLASMOID_DIR"
  fi
}

doctor_recent_events() {
  # Not a check, and deliberately below every check that is: doctor answers "is this install
  # sound", and the next question is "then why did my change not take effect?". The last five
  # events answer that in place, without anyone needing to know `kempt log` exists. Indented, so
  # nothing here can be mistaken for a report line.
  echo
  echo "Recent events (kempt log):"
  if [[ -s "$EVENTS_FILE" ]]; then
    tail -n 5 "$EVENTS_FILE" | sed 's/^/  /'
  else
    echo "  none"
  fi
  echo
}

cmd_doctor() {
  DOCTOR_FAILS=0
  # First line, and info rather than ok: not a check that can pass or fail, but the fact every
  # other line has to be read against - a report pasted into a bug report without it describes an
  # unknown build.
  doctor_info "kempt $(kempt_version) ($KEMPT_ROOT)"
  doctor_image_based_row
  doctor_privileged_rows

  doctor_tool_rows
  doctor_reclaim_row
  doctor_other_updater_row
  doctor_metadata_row
  doctor_config_row
  doctor_state_dir_row
  doctor_files_row
  doctor_offline_rows
  doctor_version_row
  doctor_install_rows
  # Outside that branch on purpose: both kinds of install can be shadowed for the widget alone - a
  # leftover ~/.local/bin/kempt from a checkout wins over /usr/bin/kempt for the panel and for
  # nothing else.
  doctor_widget_engine

  doctor_recent_events

  if [[ $DOCTOR_FAILS -eq 0 ]]; then
    echo "kempt doctor: all checks passed"
    return 0
  fi
  local word=problems
  if [[ $DOCTOR_FAILS -eq 1 ]]; then word=problem; fi
  echo "kempt doctor: $DOCTOR_FAILS $word found"
  return 1
}

# Turns Discover's update notifier off or on for this user, or says where it stands. The work is
# in lib/common.sh, shared with install.sh's question.
cmd_discover_notifier() {
  case "${1:-}" in
    off|on|keep) [[ $# -eq 1 ]] || { echo "unknown option: $2" >&2; exit 2; }
            # The widget and Settings run these on separate queues: one at a time, so two offs
            # cannot both find no kept copy and overwrite each other's.
            writer_lock || exit 1
            "discover_notifier_$1" ;;
    status) [[ $# -eq 1 || ( $# -eq 2 && "$2" == --json ) ]] || { echo "unknown option: $2" >&2; exit 2; }
            discover_notifier_status "${2:-}" ;;
    *) echo "usage: kempt discover-notifier off | on | keep | status [--json]" >&2; exit 2 ;;
  esac
}

# Where the passwordless rule lives. polkit reads FOUR rules directories (polkit(8)); Kempt uses the
# ADMINISTRATOR's one, because the other three belong to packages and to the runtime.
RULES_DST_FIXED=/etc/polkit-1/rules.d/49-kempt.rules
RULES_DST="$RULES_DST_FIXED"

# This path goes to a ROOT install(1) and a ROOT rm, so a real run uses exactly the fixed path.
# A list of allowed directories is not enough: a check on a path the user can write to can be
# defeated by swapping a directory on it for a symlink after the check. Every directory on the fixed
# path is root-owned, so nothing running as the user can change where it leads.
# KEMPT_RULES_DST lets the suite drive the real install and removal commands. It is honoured only
# where those commands run as the user, with no pkexec wrapper and not as root, so it can never
# point a root write anywhere. Set in any other run it is refused rather than ignored, so nobody is
# told a rule went somewhere it did not.
check_rules_dst() {
  [[ -n "${KEMPT_RULES_DST:-}" ]] || return 0
  if [[ -n "$KEMPT_PKEXEC" || $EUID -eq 0 ]]; then
    echo "invalid rules destination: KEMPT_RULES_DST is a test setting, honoured only without pkexec and not as root. The rule always goes to $RULES_DST_FIXED" >&2
    exit 2
  fi
  if [[ "$KEMPT_RULES_DST" != /* || "$KEMPT_RULES_DST" != *.rules ]]; then
    echo "invalid rules destination: $KEMPT_RULES_DST" >&2; exit 2
  fi
  RULES_DST="$KEMPT_RULES_DST"
}

cmd_enable_passwordless() {
  local rule
  check_rules_dst
  # render_passwordless_rule (lib/common.sh) renders from $(id -un), self-checks the result and
  # prints it only when the check passed, so an unverified rule can never reach install(1).
  # One event per invocation carrying this command's exit status - a grant refused at the
  # authentication dialog is recorded as plainly as one that succeeded. Largest security
  # consequence Kempt can change.
  if ! rule="$(render_passwordless_rule "$ROOT/polkit/49-kempt.rules.in")"; then
    log_event "passwordless enable rc=2"; exit 2
  fi
  # The checked text goes to root on a pipe, never as a file path. A file here would be the user's
  # own, and any process running as the user could rewrite it between the check and root's copy,
  # which waits on a person at the authentication dialog. pkexec asks for the password on its own
  # agent or the terminal, not on stdin, so the pipe carries the rule and nothing else.
  # ${VAR:+$VAR} matches priv_refresh/priv_apply: empty KEMPT_PKEXEC means "no wrapper" (test
  # sandbox). lib/common.sh always sets the variable, so there is no fallback case to cover.
  # Full paths here and in disable: pkexec finds a bare name through the caller's PATH, where
  # ~/.local/bin comes first on Fedora.
  if ! printf '%s\n' "$rule" | ${KEMPT_PKEXEC:+$KEMPT_PKEXEC} /usr/bin/install -m 0644 -o root -g root /dev/stdin "$RULES_DST"; then
    log_event "passwordless enable rc=1"
    echo "could not install $RULES_DST, so passwordless is NOT enabled" >&2; exit 1
  fi
  log_event "passwordless enable rc=0"
  echo "Passwordless updates ENABLED for $(id -un) ($RULES_DST)"
}

cmd_disable_passwordless() {
  check_rules_dst
  # Nothing to remove is not a failure, and discovering that must not raise an auth prompt. The
  # negative test is trusted only where the directory is searchable: the real /etc/polkit-1/rules.d
  # is 0750 root:polkitd, so an unprivileged [[ -e ]] reports "absent" for a file that exists, and
  # "not enabled" would leave a live grant in place.
  if [[ -x "$(dirname "$RULES_DST")" && ! -e "$RULES_DST" ]]; then
    log_event "passwordless disable rc=0"
    echo "passwordless was not enabled"; return 0
  fi
  local rc=0
  ${KEMPT_PKEXEC:+$KEMPT_PKEXEC} /usr/bin/rm -f "$RULES_DST" || rc=$?
  log_event "passwordless disable rc=$rc"
  # The rc is still the command's own: captured only so the event can name it, then handed back
  # unchanged - exactly what errexit would have done here.
  [[ $rc -eq 0 ]] || return $rc
  echo "Passwordless updates disabled"
}

# Exit codes (one contract, every command):
#   0 success - including a user who declines at the risky-transaction prompt
#   1 the run itself failed (a backend returned non-zero), `check --strict` had a backend fail,
#     could not list the per-user Flatpak apps or served the previous state, `doctor` found a
#     problem, or a writer
#     (config set / hold / unhold / discover-notifier off|on|keep) could not take the writers' lock. docs/usage.md carries the
#     same table - keep the two in step.
#     Also reclaim when flatpak failed: partly removed, or with what went unknown
#   2 usage error (unknown command, option or argument)
#   3 cannot start: jq missing, or another kempt update already holds the lock
#   4 launcher missing (no terminal emulator for the terminal surface)
#   5 aborted during pre-flight - nothing was changed. For reclaim: may not remove, flatpak's refusal
#     by polkit included
#   6 reclaim only: what Flatpak would remove is not the set that was shown, or part of it became
#     unused less than an hour ago (every ref, on first use) - nothing was removed
#   7 update only: another program held the dnf or Flatpak lock through all three tries
usage() {
  cat <<'EOF'
usage: kempt <command>
  check [--refresh] [--coalesce] [--strict]
                        refresh pending-updates state (JSON to stdout). --refresh fetches package
                        metadata now, ignoring the 3-hour interval but never the battery or
                        metered-connection rules. --coalesce accepts the answer of a check that
                        finished while this one waited (the widget's automatic checks). --strict
                        exits 1 when dnf or Flatpak failed, the apps for you only could not be
                        listed, or the previous state was served
  update                run the update now (options from config; --no-flatpak, --surface=X override)
  run [--print-command] launch an update where the config says (what the widget calls;
                        --surface=X runs this one elsewhere; --risky-ok when the person
                        already chose to install session-critical updates now)
  summary [N]           human summary of the last (or Nth-last) run
  summary --json        the newest run's history entry, verbatim JSON (nothing if no runs yet,
                        or if the newest entry is damaged)
  history [--json]      list past runs, newest first; --json prints them as a JSON array of
                        history entries
  log [-n N]            recent events: what Kempt did, when, and from where (default 30)
  doctor                check this install: helpers, polkit action, tools, config, state
  hold dnf:<pkg> | flatpak:<app.id>     skip in updates, still notify
  unhold <same>         remove a hold
  holds [--exclude-args]  list holds; --exclude-args prints the dnf ones as dnf5 --exclude=
                        arguments, on one line, to reuse by hand
  unstage               discard the staged offline update; the next restart installs nothing
  reclaim [--list] [-y] [--expect=DIGEST]
                        remove the Flatpak runtimes no installed app uses (--list only shows them)
  config get|set        read/write settings
  discover-notifier off | on | keep | status [--json]
                        turn Discover's own update notifier off or back on for this user, keep
                        it as it is (the widget's answer), or say whether it is installed, on
                        and running
  enable-passwordless | disable-passwordless
  --version | version | -V   print the version and exit
  help | --help | -h    print this list
EOF
}

# --help or -h right after any command asks for help, and gets it before the command runs or
# parses anything, so `kempt update --help` can never start an update.
if [[ $# -ge 2 && ( "$2" == --help || "$2" == -h ) ]]; then
  usage
  exit 0
fi

# Before any command reads the config, so the first `config get surface` of this version already
# answers what the migration decided. Only the commands that exist: help, the version and a
# mistyped command change nothing, so they skip it.
case "${1:-help}" in
  check|update|run|summary|history|log|doctor|config|hold|unhold|holds|unstage|reclaim|\
  discover-notifier|enable-passwordless|disable-passwordless) surface_migrate ;;
esac

case "${1:-help}" in
  check)   shift; cmd_check "$@" ;;
  update)  shift; cmd_update "$@" ;;
  run)     shift; cmd_run "$@" ;;
  summary) shift; cmd_summary "$@" ;;
  history) shift; cmd_history "$@" ;;
  log)     shift; cmd_log "$@" ;;
  doctor)  shift; [[ $# -eq 0 ]] || { echo "unknown option: $1" >&2; exit 2; }; cmd_doctor ;;
  config)  shift; cmd_config "$@" ;;
  hold)    shift; cmd_hold "$@" ;;
  unhold)  shift; cmd_unhold "$@" ;;
  holds)   shift; cmd_holds "$@" ;;
  unstage) shift; cmd_unstage "$@" ;;
  reclaim) shift; cmd_reclaim "$@" ;;
  discover-notifier) shift; cmd_discover_notifier "$@" ;;
  enable-passwordless)  [[ $# -eq 1 ]] || { echo "unknown option: $2" >&2; exit 2; }; cmd_enable_passwordless ;;
  disable-passwordless) [[ $# -eq 1 ]] || { echo "unknown option: $2" >&2; exit 2; }; cmd_disable_passwordless ;;
  version|--version|-V) shift; cmd_version "$@" ;;
  help|--help|-h) usage ;;
  *) echo "unknown command: $1" >&2; usage >&2; exit 2 ;;
esac

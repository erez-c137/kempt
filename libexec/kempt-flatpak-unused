#!/usr/bin/python3 -s
# Kempt's read-only list of the Flatpak refs nothing installed uses. Runs as the desktop user,
# never as root and never through pkexec: for the system installation, libflatpak also counts the
# CALLING user's own apps as users, so the answer is only right for the person who runs it.
#
# Why a library call and not `flatpak uninstall --unused` with no terminal: list_unused_refs() is
# the same flatpak_dir_list_unused_refs() call that command makes, so the list is exactly what a
# removal would take, and it needs no prompt that has to answer itself.
#
# JSON on stdout:
#   {"installation": path,
#    "unused": [{"ref", "commit", "deploy_dir", "eol", "extension"}],
#    "used":   [{"ref", "commit", "deploy_dir"}]}          every other installed ref
# eol is the reason string or null. The used refs are there for the size estimate: a file an unused
# ref shares with a used one is not freed, and du can only tell the two apart when it sees both sets
# of directories.
#
# extension is true when the unused ref is an extension, which flatpak removes even while an app
# uses it (kempt removes those in a second pass, bin/kempt reclaim_remove). Read from flatpak's own
# metadata, not the id: org.gtk.Gtk3theme.* or org.kde.KStyle.* do not start with their runtime's
# id. It is an extension when its own metadata has an [ExtensionOf] group (build-finish writes one),
# or when its id is an extension point some installed runtime or app declares ([Extension P]), or
# lies under one (P.something: subdirectories, as org.freedesktop.Platform.GL.default under
# org.freedesktop.Platform.GL). The field is left out when the ref's own metadata cannot be read
# and no declaration matches; the CLI then falls back to the id. Cost: one read of each installed
# ref's small metadata file, no network and no writes.
#
# Exit 0 with the JSON, or non-zero with a one-line reason on stderr. Takes no arguments.
#
# System installation ONLY, and only the default one, matching backends/flatpak.sh. Never
# Installation.new_user(): it creates ~/.local/share/flatpak/repo as a side effect.
import json
import os
import sys


def ref_entry(ref):
    return {
        "ref": ref.format_ref(),
        "commit": ref.get_commit() or "",
        "deploy_dir": ref.get_deploy_dir() or "",
    }


def metadata_groups(ref, GLib):
    """The group names of an installed ref's metadata keyfile, or None when it cannot be read."""
    try:
        kf = GLib.KeyFile()
        kf.load_from_bytes(ref.load_metadata(None), GLib.KeyFileFlags.NONE)
        groups = kf.get_groups()
    except Exception:  # GLib.Error: a missing or unparsable metadata file
        return None
    # PyGObject returns (groups, length)
    if isinstance(groups, tuple):
        groups = groups[0]
    return list(groups or [])


def is_extension(ref_id, own_groups, points):
    if own_groups is not None and "ExtensionOf" in own_groups:
        return True
    if any(ref_id == p or ref_id.startswith(p + ".") for p in points):
        return True
    return False if own_groups is not None else None


def main():
    if len(sys.argv) != 1:
        print("usage: kempt-flatpak-unused", file=sys.stderr)
        return 2
    try:
        import gi
        gi.require_version("Flatpak", "1.0")
        from gi.repository import Flatpak, GLib
    except (ImportError, ValueError) as e:
        print("cannot load libflatpak from Python: %s" % e, file=sys.stderr)
        return 3
    try:
        inst = Flatpak.Installation.new_system(None)
        path = inst.get_path().get_path()
        # flatpak creates the repository with the first remote or install. Without it nothing is
        # installed, and the listing calls would fail opening it: an empty answer, not an error.
        if not os.path.isdir(os.path.join(path, "repo")):
            json.dump({"installation": path, "unused": [], "used": []}, sys.stdout)
            sys.stdout.write("\n")
            return 0
        unused = inst.list_unused_refs(None, None)
        installed = inst.list_installed_refs(None)
    except Exception as e:  # GLib.Error, and anything else the bindings raise
        print("flatpak did not answer: %s" % e, file=sys.stderr)
        return 1
    groups = {r.format_ref(): metadata_groups(r, GLib) for r in installed}
    points = set()
    for g in groups.values():
        points.update(n[len("Extension "):] for n in (g or []) if n.startswith("Extension "))
    unused_names = set()
    out_unused = []
    for ref in unused:
        entry = ref_entry(ref)
        entry["eol"] = ref.get_eol() or None
        own = groups[entry["ref"]] if entry["ref"] in groups else metadata_groups(ref, GLib)
        ext = is_extension(ref.get_name(), own, points)
        if ext is not None:
            entry["extension"] = ext
        unused_names.add(entry["ref"])
        out_unused.append(entry)
    out_used = [ref_entry(r) for r in installed if r.format_ref() not in unused_names]
    json.dump({"installation": path, "unused": out_unused, "used": out_used}, sys.stdout)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/python3 -s
# Kempt's read-only list of the Flatpak refs nothing installed uses. Runs as the desktop user,
# never as root and never through pkexec: for the system installation, libflatpak also counts the
# CALLING user's own apps as users, so the answer is only right for the person who runs it.
#
# list_unused_refs() is the same flatpak_dir_list_unused_refs() call `flatpak uninstall --unused`
# makes. It leaves out what another installed ref needs (a codecs extension a newer Platform uses)
# and what is pinned, and that is the whole decision: Kempt removes what it names and nothing else.
#
# JSON on stdout:
#   {"unused": [{"ref", "deploy_dir"}],
#    "used":   [{"ref", "deploy_dir"}]}          every other installed ref
# The used refs are there for the size estimate: a file an unused
# ref shares with a used one is not freed, and du can only tell the two apart when it sees both sets
# of directories.
#
# Exit 0 with the JSON, or non-zero with a one-line reason on stderr. Takes no arguments.
#
# System installation ONLY, and only the default one, matching backends/flatpak.sh. Never
# Installation.new_user(): it creates ~/.local/share/flatpak/repo as a side effect.
import json
import os
import sys


def entry(ref):
    return {"ref": ref.format_ref(), "deploy_dir": ref.get_deploy_dir() or ""}


def main():
    if len(sys.argv) != 1:
        print("usage: kempt-flatpak-unused", file=sys.stderr)
        return 2
    try:
        import gi
        gi.require_version("Flatpak", "1.0")
        from gi.repository import Flatpak
    except (ImportError, ValueError) as e:
        print("cannot load libflatpak from Python: %s" % e, file=sys.stderr)
        return 3
    try:
        inst = Flatpak.Installation.new_system(None)
        # flatpak creates the repository with the first remote or install. Without it nothing is
        # installed, and the listing calls would fail opening it: an empty answer, not an error.
        if not os.path.isdir(os.path.join(inst.get_path().get_path(), "repo")):
            unused, installed = [], []
        else:
            unused = inst.list_unused_refs(None, None)
            installed = inst.list_installed_refs(None)
    except Exception as e:  # GLib.Error, and anything else the bindings raise
        print("flatpak did not answer: %s" % e, file=sys.stderr)
        return 1
    names = {r.format_ref() for r in unused}
    json.dump({"unused": [entry(r) for r in unused],
               "used": [entry(r) for r in installed if r.format_ref() not in names]}, sys.stdout)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())

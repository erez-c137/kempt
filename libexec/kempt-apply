#!/usr/bin/bash -p
# Kempt root helper - the dnf upgrade verbs, and only those. polkit action
# io.github.erez_c137.kempt.apply (auth_admin_keep). Flatpak is NOT here: `flatpak update` needs
# no password of its own in an active local session, so it runs as the user from
# backends/flatpak.sh, which is where the reasoning and the two residual prompts are written down.
# SECURITY: every argument is validated; anything unexpected exits 2 before any privileged command.
# Absolute shebang, -p and a pinned PATH: defense in depth beyond pkexec's env sanitizing.
# -p is bash's privileged mode. It never reads BASH_ENV or ENV, and it ignores SHELLOPTS, BASHOPTS,
# CDPATH, GLOBIGNORE and exported functions, so a caller that skips pkexec (sudo -E, say) still
# cannot run code before the first line below. /usr/bin/bash because that is the path the package
# ships. The same PATH is set on dnf5's unit (run_dnf5), so dnf5's own lookups use the pinned order.
# rpm sets its own PATH for scriptlets.
# This shell only decides. It validates the arguments, reads dnf5's stored state, and then hands
# the one dnf5 command to systemd, which starts it as a fresh system service (see run_dnf5). pkexec
# passes on far more of the caller than its environment: the umask, resource limits, ignored
# signals, the working directory, the nice value, the CPU affinity and the cgroup. A process systemd
# starts inherits none of them, so root's dnf5 cannot write group- or world-writable files into its
# cache, its downloads or the offline directory, and rpm scriptlets do not run with signals the
# caller chose to ignore. The umask and core-file lines below are belt and braces for this shell
# and systemd-run, which write nothing; dnf5 gets its own from the unit properties.
umask 022
ulimit -c 0
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C.UTF-8   # load-bearing: glibc widens [A-Za-z] under UTF-8 locales; pkexec passes LC_* through
NAME_RE='^[A-Za-z0-9][A-Za-z0-9._+-]*$'

run() {  # test seam: KEMPT_APPLY_ECHO=1 prints instead of running it
  if [[ -n "${KEMPT_APPLY_ECHO:-}" ]]; then echo "$*"; else run_watched "$@"; fi
}

# This helper's name in its messages, and its exit status when dnf5's unit from an earlier run is
# still going (claim_unit). 5 is apart from 2, 3 and 4 below, dnf5's 0, 1, 2 and 100, and pkexec's
# 126 and 127.
ME=kempt-apply
BUSY=5

# systemd-run runs as a child, never by exec, so the shell can watch dnf5's unit while it waits
# (watch_unit). With --pipe, systemd-run hands its own stdin, stdout and stderr to PID 1, which
# gives them to dnf5's unit. They must never be this shell's own. PID 1 runs in SELinux's init_t,
# which may not write the caller's files (a mktemp file in /tmp is user_tmp_t), and systemd-run
# then fails with "Remote peer disconnected" before dnf5 starts. So its stdin is /dev/null, and its
# stdout and stderr are each a pipe this shell makes, read by a cat that copies to this shell's
# stdout or stderr. The two stay apart, because the CLI reads them apart. With --pty, systemd-run
# reads the terminal itself, so its stdin is named: a background command would get /dev/null.
# The shell waits for systemd-run and both cats before it exits, so no output is cut short, and
# the exit status is systemd-run's, which is dnf5's. Bash starts a background command with INT and
# QUIT ignored, so systemd-run gets them back. A TERM, INT or HUP to this shell is passed on to
# systemd-run. Then the cats are stopped as well, since dnf5 may still hold their pipes open, and
# nothing outlives this shell.
# When the watch reports that the unit has ended and systemd-run is still waiting, systemd-run will
# never return (see watch_unit). Only then the shell stops it, the client and never the unit, takes
# the status systemd recorded, and says so. A systemd-run still there one poll interval after the
# TERM is killed: it is the client, which owns no unit, and the helper must return. The cats get
# one more poll interval for what is left in the pipes, and are then stopped: a stdio bridge left
# behind can hold them open for good.
# Identical in kempt-refresh.
run_watched() {  # systemd-run --pipe|--pty ... → dnf5's exit status
  local out err out_pid="" err_pid="" sd_pid wd wd_pid wd_live=1 who r rc=0 woke=0 stopped=0 sig=0 verdict="" pause
  local -a ids
  claim_unit
  if [[ "$2" == --pipe ]]; then
    exec {out}> >(cat)
    out_pid=$!
    exec {err}> >(cat >&2 {out}>&-)
    err_pid=$!
    { trap - INT QUIT; exec "$@"; } </dev/null >&"$out" 2>&"$err" {out}>&- {err}>&- &
    sd_pid=$!
    exec {out}>&- {err}>&-
  else
    { trap - INT QUIT; exec "$@"; } <&0 &
    sd_pid=$!
  fi
  exec {wd}< <(watch_unit </dev/null)
  wd_pid=$!
  ids=("$sd_pid" "$wd_pid")
  trap 'woke=1 stopped=1 sig=15; kill -s TERM "$sd_pid" 2>/dev/null || :' TERM
  trap 'woke=1 stopped=1 sig=2; kill -s INT "$sd_pid" 2>/dev/null || :' INT
  trap 'woke=1 stopped=1 sig=1; kill -s HUP "$sd_pid" 2>/dev/null || :' HUP
  # A trapped signal ends wait early. Waiting again returns the status once a child exits. The
  # watch exits only with a verdict; if it ever exits without one, systemd-run is waited for alone.
  while :; do
    woke=0 r=0 who=""
    wait -n -p who "${ids[@]}" || r=$?
    if [[ "${who:-}" == "$sd_pid" ]]; then rc=$r; break; fi
    if [[ -n "${who:-}" ]]; then
      wd_live=0
      ids=("$sd_pid")
      read -r -u "$wd" verdict || verdict=""
      if (( stopped )); then verdict=""; fi
      if [[ "$verdict" == "rc "* || "$verdict" == unknown ]]; then break; fi
      verdict=""
      continue
    fi
    (( woke )) || { rc=$r; break; }
  done
  # If systemd-run exited while a trap ran, bash reaped it there and the next wait finds no child.
  # Its status is lost, so report the signal that stopped it rather than 127 (a pkexec failure).
  if (( rc == 127 && stopped )); then rc=$(( 128 + sig )); fi
  trap - TERM INT HUP
  if [[ -n "$verdict" ]]; then
    kill -s TERM "$sd_pid" 2>/dev/null || :
    exec {pause}<> <(:)
    { read -r -t "$POLL" -u "$pause" _ || :; } &
    ids=("$sd_pid" "$!")
    exec {pause}<&-
    who=""
    wait -n -p who "${ids[@]}" || :
    if [[ "${who:-}" == "$sd_pid" ]]; then kill "${ids[1]}" 2>/dev/null || :
    else kill -s KILL "$sd_pid" 2>/dev/null || :; fi
    wait "${ids[@]}" 2>/dev/null || :
    if [[ "$verdict" =~ ^rc\ ([0-9]{1,3})$ ]]; then
      rc="${BASH_REMATCH[1]}"
      echo "$ME: systemd-run stopped reporting after dnf5 finished, so its exit status ($rc) was read from systemd." >&2
    else
      rc=1
      echo "$ME: systemd-run stopped reporting after dnf5 finished, and systemd no longer has its result." >&2
    fi
    if [[ -n "$out_pid" ]]; then
      exec {pause}<> <(:)
      read -r -t "$POLL" -u "$pause" _ || :
      exec {pause}<&-
      stopped=1
    fi
  elif (( wd_live )); then
    kill -s TERM "$wd_pid" 2>/dev/null || :
    wait "$wd_pid" || :
  fi
  exec {wd}<&-
  if [[ -n "$out_pid" ]]; then
    if (( stopped )); then kill "$out_pid" "$err_pid" 2>/dev/null || :; fi
    wait "$out_pid" "$err_pid" || :
  fi
  return "$rc"
}

# A second run of the same verb must not start while the first one's dnf5 is still running: its
# unit name is fixed, so systemd would refuse the start anyway, with a message about unit names.
# Otherwise the name is reset first. Without --collect a failed unit stays loaded until then, and
# it would block the name. reset-failed changes nothing about a unit that is running.
claim_unit() {  # → returns, or exits BUSY while the unit of an earlier run is still going
  case "$("$SYSTEMCTL" show --no-pager -p ActiveState --value -- "$UNIT" 2>/dev/null || :)" in
    active|activating|deactivating|reloading|refreshing)
      echo "$ME: dnf5 was not started, because the one Kempt started earlier is still running. Nothing changed." >&2
      exit "$BUSY" ;;
  esac
  "$SYSTEMCTL" reset-failed --no-pager -- "$UNIT" 2>/dev/null || :
}

# The watch on dnf5's unit, run while systemd-run waits. systemd-run --wait hears that the unit
# finished from PID 1 over the system bus. When PID 1 drops its API bus connection, which a
# package's setup step can cause (a scriptlet that runs systemctl for a user manager, say), it
# forgets systemd-run's interest in the unit, and systemd-run waits for good. So every POLL seconds
# this asks systemctl, as root over systemd's private socket, about the unit. Once the unit has
# been seen running, and has then ended for GRACE reads in a row, it prints the verdict and exits:
# "rc N" from what systemd recorded, or "unknown" when systemd no longer has it. A successful unit
# is unloaded once nothing refers to it, and a failed one stays loaded until reset, so gone after
# running is success. Another InvocationID under the name is another run, and this run's result
# is gone with it. A unit never seen running is never judged: systemd-run may still be starting it.
# Until it has been seen, the first FIRST_READS reads come every FIRST seconds, so a dnf5 that ends
# within seconds is still seen running. A read with no InvocationID names no run (systemd answers
# like that while it re-executes itself), so it is never taken as this run's or another one's.
# Nothing here stops anything. A unit still running after LONG_RUN reads is only reported, once.
watch_unit() {  # → "rc N" or "unknown" once dnf5's unit has ended; nothing while it runs
  local pause k v load active result code status inv mine="" seen=0 ended=0 polls=0 early=0
  exec {pause}<> <(:)
  while :; do
    if (( ! seen && early < FIRST_READS )); then
      early=$(( early + 1 ))
      read -r -t "$FIRST" -u "$pause" _ || :
    else
      read -r -t "$POLL" -u "$pause" _ || :
    fi
    load="" active="" result="" code="" status="" inv=""
    while IFS='=' read -r k v; do
      case "$k" in
        LoadState) load="$v" ;;
        ActiveState) active="$v" ;;
        Result) result="$v" ;;
        ExecMainCode) code="$v" ;;
        ExecMainStatus) status="$v" ;;
        InvocationID) inv="$v" ;;
      esac
    done < <("$SYSTEMCTL" show --no-pager -p LoadState,ActiveState,Result,ExecMainCode,ExecMainStatus,InvocationID -- "$UNIT" 2>/dev/null || :)
    [[ -n "$load" && -n "$active" ]] || continue
    case "$active" in
      active|activating|deactivating|reloading|refreshing)
        if [[ -z "$inv" ]]; then :
        elif (( ! seen )); then seen=1 mine="$inv"
        elif [[ "$inv" != "$mine" ]]; then echo unknown; return 0; fi
        ended=0 polls=$(( polls + 1 ))
        if (( polls == LONG_RUN )); then
          echo "$ME: dnf5 has been running for 15 minutes. Kempt will not interrupt it. Keep the computer on." >&2
        fi
        continue ;;
    esac
    (( seen )) || continue
    ended=$(( ended + 1 ))
    (( ended >= GRACE )) || continue
    # ExecMainCode is how dnf5 ended: 1 exited with ExecMainStatus, 2 killed, 3 dumped core.
    # systemd-run itself reports 255 for the last two.
    if [[ "$load" == not-found ]]; then echo "rc 0"
    elif [[ "$inv" != "$mine" ]]; then echo unknown
    elif [[ "$code" == 1 && "$status" =~ ^(0|[1-9][0-9]?|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$ ]]; then echo "rc $status"
    elif [[ "$code" == 2 || "$code" == 3 ]]; then echo "rc 255"
    elif [[ "$result" == success ]]; then echo "rc 0"
    else echo unknown; fi
    return 0
  done
}

# systemd-run, the directory that exists only while systemd is PID 1 (sd_booted(3)), systemctl,
# and the watch's timing: a read every POLL seconds, but every FIRST seconds (POLL if shorter)
# for the first FIRST_READS reads until the unit is seen running, a verdict after GRACE reads of an
# ended unit (10 s), the long-run line after LONG_RUN reads of a running one (15 minutes). Fixed whenever this
# runs as root; the seams are honoured only for an unprivileged caller, which is the test suite,
# like KEMPT_OFFLINE_TOML below. UNIT is set from a fixed table once the verb is known.
SYSTEMD_RUN=/usr/bin/systemd-run
SYSTEMD_BOOTED=/run/systemd/system
SYSTEMCTL=/usr/bin/systemctl
POLL=5
FIRST=1
FIRST_READS=10
GRACE=2
LONG_RUN=180
UNIT=""
if [[ $EUID -ne 0 ]]; then
  SYSTEMD_RUN="${KEMPT_SYSTEMD_RUN:-$SYSTEMD_RUN}"
  SYSTEMD_BOOTED="${KEMPT_SYSTEMD_BOOTED:-$SYSTEMD_BOOTED}"
  SYSTEMCTL="${KEMPT_SYSTEMD_SYSTEMCTL:-$SYSTEMCTL}"
  if [[ "${KEMPT_SYSTEMD_POLL:-}" =~ ^[0-9]{1,3}(\.[0-9]{1,3})?$ && "$KEMPT_SYSTEMD_POLL" =~ [1-9] ]]; then POLL="$KEMPT_SYSTEMD_POLL"; fi
  if [[ "${POLL%%.*}" =~ ^0+$ ]]; then FIRST="$POLL"; fi
  if [[ "${KEMPT_SYSTEMD_GRACE:-}" =~ ^[1-9][0-9]{0,4}$ ]]; then GRACE="$KEMPT_SYSTEMD_GRACE"; fi
  if [[ "${KEMPT_SYSTEMD_LONG_RUN:-}" =~ ^[1-9][0-9]{0,4}$ ]]; then LONG_RUN="$KEMPT_SYSTEMD_LONG_RUN"; fi
fi

# The only way dnf5 starts. [unit properties...] -- dnf5 arguments...
# --pipe gives dnf5 /dev/null for stdin and pipes back to this process's stdout and stderr
# (run_piped); a terminal on stdin gets --pty instead
# (below), so dnf5's own "Is this ok" prompt still reads it when the CLI runs without -y. --wait and
# systemd-run's exit status carry dnf5's back. The unit gets umask 022, no core files, systemd's
# default limits, cwd / and an environment of its own (--pty also copies TERM, COLORTERM and
# NO_COLOR from the caller, which only shape dnf5's output), so PATH and LC_ALL are set on it:
# without them it gets systemd's PATH, which puts /usr/local first for dnf5's own lookups, and the system
# locale. No time limit: stopping an rpm transaction partway is worse than waiting for it. Every
# dnf5 argument comes after `--`, so a validated --exclude can never reach systemd-run as an option,
# and --expand-environment=no keeps PID 1 from expanding ${VAR} and $$ inside them. HOME is set
# because rpm scriptlets otherwise run without one (pkexec set it to /root). argv[0] is
# /usr/bin/dnf5, and dnf5 records it in its history; cmd_update looks the run up by that exact
# command line.
run_dnf5() {
  local -a props=()
  while [[ "$1" != -- ]]; do props+=("$1"); shift; done
  shift
  [[ -d "$SYSTEMD_BOOTED" && -x "$SYSTEMD_RUN" ]] || {
    echo "kempt-apply: dnf5 was not started, because systemd is not running this system (as in a container) or systemd-run is missing. Nothing changed." >&2
    exit "$NO_SYSTEMD"
  }
  # A terminal on stdin gets a pty of the unit's own instead of the terminal itself. With --pipe,
  # Ctrl-C reaches only systemd-run, which exits 130 and leaves dnf5 running, still reading the
  # terminal, so the next "y" typed at the shell answers dnf5's prompt. --pty puts the terminal in
  # raw mode and hands ^C to dnf5, which stops (exit 1) or, inside the rpm transaction, finishes.
  local io=--pipe
  [[ -t 0 ]] && io=--pty
  run "$SYSTEMD_RUN" "$io" --wait --quiet --unit="$UNIT" --expand-environment=no -p UMask=0022 -p LimitCORE=0 \
    --setenv=PATH=/usr/sbin:/usr/bin:/sbin:/bin --setenv=LC_ALL=C.UTF-8 --setenv=HOME=/root "${props[@]}" -- /usr/bin/dnf5 "$@"
}

# dnf5's record of the ONE stored offline transaction. An ordinary offline update and a Fedora
# release upgrade share it, and all three offline verbs act on whichever is there: staging replaces
# it, cleaning deletes it, arming makes the next restart install it. So this helper refuses all three
# over a stored release upgrade itself. The CLI refuses first, but the CLI runs as the user, and
# anything that calls this helper directly (inside polkit's retention window, or at any time under
# passwordless mode) never passes through the CLI.
#
# The path is fixed whenever this runs as root. KEMPT_OFFLINE_TOML is honoured only for an
# unprivileged caller, which is the test suite: a seam must never be able to change what root
# decides, and a non-root caller cannot run any of these dnf5 commands anyway.
OFFLINE_STATE=/usr/lib/sysimage/libdnf5/offline/offline-transaction-state.toml
if [[ $EUID -ne 0 && -n "${KEMPT_OFFLINE_TOML:-}" ]]; then OFFLINE_STATE="$KEMPT_OFFLINE_TOML"; fi

# Exit status for "refused because of what is stored", or because other users can change dnf5's
# folders (guard_unsafe_dirs), kept apart from 2 (bad arguments) so the CLI can tell the two apart
# and say which it was. dnf5 itself exits 0, 1, 2 or 100, and pkexec 126 or
# 127, so 3 cannot be mistaken for either of them.
REFUSED=3
# Exit status when systemd cannot start dnf5: no systemd as PID 1 (a container, say), or no
# systemd-run. Nothing ran. dnf5 is never started from this shell instead.
NO_SYSTEMD=4

# One `key = "value"` line from dnf5's file, the same line-anchored read lib/common.sh uses. It is
# repeated here rather than sourced because root must never source a file outside this helper. The
# value must look like a release version ("44", "rawhide", "eln"). Anything else is treated as a
# file that cannot be read, and never as a match.
stored_value() {  # key → the value; rc 1 when it is missing or not shaped like a release version
  local v
  v="$(sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" "$OFFLINE_STATE" 2>/dev/null)" \
    || return 1
  v="${v%%$'\n'*}"
  [[ "$v" =~ ^[A-Za-z0-9._-]+$ ]] || return 1
  printf '%s\n' "$v"
}

# No file: nothing is stored, so there is nothing to protect.
# A file whose two release versions are equal: an ordinary offline update. Allowed.
# A file whose two release versions differ: a release upgrade. Refused.
# A file that exists but cannot be read, or has no usable release versions: REFUSED. This is the
# fail-closed choice, and it is deliberate. The file is root-owned in a root-owned directory, so no
# unprivileged process can put it in this state. And the two mistakes cost very different amounts:
# refusing leaves the transaction in place, and `sudo dnf5 offline clean` still removes it, while
# allowing could arm or delete a release upgrade that took gigabytes to download.
guard_stored_release_upgrade() {  # verb → returns, or exits REFUSED
  [[ -e "$OFFLINE_STATE" || -L "$OFFLINE_STATE" ]] || return 0
  local from to
  if [[ -f "$OFFLINE_STATE" && -r "$OFFLINE_STATE" ]] \
     && from="$(stored_value system_releasever)" && to="$(stored_value target_releasever)"; then
    [[ "$from" != "$to" ]] || return 0
    echo "kempt-apply: refusing $1: a Fedora release upgrade ($from -> $to) is stored" >&2
  else
    echo "kempt-apply: refusing $1: the stored offline transaction cannot be read, so it may be a Fedora release upgrade" >&2
  fi
  exit "$REFUSED"
}

# systemd boots into an offline update whenever /system-update exists (systemd.offline-updates(7)).
# dnf5 points it at its offline directory. PackageKit, which Discover uses, points it at its own
# prepared update. Then the next restart belongs to that updater, and `dnf5 offline clean` would
# delete its link and cancel its install. So the clean refuses unless the path is absent or a link
# to dnf5's directory, the same rule the CLI's offline_link_state applies, written out here because
# root never sources the CLI's library. The arm is not guarded: dnf5 creates the link only when the
# path is absent, so it cannot replace another updater's, and the CLI reports that stage as blocked.
# The link text is read once and judged as read, so nothing swaps it between test and use. -ef is
# dnf5's own test (std::filesystem::equivalent). Anything else at the path, a link that cannot be
# read included, is refused. Only root can write to /, so no user can change the answer.
# Seams as for the state file: honoured only for an unprivileged caller.
SYSTEM_UPDATE=/system-update
OFFLINE_DATADIR=/usr/lib/sysimage/libdnf5/offline
if [[ $EUID -ne 0 ]]; then
  SYSTEM_UPDATE="${KEMPT_OFFLINE_LINK:-$SYSTEM_UPDATE}"
  OFFLINE_DATADIR="${KEMPT_OFFLINE_DATADIR:-$OFFLINE_DATADIR}"
fi

guard_foreign_system_update() {  # verb → returns, or exits REFUSED
  [[ -e "$SYSTEM_UPDATE" || -L "$SYSTEM_UPDATE" ]] || return 0
  local t
  if t="$(readlink -- "$SYSTEM_UPDATE" 2>/dev/null)" && [[ -n "$t" ]]; then
    [[ "$t" == /* ]] || t="${SYSTEM_UPDATE%/*}/$t"   # a relative link starts from its own directory
    if [[ "${t%/}" == "${OFFLINE_DATADIR%/}" || "$t" -ef "$OFFLINE_DATADIR" ]]; then return 0; fi
  fi
  echo "kempt-apply: refusing $1: another updater has prepared the next restart ($SYSTEM_UPDATE is not dnf5's)" >&2
  exit "$REFUSED"
}

# Releases up to 0.1.7 could leave dnf5's state and staged-package folders writable by other users.
# dnf5 keeps the staged transaction's record in the first, and that record names each package by
# its full path in the second. The restart installs those packages as root without checking their
# signatures again. So the upgrade, the stage and the arm all refuse while another user can change
# either folder: what they would build on, or install at the next restart, cannot be trusted.
# `kempt doctor` prints the fix. The clean is not refused, because discarding the stage is part of
# that fix. The cache is not checked: dnf5 checks signatures when it installs from there.
# The rule is doctor's (doctor_unsafe_entry in bin/kempt), written out here because root never
# sources the CLI's library. An entry counts when root does not own it, when it is a link (dnf5
# keeps none there), when it is world-writable, or when it is group-writable with a group other
# than root. Any ACL entry counts too. find -P and getfacl -P never follow a link. A folder that
# does not exist counts as safe: dnf5 creates it root-only. Only what is printed decides. find and
# getfacl carry on past an entry they cannot read, so an error elsewhere never hides a hit.
# Seams as for the state file: honoured only for an unprivileged caller.
DNF_STATE_DIR=/usr/lib/sysimage/libdnf5
DNF_OFFLINE_PKG_DIR=/var/lib/dnf/offline
if [[ $EUID -ne 0 ]]; then
  DNF_STATE_DIR="${KEMPT_DNF_SYSIMAGE_DIR:-$DNF_STATE_DIR}"
  DNF_OFFLINE_PKG_DIR="${KEMPT_DNF_OFFLINE_PKG_DIR:-$DNF_OFFLINE_PKG_DIR}"
fi

unsafe_entry() {  # dir → the first entry under it another user could change, or nothing
  [[ -e "$1" || -L "$1" ]] || return 0
  local hit
  hit="$(find -P "$1" \( ! -user root -o -type l -o \( ! -type l \( -perm -0002 -o \( -perm -0020 ! -group root \) \) \) \) \
    -print -quit 2>/dev/null)" || true
  if [[ -z "$hit" ]] && command -v getfacl >/dev/null 2>&1; then
    hit="$(getfacl -R -P -s -p "$1" 2>/dev/null | sed -n '1s/^# file: //p')" || true
  fi
  printf '%s' "$hit"
}

guard_unsafe_dirs() {  # verb → returns, or exits REFUSED
  local d
  for d in "$DNF_STATE_DIR" "$DNF_OFFLINE_PKG_DIR"; do
    [[ -z "$(unsafe_entry "$d")" ]] && continue
    echo "kempt-apply: refusing $1: other users can change files in $d. Run kempt doctor for the fix." >&2
    exit "$REFUSED"
  done
}

verb="${1:-}"; shift || true
# One fixed unit name per verb, never built from what the caller passed.
case "$verb" in
  dnf-upgrade) UNIT=kempt-apply-dnf-upgrade.service ;;
  dnf-offline-stage) UNIT=kempt-apply-dnf-offline-stage.service ;;
  dnf-offline-arm) UNIT=kempt-apply-dnf-offline-arm.service ;;
  dnf-offline-clean) UNIT=kempt-apply-dnf-offline-clean.service ;;
esac
case "$verb" in
  dnf-upgrade|dnf-offline-stage)
    assume=(); excludes=()
    for a in "$@"; do
      case "$a" in
        -y) assume=(-y) ;;
        --exclude=*) n="${a#--exclude=}"
           [[ "$n" =~ $NAME_RE ]] || { echo "invalid exclude: $n" >&2; exit 2; }
           excludes+=("--exclude=$n") ;;
        *) echo "invalid arg: $a" >&2; exit 2 ;;
      esac
    done
    guard_unsafe_dirs "$verb"
    offline=()
    # Only the stage is guarded against a stored release upgrade. A live upgrade does not replace
    # the stored transaction, but it moves the package set under it, which can leave a stored
    # release upgrade out of date. It is allowed on purpose: the CLI runs live updates while a
    # release upgrade waits. docs/security.md says so.
    if [[ "$verb" == dnf-offline-stage ]]; then
      guard_stored_release_upgrade "$verb"
      offline=(--offline)
    fi
    run_dnf5 -- upgrade "${offline[@]}" "${assume[@]}" "${excludes[@]}"
    ;;
  # A staged transaction sits at status="download-complete" and no boot applies it. This is what
  # ARMS it: status becomes "ready" and /system-update appears, which is the only thing systemd's
  # system-update-generator looks for. DNF_SYSTEM_UPGRADE_NO_REBOOT is the supported
  # arm-without-rebooting switch (dnf5-offline(8)) and is not optional here - without it dnf5
  # reboots the moment the transaction is armed, which is not what "on next restart" promised.
  # Set on the unit with --setenv, since the unit's environment is its own, so the guard is part of
  # the command line the ECHO seam prints and the suite can pin.
  dnf-offline-arm)
    [[ $# -eq 0 ]] || { echo "invalid arg: $1" >&2; exit 2; }
    guard_unsafe_dirs "$verb"
    guard_stored_release_upgrade "$verb"
    run_dnf5 --setenv=DNF_SYSTEM_UPGRADE_NO_REBOOT=1 -- offline reboot -y
    ;;
  # Discards a staged transaction: drops /system-update and empties the offline directory. Kempt
  # calls this to unwind a stage it could not arm, and to retire a stage a live update has already
  # superseded - a staged transaction records the rpmdb cookie it was built against, so once the
  # rpm set moves the stage can only fail at boot.
  dnf-offline-clean)
    [[ $# -eq 0 ]] || { echo "invalid arg: $1" >&2; exit 2; }
    guard_stored_release_upgrade "$verb"
    guard_foreign_system_update "$verb"
    run_dnf5 -- offline clean -y
    ;;
  *) echo "usage: kempt-apply dnf-upgrade [args]|dnf-offline-stage [args]|dnf-offline-arm|dnf-offline-clean" >&2; exit 2 ;;
esac

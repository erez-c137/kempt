#!/usr/bin/bash -p
# Kempt root helper - the dnf upgrade verbs, and only those. polkit action
# io.github.erez_c137.kempt.apply (auth_admin_keep). Flatpak is NOT here: `flatpak update` needs
# no password of its own in an active local session, so it runs as the user from
# backends/flatpak.sh, which is where the reasoning and the two residual prompts are written down.
# SECURITY: every argument is validated; anything unexpected exits 2 before any privileged command.
# Absolute shebang, -p and a pinned PATH: defense in depth beyond pkexec's env sanitizing.
# -p is bash's privileged mode. It never reads BASH_ENV or ENV, and it ignores SHELLOPTS, BASHOPTS,
# CDPATH, GLOBIGNORE and exported functions, so a caller that skips pkexec (sudo -E, say) still
# cannot run code before the first line below. /usr/bin/bash because that is the path the package
# ships. The same PATH is set on dnf5's unit (run_dnf5), so the pinned lookup order reaches dnf5's
# own children (rpm scriptlets run as root) too.
# This shell only decides. It validates the arguments, reads dnf5's stored state, and then hands
# the one dnf5 command to systemd, which starts it as a fresh system service (see run_dnf5). pkexec
# passes on far more of the caller than its environment: the umask, resource limits, ignored
# signals, the working directory, the nice value, the CPU affinity and the cgroup. A process systemd
# starts inherits none of them, so root's dnf5 cannot write group- or world-writable files into its
# cache, its downloads or the offline directory, and rpm scriptlets do not run with signals the
# caller chose to ignore. The umask and core-file lines below are belt and braces for this shell
# and systemd-run, which write nothing; dnf5 gets its own from the unit properties.
umask 022
ulimit -c 0
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C.UTF-8   # load-bearing: glibc widens [A-Za-z] under UTF-8 locales; pkexec passes LC_* through
NAME_RE='^[A-Za-z0-9][A-Za-z0-9._+-]*$'

run() {  # test seam: KEMPT_APPLY_ECHO=1 prints instead of exec
  if [[ -n "${KEMPT_APPLY_ECHO:-}" ]]; then echo "$*"; else exec "$@"; fi
}

# systemd-run, and the directory that exists only while systemd is PID 1 (sd_booted(3)). Fixed
# whenever this runs as root; the seams are honoured only for an unprivileged caller, which is the
# test suite, like KEMPT_OFFLINE_TOML below.
SYSTEMD_RUN=/usr/bin/systemd-run
SYSTEMD_BOOTED=/run/systemd/system
if [[ $EUID -ne 0 ]]; then
  SYSTEMD_RUN="${KEMPT_SYSTEMD_RUN:-$SYSTEMD_RUN}"
  SYSTEMD_BOOTED="${KEMPT_SYSTEMD_BOOTED:-$SYSTEMD_BOOTED}"
fi

# The only way dnf5 starts. [unit properties...] -- dnf5 arguments...
# --pipe hands dnf5 this process's stdin, stdout and stderr, so dnf5's own "Is this ok" prompt
# still reads the terminal when the CLI runs without -y; --wait and systemd-run's exit status carry
# dnf5's back. The unit gets umask 022, no core files, systemd's default limits, cwd / and an
# environment of its own, so PATH and LC_ALL are set on it: without them it gets systemd's PATH,
# which puts /usr/local first for dnf5's own lookups, and the system locale. No time limit: stopping an
# rpm transaction partway is worse than waiting for it. Every dnf5 argument comes after `--`, so a
# validated --exclude can never reach systemd-run as an option, and --expand-environment=no keeps
# PID 1 from expanding ${VAR} and $$ inside them. HOME is set because rpm scriptlets otherwise run
# without one (pkexec set it to /root). argv[0] is /usr/bin/dnf5, and dnf5
# records it in its history; cmd_update looks the run up by that exact command line.
run_dnf5() {
  local -a props=()
  while [[ "$1" != -- ]]; do props+=("$1"); shift; done
  shift
  [[ -d "$SYSTEMD_BOOTED" && -x "$SYSTEMD_RUN" ]] || {
    echo "kempt-apply: systemd is not running this system, or systemd-run is missing, so dnf5 was not started" >&2
    exit "$NO_SYSTEMD"
  }
  # A terminal on stdin gets a pty of the unit's own instead of the terminal itself. With --pipe,
  # Ctrl-C reaches only systemd-run, which exits 130 and leaves dnf5 running, still reading the
  # terminal, so the next "y" typed at the shell answers dnf5's prompt. --pty puts the terminal in
  # raw mode and hands ^C to dnf5, which stops (exit 1) or, inside the rpm transaction, finishes.
  local io=--pipe
  [[ -t 0 ]] && io=--pty
  run "$SYSTEMD_RUN" "$io" --wait --quiet --collect --expand-environment=no -p UMask=0022 -p LimitCORE=0 \
    --setenv=PATH=/usr/sbin:/usr/bin:/sbin:/bin --setenv=LC_ALL=C.UTF-8 --setenv=HOME=/root "${props[@]}" -- /usr/bin/dnf5 "$@"
}

# dnf5's record of the ONE stored offline transaction. An ordinary offline update and a Fedora
# release upgrade share it, and all three offline verbs act on whichever is there: staging replaces
# it, cleaning deletes it, arming makes the next restart install it. So this helper refuses all three
# over a stored release upgrade itself. The CLI refuses first, but the CLI runs as the user, and
# anything that calls this helper directly (inside polkit's retention window, or at any time under
# passwordless mode) never passes through the CLI.
#
# The path is fixed whenever this runs as root. KEMPT_OFFLINE_TOML is honoured only for an
# unprivileged caller, which is the test suite: a seam must never be able to change what root
# decides, and a non-root caller cannot run any of these dnf5 commands anyway.
OFFLINE_STATE=/usr/lib/sysimage/libdnf5/offline/offline-transaction-state.toml
if [[ $EUID -ne 0 && -n "${KEMPT_OFFLINE_TOML:-}" ]]; then OFFLINE_STATE="$KEMPT_OFFLINE_TOML"; fi

# Exit status for "refused because of what is stored", kept apart from 2 (bad arguments) so the CLI
# can tell the two apart and say which it was. dnf5 itself exits 0, 1, 2 or 100, and pkexec 126 or
# 127, so 3 cannot be mistaken for either of them.
REFUSED=3
# Exit status when systemd cannot start dnf5: no systemd as PID 1 (a container, say), or no
# systemd-run. Nothing ran. dnf5 is never started from this shell instead.
NO_SYSTEMD=4

# One `key = "value"` line from dnf5's file, the same line-anchored read lib/common.sh uses. It is
# repeated here rather than sourced because root must never source a file outside this helper. The
# value must look like a release version ("44", "rawhide", "eln"). Anything else is treated as a
# file that cannot be read, and never as a match.
stored_value() {  # key → the value; rc 1 when it is missing or not shaped like a release version
  local v
  v="$(sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" "$OFFLINE_STATE" 2>/dev/null)" \
    || return 1
  v="${v%%$'\n'*}"
  [[ "$v" =~ ^[A-Za-z0-9._-]+$ ]] || return 1
  printf '%s\n' "$v"
}

# No file: nothing is stored, so there is nothing to protect.
# A file whose two release versions are equal: an ordinary offline update. Allowed.
# A file whose two release versions differ: a release upgrade. Refused.
# A file that exists but cannot be read, or has no usable release versions: REFUSED. This is the
# fail-closed choice, and it is deliberate. The file is root-owned in a root-owned directory, so no
# unprivileged process can put it in this state. And the two mistakes cost very different amounts:
# refusing leaves the transaction in place, and `sudo dnf5 offline clean` still removes it, while
# allowing could arm or delete a release upgrade that took gigabytes to download.
guard_stored_release_upgrade() {  # verb → returns, or exits REFUSED
  [[ -e "$OFFLINE_STATE" || -L "$OFFLINE_STATE" ]] || return 0
  local from to
  if [[ -f "$OFFLINE_STATE" && -r "$OFFLINE_STATE" ]] \
     && from="$(stored_value system_releasever)" && to="$(stored_value target_releasever)"; then
    [[ "$from" != "$to" ]] || return 0
    echo "kempt-apply: refusing $1: a Fedora release upgrade ($from -> $to) is stored" >&2
  else
    echo "kempt-apply: refusing $1: the stored offline transaction cannot be read, so it may be a Fedora release upgrade" >&2
  fi
  exit "$REFUSED"
}

# systemd boots into an offline update whenever /system-update exists (systemd.offline-updates(7)).
# dnf5 points it at its offline directory. PackageKit, which Discover uses, points it at its own
# prepared update. Then the next restart belongs to that updater, and `dnf5 offline clean` would
# delete its link and cancel its install. So the clean refuses unless the path is absent or a link
# to dnf5's directory, the same rule the CLI's offline_link_state applies, written out here because
# root never sources the CLI's library. The arm is not guarded: dnf5 creates the link only when the
# path is absent, so it cannot replace another updater's, and the CLI reports that stage as blocked.
# The link text is read once and judged as read, so nothing swaps it between test and use. -ef is
# dnf5's own test (std::filesystem::equivalent). Anything else at the path, a link that cannot be
# read included, is refused. Only root can write to /, so no user can change the answer.
# Seams as for the state file: honoured only for an unprivileged caller.
SYSTEM_UPDATE=/system-update
OFFLINE_DATADIR=/usr/lib/sysimage/libdnf5/offline
if [[ $EUID -ne 0 ]]; then
  SYSTEM_UPDATE="${KEMPT_OFFLINE_LINK:-$SYSTEM_UPDATE}"
  OFFLINE_DATADIR="${KEMPT_OFFLINE_DATADIR:-$OFFLINE_DATADIR}"
fi

guard_foreign_system_update() {  # verb → returns, or exits REFUSED
  [[ -e "$SYSTEM_UPDATE" || -L "$SYSTEM_UPDATE" ]] || return 0
  local t
  if t="$(readlink -- "$SYSTEM_UPDATE" 2>/dev/null)" && [[ -n "$t" ]]; then
    [[ "$t" == /* ]] || t="${SYSTEM_UPDATE%/*}/$t"   # a relative link starts from its own directory
    if [[ "${t%/}" == "${OFFLINE_DATADIR%/}" || "$t" -ef "$OFFLINE_DATADIR" ]]; then return 0; fi
  fi
  echo "kempt-apply: refusing $1: another updater has prepared the next restart ($SYSTEM_UPDATE is not dnf5's)" >&2
  exit "$REFUSED"
}

verb="${1:-}"; shift || true
case "$verb" in
  dnf-upgrade|dnf-offline-stage)
    assume=(); excludes=()
    for a in "$@"; do
      case "$a" in
        -y) assume=(-y) ;;
        --exclude=*) n="${a#--exclude=}"
           [[ "$n" =~ $NAME_RE ]] || { echo "invalid exclude: $n" >&2; exit 2; }
           excludes+=("--exclude=$n") ;;
        *) echo "invalid arg: $a" >&2; exit 2 ;;
      esac
    done
    offline=()
    # Only the stage is guarded. A live upgrade does not replace the stored transaction, but it
    # moves the package set under it, which can leave a stored release upgrade out of date. It is
    # allowed on purpose: the CLI runs live updates while a release upgrade waits, and reports a
    # failure of this verb as a failed run rather than a refusal. docs/security.md says so.
    if [[ "$verb" == dnf-offline-stage ]]; then
      guard_stored_release_upgrade "$verb"
      offline=(--offline)
    fi
    run_dnf5 -- upgrade "${offline[@]}" "${assume[@]}" "${excludes[@]}"
    ;;
  # A staged transaction sits at status="download-complete" and no boot applies it. This is what
  # ARMS it: status becomes "ready" and /system-update appears, which is the only thing systemd's
  # system-update-generator looks for. DNF_SYSTEM_UPGRADE_NO_REBOOT is the supported
  # arm-without-rebooting switch (dnf5-offline(8)) and is not optional here - without it dnf5
  # reboots the moment the transaction is armed, which is not what "on next restart" promised.
  # Set on the unit with --setenv, since the unit's environment is its own, so the guard is part of
  # the command line the ECHO seam prints and the suite can pin.
  dnf-offline-arm)
    [[ $# -eq 0 ]] || { echo "invalid arg: $1" >&2; exit 2; }
    guard_stored_release_upgrade "$verb"
    run_dnf5 --setenv=DNF_SYSTEM_UPGRADE_NO_REBOOT=1 -- offline reboot -y
    ;;
  # Discards a staged transaction: drops /system-update and empties the offline directory. Kempt
  # calls this to unwind a stage it could not arm, and to retire a stage a live update has already
  # superseded - a staged transaction records the rpmdb cookie it was built against, so once the
  # rpm set moves the stage can only fail at boot.
  dnf-offline-clean)
    [[ $# -eq 0 ]] || { echo "invalid arg: $1" >&2; exit 2; }
    guard_stored_release_upgrade "$verb"
    guard_foreign_system_update "$verb"
    run_dnf5 -- offline clean -y
    ;;
  *) echo "usage: kempt-apply dnf-upgrade [args]|dnf-offline-stage [args]|dnf-offline-arm|dnf-offline-clean" >&2; exit 2 ;;
esac

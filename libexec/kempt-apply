#!/usr/bin/bash -p
# Kempt's root helper for updates: four fixed dnf5 commands and nothing else.
# polkit action io.github.erez_c137.kempt.apply: a wheel user at the desk, no password; anyone else at
# the desk, an admin password; over SSH, nobody. pkexec picks the action by this file's path, which
# is why the no-dialog helper, kempt-refresh, is a separate file. docs/security.md explains each line.

# pkexec clears the environment, but passes on the umask, limits, directory and ignored signals.
umask 022
cd /
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C.UTF-8
ulimit -c 0
ulimit -f unlimited -t unlimited -d unlimited -v unlimited -m unlimited -s 8192 -n 4096 || (( EUID ))

NAME_RE='^[A-Za-z0-9][A-Za-z0-9._+-]*$'
ROOT="" OWNER=0 GROUP=0
# The tests' stand-in tree. pkexec always runs this as root, which never enters this block.
if (( EUID )); then ROOT="${KEMPT_HELPER_ROOT:?this helper runs through pkexec}" OWNER="$EUID" GROUP="$(id -g)"; fi
STATE="$ROOT/usr/lib/sysimage/libdnf5" STAGED="$ROOT/var/lib/dnf/offline" CACHE="$ROOT/var/cache/libdnf5"
STORED="$STATE/offline/offline-transaction-state.toml" LINK="$ROOT/system-update"

refuse() { echo "kempt-apply: $1" >&2; exit 3; }
usage() { echo "usage: kempt-apply dnf-upgrade [-y] [--exclude=NAME]...|dnf-offline-stage [-y] [--exclude=NAME]...|dnf-offline-arm|dnf-offline-clean" >&2; exit 2; }

# Root installs what is in these folders, so it stays out while other users can change them.
check_folders() {
  local d hit
  for d in "$STATE" "$STAGED" "$CACHE"; do
    [[ -e "$d" ]] || continue
    hit="$(find -P "$d" -ignore_readdir_race \( ! -uid "$OWNER" -o \( ! -type l \( -perm -0002 -o \
      \( -perm -0020 ! -gid "$GROUP" \) \) \) \) -print -quit)" || refuse "Kempt could not check $d. Run kempt doctor."
    [[ -z "$hit" ]] || refuse "Updates paused for safety: users other than root can change $d. Run kempt doctor for the fix."
  done
}

# dnf5 keeps one stored transaction, and a Fedora release upgrade shares it. Stage replaces it, arm
# makes the next restart install it, clean deletes it. Two equal releases are an ordinary update;
# anything else, a file that cannot be read included, is refused.
stored() { sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\"\([A-Za-z0-9._-]*\)\".*/\1/;T;p;q" "$STORED" 2>/dev/null || true; }
check_stored() {
  [[ -e "$STORED" || -L "$STORED" ]] || return 0
  local from to
  from="$(stored system_releasever)" to="$(stored target_releasever)"
  [[ -n "$from" && "$from" == "$to" ]] || refuse "refusing: a Fedora release upgrade may be stored"
}

# dnf5 offline clean would delete /system-update whoever made it, and PackageKit makes one too.
check_link() {
  [[ -e "$LINK" || -L "$LINK" ]] || return 0
  [[ "$(readlink -- "$LINK")" == "$STATE/offline" || "$LINK" -ef "$STATE/offline" ]] \
    || refuse "refusing: another updater has prepared the next restart ($LINK is not dnf5's)"
}

verb="${1:-}"
(( $# == 0 )) || shift
env_extra=()
case "$verb" in
  dnf-upgrade|dnf-offline-stage)
    args=(upgrade)
    if [[ "$verb" == dnf-offline-stage ]]; then args+=(--offline); fi
    for a in "$@"; do
      case "$a" in
        -y) args+=(-y) ;;
        --exclude=*) [[ "${a#--exclude=}" =~ $NAME_RE ]] || usage; args+=("$a") ;;
        *) usage ;;
      esac
    done
    check_folders
    # A live update is allowed beside a stored release upgrade: the CLI offers that on purpose.
    if [[ "$verb" == dnf-offline-stage ]]; then check_stored; fi
    ;;
  dnf-offline-arm)
    (( $# == 0 )) || usage
    check_folders
    check_stored
    # Without this, dnf5 reboots the moment the update is set to install.
    env_extra=(DNF_SYSTEM_UPGRADE_NO_REBOOT=1) args=(offline reboot -y)
    ;;
  dnf-offline-clean)
    (( $# == 0 )) || usage
    check_stored
    check_link
    args=(offline clean -y)
    ;;
  *) usage ;;
esac

# A closed terminal sends dnf5 no HUP it will act on, and the scope outlives the login session. Output
# and exit status stay this process's own, because everything here is exec, with no child to wait for.
exec "$ROOT/usr/bin/systemd-run" --scope --quiet --collect -- \
  env -i --default-signal --ignore-signal=PIPE --ignore-signal=HUP \
  PATH="$PATH" LC_ALL=C.UTF-8 HOME=/root "${env_extra[@]}" "$ROOT/usr/bin/dnf5" "${args[@]}"

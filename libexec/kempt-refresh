#!/usr/bin/bash -p
# Kempt root helper - metadata only. polkit action io.github.erez_c137.kempt.refresh (allow_active=yes).
# Absolute shebang, -p and a pinned PATH: defense in depth beyond pkexec's env sanitizing. -p keeps
# bash from reading BASH_ENV, ENV, SHELLOPTS, BASHOPTS, CDPATH, GLOBIGNORE or exported functions
# from the caller (see kempt-apply). PATH is exported, so the pinned lookup order reaches dnf5's own
# children too.
# pkexec passes on the caller's umask and resource limits, so both are reset before anything else.
# The umask keeps root's dnf5 from writing group- or world-writable files into its cache.
# The file size limit goes so a limit the caller chose cannot cut a root write short. Core files
# go off so a crash leaves no copy of root's memory on disk. Raising a limit can fail outside root,
# which is only the test suite, and must not stop the helper there.
umask 022
ulimit -c 0
ulimit -f unlimited 2>/dev/null || true
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C.UTF-8

run() {  # test seam: KEMPT_REFRESH_ECHO=1 prints the final command instead of exec'ing it
  if [[ -n "${KEMPT_REFRESH_ECHO:-}" ]]; then echo "$*"; else exec "$@"; fi
}

# Does the installed dnf5 print check-update as JSON? 5.4.0 added --json; Fedora 43 ships 5.2.
# The CLI tells the two formats apart by content, so this choice never has to match the CLI's.
# KEMPT_DNF5_VERSION is a test seam; pkexec clears the environment, so it never reaches a real run.
dnf5_json() {
  local v="${KEMPT_DNF5_VERSION:-$(rpm -q --qf '%{VERSION}' dnf5 2>/dev/null || true)}"
  [[ "$v" =~ ^[0-9][0-9.]*$ ]] && [[ "$(printf '%s\n' 5.4.0 "$v" | sort -V | head -n1)" == 5.4.0 ]]
}

# Exactly one argument: extra args are never forwarded, so refusing them keeps the caller honest
# instead of silently ignoring what it asked for.
[[ $# -eq 1 ]] || { echo "usage: kempt-refresh check|refresh" >&2; exit 2; }
case "$1" in
  # NEVER add 2>&1 to the check verb: the CLI parses its stdout, and dnf5 keeps all
  # progress/errors on stderr - merging them would feed diagnostics into the parser.
  # Text exits 100 when updates are pending; JSON exits 0 either way.
  check)   if dnf5_json; then run dnf5 --cacheonly check-update --quiet --json
           else run dnf5 --cacheonly check-update --quiet; fi ;;
  # The time limit lives here, as root: the CLI's own `timeout` wraps pkexec and cannot signal a
  # root dnf5. 120 s is the CLI's KEMPT_REFRESH_TIMEOUT, so the widget's 510 s ceiling holds; -k 10
  # sends SIGKILL if dnf5 ignores SIGTERM. Fixed here, never taken from the caller. timeout exits
  # 124 (or 137 after the kill), which the CLI records as a failed refresh like any other.
  refresh) run /usr/bin/timeout -k 10 120 dnf5 makecache --refresh ;;
  *) echo "usage: kempt-refresh check|refresh" >&2; exit 2 ;;
esac

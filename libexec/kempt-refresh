#!/usr/bin/bash -p
# Kempt's no-dialog root helper: reads and refreshes package lists, and can install nothing.
# polkit action io.github.erez_c137.kempt.refresh: any active local user, no dialog. pkexec picks the
# action by this file's path, so this file holds no upgrade verb and never shares one with kempt-apply.
# docs/security.md explains each line.

# pkexec clears the environment, but passes on the umask, limits, directory and ignored signals.
umask 022
cd /
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C.UTF-8
ulimit -c 0
ulimit -f unlimited -t unlimited -d unlimited -v unlimited -m unlimited -s 8192 -n 4096 || (( EUID ))

ROOT="" OWNER=0 GROUP=0
version="$(rpm -q --qf '%{VERSION}' dnf5 2>/dev/null || true)"
# The tests' stand-in tree. pkexec always runs this as root, which never enters this block.
if (( EUID )); then
  ROOT="${KEMPT_HELPER_ROOT:?this helper runs through pkexec}" OWNER="$EUID" GROUP="$(id -g)"
  version="${KEMPT_DNF5_VERSION:-}"
fi
CACHE="$ROOT/var/cache/libdnf5"

refuse() { echo "kempt-refresh: $1" >&2; exit 3; }
usage() { echo "usage: kempt-refresh check|refresh" >&2; exit 2; }

[[ $# -eq 1 ]] || usage
case "$1" in
  # NEVER add 2>&1 to check: the CLI parses its stdout, and dnf5 keeps progress and errors on stderr.
  # dnf5 5.4.0 added --json; Fedora 43 has 5.2. The CLI tells the two apart by content.
  check)
    args=(--cacheonly check-update --quiet)
    if [[ "$version" =~ ^[0-9][0-9.]*$ && "$(printf '%s\n' 5.4.0 "$version" | sort -V | head -n1)" == 5.4.0 ]]; then
      args+=(--json)
    fi
    ;;
  refresh) args=(makecache --refresh) ;;
  *) usage ;;
esac

# Root's dnf5 parses what is in the cache, so it stays out while other users can change it.
if [[ -e "$CACHE" ]]; then
  hit="$(find -P "$CACHE" -ignore_readdir_race \( ! -uid "$OWNER" -o \( ! -type l \( -perm -0002 -o \
    \( -perm -0020 ! -gid "$GROUP" \) \) \) \) -print -quit)" || refuse "Kempt could not check $CACHE. Run kempt doctor."
  [[ -z "$hit" ]] || refuse "Updates paused for safety: users other than root can change $CACHE. Run kempt doctor for the fix."
fi

# One fixed scope per verb: a second one started while the first runs gets exit 1 and starts nothing.
# The time limit is here because the CLI's `timeout` cannot signal a root process.
exec "$ROOT/usr/bin/systemd-run" --scope --quiet --collect --unit="kempt-refresh-$1" \
  -p RuntimeMaxSec=120 -p TimeoutStopSec=10 -- \
  env -i --default-signal --ignore-signal=PIPE --ignore-signal=HUP \
  PATH="$PATH" LC_ALL=C.UTF-8 HOME=/root "$ROOT/usr/bin/dnf5" "${args[@]}"

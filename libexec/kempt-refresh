#!/usr/bin/bash -p
# Kempt root helper - metadata only. polkit action io.github.erez_c137.kempt.refresh (allow_active=yes).
# Absolute shebang, -p and a pinned PATH: defense in depth beyond pkexec's env sanitizing. -p keeps
# bash from reading BASH_ENV, ENV, SHELLOPTS, BASHOPTS, CDPATH, GLOBIGNORE or exported functions
# from the caller (see kempt-apply).
# This shell only decides. It validates its argument, checks the dnf5 version, and then hands the
# one dnf5 command to systemd, which starts it as a fresh system service (see run_dnf5). pkexec
# passes on far more of the caller than its environment: the umask, resource limits, ignored
# signals, the working directory, the nice value, the CPU affinity and the cgroup. A process systemd
# starts inherits none of them. The umask and core-file lines below are belt and braces for this
# shell and systemd-run, which write nothing; dnf5 gets its own from the unit properties.
umask 022
ulimit -c 0
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C.UTF-8

run() {  # test seam: KEMPT_REFRESH_ECHO=1 prints the final command instead of running it
  if [[ -n "${KEMPT_REFRESH_ECHO:-}" ]]; then echo "$*"; elif [[ "$2" == --pipe ]]; then run_piped "$@"; else exec "$@"; fi
}

# With --pipe, systemd-run hands its own stdin, stdout and stderr to PID 1, which gives them to
# dnf5's unit. They must never be this shell's own. PID 1 runs in SELinux's init_t, which may not
# write the caller's files (a mktemp file in /tmp is user_tmp_t), and systemd-run then fails with
# "Remote peer disconnected" before dnf5 starts. So its stdin is /dev/null, and its stdout and
# stderr are each a pipe this shell makes, read by a cat that copies to this shell's stdout or
# stderr. The two stay apart, because the CLI reads them apart. systemd-run runs as a child, not by
# exec, so the shell waits for both cats before it exits: no output is cut short, and the exit
# status is still systemd-run's, which is dnf5's. A TERM, INT or HUP to this shell is passed on to
# systemd-run, as it reached systemd-run when the shell exec'd it. Then the cats are stopped as
# well, since dnf5 may still hold their pipes open, and nothing outlives this shell. Identical in
# kempt-apply.
run_piped() {  # systemd-run --pipe ... → systemd-run's exit status
  local out err out_pid err_pid sd_pid rc=0 woke=0 stopped=0
  exec {out}> >(cat)
  out_pid=$!
  exec {err}> >(cat >&2 {out}>&-)
  err_pid=$!
  # Bash starts a background command with INT and QUIT ignored. systemd-run gets them back as this
  # shell had them, the way exec handed them over.
  { trap - INT QUIT; exec "$@"; } </dev/null >&"$out" 2>&"$err" {out}>&- {err}>&- &
  sd_pid=$!
  exec {out}>&- {err}>&-
  trap 'woke=1 stopped=1; kill -s TERM "$sd_pid" 2>/dev/null || :' TERM
  trap 'woke=1 stopped=1; kill -s INT "$sd_pid" 2>/dev/null || :' INT
  trap 'woke=1 stopped=1; kill -s HUP "$sd_pid" 2>/dev/null || :' HUP
  # A trapped signal ends wait early. Waiting again returns systemd-run's own status once it exits.
  while :; do
    woke=0 rc=0
    wait "$sd_pid" || rc=$?
    (( woke )) || break
  done
  trap - TERM INT HUP
  if (( stopped )); then kill "$out_pid" "$err_pid" 2>/dev/null || :; fi
  wait "$out_pid" "$err_pid" || :
  return "$rc"
}

# systemd-run, and the directory that exists only while systemd is PID 1 (sd_booted(3)). Fixed
# whenever this runs as root; the seams are honoured only for an unprivileged caller, which is the
# test suite, as in kempt-apply.
SYSTEMD_RUN=/usr/bin/systemd-run
SYSTEMD_BOOTED=/run/systemd/system
if [[ $EUID -ne 0 ]]; then
  SYSTEMD_RUN="${KEMPT_SYSTEMD_RUN:-$SYSTEMD_RUN}"
  SYSTEMD_BOOTED="${KEMPT_SYSTEMD_BOOTED:-$SYSTEMD_BOOTED}"
fi
# Exit status when systemd cannot start dnf5. It differs from 2 (bad arguments), from dnf5's own
# 0, 1 and 100, and from pkexec's 126 and 127. Without systemd, dnf5 does not run at all, and never
# directly from this shell.
NO_SYSTEMD=4

# The only way dnf5 starts. [unit properties...] -- dnf5 arguments...
# --pipe gives dnf5 /dev/null for stdin and pipes back to this process's stdout and stderr
# (run_piped); --wait and systemd-run's exit status carry dnf5's back (100 from check-update
# included). The unit gets umask 022, no core files, systemd's default limits, cwd /, and an
# environment of its own, so PATH and LC_ALL are set on it:
# without them it gets systemd's PATH, which puts /usr/local first for dnf5's own lookups, and
# the system locale, which would translate the text the CLI parses. Every dnf5 argument comes after
# `--`, so none of them can reach systemd-run as an option, and --expand-environment=no keeps PID 1
# from expanding ${VAR} and $$ inside them. HOME is set because rpm scriptlets otherwise run without
# one (pkexec set it to /root).
run_dnf5() {
  local -a props=()
  while [[ "$1" != -- ]]; do props+=("$1"); shift; done
  shift
  [[ -d "$SYSTEMD_BOOTED" && -x "$SYSTEMD_RUN" ]] || {
    echo "kempt-refresh: dnf5 was not started, because systemd is not running this system (as in a container) or systemd-run is missing. Nothing changed." >&2
    exit "$NO_SYSTEMD"
  }
  run "$SYSTEMD_RUN" --pipe --wait --quiet --collect --expand-environment=no -p UMask=0022 -p LimitCORE=0 \
    --setenv=PATH=/usr/sbin:/usr/bin:/sbin:/bin --setenv=LC_ALL=C.UTF-8 --setenv=HOME=/root "${props[@]}" -- /usr/bin/dnf5 "$@"
}

# Does the installed dnf5 print check-update as JSON? 5.4.0 added --json; Fedora 43 ships 5.2.
# The CLI tells the two formats apart by content, so this choice never has to match the CLI's.
# KEMPT_DNF5_VERSION is a test seam; pkexec clears the environment, so it never reaches a real run.
dnf5_json() {
  local v="${KEMPT_DNF5_VERSION:-$(rpm -q --qf '%{VERSION}' dnf5 2>/dev/null || true)}"
  [[ "$v" =~ ^[0-9][0-9.]*$ ]] && [[ "$(printf '%s\n' 5.4.0 "$v" | sort -V | head -n1)" == 5.4.0 ]]
}

# Exactly one argument: extra args are never forwarded, so refusing them keeps the caller honest
# instead of silently ignoring what it asked for.
[[ $# -eq 1 ]] || { echo "usage: kempt-refresh check|refresh" >&2; exit 2; }
case "$1" in
  # NEVER add 2>&1 to the check verb: the CLI parses its stdout, and dnf5 keeps all
  # progress/errors on stderr - merging them would feed diagnostics into the parser.
  # Text exits 100 when updates are pending; JSON exits 0 either way.
  check)   if dnf5_json; then run_dnf5 -- --cacheonly check-update --quiet --json
           else run_dnf5 -- --cacheonly check-update --quiet; fi ;;
  # The time limit lives here, as root: the CLI's own `timeout` wraps pkexec and cannot signal a
  # root dnf5. 120 s is the CLI's KEMPT_REFRESH_TIMEOUT, so the widget's 510 s ceiling holds. systemd
  # stops the unit when RuntimeMaxSec runs out, with SIGTERM and then SIGKILL after TimeoutStopSec.
  # Fixed here, never taken from the caller. The CLI records a refresh stopped this way as failed,
  # like any other.
  refresh) run_dnf5 -p RuntimeMaxSec=120 -p TimeoutStopSec=10 -- makecache --refresh ;;
  *) echo "usage: kempt-refresh check|refresh" >&2; exit 2 ;;
esac
